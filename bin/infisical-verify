#!/usr/bin/env bash
# =============================================================================
# infisical-verify — Verify secret chain integrity
#
# Usage:
#   infisical-verify                                        # Verify all sections
#   infisical-verify --section <section_id>                 # Verify specific section
#   infisical-verify --secret <secret_name>                 # Verify specific secret
#   infisical-verify --env prod                             # Target environment
#   infisical-verify --fail-fast                            # Stop on first mismatch
#   infisical-verify --report-file ./verification.json     # Export report
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/secret-engine.sh"

# -- Flags --------------------------------------------------------------------
ENV_ARG="prod"
SECTION_ARG=""
SECRET_ARG=""
FAIL_FAST=false
SHOW_VALUES=false
REPORT_FILE=""
CONFIG_FILE=""

# Parse arguments
next_is_value=false
for arg in "$@"; do
  if $next_is_value; then
    REPORT_FILE="$arg"
    next_is_value=false
    continue
  fi
  case "$arg" in
    --section) SECTION_ARG="$2"; shift 2 ;;
    --secret) SECRET_ARG="$2"; shift 2 ;;
    --env) ENV_ARG="$2"; shift 2 ;;
    --stage) ENV_ARG="staging"; shift ;;
    --prod) ENV_ARG="prod"; shift ;;
    --dev) ENV_ARG="dev"; shift ;;
    --fail-fast) FAIL_FAST=true; shift ;;
    --show-values) SHOW_VALUES=true; shift ;;
    --report-file) next_is_value=true; shift ;;
    --config) CONFIG_FILE="$2"; shift 2 ;;
    -h|--help)
      cat <<'USAGE'
Usage: infisical-verify [OPTIONS]

Verify secret chain integrity comparing:
  - .infisical-secrets.yaml (declarative mapping)
  - .envrc.dc (runtime configuration via dc get)
  - Infisical (remote storage)

Options:
  --section ID       Verify specific section/group only
  --secret NAME      Verify specific secret name only
  --env ENV          Target environment: prod | staging (default: prod)
  --stage            Shorthand for --env=staging
  --prod             Shorthand for --env=prod
  --dev              Shorthand for --env=dev
  --fail-fast        Stop on first mismatch (default: continue)
  --show-values      Show actual secret values (sensitive!)
  --report-file FILE Export detailed report to JSON file
  --config FILE      Path to secrets YAML config
  -h, --help         Show this help message

Exit codes:
  0 - All secrets verified successfully
  1 - One or more secrets failed verification
  2 - Configuration or authentication error

Examples:
  infisical-verify                              # Verify all secrets
  infisical-verify --section data-postgres       # Verify specific section
  infisical-verify --secret POSTGRES_PASSWORD     # Verify specific secret
  infisical-verify --fail-fast                   # Stop on first error
  infisical-verify --report-file audit.json      # Export to JSON
USAGE
      exit 0
      ;;
    *)
      log_error "Unknown option: $1"
      exit 2
      ;;
  esac
done

# -- Find secrets config ------------------------------------------------------
if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE=$(secrets_find_config)
  if [[ -z "$CONFIG_FILE" ]]; then
    die "No secrets config file found (.infisical-secrets.yaml or secrets.yaml)"
  fi
fi

log_info "Using config: $CONFIG_FILE"
log_info "Environment: $ENV_ARG"

# -- Authenticate with Infisical -----------------------------------------------
log_info "Authenticating with Infisical..."
INFISICAL_PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-$(yq -r '.project.slug // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
INFISICAL_PROJECT_ID="${INFISICAL_PROJECT_ID:-}"

infisical_auth "" "$INFISICAL_PROJECT_ID" "$INFISICAL_PROJECT_SLUG"

log_success "Authenticated (project: ${SECRET_ENGINE_PROJECT_ID})"
echo ""

# -- Run verification ---------------------------------------------------------
results_json=""
has_error=false

if [[ -n "$SECRET_ARG" ]]; then
  # Verify single secret
  log_info "Verifying secret: $SECRET_ARG"
  results_json="["
  results_json+="$(verify_secret "$CONFIG_FILE" "$SECRET_ARG" "$ENV_ARG" "$SHOW_VALUES")"
  results_json+="]"
elif [[ -n "$SECTION_ARG" ]]; then
  # Verify section
  log_info "Verifying section: $SECTION_ARG"
  results_json=$(verify_section "$CONFIG_FILE" "$SECTION_ARG" "$ENV_ARG" "$SHOW_VALUES")
else
  # Verify all
  log_info "Verifying all secrets..."
  results_json=$(verify_all "$CONFIG_FILE" "$ENV_ARG" "$SHOW_VALUES")
fi

# -- Analyze results ---------------------------------------------------------
total=$(echo "$results_json" | jq 'length')
ok=$(echo "$results_json" | jq '[.[] | select(.status == "ok")] | length')
mismatch=$(echo "$results_json" | jq '[.[] | select(.status == "mismatch")] | length')
missing_yaml=$(echo "$results_json" | jq '[.[] | select(.status == "missing_yaml")] | length')
missing_dc=$(echo "$results_json" | jq '[.[] | select(.status == "missing_dc")] | length')
missing_infisical=$(echo "$results_json" | jq '[.[] | select(.status == "missing_infisical")] | length')
missing_all=$(echo "$results_json" | jq '[.[] | select(.status == "missing_all")] | length')

failed=$((mismatch + missing_yaml + missing_dc + missing_infisical + missing_all))
[[ "$failed" -gt 0 ]] && has_error=true

# -- Display results ----------------------------------------------------------
echo ""
echo "═══════════════════════════════════════════════════════════════"
echo -e "  ${BLUE}Verification Summary${NC}"
echo "═══════════════════════════════════════════════════════════════"
printf "  Total:   %4s\n" "$total"
printf "%-32s %4s\n" "  ✓  OK:" "$ok"

if [[ "$mismatch" -gt 0 ]]; then
  printf "%-32s ${RED}%4s${NC}\n" "  ✗  Mismatch:" "$mismatch"
fi
if [[ "$missing_yaml" -gt 0 ]]; then
  printf "%-32s ${YELLOW}%4s${NC}\n" "  !  Missing (YAML):" "$missing_yaml"
fi
if [[ "$missing_dc" -gt 0 ]]; then
  printf "%-32s ${YELLOW}%4s${NC}\n" "  !  Missing (dc):" "$missing_dc"
fi
if [[ "$missing_infisical" -gt 0 ]]; then
  printf "%-32s ${YELLOW}%4s${NC}\n" "  !  Missing (Infisical):" "$missing_infisical"
fi
if [[ "$missing_all" -gt 0 ]]; then
  printf "%-32s ${RED}%4s${NC}\n" "  ✗  Missing (all sources):" "$missing_all"
fi

echo "═══════════════════════════════════════════════════════════════"

# -- Show mismatches ----------------------------------------------------------
if [[ "$mismatch" -gt 0 ]]; then
  echo ""
  echo -e "${RED}Mismatching secrets:${NC}"
  echo ""
  echo -n "$results_json" | jq -r '.[] | select(.status == "mismatch") |
    "  • \(.name)\n    DC value:     \(if .dc.value then "[set]" else "[null]" end)\n    Infisical:   \(if .infisical.value then "[set]" else "[null]" end)\n"
  '

  if $FAIL_FAST; then
    exit 1
  fi
fi

# # -- Show missing secrets ------------------------------------------------------
if [[ "$missing_yaml" -gt 0 ]] || [[ "$missing_dc" -gt 0 ]] || [[ "$missing_infisical" -gt 0 ]] || [[ "$missing_all" -gt 0 ]]; then
  echo ""
  echo -e "${YELLOW}Missing secrets:${NC}"
  echo ""
  echo -n "$results_json" | jq -r '.[] |
    select(.status == "missing_yaml" or .status == "missing_dc" or .status == "missing_infisical" or .status == "missing_all") |
    "  • \(.name) (\(.status))"
  '

  if $FAIL_FAST; then
    exit 1
  fi
fi

# -- Export report -----------------------------------------------------------
if [[ -n "$REPORT_FILE" ]]; then
  report_data=$(jq -n \
    --argjson results "$results_json" \
    --arg env "$ENV_ARG" \
    --arg config "$CONFIG_FILE" \
    --argjson summary "$(jq -n \
      --arg total "$total" \
      --arg ok "$ok" \
      --arg mismatch "$mismatch" \
      --arg missing_yaml "$missing_yaml" \
      --arg missing_dc "$missing_dc" \
      --arg missing_infisical "$missing_infisical" \
      --arg missing_all "$missing_all" \
      '{total: $total | tonumber, ok: $ok | tonumber, mismatch: $mismatch | tonumber,
        missing_yaml: $missing_yaml | tonumber, missing_dc: $missing_dc | tonumber,
        missing_infisical: $missing_infisical | tonumber, missing_all: $missing_all | tonumber}
    )" \
    '{
      generated_at: (now | todate | toiso8601),
      environment: $env,
      config_file: $config,
      project_id: "'"${SECRET_ENGINE_PROJECT_ID}"'",
      summary: $summary,
      results: $results
    }')

  echo "$report_data" | jq '.' > "$REPORT_FILE"
  log_success "Report saved to: $REPORT_FILE"
fi

# -- Exit --------------------------------------------------------------------
if $has_error; then
  exit 1
fi

log_success "All secrets verified successfully!"
exit 0