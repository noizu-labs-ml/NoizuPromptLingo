#!/usr/bin/env bash
# =============================================================================
# infisical-set-secret — Edit secrets by name
#
# Usage:
#   infisical-set-secret <secret_name>                      # Prompt for new value
#   infisical-set-secret <secret_name> --value "new-value"  # Set inline
#   infisical-set-secret <secret_name> --generate           # Auto-generate new value
#   infisical-set-secret <secret_name> --dry-run           # Preview changes
#   infisical-set-secret --cascade                          # Update all references
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/secret-engine.sh"

# -- Flags --------------------------------------------------------------------
ENV_ARG="prod"
DRY_RUN=false
GENERATE=false
CASCADE=false
NEW_VALUE=""
CONFIG_FILE=""

# Parse arguments
next_is_value=false
for arg in "$@"; do
  if $next_is_value; then
    NEW_VALUE="$arg"
    next_is_value=false
    continue
  fi
  case "$arg" in
    --value) next_is_value=true; shift ;;
    --generate) GENERATE=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    --cascade) CASCADE=true; shift ;;
    --env) ENV_ARG="$2"; shift 2 ;;
    --stage) ENV_ARG="staging"; shift ;;
    --prod) ENV_ARG="prod"; shift ;;
    --dev) ENV_ARG="dev"; shift ;;
    --config) CONFIG_FILE="$2"; shift 2 ;;
    -h|--help)
      cat <<'USAGE'
Usage: infisical-set-secret <secret_name> [OPTIONS]

Edit a secret by name, updating across the chain:
  - .infisical-secrets.yaml (for reference)
  - .envrc.dc (via dc set)
  - Infisical (remote storage)

Arguments:
  secret_name           The secret name to edit

Options:
  --value VALUE         Set the new value directly
  --generate TYPE LEN   Auto-generate new value (types: password, hex, django)
  --dry-run             Preview changes without writing
  --cascade             Update all secrets that reference this one
  --env ENV             Target environment: prod | staging (default: prod)
  --stage               Shorthand for --env=staging
  --prod                Shorthand for --env=prod
  --dev                 Shorthand for --env=dev
  --config FILE         Path to secrets YAML config
  -h, --help            Show this help message

Auto-generation types:
  password              Random 32-character base64 password
  hex                   Random 32-character hex string
  django               Django-style 50-char secret key

Examples:
  infisical-set-secret POSTGRES_PASSWORD                    # Prompt for value
  infisical-set-secret POSTGRES_PASSWORD --value "newpass" # Set inline
  infisical-set-secret SESSION_SECRET --generate hex 64    # Generate 64-byte hex
  infisical-set-secret API_KEY --generate password         # Generate password
  infisical-set-secret POSTGRES_PASSWORD --dry-run          # Preview changes
USAGE
      exit 0
      ;;
    -*)
      log_error "Unknown option: $1"
      exit 1
      ;;
    *)
      SECRET_NAME="$arg"
      ;;
  esac
done

# -- Validate arguments -------------------------------------------------------
if [[ -z "${SECRET_NAME:-}" ]]; then
  die "Secret name is required"
  echo "Usage: infisical-set-secret <secret_name> [OPTIONS]"
  exit 1
fi

# -- Find secrets config ------------------------------------------------------
if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE=$(secrets_find_config)
  if [[ -z "$CONFIG_FILE" ]]; then
    die "No secrets config file found (.infisical-secrets.yaml or secrets.yaml)"
  fi
fi

log_info "Using config: $CONFIG_FILE"
log_info "Secret: $SECRET_NAME"
log_info "Environment: $ENV_ARG"

# -- Get secret definition -----------------------------------------------------
log_info "Looking up secret definition..."
local secret_def
secret_def=$(secrets_get_by_name "$CONFIG_FILE" "$SECRET_NAME")

if [[ -z "$secret_def" ]] || [[ "$secret_def" == "null" ]]; then
  die "Secret '$SECRET_NAME' not found in secrets config"
fi

local scope item_path infisical_path section
scope=$(echo "$secret_def" | jq -r '.scope // empty')
item_path=$(echo "$secret_def" | jq -r '.item_path // empty')
infisical_path=$(echo "$secret_def" | jq -r '.path // empty')
section=$(echo "$secret_def" | jq -r '.section // empty')

log_success "Found: section=$section path=$infisical_path scope=$scope"

# # -- Get current values --------------------------------------------------------
log_info "Current values:"
current_dc_value=""
current_infisical_value=""
current_dc_value=$(dc get "$scope" "$item_path" 2>/dev/null || true)
current_infisical_value=$(if [[ -n "$infisical_path" && -n "$SECRET_NAME" ]]; then
  # Don't auth yet, we'll do it when needed
  echo "(will fetch)"
else
  echo "(not set)"
fi)

echo ""
printf "  DC value:      %s\n" "${current_dc_value:-(not set)}"
printf "  Infisical:    %s\n" "$current_infisical_value"
echo ""

# # -- Determine new value ------------------------------------------------------
if [[ -z "$NEW_VALUE" ]] && ! $GENERATE; then
  # Prompt for value
  echo "Enter new value (leave empty to skip):"
  echo -n "> "
  read -rs NEW_VALUE
  echo ""

  if [[ -z "$NEW_VALUE" ]]; then
    log_warn "Skipping - no value provided"
    exit 0
  fi
elif $GENERATE; then
  # Auto-generate value
  gen_type="${GENERATE_TYPE:-password}"
  gen_len="${GENERATE_LEN:-32}"
  case "$gen_type" in
    password)
      NEW_VALUE=$(openssl rand -base64 "$((gen_len * 2))" | tr -d '=+/' | cut -c1-"$gen_len")
      ;;
    hex)
      NEW_VALUE=$(openssl rand -hex "$gen_len")
      ;;
    django)
      NEW_VALUE=$(python3 -c "import secrets,string;print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#\$%^&*(-_=+)') for _ in range(50)))" 2>/dev/null || openssl rand -hex 32)
      ;;
    *)
      die "Unknown generation type: $gen_type (use password, hex, or django)"
      ;;
  esac
  log_success "Generated $gen_type value: ${NEW_VALUE:0:4}...${NEW_VALUE: -4}"
fi

# -- Check for changes --------------------------------------------------------
if [[ "$NEW_VALUE" == "$current_dc_value" ]]; then
  log_warn "Value unchanged - skipping"
  exit 0
fi

# -- Authenticate with Infisical -----------------------------------------------
log_info "Authenticating with Infisical..."
INFISICAL_PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-$(yq -r '.project.slug // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
INFISICAL_PROJECT_ID="${INFISICAL_PROJECT_ID:-}"

infisical_auth "" "$INFISICAL_PROJECT_ID" "$INFISICAL_PROJECT_SLUG"
log_success "Authenticated (project: ${SECRET_ENGINE_PROJECT_ID})"

# # -- Confirm changes ----------------------------------------------------------
if ! $DRY_RUN; then
  echo ""
  echo "Summary of changes:"
  echo ""
  echo "  Secret:     $SECRET_NAME"
  echo "  Scope:      $scope"
  echo "  Item Path:  $item_path"
  echo "  Infisical:  $infisical_path/$SECRET_NAME"
  echo ""
  printf "  DC:        %s\n" "${current_dc_value:-(not set)}"
  printf "  →          %s\n" "${NEW_VALUE:0:31}... (${#NEW_VALUE} chars)"
  echo ""
  echo "  Infisical:  (will fetch)"
  printf "  →          %s\n" "${NEW_VALUE:0:31}... (${#NEW_VALUE} chars)"
  echo ""
  echo -n "Apply changes? [Y/n] "
  read -r confirm
  case "$confirm" in
    [Nn]*)
      log_warn "Cancelled"
      exit 0
      ;;
  esac
fi

# -- Apply changes ------------------------------------------------------------
log_info "Applying changes...${DRY_RUN:+[DRY RUN]}"
echo ""

# Step 1: Update dc store using dc set
log_info "Step 1: Update dc store..."
if ! $DRY_RUN; then
  dc set "$scope" "$item_path" "$NEW_VALUE"
  log_success "Updated dc: $scope .item_path"
else
  echo "  [DRY RUN] Would set dc $scope $item_path = ${NEW_VALUE:0:10}..."
fi

# Step 2: Update Infisical
log_info "Step 2: Update Infisical..."
current_infisical_value=$(infisical_get_secret "$infisical_path" "$SECRET_NAME" 2>/dev/null || true)
printf "  Current:   %s\n" "${current_infisical_value:-(not set)}"
printf "  New:       %s\n" "${NEW_VALUE:0:10}..."

if ! $DRY_RUN; then
  if infisical_set_secret "$infisical_path" "$SECRET_NAME" "$NEW_VALUE"; then
    log_success "Updated Infisical"
  else
    log_error "Failed to update Infisical"
    exit 1
  fi
else
  log_info "[DRY RUN] Would update Infisical at $infisical_path/$SECRET_NAME"
fi

echo ""

# Step 3: Handle cascading updates if requested
if $CASCADE; then
  log_info "Step 3: Checking for cascading references..."
  # Find secrets in config that reference this one via 'ref' or use this dc value
  cascading_secrets=""
  cascading_secrets=$(yq -o=json "$CONFIG_FILE" | jq -r --arg ref_name "$SECRET_NAME" '
    .sections[]?.secrets | to_entries[]?
    | select(
        (.value.ref == $ref_name) or
        (.value.template | contains("{{" + $ref_name + "}}"))
      ) | .key
  ' 2>/dev/null || true)

  if [[ -n "$cascading_secrets" ]]; then
    while IFS= read -r cas_secret; do
      [[ -z "$cas_secret" ]] && continue

      log_info "  • $cas_secret references $SECRET_NAME - may need re-generation"

      # For now, just flag them - automatic re-generation is complex due to templates
      # Future enhancement: parse templates and re-render
    done <<< "$cascading_secrets"
  else
    log_info "  No cascading references found"
  fi
fi
  else
    log_info "  No cascading references found"
  fi
fi

echo ""
if $DRY_RUN; then
  log_warn "DRY RUN complete - no changes applied"
else
  log_success "Secret updated successfully!"
  echo ""
  echo "Next steps:"
  echo "  1. Verify: infisical-verify --secret $SECRET_NAME"
  echo "  2. Reload: source .envrc (or cd into another directory and back)"
fi

exit 0