#!/usr/bin/env bash
# =============================================================================
# infisical-audit — Full audit report
#
# Usage:
#   infisical-audit                              # Generate complete audit
#   infisical-audit --format markdown|json       # Output format
#   infisical-audit --show-diff                  # Show value differences
#   infisical-audit --export ./audit-report.md  # Save to file
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/secret-engine.sh"

# -- Flags --------------------------------------------------------------------
ENV_ARG="prod"
FORMAT="markdown"
SHOW_DIFF=false
EXPORT_FILE=""
CONFIG_FILE=""

# Parse arguments
next_is_export=false
for arg in "$@"; do
  if $next_is_export; then
    EXPORT_FILE="$arg"
    next_is_export=false
    continue
  fi
  case "$arg" in
    --format)
      case "$2" in
        markdown|json) FORMAT="$2"; shift 2 ;;
        *) log_error "Invalid format: $2 (use markdown|json)"; exit 1 ;;
      esac
      ;;
    --show-diff) SHOW_DIFF=true; shift ;;
    --export) next_is_export=true; shift ;;
    --env) ENV_ARG="$2"; shift 2 ;;
    --stage) ENV_ARG="staging"; shift ;;
    --prod) ENV_ARG="prod"; shift ;;
    --dev) ENV_ARG="dev"; shift ;;
    --config) CONFIG_FILE="$2"; shift 2 ;;
    -h|--help)
      cat <<'USAGE'
Usage: infisical-audit [OPTIONS]

Generate comprehensive audit report comparing secrets across all sources.

Options:
  --format {markdown|json}  Output format (default: markdown)
  --show-diff               Show actual value differences (SENSITIVE!)
  --export FILE             Save report to file
  --env ENV                 Target environment: prod | staging (default: prod)
  --stage                   Shorthand for --env=staging
  --prod                    Shorthand for --env=prod
  --dev                     Shorthand for --env=dev
  --config FILE             Path to secrets YAML config
  -h, --help                Show this help message

Exit codes:
  0 - Audit completed successfully
  1 - Audit found issues (mismatches or missing secrets)

Examples:
  infisical-audit                              # Display audit to stdout
  infisical-audit --export audit.md          # Save audit to file
  infisical-audit --format json              # JSON output for scripting
  infisical-audit --show-diff                # Show value differences
USAGE
      exit 0
      ;;
    *)
      log_error "Unknown option: $1"
      exit 1
      ;;
  esac
done

# -- Find secrets config ------------------------------------------------------
if [[ -z "$CONFIG_FILE" ]]; then
  CONFIG_FILE=$(secrets_find_config)
  if [[ -z "$CONFIG_FILE" ]]; then
    die "No secrets config file found (.infisical-secrets.yaml or secrets.yaml)"
  fi
fi

# -- Authenticate with Infisical -----------------------------------------------
INFISICAL_PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-$(yq -r '.project.slug // empty' "$CONFIG_FILE" 2>/dev/null || true)}"
INFISICAL_PROJECT_ID="${INFISICAL_PROJECT_ID:-}"

infisical_auth "" "$INFISICAL_PROJECT_ID" "$INFISICAL_PROJECT_SLUG"

# -- Run verification ---------------------------------------------------------
results_json=$(verify_all "$CONFIG_FILE" "$ENV_ARG" "$SHOW_DIFF")

# -- Analyze results ---------------------------------------------------------
total=$(echo "$results_json" | jq 'length')
ok=$(echo "$results_json" | jq '[.[] | select(.status == "ok")] | length')
mismatch=$(echo "$results_json" | jq '[.[] | select(.status == "mismatch")] | length')
missing_yaml=$(echo "$results_json" | jq '[.[] | select(.status == "missing_yaml")] | length')
missing_dc=$(echo "$results_json" | jq '[.[] | select(.status == "missing_dc")] | length')
missing_infisical=$(echo "$results_json" | jq '[.[] | select(.status == "missing_infisical")] | length')
missing_all=$(echo "$results_json" | jq '[.[] | select(.status == "missing_all")] | length')
failed=$((mismatch + missing_yaml + missing_dc + missing_infisical + missing_all))

# -- Generate markdown report -------------------------------------------------
  local output=""
  output+="# Secrets Audit Report\n\n"
  output+="**Generated:** $(date -u '+%Y-%m-%d %H:%M:%S UTC')\n"
  output+="**Environment:** $ENV_ARG\n"
  output+="**Config File:** $CONFIG_FILE\n"
  output+="**Project ID:** ${SECRET_ENGINE_PROJECT_ID}\n"
  output+="**Infisical:** ${SECRET_ENGINE_HOST}\n\n"
  output+="---\n\n"
  output+="## Summary\n\n"
  output+="| Metric | Count |\n"
  output+="|--------|-------|\n"
  output+="| Total Secrets | $total |\n"
  output+="| ✓ Verified | $ok |\n"

  [[ "$mismatch" -gt 0 ]] && output+="| ✗ Mismatch | $mismatch |\n"
  [[ "$missing_yaml" -gt 0 ]] && output+="| ! Missing (YAML) | $missing_yaml |\n"
  [[ "$missing_dc" -gt 0 ]] && output+="| ! Missing (dc) | $missing_dc |\n"
  [[ "$missing_infisical" -gt 0 ]] && output+="| ! Missing (Infisical) | $missing_infisical |\n"
  [[ "$missing_all" -gt 0 ]] && output+="| ✗ Missing (All) | $missing_all |\n"

  output+="%\n"
  output+="---\n\n"

  # Mismatches section
  if [[ "$mismatch" -gt 0 ]]; then
    output+="## Mismatches\n\n"
    output+="_The following secrets have different values across sources._\n\n"
    while IFS= read -r item; do
      [[ -z "$item" ]] && continue
      local name scope item_path infisical_path
      name=$(echo "$item" | jq -r '.name')
      scope=$(echo "$item" | jq -r '.dc.scope')
      item_path=$(echo "$item" | jq -r '.dc.path')
      infisical_path=$(echo "$item" | jq -r '.infisical.path')

      local dc_val infisical_val
      dc_val=$(echo "$item" | jq -r '.dc.value // "null"')
      infisical_val=$(echo "$item" | jq -r '.infisical.value // "null"')

      output+="### $name\n\n"
      output+="- **Scope:** \`$scope\`\n"
      output+="- **DC Path:** \`$item_path\`\n"
      output+="- **Infisical:** \`$infisical_path\`\n\n"

      if $SHOW_DIFF; then
        output+="| Source | Value |\n"
        output+="|--------|-------|\n"
        output+="| DC | \`\`\`\n${dc_val}\n\`\`\` |\n"
        output+="| Infisical | \`\`\`\n${infisical_val}\n\`\`\` |\n\n"
      else
        output+="| Source | Status |\n"
        output+="|--------|--------|\n"
        output+="| DC | ${dc_val:+Set}${dc_val:-(null)} |\n"
        output+="| Infisical | ${infisical_val:+Set}${infisical_val:-(null)} |\n\n"
      fi

      output+="> **Action Required:** Verify which source is correct and update the other.\n"
      output+="> Use: \`infisical-set-secret $name --value <correct-value>\`\n\n"
      output+="---\n\n"
    done < <(echo "$results_json" | jq -r '.[] | select(.status == "mismatch")')
  fi

  # Missing secrets section
  if [[ "$missing_yaml" -gt 0 ]] || [[ "$missing_dc" -gt 0 ]] || [[ "$missing_infisical" -gt 0 ]] || [[ "$missing_all" -gt 0 ]]; then
    output+="## Missing Secrets\n\n"
    output+="_The following secrets are missing from one or more sources._\n\n"
    while IFS= read -r item; do
      [[ -z "$item" ]] && continue
      name=$(echo "$item" | jq -r '.name')
      status=$(echo "$item" | jq -r '.status')

      output+="### $name\n\n"
      output+="**Status:** \`$status\`\n\n"

      case "$status" in
        missing_yaml)
          output+="This secret is defined in dc store and Infisical, but **missing from** \`.infisical-secrets.yaml\`.\n\n"
          output+="> **Action:** Add the secret definition to \`$CONFIG_FILE\`.\n"
          ;;
        missing_dc)
          output+="This secret is defined in \`$CONFIG_FILE\` and Infisical, but **missing from** dc store.\n\n"
          item_scope=$(echo "$item" | jq -r '.dc.scope // "?"')
          item_path=$(echo "$item" | jq -r '.dc.path // "?"')
          output+="> **Action:** Set the value in dc store.\n"
          output+="> Use: \`dc set ${item_scope} ${item_path} <value>\`\n"
          ;;
        missing_infisical)
          output+="This secret is configured locally, but **not stored in** Infisical.\n\n"
          output+="> **Action:** Push the secret to Infisical.\n"
          output+="> Use: \`infisical-set-secret $name --value <value>\`\n"
          ;;
        missing_all)
          output+="This secret is **not available anywhere** - it's orphaned.\n\n"
          output+="> **Action:** Determine if the secret is still needed:\n"
          output+"> - If yes: create it via \`infisical-set-secret $name\`\n"
          output+"> - If no: remove the definition from \`$CONFIG_FILE\`\n"
          ;;
      esac

      output+="\n---\n\n"
    done < <(echo "$results_json" | jq -r '.[] |
      select(.status == "missing_yaml" or .status == "missing_dc" or .status == "missing_infisical" or .status == "missing_all")')
  fi

  if [[ "$failed" -eq 0 ]]; then
    output+="## Result\n\n"
    output+="${GREEN}✓ All secrets verified successfully!${NC}\n"
  else
    output+="## Result\n\n"
    output+="${RED}✗ Found $failed issue(s) that require attention.${NC}\n"
  fi

  printf '%s' "$output"

# -- Generate JSON report ----------------------------------------------------
  report_data=$(jq -n \
    --argjson results "$results_json" \
    --arg env "$ENV_ARG" \
    --arg config "$CONFIG_FILE" \
    --arg project_id "${SECRET_ENGINE_PROJECT_ID}" \
    --arg infisical_host "${SECRET_ENGINE_HOST}" \
    --argjson summary "$(jq -n \
      --arg total "$total" \
      --arg ok "$ok" \
      --arg mismatch "$mismatch" \
      --arg missing_yaml "$missing_yaml" \
      --arg missing_dc "$missing_dc" \
      --arg missing_infisical "$missing_infisical" \
      --arg missing_all "$missing_all" \
      '{total: $total | tonumber, ok: $ok | tonumber, mismatch: $mismatch | tonumber,
        missing_yaml: $missing_yaml | tonumber, missing_dc: $missing_dc | tonumber,
        missing_infisical: $missing_infisical | tonumber, missing_all: $missing_all | tonumber}
    )" \
    '{
      generated_at: (now | todate | toiso8601),
      environment: $env,
      config_file: $config,
      project_id: $project_id,
      infisical_host: $infisical_host,
      summary: $summary,
      results: $results,
      has_issues: [($summary.mismatch + $summary.missing_yaml + $summary.missing_dc + $summary.missing_infisical + $summary.missing_all) > 0]
    }')

  echo "$report_data" | jq '.'
}

# -- Output ------------------------------------------------------------------
case "$FORMAT" in
  markdown)
    report_output=""

# -- Exit --------------------------------------------------------------------
if [[ "$failed" -gt 0 ]]; then
  exit 1
fi

exit 0