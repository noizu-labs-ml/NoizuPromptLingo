#!/usr/bin/env bash
set -euo pipefail
# =============================================================================
# infisical-bootstrap — Pre-create K8s Secrets for Infisical (tier 0)
#
# Infisical can't manage its own secrets (chicken-and-egg), so this script
# creates the required Secrets from environment variables before helm install.
#
# Configuration (k8-util-config.yaml → infisical_bootstrap):
#   namespace, secret_name, tls_secret_name, site_url,
#   pg_user, pg_db, db_host, db_port, redis_host, redis_port
#
# All config values can be overridden by K8_INFISICAL_BOOTSTRAP_* env vars.
#
# Usage:
#   infisical-bootstrap [--dry-run] [--tls-only] [--namespace <ns>] [--config <path>]
#
# Environment variables:
#   Required:
#     INFISICAL_POSTGRES_PASSWORD   — PostgreSQL password for infisical user
#     INFISICAL_ENCRYPTION_KEY      — Infisical encryption key (hex)
#     INFISICAL_AUTH_SECRET         — Infisical auth secret
#   Required (Redis):
#     INFISICAL_REDIS_PASSWORD      — Redis password
#   Optional:
#     INFISICAL_POSTGRES_ADMIN_PASSWORD — PostgreSQL superuser password
#     SENDGRID_API_KEY              — SMTP relay key
#     SMTP_FROM                     — SMTP from address
#     GOOGLE_CLIENT_ID              — Google OAuth client ID
#     GOOGLE_CLIENT_SECRET          — Google OAuth client secret
#   TLS:
#     TLS_CRT                       — Base64-encoded TLS certificate
#     TLS_KEY                       — Base64-encoded TLS private key
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# --- Load config values with env var overrides --------------------------------
NS="${K8_INFISICAL_BOOTSTRAP_NAMESPACE:-$(_cfg_default '.infisical_bootstrap.namespace' 'infisical')}"
SECRET_NAME="${K8_INFISICAL_BOOTSTRAP_SECRET_NAME:-$(_cfg_default '.infisical_bootstrap.secret_name' 'infisical-core-secrets')}"
TLS_SECRET_NAME="${K8_INFISICAL_BOOTSTRAP_TLS_SECRET_NAME:-$(_cfg_default '.infisical_bootstrap.tls_secret_name' '')}"
SITE_URL="${K8_INFISICAL_BOOTSTRAP_SITE_URL:-$(_cfg_default '.infisical_bootstrap.site_url' '')}"
PG_USER="${K8_INFISICAL_BOOTSTRAP_PG_USER:-$(_cfg_default '.infisical_bootstrap.pg_user' 'infisical')}"
PG_DB="${K8_INFISICAL_BOOTSTRAP_PG_DB:-$(_cfg_default '.infisical_bootstrap.pg_db' 'infisicalDB')}"
DB_HOST="${K8_INFISICAL_BOOTSTRAP_DB_HOST:-$(_cfg_default '.infisical_bootstrap.db_host' 'postgresql')}"
DB_PORT="${K8_INFISICAL_BOOTSTRAP_DB_PORT:-$(_cfg_default '.infisical_bootstrap.db_port' '5432')}"
REDIS_HOST="${K8_INFISICAL_BOOTSTRAP_REDIS_HOST:-$(_cfg_default '.infisical_bootstrap.redis_host' 'redis')}"
REDIS_PORT="${K8_INFISICAL_BOOTSTRAP_REDIS_PORT:-$(_cfg_default '.infisical_bootstrap.redis_port' '6379')}"

DRY_RUN=false
TLS_ONLY=false

# --- Parse args ---------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)       DRY_RUN=true; shift ;;
    --tls-only)      TLS_ONLY=true; shift ;;
    --namespace=*)   NS="${1#--namespace=}"; shift ;;
    --namespace)     NS="$2"; shift 2 ;;
    --config=*)      shift ;;
    --config)        shift 2 ;;
    -h|--help)
      sed -n '3,/^# ===/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
      exit 0 ;;
    *)               die "Unknown flag: $1 (see --help)" ;;
  esac
done

# --- Validation ---------------------------------------------------------------
[[ -z "$SITE_URL" ]] && die "site_url not configured. Set infisical_bootstrap.site_url in k8-util-config.yaml or K8_INFISICAL_BOOTSTRAP_SITE_URL"

create_app_secret() {
  # Support the historical typo from .envrc.infisical
  local redis_pw="${INFISCIAL_REDIS_PASSWORD:-${INFISICAL_REDIS_PASSWORD:-}}"
  local pg_pw="${INFISICAL_POSTGRES_PASSWORD:-}"
  local pg_admin_pw="${INFISICAL_POSTGRES_ADMIN_PASSWORD:-$pg_pw}"

  [[ -z "$pg_pw" ]] && die "INFISICAL_POSTGRES_PASSWORD is not set"
  [[ -z "$redis_pw" ]] && die "INFISICAL_REDIS_PASSWORD is not set"
  [[ -z "${INFISICAL_ENCRYPTION_KEY:-}" ]] && die "INFISICAL_ENCRYPTION_KEY is not set"
  [[ -z "${INFISICAL_AUTH_SECRET:-}" ]] && die "INFISICAL_AUTH_SECRET is not set"

  local db_uri="postgresql://${PG_USER}:${pg_pw}@${DB_HOST}:${DB_PORT}/${PG_DB}?sslmode=disable"
  local redis_url="redis://:${redis_pw}@${REDIS_HOST}:${REDIS_PORT}"

  local cmd=(kubectl create secret generic "$SECRET_NAME" -n "$NS"
    --from-literal=POSTGRES_PASSWORD="$pg_pw"
    --from-literal=POSTGRES_ADMIN_PASSWORD="$pg_admin_pw"
    --from-literal=REDIS_PASSWORD="$redis_pw"
    --from-literal=ENCRYPTION_KEY="$INFISICAL_ENCRYPTION_KEY"
    --from-literal=AUTH_SECRET="$INFISICAL_AUTH_SECRET"
    --from-literal=DB_CONNECTION_URI="$db_uri"
    --from-literal=REDIS_URL="$redis_url"
    --from-literal=SITE_URL="$SITE_URL"
  )

  [[ -n "${SENDGRID_API_KEY:-}" ]] && cmd+=(--from-literal=SENDGRID_API_KEY="$SENDGRID_API_KEY")
  [[ -n "${SMTP_FROM:-}" ]] && cmd+=(--from-literal=SMTP_FROM="$SMTP_FROM")
  [[ -n "${GOOGLE_CLIENT_ID:-}" ]] && cmd+=(--from-literal=GOOGLE_CLIENT_ID="$GOOGLE_CLIENT_ID")
  [[ -n "${GOOGLE_CLIENT_SECRET:-}" ]] && cmd+=(--from-literal=GOOGLE_CLIENT_SECRET="$GOOGLE_CLIENT_SECRET")

  step "Creating secret: $NS/$SECRET_NAME"
  if $DRY_RUN; then
    echo "  [dry-run] ${cmd[*]}"
  else
    kubectl delete secret "$SECRET_NAME" -n "$NS" --ignore-not-found
    "${cmd[@]}"
    ok "Created $NS/$SECRET_NAME"
  fi
}

create_tls_secret() {
  if [[ -z "$TLS_SECRET_NAME" ]]; then
    warn "tls_secret_name not configured — skipping TLS secret"
    return 0
  fi

  local tls_crt="" tls_key=""

  if [[ -n "${TLS_CRT:-}" ]]; then
    tls_crt=$(printf '%s' "$TLS_CRT" | base64 -d 2>/dev/null) || tls_crt="$TLS_CRT"
  fi
  if [[ -n "${TLS_KEY:-}" ]]; then
    tls_key=$(printf '%s' "$TLS_KEY" | base64 -d 2>/dev/null) || tls_key="$TLS_KEY"
  fi

  if [[ -z "$tls_crt" ]] || [[ -z "$tls_key" ]]; then
    warn "TLS_CRT or TLS_KEY not set — skipping TLS secret"
    return 0
  fi

  step "Creating TLS secret: $NS/$TLS_SECRET_NAME"
  if $DRY_RUN; then
    echo "  [dry-run] kubectl create secret tls $TLS_SECRET_NAME -n $NS ..."
  else
    local tmpdir
    tmpdir=$(mktemp -d)
    trap "rm -rf $tmpdir" RETURN
    printf '%s' "$tls_crt" > "$tmpdir/tls.crt"
    printf '%s' "$tls_key" > "$tmpdir/tls.key"
    kubectl delete secret "$TLS_SECRET_NAME" -n "$NS" --ignore-not-found
    kubectl create secret tls "$TLS_SECRET_NAME" -n "$NS" \
      --cert="$tmpdir/tls.crt" --key="$tmpdir/tls.key"
    ok "Created $NS/$TLS_SECRET_NAME"
  fi
}

# Ensure namespace exists
kubectl get ns "$NS" &>/dev/null || kubectl create namespace "$NS"

if $TLS_ONLY; then
  create_tls_secret
else
  create_app_secret
  create_tls_secret
fi

info "Done. Deploy with: helm-upgrade --include infisical"
