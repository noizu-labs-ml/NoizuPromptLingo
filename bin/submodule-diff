#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: submodule-diff [repo-root]

Reads repo-root/.gitmodules recursively, enters each listed submodule with
local changes, and streams:
  git diff --cached
  git diff
  git diff --no-index /dev/null <untracked-file>
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

repo_root="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
gitmodules="${repo_root}/.gitmodules"

if [ ! -f "$gitmodules" ]; then
  echo "error: .gitmodules not found at ${gitmodules}" >&2
  exit 1
fi

found_changes=false
found_submodules=false

enumerate_submodules() {
  local repo_dir="$1"
  local repo_gitmodules="${repo_dir}/.gitmodules"

  if [ ! -f "$repo_gitmodules" ]; then
    return 0
  fi

  git config --file "$repo_gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null |
    awk '{print $2}'
}

print_diff_if_dirty() {
  local submodule_dir="$1"
  local submodule_path="$2"
  local untracked_files

  if ! git -C "$submodule_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    return 0
  fi

  untracked_files="$(git -C "$submodule_dir" ls-files --others --exclude-standard)"

  if git -C "$submodule_dir" diff --quiet &&
    git -C "$submodule_dir" diff --cached --quiet &&
    [ -z "$untracked_files" ]; then
    return 0
  fi

  found_changes=true
  printf '==> %s\n' "$submodule_path"

  if ! git -C "$submodule_dir" diff --cached --quiet; then
    printf '%s\n' "--- staged changes"
    git -C "$submodule_dir" diff --cached --src-prefix="a/${submodule_path}/" --dst-prefix="b/${submodule_path}/"
  fi

  if ! git -C "$submodule_dir" diff --quiet; then
    printf '%s\n' "--- unstaged changes"
    git -C "$submodule_dir" diff --src-prefix="a/${submodule_path}/" --dst-prefix="b/${submodule_path}/"
  fi

  if [ -n "$untracked_files" ]; then
    printf '%s\n' "--- untracked changes"
    while IFS= read -r untracked_file; do
      [ -n "$untracked_file" ] || continue
      {
        git -C "$submodule_dir" diff --no-index -- /dev/null "$untracked_file" || true
      } | sed \
        -e "s#^diff --git a/#diff --git a/${submodule_path}/#" \
        -e "s# b/# b/${submodule_path}/#" \
        -e "s#^+++ b/#+++ b/${submodule_path}/#"
    done <<< "$untracked_files"
  fi
}

walk_submodules() {
  local repo_dir="$1"
  local rel_prefix="$2"
  local submodule_path

  while IFS= read -r submodule_path; do
    [ -n "$submodule_path" ] || continue

    found_submodules=true

    local submodule_dir="${repo_dir}/${submodule_path}"
    local display_path="${rel_prefix}${submodule_path}"

    if [ ! -d "$submodule_dir" ]; then
      continue
    fi

    print_diff_if_dirty "$submodule_dir" "$display_path"
    walk_submodules "$submodule_dir" "${display_path}/"
  done < <(enumerate_submodules "$repo_dir")
}

walk_submodules "$repo_root" ""

if [ "$found_submodules" = false ]; then
  echo "No submodules found in ${gitmodules}"
  exit 0
fi

if [ "$found_changes" = false ]; then
  echo "No submodules with local changes found."
fi
