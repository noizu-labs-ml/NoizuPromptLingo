#!/usr/bin/env bash
# =============================================================================
# infisical-find-dc-line — Locate dc get line items
#
# Usage:
#   infisical-find-dc-line <scope> <item_path>           # Find line with file context
#   infisical-find-dc-line secrets infisical.host        # Example
#   infisical-find-dc-line --inline <scope> <item_path>  # One-liner format
#   infisical-find-dc-line --env-path                    # Show .envrc.dc location
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/secret-engine.sh"

# -- Flags --------------------------------------------------------------------
INLINE=false
SHOW_ENV_PATH=false
ENVRC_FILE=""

# Parse positional arguments first
SCOPE_ARG=""
ITEM_PATH_ARG=""

skip_next=false
for arg in "$@"; do
  if $skip_next; then skip_next=false; continue; fi
  case "$arg" in
    --inline) INLINE=true; shift ;;
    --env-path) SHOW_ENV_PATH=true; shift ;;
    --file) skip_next=true; shift; shift ;;
    -h|--help)
      cat <<'USAGE'
Usage: infisical-find-dc-line [OPTIONS] <scope> <item_path>

Find dc get line items in .envrc.dc file with file context.

Arguments:
  scope                 The scope name (e.g., secrets, infra)
  item_path             The item path (e.g., infisical.host)

Options:
  --inline              Output one-liner format: file:line:content
  --env-path            Show the absolute path to .envrc.dc
  --file PATH           Path to .envrc.dc file (default: auto-discover)
  -h, --help            Show this help message

Examples:
  infisical-find-dc-line secrets infisical.host
  infisical-find-dc-line --inline secrets infisical.host
  infisical-find-dc-line --env-path secrets infisical.host
USAGE
      exit 0
      ;;
    -*)
      # Skip unknown flags but continue
      ;;
    *)
      if [[ -z "$SCOPE_ARG" ]]; then
        SCOPE_ARG="$arg"
      elif [[ -z "$ITEM_PATH_ARG" ]]; then
        ITEM_PATH_ARG="$arg"
      fi
      ;;
  esac
done

# -- Validate arguments -------------------------------------------------------
if [[ -z "$SCOPE_ARG" ]] || [[ -z "$ITEM_PATH_ARG" ]]; then
  log_error "Both scope and item_path are required"
  echo "Usage: infisical-find-dc-line <scope> <item_path>"
  exit 1
fi

# -- Find .envrc.dc file ------------------------------------------------------
if [[ -z "$ENVRC_FILE" ]]; then
  ENVRC_FILE=$(envrc_find_file)
  if [[ -z "$ENVRC_FILE" ]]; then
    die ".envrc.dc file not found in current directory or parent chain"
  fi
fi

# -- Find the line -----------------------------------------------------------
line_info=$(envrc_find_line "$ENVRC_FILE" "$SCOPE_ARG" "$ITEM_PATH_ARG")

if [[ -z "$line_info" ]] || [[ "$line_info" == "null" ]]; then
  die "No dc get line found for scope '$SCOPE_ARG' and item_path '$ITEM_PATH_ARG'"
fi

line_num=$(echo "$line_info" | jq -r '.line_number')
scope=$(echo "$line_info" | jq -r '.scope')
item_path=$(echo "$line_info" | jq -r '.item_path')
line_content=$(echo "$line_info" | jq -r '.line')

# -- Output ------------------------------------------------------------------
if $SHOW_ENV_PATH; then
  echo "$ENVRC_FILE"
fi

if $INLINE; then
  echo "${ENVRC_FILE}:${line_num}:${line_content}"
else
  echo ""
  log_info "Found dc get line:"
  echo ""
  echo -e "  ${BLUE}File:${NC}     $ENVRC_FILE"
  echo -e "  ${BLUE}Line:${NC}     $line_num"
  echo -e "  ${BLUE}Scope:${NC}    $scope"
  echo -e "  ${BLUE}Item Path:${NC} $item_path"
  echo ""
  echo -e "  ${GREEN}$line_content${NC}"
  echo ""
  echo "View with:"
  echo "  sed -n '${line_num}p' $ENVRC_FILE"
  echo "  code -g $ENVRC_FILE:$line_num"
  echo "  vim +$line_num $ENVRC_FILE"
fi

exit 0