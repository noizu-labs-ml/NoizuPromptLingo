#!/usr/bin/env bash
set -euo pipefail

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
[[ -f "$_K8_ASSIST_LIB" ]] && { source "$_K8_ASSIST_LIB"; _k8_check_assist "$0" "$@"; }

# Polls GitHub Deployments API for pending deployments and runs helm-upgrade.
# Designed to run as a systemd timer on the colo server.
#
# Prerequisites:
#   - gh CLI authenticated with a PAT that can read/write deployments
#   - helm + kubectl configured with cluster access
#   - helm-upgrade on PATH (from k8-lib devops tools)
#
# Environment:
#   DEPLOY_REPO          GitHub repo (default: the-robot-lives/incubator)
#   DEPLOY_ENV           Target environment (default: production)
#   STATE_DIR            Where to persist last-processed ID (default: /var/lib/deploy-relay)
#   REGISTRY             Container registry (default: ghcr.io/the-robot-lives)
#   DRY_RUN              Set to "true" to skip actual helm commands

DEPLOY_REPO="${DEPLOY_REPO:-the-robot-lives/incubator}"
DEPLOY_ENV="${DEPLOY_ENV:-production}"
STATE_DIR="${STATE_DIR:-/var/lib/deploy-relay}"
REGISTRY="${REGISTRY:-ghcr.io/the-robot-lives}"
DRY_RUN="${DRY_RUN:-false}"

STATE_FILE="${STATE_DIR}/last-deployment-id"
LOG_FILE="${STATE_DIR}/deploy.log"

mkdir -p "$STATE_DIR"

log() {
  local ts
  ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  echo "[$ts] $*" | tee -a "$LOG_FILE"
}

last_id() {
  cat "$STATE_FILE" 2>/dev/null || echo "0"
}

save_id() {
  echo "$1" > "$STATE_FILE"
}

set_deployment_status() {
  local deploy_id="$1" state="$2" description="${3:-}"
  gh api "repos/${DEPLOY_REPO}/deployments/${deploy_id}/statuses" \
    -f state="$state" \
    -f environment="$DEPLOY_ENV" \
    -f description="$description" \
    --silent 2>/dev/null || log "WARN: failed to set deployment ${deploy_id} status to ${state}"
}

LAST_ID=$(last_id)

deployments=$(gh api "repos/${DEPLOY_REPO}/deployments" \
  --jq "[.[] | select(.environment == \"${DEPLOY_ENV}\" and .id > ${LAST_ID})] | sort_by(.id)" \
  2>/dev/null) || {
  log "ERROR: failed to fetch deployments"
  exit 1
}

count=$(echo "$deployments" | jq 'length')

if [[ "$count" == "0" ]]; then
  exit 0
fi

log "Found ${count} pending deployment(s)"

echo "$deployments" | jq -c '.[]' | while read -r deployment; do
  deploy_id=$(echo "$deployment" | jq -r '.id')
  project=$(echo "$deployment" | jq -r '.payload.project // empty')
  tag=$(echo "$deployment" | jq -r '.payload.tag // empty')
  services=$(echo "$deployment" | jq -r '.payload.services // empty')

  if [[ -z "$project" || -z "$tag" ]]; then
    log "SKIP: deployment ${deploy_id} missing project or tag in payload"
    save_id "$deploy_id"
    continue
  fi

  log "Processing deployment ${deploy_id}: project=${project} tag=${tag}"
  set_deployment_status "$deploy_id" "in_progress" "Running helm-upgrade on colo"

  helm_args=()
  if [[ -n "$services" && "$services" != "null" ]]; then
    for svc in $(echo "$services" | jq -r 'keys[]'); do
      image_path=$(echo "$services" | jq -r ".\"${svc}\"")
      helm_args+=(--set "${svc}.image=${REGISTRY}/${image_path}:${tag}")
    done
  fi

  if [[ "$DRY_RUN" == "true" ]]; then
    log "DRY RUN: helm-upgrade --include ${project} ${helm_args[*]}"
    set_deployment_status "$deploy_id" "success" "Dry run completed"
  else
    if helm-upgrade --include "$project" "${helm_args[@]}" 2>&1 | tee -a "$LOG_FILE"; then
      log "SUCCESS: deployed ${project} @ ${tag}"
      set_deployment_status "$deploy_id" "success" "Deployed ${project} @ ${tag}"
    else
      log "FAILURE: helm-upgrade failed for ${project} @ ${tag}"
      set_deployment_status "$deploy_id" "failure" "helm-upgrade failed — check colo logs"
    fi
  fi

  save_id "$deploy_id"
done

log "Relay cycle complete"
