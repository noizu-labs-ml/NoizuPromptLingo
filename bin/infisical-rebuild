#!/usr/bin/env bash
# =============================================================================
# infisical-rebuild — Regenerate .envrc.dc from published Infisical data
#
# Reads all secrets from live Infisical, identifies duplicates, and generates
# a fresh .envrc.dc and .infisical-secrets.yaml with consolidated references.
#
# Usage:
#   infisical-rebuild --env=prod                          # full rebuild
#   infisical-rebuild --env=prod --phase=scan             # fetch only
#   infisical-rebuild --env=prod --phase=analyze          # dedup report
#   infisical-rebuild --env=prod --phase=generate         # emit new files
#   infisical-rebuild --env=prod --show-secrets           # include values
#
# Flags:
#   --env=ENV          Target environment (default: prod)
#   --phase=PHASE      scan | analyze | generate | all (default: all)
#   --show-secrets     Include actual values in inventory (not just hashes)
#   --output-dir=DIR   Output directory (default: .rebuild/)
#   --dry-run          Generate phase: preview only
#   --config=FILE      Path to .infisical-secrets.yaml
#
# Dependencies: yq (v4+), jq, curl, openssl, bash 4+
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

# Pre-parse --config
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# -- Flags --------------------------------------------------------------------
PHASE="all"
ENV_ARG=""
SHOW_SECRETS=false
DRY_RUN=false
OUTPUT_DIR=".rebuild"
CONFIG_ARG=""

for arg in "$@"; do
  case "$arg" in
    --phase=*)       PHASE="${arg#--phase=}" ;;
    --stage)         ENV_ARG="stage" ;;
    --prod)          ENV_ARG="prod" ;;
    --dev)           ENV_ARG="dev" ;;
    --env=*)         ENV_ARG="${arg#--env=}" ;;
    --show-secrets)  SHOW_SECRETS=true ;;
    --dry-run)       DRY_RUN=true ;;
    --output-dir=*)  OUTPUT_DIR="${arg#--output-dir=}" ;;
    --config=*)      CONFIG_ARG="${arg#--config=}" ;;
    --help|-h)
      cat <<'USAGE'
Usage: infisical-rebuild --env=<prod|staging> [OPTIONS]

  --env=ENV          Target environment (default: prod)
  --stage            Shorthand for --env=stage
  --prod             Shorthand for --env=prod
  --dev              Shorthand for --env=dev
  --phase=PHASE      scan | analyze | generate | all (default: all)
  --show-secrets     Include actual secret values in inventory
  --output-dir=DIR   Output directory (default: .rebuild/)
  --dry-run          Preview generate phase without writing
  --config=FILE      Path to .infisical-secrets.yaml
USAGE
      exit 0 ;;
  esac
done

# -- Dependencies -------------------------------------------------------------
for cmd in yq jq curl openssl; do
  command -v "$cmd" &>/dev/null || die "$cmd required but not found."
done

# -- Config discovery ---------------------------------------------------------
CONFIG=""
for candidate in \
  "$CONFIG_ARG" \
  "${INFISICAL_SECRETS_FILE:-}" \
  "$INFRA_ROOT/.infisical-secrets.yaml" \
  "$INFRA_ROOT/infisical-secrets.yaml" \
  "$INFRA_ROOT/secrets.yaml"; do
  [[ -n "$candidate" && -f "$candidate" ]] && CONFIG="$candidate" && break
done
[[ -z "$CONFIG" ]] && die "No .infisical-secrets.yaml found."

yq -e '.apiVersion == "secrets-tools/v1"' "$CONFIG" &>/dev/null \
  || die "Only secrets-tools/v1 configs are supported."

# -- Environment & Auth -------------------------------------------------------
ENV_SLUG="${ENV_ARG:-${INFISICAL_ENV:-$(dc get secrets infisical.env 2>/dev/null || echo prod)}}"
[[ "$ENV_SLUG" != "prod" && "$ENV_SLUG" != "staging" ]] && die "Unknown env: $ENV_SLUG"

INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-$(dc get secrets infisical.host 2>/dev/null || true)}}"
PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-${K8_INFISICAL_PROJECT_SLUG:-$(dc get secrets infisical.project_slug 2>/dev/null || true)}}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-$(dc get secrets operator.client_id 2>/dev/null || true)}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-$(dc get secrets operator.client_secret 2>/dev/null || true)}}"

[[ -z "$INFISICAL_HOST" ]] && die "INFISICAL_HOST not set."
INFISICAL_HOST="${INFISICAL_HOST%/api}"
INFISICAL_HOST="${INFISICAL_HOST%/}"
for v in EKS_OPERATOR_CLIENT_ID EKS_OPERATOR_CLIENT_SECRET; do
  [[ -z "${!v:-}" ]] && die "$v is not set."
done

CF_ACCESS_ID="${CF_ACCESS_CLIENT_ID:-$(dc get cf access.client_id 2>/dev/null || true)}"
CF_ACCESS_SECRET="${CF_ACCESS_CLIENT_SECRET:-$(dc get cf access.client_secret 2>/dev/null || true)}"
CF_HEADERS=()
if [[ -n "$CF_ACCESS_ID" && -n "$CF_ACCESS_SECRET" ]]; then
  CF_HEADERS=(-H "CF-Access-Client-Id: ${CF_ACCESS_ID}" -H "CF-Access-Client-Secret: ${CF_ACCESS_SECRET}")
fi

API_TOKEN=""

authenticate() {
  step "Authenticating via universal auth ..."
  API_TOKEN=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
    -H "Content-Type: application/json" \
    -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}" \
    | jq -r '.accessToken // empty')
  [[ -z "$API_TOKEN" ]] && die "Auth failed."

  if [[ -z "$PROJECT_ID" && -n "${PROJECT_SLUG:-}" ]]; then
    PROJECT_ID=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X GET "${INFISICAL_HOST}/api/v1/projects/slug/${PROJECT_SLUG}" \
      -H "Authorization: Bearer ${API_TOKEN}" \
      -H "Content-Type: application/json" | jq -r '.id // .project.id // empty')
  fi
  [[ -z "$PROJECT_ID" ]] && die "Could not resolve project ID."
  ok "Authenticated — env=$ENV_SLUG project=$PROJECT_ID"
}

# -- Helpers ------------------------------------------------------------------
hash_value() {
  printf '%s' "$1" | openssl dgst -sha256 -r | cut -d' ' -f1
}

fetch_secrets_at_path() {
  local path="$1"
  curl -sf -G "${INFISICAL_HOST}/api/v3/secrets/raw" \
    ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} \
    -H "Authorization: Bearer ${API_TOKEN}" \
    --data-urlencode "workspaceId=${PROJECT_ID}" \
    --data-urlencode "environment=${ENV_SLUG}" \
    --data-urlencode "secretPath=${path}" \
    --data-urlencode "expandSecretReferences=true" \
    --data-urlencode "recursive=false" 2>/dev/null || echo '{"secrets":[]}'
}

mkdir -p "$OUTPUT_DIR"

# =============================================================================
# PHASE 1: SCAN — Fetch all secrets from Infisical
# =============================================================================
do_scan() {
  authenticate
  step "Scanning all Infisical paths ..."

  mapfile -t PATHS < <(yq -r '.sections[].path' "$CONFIG")
  step "Found ${#PATHS[@]} paths to scan"

  # Initialize inventory file
  echo '[]' > "$OUTPUT_DIR/_inventory_tmp.json"

  for path in "${PATHS[@]}"; do
    local resp count
    resp=$(fetch_secrets_at_path "$path")
    count=$(echo "$resp" | jq '.secrets | length')

    if [[ "$count" == "0" ]]; then
      warn "$path — empty"
      continue
    fi

    ok "$path — $count secrets"

    # Process each secret in this path
    echo "$resp" | jq -r '.secrets[] | @base64' | while IFS= read -r b64; do
      local key val h entry
      key=$(echo "$b64" | base64 -d | jq -r '.secretKey')
      val=$(echo "$b64" | base64 -d | jq -r '.secretValue')
      h=$(hash_value "$val")

      if $SHOW_SECRETS; then
        entry=$(jq -n --arg p "$path" --arg k "$key" --arg h "sha256:$h" --arg v "$val" \
          '{path:$p, key:$k, value_hash:$h, value:$v}')
      else
        entry=$(jq -n --arg p "$path" --arg k "$key" --arg h "sha256:$h" \
          '{path:$p, key:$k, value_hash:$h}')
      fi

      # Append to inventory
      local tmp
      tmp=$(jq --argjson e "$entry" '. + [$e]' "$OUTPUT_DIR/_inventory_tmp.json")
      echo "$tmp" > "$OUTPUT_DIR/_inventory_tmp.json"
    done
  done

  # Extract dc mappings from .infisical-secrets.yaml
  step "Extracting dc reference mappings from config ..."
  local dc_map
  dc_map=$(yq -o=json '
    [.sections[] | .path as $p | .id as $sid |
      ((.vars // {}) | to_entries[] | {
        section_id: $sid,
        infisical_path: $p,
        var_name: .key,
        dc_ref: (.value.dc // null),
        is_var: true
      }),
      ((.secrets // {}) | to_entries[] | {
        section_id: $sid,
        infisical_path: $p,
        infisical_key: .key,
        dc_ref: (.value.dc // null),
        ref: (.value.ref // null),
        template: (.value.template // null),
        file: (.value.file // null),
        auto: (.value.auto // null),
        default: (.value.default // null),
        is_var: false
      })
    ]' "$CONFIG")

  local inv
  inv=$(cat "$OUTPUT_DIR/_inventory_tmp.json")
  rm -f "$OUTPUT_DIR/_inventory_tmp.json"

  jq -n --argjson inv "$inv" --argjson dc "$dc_map" \
    --arg env "$ENV_SLUG" \
    --arg ts "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{
    scan_time: $ts,
    env: $env,
    total_secrets: ($inv | length),
    total_paths: ($inv | [.[].path] | unique | length),
    inventory: $inv,
    dc_mappings: $dc
  }' > "$OUTPUT_DIR/inventory.json"

  ok "Inventory written to $OUTPUT_DIR/inventory.json ($(echo "$inv" | jq length) secrets)"
}

# =============================================================================
# PHASE 2: ANALYZE — Identify duplicates, classify, suggest canonical paths
# =============================================================================
do_analyze() {
  [[ ! -f "$OUTPUT_DIR/inventory.json" ]] && die "No inventory.json — run --phase=scan first."
  step "Analyzing duplicate values ..."

  local inv="$OUTPUT_DIR/inventory.json"

  # Group by value_hash to find duplicates
  jq '
    .inventory
    | group_by(.value_hash)
    | map(select(length > 1))
    | map({
        value_hash: .[0].value_hash,
        count: length,
        entries: [.[] | {path, key}],
        paths: [.[].path] | unique,
        keys: [.[].key] | unique,
        classification: (
          if length >= 3 then "shared-credential"
          elif (.[0].path | test("^/data/")) and (.[1].path | test("^/data/")) then "namespace-shared"
          elif length == 2 then "review"
          else "unique"
          end
        )
      })
    | sort_by(-.count)
  ' "$inv" > "$OUTPUT_DIR/duplicates.json"

  local dup_count
  dup_count=$(jq length "$OUTPUT_DIR/duplicates.json")

  # Build dc reverse map: for each inventory entry, find its dc reference
  jq '
    .dc_mappings
    | map(select(.dc_ref != null and .is_var == false))
    | map({infisical_path, infisical_key, dc_ref})
  ' "$inv" > "$OUTPUT_DIR/dc_reverse_map.json"

  # Enrich duplicates with dc references
  jq --slurpfile dcmap "$OUTPUT_DIR/dc_reverse_map.json" '
    [.[] | . as $grp | {
      value_hash: .value_hash,
      count: .count,
      classification: .classification,
      entries: [.entries[] | . as $e |
        ($dcmap[0] // [] | map(select(.infisical_path == $e.path and .infisical_key == $e.key)) | first // null) as $dc |
        $e + {dc_ref: ($dc.dc_ref // null)}
      ],
      suggested_canonical: (
        [.entries[] | . as $e |
          ($dcmap[0] // [] | map(select(.infisical_path == $e.path and .infisical_key == $e.key)) | first // null) as $dc |
          ($dc.dc_ref // empty)
        ] | map(select(startswith("secrets "))) | first // null
      )
    }]
  ' "$OUTPUT_DIR/duplicates.json" > "$OUTPUT_DIR/report.json"

  # Generate human-readable report
  {
    echo "==============================================================="
    echo "  Infisical Rebuild — Duplicate Analysis Report"
    echo "  Scanned: $(jq -r .scan_time "$inv")"
    echo "  Environment: $(jq -r .env "$inv")"
    echo "  Total secrets: $(jq .total_secrets "$inv")"
    echo "  Total paths: $(jq .total_paths "$inv")"
    echo "  Duplicate groups: $dup_count"
    echo "==============================================================="
    echo ""

    jq -r '
      .[] | "=== Group: \(.value_hash[:24])... (\(.count) occurrences) ===\n" +
      "Classification: \(.classification)\n" +
      "Suggested canonical: \(.suggested_canonical // "(none — needs assignment)")\n" +
      "Entries:\n" +
      ([.entries[] |
        "  - \(.path)/\(.key)" +
        if .dc_ref then " [dc: \(.dc_ref)]" else "" end
      ] | join("\n")) +
      "\n"
    ' "$OUTPUT_DIR/report.json"
  } > "$OUTPUT_DIR/report.txt"

  ok "Report written to $OUTPUT_DIR/report.txt ($dup_count duplicate groups)"
  echo ""
  cat "$OUTPUT_DIR/report.txt"
}

# =============================================================================
# PHASE 3: GENERATE — Produce .envrc.new.dc and infisical-secrets.new.yaml
# =============================================================================
do_generate() {
  [[ ! -f "$OUTPUT_DIR/inventory.json" ]] && die "No inventory.json — run --phase=scan first."
  [[ ! -f "$OUTPUT_DIR/report.json" ]] && die "No report.json — run --phase=analyze first."
  $SHOW_SECRETS || die "Generate phase requires --show-secrets (needs actual values to write .envrc.dc)"

  step "Generating new files ..."

  local inv="$OUTPUT_DIR/inventory.json"
  local envrc_src="$INFRA_ROOT/.envrc.dc"
  local envrc_out="$OUTPUT_DIR/.envrc.new.dc"
  local yaml_out="$OUTPUT_DIR/infisical-secrets.new.yaml"

  # -- Build enriched inventory with dc refs --
  jq '
    [.inventory[] | {path, key, value}] as $inv |
    [.dc_mappings[] | select(.is_var == false and .dc_ref != null) |
      {infisical_path, infisical_key, dc_ref}
    ] as $dcmap |
    [$inv[] | . as $e |
      ($dcmap | map(select(.infisical_path == $e.path and .infisical_key == $e.key)) | first // null) as $dc |
      $e + {dc_ref: ($dc.dc_ref // null)}
    ]
  ' "$inv" > "$OUTPUT_DIR/enriched_inventory.json"

  # -- Build set of dc_refs to skip (duplicates that should use canonical) --
  jq -r '
    .[] | select(.suggested_canonical != null) |
    .suggested_canonical as $canonical |
    .entries[] | select(.dc_ref != null and .dc_ref != $canonical) |
    .dc_ref
  ' "$OUTPUT_DIR/report.json" > "$OUTPUT_DIR/skip_dc_refs.txt"

  # -- Group entries by dc config block --
  # dc refs look like: "secrets google.client_id" → block=secrets, path=google.client_id
  jq '
    group_by(.dc_ref | if . then split(" ")[0] else "unassigned" end)
    | map({
        block: (.[0].dc_ref | if . then split(" ")[0] else "unassigned" end),
        entries: [.[] | {
          dc_path: (.dc_ref | if . then split(" ")[1:] | join(" ") else null end),
          dc_ref: .dc_ref,
          key: .key,
          path: .path,
          value: .value
        }]
      })
  ' "$OUTPUT_DIR/enriched_inventory.json" > "$OUTPUT_DIR/block_assignments.json"

  # ── Generate .envrc.new.dc ──────────────────────────────────────────────

  step "Generating .envrc.new.dc ..."

  {
    echo "# ============================================================================="
    echo "# Generated by infisical-rebuild on $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "# Source: Infisical ($ENV_SLUG environment)"
    echo "# ============================================================================="
    echo ""
    echo 'PATH_add ./utils/'
    echo ""
  } > "$envrc_out"

  # Copy structural (non-secret) blocks from existing .envrc.dc if available
  if [[ -f "$envrc_src" ]]; then
    # Extract each structural block using awk
    # Structural blocks: infra, cluster, cf (base only), tab, _dc
    for block_name in infra cluster tab; do
      local block_content
      block_content=$(awk -v name="$block_name" '
        /^dc_yaml --no-bump '"$block_name"' <</ && !/--layer/ && !/--if-missing/ {
          printing=1
          print
          next
        }
        printing && /^YAML$/ {
          print
          printing=0
          print ""
          next
        }
        printing { print }
      ' "$envrc_src")

      if [[ -n "$block_content" ]]; then
        echo "# =============================================================================" >> "$envrc_out"
        echo "# $block_name (copied from existing .envrc.dc)" >> "$envrc_out"
        echo "# =============================================================================" >> "$envrc_out"
        echo "$block_content" >> "$envrc_out"
      fi
    done

    # cf base block (non-secrets)
    local cf_base
    cf_base=$(awk '
      /^dc_yaml --no-bump cf <</ && !/--layer/ {
        printing=1
        print
        next
      }
      printing && /^YAML$/ {
        print
        printing=0
        print ""
        next
      }
      printing { print }
    ' "$envrc_src")

    if [[ -n "$cf_base" ]]; then
      echo "# =============================================================================" >> "$envrc_out"
      echo "# cf (base — copied from existing .envrc.dc)" >> "$envrc_out"
      echo "# =============================================================================" >> "$envrc_out"
      echo "$cf_base" >> "$envrc_out"
    fi
  fi

  # Now generate secret blocks from Infisical data
  # For each dc config block, build a YAML heredoc with the values
  local skip_file="$OUTPUT_DIR/skip_dc_refs.txt"

  # Process each block in order: cf(secrets), secrets, platform, services, auto
  for block_name in cf secrets platform services auto; do
    local layer_flag="--layer secrets"
    local if_missing=""
    [[ "$block_name" == "auto" ]] && if_missing=" --if-missing"

    # Get entries for this block, filtering out skipped dc_refs
    local block_entries
    block_entries=$(jq --arg bn "$block_name" --slurpfile skip <(jq -R -s 'split("\n") | map(select(. != ""))' "$skip_file") '
      .[] | select(.block == $bn) |
      .entries | map(select(.dc_ref as $ref | ($skip[0] | index($ref)) | not))
    ' "$OUTPUT_DIR/block_assignments.json")

    local entry_count
    entry_count=$(echo "$block_entries" | jq 'length' 2>/dev/null || echo "0")
    [[ "$entry_count" == "0" || "$entry_count" == "null" ]] && continue

    echo "# =============================================================================" >> "$envrc_out"
    echo "# $block_name (secrets — from Infisical)" >> "$envrc_out"
    echo "# =============================================================================" >> "$envrc_out"
    echo "dc_yaml --no-bump $block_name $layer_flag$if_missing <<'YAML'" >> "$envrc_out"

    # Build nested YAML from flat dc paths using jq
    # dc_path like "google.client_id" → google:\n  client_id: value
    echo "$block_entries" | jq -r '
      # Build nested structure
      reduce .[] as $e ({};
        ($e.dc_path | split(".")) as $parts |
        if ($parts | length) == 1 then
          . + {($parts[0]): $e.value}
        elif ($parts | length) == 2 then
          .[$parts[0]] = ((.[$parts[0]] // {}) + {($parts[1]): $e.value})
        elif ($parts | length) == 3 then
          .[$parts[0]] = ((.[$parts[0]] // {}) | .[$parts[1]] = (((.[$parts[0]][$parts[1]]) // {}) + {($parts[2]): $e.value}))
        else . end
      ) |
      # Render as YAML (simple 3-level nesting)
      to_entries | sort_by(.key) | map(
        if (.value | type) == "object" then
          .key + ":\n" + (
            .value | to_entries | sort_by(.key) | map(
              if (.value | type) == "object" then
                "  " + .key + ":\n" + (
                  .value | to_entries | sort_by(.key) | map(
                    "    " + .key + ": " + (
                      if (.value | tostring | test("[:#{}\\[\\]|>!&*?,]")) or (.value | tostring | startswith(" ")) or (.value | tostring | startswith("-"))
                      then "\"" + (.value | tostring) + "\""
                      else .value | tostring end
                    )
                  ) | join("\n")
                )
              else
                "  " + .key + ": " + (
                  if (.value | tostring | test("[:#{}\\[\\]|>!&*?,]")) or (.value | tostring | startswith(" ")) or (.value | tostring | startswith("-"))
                  then "\"" + (.value | tostring) + "\""
                  else .value | tostring end
                )
              end
            ) | join("\n")
          )
        else
          .key + ": " + (
            if (.value | tostring | test("[:#{}\\[\\]|>!&*?,]")) or (.value | tostring | startswith(" ")) or (.value | tostring | startswith("-"))
            then "\"" + (.value | tostring) + "\""
            else .value | tostring end
          )
        end
      ) | join("\n")
    ' >> "$envrc_out"

    echo "YAML" >> "$envrc_out"
    echo "" >> "$envrc_out"
  done

  # Copy _dc block from existing if available
  if [[ -f "$envrc_src" ]]; then
    local dc_block
    dc_block=$(awk '
      /^dc_yaml --no-bump _dc/ {
        printing=1
        print
        next
      }
      printing && /^YAML$/ {
        print
        printing=0
        print ""
        next
      }
      printing { print }
    ' "$envrc_src")

    if [[ -n "$dc_block" ]]; then
      echo "# =============================================================================" >> "$envrc_out"
      echo "# _dc (flatten rules — copied from existing .envrc.dc)" >> "$envrc_out"
      echo "# =============================================================================" >> "$envrc_out"
      echo "$dc_block" >> "$envrc_out"
    fi
  fi

  # Trailing directives
  {
    echo "dc_bump"
    echo "dc_export"
    echo ""
    echo '# Runtime cert population (file-based TLS certs for registry)'
    echo 'export REGISTRY_TLS_CRT="$(cat "$REGISTRY_TLS_CRT_FILE" 2>/dev/null)"'
    echo 'export REGISTRY_TLS_KEY="$(cat "$REGISTRY_TLS_KEY_FILE" 2>/dev/null)"'
  } >> "$envrc_out"

  ok "Generated $envrc_out"

  # ── Generate infisical-secrets.new.yaml ──────────────────────────────────

  step "Generating infisical-secrets.new.yaml ..."

  # Start with a copy of the existing config
  cp "$CONFIG" "$yaml_out"

  # Apply dc reference updates from the report
  jq -r '
    .[] | select(.suggested_canonical != null) |
    .suggested_canonical as $canonical |
    .entries[] | select(.dc_ref != null and .dc_ref != $canonical) |
    "\(.dc_ref)\t\($canonical)"
  ' "$OUTPUT_DIR/report.json" | while IFS=$'\t' read -r old_ref new_ref; do
    [[ -z "$old_ref" || -z "$new_ref" ]] && continue
    local escaped_old escaped_new
    escaped_old=$(printf '%s' "$old_ref" | sed 's/[&/\]/\\&/g')
    escaped_new=$(printf '%s' "$new_ref" | sed 's/[&/\]/\\&/g')
    sed -i '' "s|dc: ${escaped_old}|dc: ${escaped_new}|g" "$yaml_out" 2>/dev/null || \
      sed -i "s|dc: ${escaped_old}|dc: ${escaped_new}|g" "$yaml_out" 2>/dev/null || true
  done

  ok "Generated $yaml_out"

  # ── Backup originals ────────────────────────────────────────────────────

  if ! $DRY_RUN; then
    local ts
    ts=$(date +%Y%m%d-%H%M%S)
    if [[ -f "$INFRA_ROOT/.envrc.dc" ]]; then
      cp "$INFRA_ROOT/.envrc.dc" "$INFRA_ROOT/.envrc.dc.$ts"
      ok "Backed up .envrc.dc → .envrc.dc.$ts"
    fi
    if [[ -f "$CONFIG" ]]; then
      cp "$CONFIG" "$CONFIG.$ts"
      ok "Backed up $(basename "$CONFIG") → $(basename "$CONFIG").$ts"
    fi
  fi

  echo ""
  step "Generated files in $OUTPUT_DIR/:"
  echo "  .envrc.new.dc              — new direnv-config (review before replacing)"
  echo "  infisical-secrets.new.yaml — updated secret topology"
  echo ""
  echo "Next steps:"
  echo "  1. Review: diff .envrc.dc $OUTPUT_DIR/.envrc.new.dc"
  echo "  2. Review: diff .infisical-secrets.yaml $OUTPUT_DIR/infisical-secrets.new.yaml"
  echo "  3. Or use: /rebuild-review (Claude interactive review)"
  echo "  4. Apply:  cp $OUTPUT_DIR/.envrc.new.dc .envrc.dc"
  echo "  5. Verify: infisical-populate-secrets --dry-run --env=prod"
}

# =============================================================================
# DISPATCH
# =============================================================================
case "$PHASE" in
  scan)     do_scan ;;
  analyze)  do_analyze ;;
  generate) do_generate ;;
  all)      do_scan; do_analyze; do_generate ;;
  *)        die "Unknown phase: $PHASE (use scan|analyze|generate|all)" ;;
esac
