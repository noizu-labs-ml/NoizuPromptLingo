#!/usr/bin/env bash
# =============================================================================
# generate-media-prompt — Generate media assets from .prompt YAML files
#
# Usage:
#   generate-media-prompt hero.media.prompt         # Generate from a single prompt
#   generate-media-prompt assets/                  # Process all *.prompt files in dir
#   generate-media-prompt -n 3 hero.media.prompt   # Generate 3 candidates, vision-pick best
#   generate-media-prompt --dry-run hero.media.prompt # Show plan without generating
#   generate-media-prompt --force hero.media.prompt # Overwrite existing outputs
#   generate-media-prompt --refine hero.media.prompt # Interactive refinement loop
#   generate-media-prompt --model imagen-3.0-generate-002 hero.media.prompt
#
# Prompt files:
#   Files named *.media.prompt (v0.3) or *.{ext}.prompt (legacy) are YAML
#   files that describe media assets to generate.
#     *.media.prompt  → type and format from YAML (v0.3 schema)
#     *.png.prompt    → image (legacy, inferred from extension)
#     *.ts.prompt     → component (legacy, not yet supported)
#     *.mp3.prompt    → audio (legacy, not yet supported)
#     *.mp4.prompt    → video (legacy, not yet supported)
#
# Environment:
#   GEMINI_API_KEY    API key for Google Gemini (falls back to .envrc.k8.dc)
#
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-$(cd "$SCRIPT_DIR/../../k8-lib" 2>/dev/null && pwd || echo "${HOME}/.local/share/k8-lib")}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"

# --- Colours (supplement k8-lib's common.sh) ---------------------------------
RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'
BLU=$'\033[0;34m'; CYN=$'\033[0;36m'; NC=$'\033[0m'
BOLD=$'\033[1m'

banner()  { echo -e "\n${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; echo -e "${BLU}${BOLD}  $1${NC}"; echo -e "${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; }
step()    { echo -e "\n${BLU}▶ $1${NC}"; }
ok()      { echo -e "  ${GRN}✅ $1${NC}"; }
warn()    { echo -e "  ${YEL}⚠️  $1${NC}"; }
fail()    { echo -e "  ${RED}❌ $1${NC}"; }
info()    { echo -e "  ${CYN}ℹ️  $1${NC}"; }
die()     { echo -e "\n${RED}❌ $1${NC}\n"; exit 1; }

# =============================================================================
# Usage / Help
# =============================================================================
usage() {
cat <<EOF

  ${BLU}generate-media-prompt${NC} — Generate media assets from .prompt YAML files

  ${BLU}Usage:${NC}
    generate-media-prompt [flags] <file.prompt|directory> [...]

  ${BLU}Flags:${NC}
    -n <count>         Candidates to generate; best is vision-selected (default: 1)
    --dry-run          Show generation plan without making API calls
    --force            Overwrite existing output files
    --refine           Interactive refinement loop after generation
    --model <model>    Override generation model
    --verbose          Show detailed output
    --config <path>    Use alternate k8-lib config file
    -h, --help         Show this help

  ${BLU}Environment:${NC}
    GEMINI_API_KEY     Google Gemini API key (falls back to .envrc.k8.dc)
    GROQ_API_KEY       Groq API key for vision evaluation (optional)
    GROQ_VISION_MODEL  Override vision model (default: meta-llama/llama-4-scout-17b-16e-instruct)

  ${BLU}Examples:${NC}
    generate-media-prompt hero.png.prompt
    generate-media-prompt -n 3 assets/
    generate-media-prompt --dry-run --verbose hero.png.prompt bg.jpg.prompt
    generate-media-prompt --model imagen-3.0-generate-002 logo.png.prompt

EOF
}

# =============================================================================
# Parse flags
# =============================================================================
VARIANT_COUNT=1
FLAG_DRY_RUN=false
FLAG_FORCE=false
FLAG_REFINE=false
FLAG_VERBOSE=false
MODEL_OVERRIDE=""
PROMPT_INPUTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n)
      [[ -z "${2:-}" ]] && die "-n requires a count argument"
      VARIANT_COUNT="$2"; shift
      ;;
    --dry-run)   FLAG_DRY_RUN=true ;;
    --force)     FLAG_FORCE=true ;;
    --refine)    FLAG_REFINE=true ;;
    --verbose)   FLAG_VERBOSE=true ;;
    --model)
      [[ -z "${2:-}" ]] && die "--model requires a model name"
      MODEL_OVERRIDE="$2"; shift
      ;;
    --config)    shift ;;   # already pre-parsed
    --config=*)  ;;         # already pre-parsed
    -h|--help)   usage; exit 0 ;;
    -*)          warn "Unknown flag: $1" ;;
    *)           PROMPT_INPUTS+=("$1") ;;
  esac
  shift
done

if [[ ${#PROMPT_INPUTS[@]} -eq 0 ]]; then
  die "No prompt files or directories specified.\n   Run with -h for usage."
fi

# =============================================================================
# Resolve API key
# =============================================================================
if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  GEMINI_API_KEY="$(_dc_get k8 gemini.api_key '' '')"
fi

if [[ -z "${GEMINI_API_KEY:-}" ]]; then
  die "No Gemini API key found.\n   Set GEMINI_API_KEY or add gemini.api_key to .envrc.k8.dc secrets layer"
fi

export GEMINI_API_KEY

# =============================================================================
# Resolve Groq API key (optional — used for vision evaluation of candidates)
# =============================================================================
if [[ -z "${GROQ_API_KEY:-}" ]]; then
  GROQ_API_KEY="$(_dc_get k8 groq.api_key '' '')"
fi

if [[ -n "${GROQ_API_KEY:-}" ]]; then
  export GROQ_API_KEY
fi

# =============================================================================
# Validate dependencies — prefer uv (auto-installs pyyaml), fall back to python3
# =============================================================================
PYTHON_CMD=""
if command -v uv &>/dev/null; then
  PYTHON_CMD="uv run"
elif command -v python3 &>/dev/null; then
  if python3 -c "import yaml" 2>/dev/null; then
    PYTHON_CMD="python3"
  else
    die "pyyaml is required but not installed.\n   Install uv (recommended): brew install uv\n   Or install pyyaml: pip3 install pyyaml"
  fi
else
  die "python3 is required but not found on PATH"
fi

# =============================================================================
# Resolve prompt files from inputs (expand directories)
# =============================================================================
PROMPT_FILES=()
for input in "${PROMPT_INPUTS[@]}"; do
  if [[ -d "$input" ]]; then
    while IFS= read -r -d '' f; do
      PROMPT_FILES+=("$f")
    done < <(find "$input" -name '*.prompt' -type f -print0 | sort -z)
    if [[ ${#PROMPT_FILES[@]} -eq 0 ]]; then
      warn "No *.prompt files found in directory: $input"
    fi
  elif [[ -f "$input" ]]; then
    PROMPT_FILES+=("$input")
  else
    fail "File or directory not found: $input"
  fi
done

if [[ ${#PROMPT_FILES[@]} -eq 0 ]]; then
  die "No valid .prompt files to process"
fi

# =============================================================================
# Resolve Python engine location
# =============================================================================
LIB_DIR="$SCRIPT_DIR/../lib"
if [[ ! -f "$LIB_DIR/media-prompt-engine.py" ]]; then
  LIB_DIR="$HOME/.local/lib/media-tools"
fi

if [[ ! -f "$LIB_DIR/media-prompt-engine.py" ]]; then
  die "media-prompt-engine.py not found in $SCRIPT_DIR/../lib or ~/.local/lib/media-tools"
fi

# =============================================================================
# Build Python args and exec
# =============================================================================
PYTHON_ARGS=(
  "$LIB_DIR/media-prompt-engine.py"
  --prompts "${PROMPT_FILES[@]}"
  --variants "$VARIANT_COUNT"
)

$FLAG_DRY_RUN && PYTHON_ARGS+=(--dry-run)
$FLAG_FORCE && PYTHON_ARGS+=(--force)
$FLAG_REFINE && PYTHON_ARGS+=(--refine)
$FLAG_VERBOSE && PYTHON_ARGS+=(--verbose)
[[ -n "$MODEL_OVERRIDE" ]] && PYTHON_ARGS+=(--model "$MODEL_OVERRIDE")

exec $PYTHON_CMD "${PYTHON_ARGS[@]}"
