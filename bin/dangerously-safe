#!/usr/bin/env bash
set -euo pipefail

AGENT_USER="claude"
AGENT_GROUP="agents"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel)"
CURRENT_BRANCH="$(git -C "$REPO_ROOT" branch --show-current)"
WORKTREE_BRANCH="${CURRENT_BRANCH}-agent"
WORKTREE_PATH="${SCRIPT_DIR}/${WORKTREE_BRANCH}"

# --- Pre-flight: ensure user and group exist ---

missing=()
if ! id "$AGENT_USER" &>/dev/null; then
  missing+=("user:$AGENT_USER")
fi
if ! getent group "$AGENT_GROUP" &>/dev/null 2>&1 && ! dscl . -read "/Groups/$AGENT_GROUP" &>/dev/null 2>&1; then
  missing+=("group:$AGENT_GROUP")
fi

if [[ ${#missing[@]} -gt 0 ]]; then
  echo "The following do not exist on this system:"
  for item in "${missing[@]}"; do
    echo "  - $item"
  done
  echo ""
  read -rp "Create them now? (requires sudo) [y/N]: " answer
  if [[ "${answer,,}" != "y" ]]; then
    echo "Aborting. Create the user/group manually and re-run."
    exit 1
  fi

  if [[ " ${missing[*]} " == *"group:$AGENT_GROUP"* ]]; then
    echo "Creating group '$AGENT_GROUP'..."
    if command -v dscl &>/dev/null; then
      # macOS
      LAST_GID=$(dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | sort -n | tail -1)
      NEW_GID=$((LAST_GID + 1))
      sudo dscl . -create "/Groups/$AGENT_GROUP"
      sudo dscl . -create "/Groups/$AGENT_GROUP" PrimaryGroupID "$NEW_GID"
    else
      sudo groupadd "$AGENT_GROUP"
    fi
    echo "Group '$AGENT_GROUP' created."
  fi

  if [[ " ${missing[*]} " == *"user:$AGENT_USER"* ]]; then
    echo "Creating user '$AGENT_USER'..."
    if command -v dscl &>/dev/null; then
      # macOS
      LAST_UID=$(dscl . -list /Users UniqueID | awk '{print $2}' | sort -n | tail -1)
      NEW_UID=$((LAST_UID + 1))
      GROUP_GID=$(dscl . -read "/Groups/$AGENT_GROUP" PrimaryGroupID | awk '{print $2}')
      sudo dscl . -create "/Users/$AGENT_USER"
      sudo dscl . -create "/Users/$AGENT_USER" UniqueID "$NEW_UID"
      sudo dscl . -create "/Users/$AGENT_USER" PrimaryGroupID "$GROUP_GID"
      sudo dscl . -create "/Users/$AGENT_USER" UserShell /usr/bin/false
      sudo dscl . -create "/Users/$AGENT_USER" NFSHomeDirectory /var/empty
      sudo dscl . -create "/Users/$AGENT_USER" RealName "Claude Agent"
    else
      sudo useradd -r -g "$AGENT_GROUP" -s /usr/bin/false -M "$AGENT_USER"
    fi
    echo "User '$AGENT_USER' created."
  fi

  # Ensure agents and staff are members of restricted-staff
  PARENT_GROUP="restricted-staff"
  NESTED_GROUPS=("$AGENT_USER" "staff")
  if command -v dscl &>/dev/null; then
    if ! dscl . -read "/Groups/$PARENT_GROUP" &>/dev/null 2>&1; then
      echo "Parent group '$PARENT_GROUP' does not exist."
      read -rp "Create '$PARENT_GROUP' group? (requires sudo) [y/N]: " create_parent
      if [[ "${create_parent,,}" == "y" ]]; then
        LAST_GID=$(dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | sort -n | tail -1)
        NEW_GID=$((LAST_GID + 1))
        sudo dscl . -create "/Groups/$PARENT_GROUP"
        sudo dscl . -create "/Groups/$PARENT_GROUP" PrimaryGroupID "$NEW_GID"
        echo "Group '$PARENT_GROUP' created."
      else
        echo "Warning: '$PARENT_GROUP' not created. Skipping group nesting."
      fi
    fi
    # macOS doesn't support nested groups natively — add members individually
    if dscl . -read "/Groups/$PARENT_GROUP" &>/dev/null 2>&1; then
      current_members=$(dscl . -read "/Groups/$PARENT_GROUP" GroupMembership 2>/dev/null || true)
      for member in "${NESTED_GROUPS[@]}"; do
        if [[ "$current_members" != *"$member"* ]]; then
          echo "Adding '$member' to '$PARENT_GROUP' group..."
          sudo dscl . -append "/Groups/$PARENT_GROUP" GroupMembership "$member"
          echo "'$member' added to '$PARENT_GROUP'."
        else
          echo "'$member' is already a member of '$PARENT_GROUP'."
        fi
      done
    fi
  else
    # Linux: add members to restricted-staff group
    if ! getent group "$PARENT_GROUP" &>/dev/null; then
      echo "Parent group '$PARENT_GROUP' does not exist."
      read -rp "Create '$PARENT_GROUP' group? (requires sudo) [y/N]: " create_parent
      if [[ "${create_parent,,}" == "y" ]]; then
        sudo groupadd "$PARENT_GROUP"
        echo "Group '$PARENT_GROUP' created."
      else
        echo "Warning: '$PARENT_GROUP' not created. Skipping."
      fi
    fi
    if getent group "$PARENT_GROUP" &>/dev/null; then
      for member in "${NESTED_GROUPS[@]}"; do
        if id "$member" &>/dev/null; then
          if ! id -nG "$member" 2>/dev/null | grep -qw "$PARENT_GROUP"; then
            echo "Adding '$member' to '$PARENT_GROUP' group..."
            sudo usermod -aG "$PARENT_GROUP" "$member"
            echo "'$member' added to '$PARENT_GROUP'."
          else
            echo "'$member' is already a member of '$PARENT_GROUP'."
          fi
        else
          echo "Note: '$member' is a group, not a user — Linux doesn't support nested groups natively."
          echo "  Users in '$member' should be added to '$PARENT_GROUP' individually."
        fi
      done
    fi
  fi
fi

# --- Create worktree ---

if [[ -d "$WORKTREE_PATH" ]]; then
  echo "Worktree already exists at: $WORKTREE_PATH"
else
  echo "Creating git worktree at: $WORKTREE_PATH (branch: $WORKTREE_BRANCH)"
  git -C "$REPO_ROOT" worktree add "$WORKTREE_PATH" -b "$WORKTREE_BRANCH" "$CURRENT_BRANCH"
  echo "Worktree created."
fi

# --- Rsync untracked files (.envrc, etc.) into worktree ---

WORKTREE_DIRNAME="$(basename "$WORKTREE_PATH")"
echo "Syncing untracked files from repo root into worktree (excluding ${WORKTREE_DIRNAME}/)..."
rsync -a \
  --exclude ".git" \
  --exclude "${WORKTREE_DIRNAME}" \
  --ignore-existing \
  "${REPO_ROOT}/" "${WORKTREE_PATH}/"
echo "Sync complete."

# --- Write .envrc.danger flag file ---

echo 'export DANGER_MODE=true' > "${WORKTREE_PATH}/.envrc.danger"
echo "Wrote .envrc.danger."

# --- Run restrict-access hook (if present) ---

RESTRICT_HOOK="${WORKTREE_PATH}/bin/restrict-access"
if [[ -x "$RESTRICT_HOOK" ]]; then
  echo "Running bin/restrict-access hook..."
  (cd "$WORKTREE_PATH" && "$RESTRICT_HOOK")
  echo "restrict-access hook complete."
elif [[ -f "$RESTRICT_HOOK" ]]; then
  echo "Warning: bin/restrict-access exists but is not executable. Skipping."
else
  echo "No bin/restrict-access hook found. Skipping."
fi

# --- Change ownership ---

echo "Setting ownership to ${AGENT_USER}:${AGENT_GROUP} on $WORKTREE_PATH ..."
sudo chown -R "${AGENT_USER}:${AGENT_GROUP}" "$WORKTREE_PATH"
echo "Ownership set."

echo ""
echo "Done. Worktree is ready at:"
echo "  $WORKTREE_PATH"
echo ""
echo "To work in it:"
echo "  cd $WORKTREE_PATH"
