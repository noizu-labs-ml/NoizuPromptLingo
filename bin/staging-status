#!/usr/bin/env bash
# =============================================================================
# staging-status — Shows staging pod status, KEDA ScaledObject state, and
#                  resource usage.
#
# Usage:
#   staging-status [--config <path>]
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

NS="${K8_STAGING_NAMESPACE:-staging}"

echo ""
echo "=== Helm Releases ==="
helm list -n "$NS" 2>/dev/null || echo "  (no releases)"

echo ""
echo "=== Pods ==="
kubectl get pods -n "$NS" -o wide 2>/dev/null || echo "  (no pods)"

echo ""
echo "=== ScaledObjects ==="
kubectl get scaledobject -n "$NS" 2>/dev/null || echo "  (no ScaledObjects — KEDA may not be installed)"

echo ""
echo "=== Resource Usage ==="
kubectl top pods -n "$NS" 2>/dev/null || echo "  (metrics unavailable)"

echo ""
