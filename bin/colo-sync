#!/usr/bin/env bash
# =============================================================================
# colo-sync — rsync between local and noizu.server (mirrored paths)
#
# Usage:
#   colo-sync --to   <path>              Push local path to server (mirror)
#   colo-sync --from <path>              Pull server path to local (mirror)
#   colo-sync --from <src> --to <dst>    Explicit source and destination
#   colo-sync --to   <path> --dry-run    Preview transfer
#   colo-sync --to   <path> --cmd        Print rsync command without running
#   colo-sync --help
#
# Single-flag mode mirrors paths: /Users/<user>/… ↔ /home/<user>/…
# Two-flag mode uses explicit paths (remote paths sent as-is).
#
# Environment:
#   COLO_HOST        Remote host (default: noizu.server)
#   COLO_USER        Remote user (default: keith)
#   COLO_RSYNC_OPTS  Extra rsync flags (appended)
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_repo_k8_lib="$SCRIPT_DIR/../../k8-lib"
if [[ -f "$_repo_k8_lib/bin/common.sh" ]]; then
  K8_LIB_DIR="$(cd "$_repo_k8_lib" && pwd)"
else
  K8_LIB_DIR="${HOME}/.local/share/k8-lib"
fi
export K8_LIB_DIR

if [[ -f "$K8_LIB_DIR/bin/assist.sh" ]]; then
  source "$K8_LIB_DIR/bin/assist.sh"
  _k8_check_assist "$0" "$@"
fi

RED=$'\033[0;31m'; BLU=$'\033[0;34m'; NC=$'\033[0m'
FAIL="${RED}❌${NC}"; INFO="${BLU}ℹ️ ${NC}"

step() { echo -e "\n${BLU}▶ $1${NC}"; }
info() { echo -e "  ${INFO} $1"; }
die()  { echo -e "\n${FAIL} $1\n"; exit 1; }

COLO_HOST="${COLO_HOST:-noizu.server}"
COLO_USER="${COLO_USER:-keith}"

EXCLUDES=(
  .venv
  venv
  .pnpm-store
  .next
  node_modules
  .build
  _build
  tmp
  .tmp
  .terraform
  dist
  junk
  .junk
  .DS_Store
  .cache
  __pycache__
)

usage() {
  sed -n '3,14{
    s/^# //
    s/^#//
    p
  }' "$0"
  echo
  echo "Standard excludes:"
  printf '  %s\n' "${EXCLUDES[@]}"
}

mirror_path() {
  local p="$1"
  # /Users/<user>/… → /home/<user>/…
  if [[ "$p" == /Users/* ]]; then
    echo "${p/#\/Users\//\/home\/}"
  # /home/<user>/… → /Users/<user>/…
  elif [[ "$p" == /home/* ]]; then
    echo "${p/#\/home\//\/Users\/}"
  else
    echo "$p"
  fi
}

# --- Parse args --------------------------------------------------------------
TO_PATH=""
FROM_PATH=""
DRY_RUN=false
CMD_ONLY=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-h)  usage; exit 0 ;;
    --dry-run)  DRY_RUN=true; shift ;;
    --cmd)      CMD_ONLY=true; shift ;;
    --to)       TO_PATH="${2:?Missing path after --to}";   shift 2 ;;
    --from)     FROM_PATH="${2:?Missing path after --from}"; shift 2 ;;
    *)          die "Unknown argument: $1 (use --to or --from)" ;;
  esac
done

[[ -z "$TO_PATH" && -z "$FROM_PATH" ]] && { usage; die "Specify --to, --from, or both"; }

resolve_local_path() {
  local p="$1" trailing=""
  [[ "$p" == */ ]] && trailing="/"
  echo "$(cd "$(dirname "$p")" && pwd)/$(basename "$p")${trailing}"
}

if [[ -n "$FROM_PATH" && -n "$TO_PATH" ]]; then
  # Explicit two-path mode: figure out which is local, which is remote
  if [[ "$FROM_PATH" == /Users/* ]]; then
    SRC="$(resolve_local_path "$FROM_PATH")"
  else
    SRC="$FROM_PATH"
  fi
  if [[ "$TO_PATH" == /Users/* ]]; then
    DST="$(resolve_local_path "$TO_PATH")"
  else
    DST="${COLO_USER}@${COLO_HOST}:${TO_PATH}"
  fi
  # Tag remote side for SRC too
  if [[ "$FROM_PATH" != /Users/* ]]; then
    SRC="${COLO_USER}@${COLO_HOST}:${FROM_PATH}"
  fi
  DIRECTION="to"
elif [[ -n "$TO_PATH" ]]; then
  # Single --to: push local path to mirrored remote
  DIRECTION="to"
  SRC="$(resolve_local_path "$TO_PATH")"
  DST="${COLO_USER}@${COLO_HOST}:$(mirror_path "$SRC")"
else
  # Single --from: pull mirrored remote to local
  DIRECTION="from"
  DST="$(resolve_local_path "$FROM_PATH")"
  SRC="${COLO_USER}@${COLO_HOST}:$(mirror_path "$DST")"
fi

# --- Build rsync command -----------------------------------------------------
RSYNC_ARGS=(-avzP)

for ex in "${EXCLUDES[@]}"; do
  RSYNC_ARGS+=(--exclude="$ex")
done

$DRY_RUN && RSYNC_ARGS+=(--dry-run)

if [[ -n "${COLO_RSYNC_OPTS:-}" ]]; then
  read -ra _extra <<< "$COLO_RSYNC_OPTS"
  RSYNC_ARGS+=("${_extra[@]}")
fi

RSYNC_ARGS+=("$SRC" "$DST")

step "colo-sync: ${SRC} → ${DST}"
$DRY_RUN && info "Dry run — no files will be transferred"

info "rsync ${RSYNC_ARGS[*]}"

if $CMD_ONLY; then
  echo
  echo "rsync ${RSYNC_ARGS[*]}"
  echo
  exit 0
fi

exec rsync "${RSYNC_ARGS[@]}"
