#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
zj-tab — add a claude dev tab to the current zellij session (or start one)

From any project directory, creates a tab with:
  - Left pane (50%):  claude (with optional args/command)
  - Right pane (50%): nvim .
  - Bottom pane:      shell (with optional command)
  - Floating pane:    dev server (with --start-app)

Inside a zellij session: adds a new tab.
Outside a session: starts a new session with the tab.

Usage:
    zj-tab [OPTIONS] [DIRECTORY]

Arguments:
    DIRECTORY                  Project directory (default: current dir)

Options:
    -n, --name NAME            Tab/session name (default: directory basename)
    --claude-args ARGS         Extra arguments passed to claude (quoted string)
    --claude-command CMD       Override the claude invocation entirely
    --claude-message, --prompt MSG  Starting message/prompt to send to claude
    --cerebras                 Shorthand: use "run-claude with cerebras-pro"
    --zai                      Shorthand: use "run-claude with zai-pro"
    --start-app, --run CMD     Command for the floating preview pane
    -c, --command CMD          Command to run in the bottom shell pane
    --bottom-size N            Bottom pane size in rows (default: 10)
    --no-nvim                  Skip the nvim pane (full-width claude)
    --dry-run                  Print generated layout and exit
    -h, --help                 Show this help

Examples:
    zj-tab                             # Tab for current dir
    zj-tab ~/Github/my-project         # Tab for specific dir
    zj-tab --cerebras .                # Tab with cerebras claude
    zj-tab --start-app "npm run dev"   # Tab with dev server in floating pane
    zj-tab -c "make watch" .           # Tab with make watch in bottom pane
    zj-tab --prompt "/init" .          # Tab with starting prompt for claude
USAGE
    exit 0
}

tab_name=""
claude_args=""
claude_command=""
claude_message=""
start_app=""
bottom_command=""
bottom_size=10
no_nvim=false
dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--name)            tab_name="$2"; shift 2 ;;
        --claude-args)        claude_args="$2"; shift 2 ;;
        --claude-command)     claude_command="$2"; shift 2 ;;
        --claude-message|--prompt) claude_message="$2"; shift 2 ;;
        --cerebras)           claude_command="run-claude with cerebras-pro"; shift ;;
        --zai)                claude_command="run-claude with zai-pro"; shift ;;
        --start-app|--run)    start_app="$2"; shift 2 ;;
        -c|--command)         bottom_command="$2"; shift 2 ;;
        --bottom-size)        bottom_size="$2"; shift 2 ;;
        --no-nvim)            no_nvim=true; shift ;;
        --dry-run)            dry_run=true; shift ;;
        -h|--help)            usage ;;
        -*)                   echo "Unknown option: $1" >&2; exit 1 ;;
        *)                    break ;;
    esac
done

dir="${1:-.}"
dir="$(cd "$dir" && pwd)"

if [[ -z "$tab_name" ]]; then
    tab_name="$(basename "$dir")"
fi

shell="$(basename "${SHELL:-/bin/bash}")"

if [[ -n "$claude_command" ]]; then
    claude_cmd="$claude_command"
elif [[ -n "$claude_args" ]]; then
    claude_cmd="claude $claude_args"
else
    claude_cmd="claude"
fi

if [[ -n "$claude_message" ]]; then
    claude_cmd="$claude_cmd $(printf '%q' "$claude_message")"
fi

gen_layout() {
    echo 'layout {'
    if [[ "$no_nvim" == true ]]; then
        cat <<PANE
  pane name="claude: $tab_name" {
    command "$shell"
    args "-c" "cd '$dir' && $claude_cmd; exec $shell"
    focus true
  }
PANE
    else
        cat <<PANE
  pane split_direction="vertical" {
    pane size="50%" name="claude: $tab_name" {
      command "$shell"
      args "-c" "cd '$dir' && $claude_cmd; exec $shell"
      focus true
    }
    pane size="50%" name="nvim: $tab_name" {
      command "$shell"
      args "-c" "cd '$dir' && nvim .; exec $shell"
    }
  }
PANE
    fi

    cat <<PANE
  pane name="shell: $tab_name" size=$bottom_size {
    command "$shell"
    args "-c" "cd '$dir' && ${bottom_command:-exec $shell}"
  }
PANE

    if [[ -n "$start_app" ]]; then
        cat <<PANE
  floating_panes {
    pane name="preview: $tab_name" {
      command "$shell"
      args "-c" "cd '$dir' && $start_app; exec $shell"
    }
  }
PANE
    fi

    echo '}'
}

layout="$(gen_layout)"

if [[ "$dry_run" == true ]]; then
    echo "--- Generated layout ---"
    echo "$layout"
    echo ""
    echo "Tab: $tab_name"
    echo "Directory: $dir"
    echo "Claude: $claude_cmd"
    [[ -n "$start_app" ]] && echo "Start app: $start_app"
    [[ -n "$bottom_command" ]] && echo "Bottom command: $bottom_command"
    exit 0
fi

if [[ -n "${ZELLIJ_SESSION_NAME:-}" ]]; then
    zellij action new-tab --layout-string "$layout" --name "$tab_name"
else
    session="zc-$tab_name"
    max_session_len=20
    if (( ${#session} > max_session_len )); then
        session="${session:0:$max_session_len}"
    fi

    unset ZELLIJ ZELLIJ_SESSION_NAME
    if zellij list-sessions --short --no-formatting 2>/dev/null | grep -qxF "$session"; then
        suffix="$(date +%s | tail -c 7)"
        session="${session:0:$((max_session_len - 7))}-${suffix}"
    fi

    layout_file="/tmp/zj-tab-$$-$(date +%s).kdl"
    echo "$layout" > "$layout_file"
    trap 'rm -f "$layout_file"' EXIT

    echo "Starting zellij session '$session'..."
    zellij -s "$session" -n "$layout_file"
fi
