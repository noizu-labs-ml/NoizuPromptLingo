#!/usr/bin/env bash
# =============================================================================
# hydrate-envrc.sh
# Reads .envrc.example, generates values for all generate:* fields,
# resolves inherit:* fields, and writes a ready-to-use .envrc.
#
# Usage:
#   ./hydrate-envrc.sh                        # reads .envrc.example → .envrc
#   ./hydrate-envrc.sh -i path/to/input       # custom input file
#   ./hydrate-envrc.sh -o path/to/output      # custom output file
#   ./hydrate-envrc.sh --dry-run              # print to stdout, no file written
# =============================================================================
set -euo pipefail

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
[[ -f "$_K8_ASSIST_LIB" ]] && { source "$_K8_ASSIST_LIB"; _k8_check_assist "$0" "$@"; }

# --------------------------------------------------------------------------
# Defaults
# --------------------------------------------------------------------------
INPUT=".envrc.example"
OUTPUT=".envrc"
DRY_RUN=false

# --------------------------------------------------------------------------
# Arg parsing
# --------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    -i|--input)  INPUT="$2";  shift 2 ;;
    -o|--output) OUTPUT="$2"; shift 2 ;;
    --dry-run)   DRY_RUN=true; shift ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

if [[ ! -f "$INPUT" ]]; then
  echo "❌  Input file not found: $INPUT"
  exit 1
fi

if [[ "$DRY_RUN" == false && -f "$OUTPUT" ]]; then
  echo "⚠️   $OUTPUT already exists. Overwrite? [y/N] "
  read -r confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }
fi

# --------------------------------------------------------------------------
# Generators
# --------------------------------------------------------------------------
gen_password() {
  openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
}

gen_hex() {
  openssl rand -hex 32
}

gen_django() {
  python3 -c "
import secrets, string
chars = string.ascii_letters + string.digits + '!\$%^&*(-_=+)'
print(''.join(secrets.choice(chars) for _ in range(50)))
" 2>/dev/null || gen_hex
}

# --------------------------------------------------------------------------
# Pass 1 — collect all generated + static values keyed by VAR name
# so that inherit: lookups work even if the source var appears later
# --------------------------------------------------------------------------
declare -A VALUES

while IFS= read -r line; do
  # Only process export lines
  [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Z_][A-Z0-9_]*)=\"([^\"]*)\"(.*)$ ]] || continue

  var="${BASH_REMATCH[1]}"
  current_val="${BASH_REMATCH[2]}"
  comment="${BASH_REMATCH[3]}"

  # Already has a value — keep it as-is
  if [[ -n "$current_val" ]]; then
    VALUES["$var"]="$current_val"
    continue
  fi

  # Determine generator from trailing comment
  hint=""
  if [[ "$comment" =~ generate:([a-z]+) ]]; then
    hint="${BASH_REMATCH[1]}"
  elif [[ "$comment" =~ inherit:([A-Z_][A-Z0-9_]+) ]]; then
    hint="inherit:${BASH_REMATCH[1]}"
  fi

  case "$hint" in
    password)         VALUES["$var"]="$(gen_password)" ;;
    hex)              VALUES["$var"]="$(gen_hex)"      ;;
    django)           VALUES["$var"]="$(gen_django)"   ;;
    inherit:*)
      src="${hint#inherit:}"
      VALUES["$var"]="${VALUES[$src]:-}"  # may be empty if src not yet seen
      ;;
    *)
      VALUES["$var"]=""  # REQUIRED / no hint — leave blank
      ;;
  esac
done < "$INPUT"

# --------------------------------------------------------------------------
# Pass 2 — resolve any inherit: fields whose source was defined after them
# --------------------------------------------------------------------------
while IFS= read -r line; do
  [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Z_][A-Z0-9_]*)=\"([^\"]*)\"(.*)$ ]] || continue
  var="${BASH_REMATCH[1]}"
  comment="${BASH_REMATCH[3]}"
  if [[ "$comment" =~ inherit:([A-Z_][A-Z0-9_]+) ]]; then
    src="${BASH_REMATCH[1]}"
    if [[ -z "${VALUES[$var]:-}" && -n "${VALUES[$src]:-}" ]]; then
      VALUES["$var"]="${VALUES[$src]}"
    fi
  fi
done < "$INPUT"

# --------------------------------------------------------------------------
# Build output — replace empty quoted values with generated ones
# --------------------------------------------------------------------------
output_lines=()
output_lines+=("# =============================================================================")
output_lines+=("# .envrc — generated by hydrate-envrc.sh on $(date '+%Y-%m-%d %H:%M:%S %Z')")
output_lines+=("# Source: $INPUT")
output_lines+=("# WARNING: Contains secrets — do NOT commit this file")
output_lines+=("# =============================================================================")
output_lines+=("")

while IFS= read -r line; do
  if [[ "$line" =~ ^([[:space:]]*export[[:space:]]+)([A-Z_][A-Z0-9_]*)=\"([^\"]*)\"(.*) ]]; then
    prefix="${BASH_REMATCH[1]}"
    var="${BASH_REMATCH[2]}"
    current_val="${BASH_REMATCH[3]}"
    comment="${BASH_REMATCH[4]}"

    if [[ -n "$current_val" ]]; then
      # Already had a value in the example — keep line exactly
      output_lines+=("${line}")
    else
      new_val="${VALUES[$var]:-}"
      # Strip the generator hint from comment in output (it's noise once hydrated)
      clean_comment=$(echo "$comment" | sed 's/# generate:[a-z]*//' | sed 's/# inherit:[A-Z_]*//' | sed 's/#[[:space:]]*$//' | sed 's/[[:space:]]*$//')
      if [[ -n "$clean_comment" ]]; then
        output_lines+=("${prefix}${var}=\"${new_val}\"${clean_comment}")
      else
        output_lines+=("${prefix}${var}=\"${new_val}\"")
      fi
    fi
  else
    output_lines+=("$line")
  fi
done < "$INPUT"

# --------------------------------------------------------------------------
# Write output
# --------------------------------------------------------------------------
final_output="$(printf '%s\n' "${output_lines[@]}")"

if [[ "$DRY_RUN" == true ]]; then
  echo "$final_output"
else
  echo "$final_output" > "$OUTPUT"
  chmod 600 "$OUTPUT"
  echo "✅  Written to $OUTPUT (chmod 600)"
  echo ""
fi

# --------------------------------------------------------------------------
# Summary: report generated vs required-but-empty
# --------------------------------------------------------------------------
GENERATED=()
REQUIRED_EMPTY=()

while IFS= read -r line; do
  [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Z_][A-Z0-9_]*)=\"([^\"]*)\"(.*)$ ]] || continue
  var="${BASH_REMATCH[1]}"
  original_val="${BASH_REMATCH[2]}"
  comment="${BASH_REMATCH[3]}"

  [[ -n "$original_val" ]] && continue  # had a value already

  if [[ "$comment" =~ generate: || "$comment" =~ inherit: ]]; then
    GENERATED+=("$var")
  elif [[ "$comment" =~ REQUIRED ]]; then
    REQUIRED_EMPTY+=("$var")
  fi
done < "$INPUT"

echo "🔑  Generated (${#GENERATED[@]}):"
for v in "${GENERATED[@]}"; do
  printf "    %-40s %s\n" "$v" "${VALUES[$v]:0:12}..."
done

if [[ ${#REQUIRED_EMPTY[@]} -gt 0 ]]; then
  echo ""
  echo "⚠️   Still REQUIRED — fill these in $OUTPUT before running the population script:"
  for v in "${REQUIRED_EMPTY[@]}"; do
    echo "    export $v=\"<value>\""
  done
fi

echo ""
echo "Done. Next steps:"
echo "  1. Fill in any REQUIRED fields above in $OUTPUT"
echo "  2. source $OUTPUT"
echo "  3. Run the Infisical population script"
