#!/usr/bin/env python3

import os
import re
from pathlib import Path

SCRIPT_DIR = Path(__file__).parent
STORIES_DIR = SCRIPT_DIR.parent / "user-stories"
OUTPUT = STORIES_DIR / "stories.yaml"

# Stage mapping
stage_map = {
    "US-001": 0,
}
# Add ranges
for i in range(2, 4): stage_map[f"US-{i:03d}"] = 1
for i in range(4, 7): stage_map[f"US-{i:03d}"] = 2
for i in range(7, 11): stage_map[f"US-{i:03d}"] = 3
for i in range(11, 14): stage_map[f"US-{i:03d}"] = 4
for i in range(14, 18): stage_map[f"US-{i:03d}"] = 5
for i in range(18, 23): stage_map[f"US-{i:03d}"] = 6
for i in range(23, 29): stage_map[f"US-{i:03d}"] = 7
for i in range(29, 34): stage_map[f"US-{i:03d}"] = -1   # Performance
for i in range(34, 43): stage_map[f"US-{i:03d}"] = -2  # Security
for i in range(43, 47): stage_map[f"US-{i:03d}"] = -3  # Accessibility
for i in range(47, 50): stage_map[f"US-{i:03d}"] = -4  # Localization
for i in range(50, 56): stage_map[f"US-{i:03d}"] = -5  # Edge Cases
stage_map["US-056"] = -6  # Developer
for i in range(57, 59): stage_map[f"US-{i:03d}"] = -7  # Onboarding
for i in range(59, 61): stage_map[f"US-{i:03d}"] = -8  # Favorites
for i in range(61, 66): stage_map[f"US-{i:03d}"] = -9  # Foundation
for i in range(66, 70): stage_map[f"US-{i:03d}"] = -10 # AI/ML
stage_map["US-070"] = -11 # Analytics
stage_map["US-071"] = -12 # Sync
for i in range(72, 87): stage_map[f"US-{i:03d}"] = -13 # Macros
for i in range(87, 100): stage_map[f"US-{i:03d}"] = -10 # LLM Snippets (AI/ML extension)
for i in range(100, 108): stage_map[f"US-{i:03d}"] = -14 # Keyboard Chords
for i in range(108, 119): stage_map[f"US-{i:03d}"] = -15 # Paste Formats
for i in range(119, 129): stage_map[f"US-{i:03d}"] = -16 # Image Support
for i in range(129, 144): stage_map[f"US-{i:03d}"] = -17 # Menu Bar & Prefs
for i in range(144, 152): stage_map[f"US-{i:03d}"] = -18 # Developer Features
for i in range(152, 159): stage_map[f"US-{i:03d}"] = -19 # Additional Features

def extract_title(content):
    match = re.search(r"^#[^:]+: (.+)$", content, re.MULTILINE)
    return match.group(1) if match else ""

def extract_user_story(content):
    match = re.search(r"As a .+?, I want .+?, so that .+?", content, re.DOTALL)
    return " ".join(match.group(0).split()) if match else ""

def extract_scenarios(content):
    scenarios = []
    pattern = re.compile(r"## Scenario: .+?\n(?:Given .+?\n(?:When .+?\n(?:Then .+?\n)?)?)+", re.DOTALL)

    for scenario_match in pattern.finditer(content):
        scenario_text = scenario_match.group(0)
        given = re.search(r"Given (.+?)(?:\n|$)", scenario_text)
        when = re.search(r"When (.+?)(?:\n|$)", scenario_text)
        then = re.search(r"Then (.+?)(?:\n|$)", scenario_text)

        if given and when and then:
            scenarios.append({
                "given": given.group(1).strip(),
                "when": when.group(1).strip(),
                "then": then.group(1).strip()
            })

    return scenarios

def parse_notes(content):
    notes_section = content.split("## Notes")[-1]
    persona = re.search(r"\*\*Persona\*\*: (.+)", notes_section)
    t_shirt = re.search(r"\*\*T-Shirt Size\*\*: (.+)", notes_section)
    complexity = re.search(r"\*\*Complexity\*\*: (.+)", notes_section)
    risks = re.search(r"\*\*Risks\*\*: (.+)", notes_section)
    dependencies = re.search(r"\*\*Dependencies\*\*: (.+)", notes_section)

    deps = []
    if dependencies:
        deps = re.findall(r"US-\d+", dependencies.group(1))

    return {
        "persona": persona.group(1).strip() if persona else "unknown",
        "t_shirt_size": t_shirt.group(1).strip() if t_shirt else "S",
        "complexity": complexity.group(1).strip() if complexity else "medium",
        "risks": risks.group(1).strip() if risks else None,
        "dependencies": deps
    }

stories = []

for mdfile in sorted(STORIES_DIR.glob("US-*.md")):
    us_id = mdfile.stem
    content = mdfile.read_text()

    story = {
        "id": us_id,
        "title": extract_title(content),
        "user_story": extract_user_story(content),
        "scenarios": extract_scenarios(content),
        "notes": parse_notes(content),
        "stage": stage_map.get(us_id, -99),
        "impacts": [],
        "status": "pending"
    }
    stories.append(story)

# Write YAML with proper escaping
import yaml

output_data = {"stories": stories}

with open(OUTPUT, "w") as f:
    yaml.dump(output_data, f, default_flow_style=False, sort_keys=False, allow_unicode=True)

print(f"✓ Generated {OUTPUT}")

print("\nVerify with:")
print(f"  yq '.stories | length' {OUTPUT}")
print(f"  yq '.stories[] | .id + \" \" + .title' {OUTPUT}")