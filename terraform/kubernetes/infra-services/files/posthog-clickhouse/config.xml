<?xml version="1.0"?>
<!--
  Overlay (config.d) for the dedicated PostHog ClickHouse, mirroring the known-good
  standalone PostHog deployment.

  PostHog's stable `latest-release` image defines Kafka-engine tables with DEFAULT
  columns, which ClickHouse 23.3+ rejects. So this runs ClickHouse 22.8 LTS (which
  still allows them) — see posthog-clickhouse.tf. Single-node cluster "posthog"
  (CLICKHOUSE_CLUSTER=posthog). The replica is addressed by the service name
  `posthog-clickhouse`, and the pod's hostname is set to match (deployment spec) so
  the node recognizes itself and ON CLUSTER DDL executes locally. Coordination is a
  separate single-node ZooKeeper (posthog-zookeeper).
-->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>
    <interserver_http_host>posthog-clickhouse</interserver_http_host>
    <macros>
        <cluster>posthog</cluster>
        <shard>01</shard>
        <replica>posthog-clickhouse</replica>
    </macros>
    <remote_servers>
        <posthog>
            <shard>
                <internal_replication>false</internal_replication>
                <replica>
                    <host>posthog-clickhouse</host>
                    <port>9000</port>
                    <default_database>posthog</default_database>
                </replica>
            </shard>
        </posthog>
    </remote_servers>
    <zookeeper>
        <node>
            <host>posthog-zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
</clickhouse>
