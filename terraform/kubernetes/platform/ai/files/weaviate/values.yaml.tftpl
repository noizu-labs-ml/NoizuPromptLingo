# =============================================================================
# Weaviate Helm Values — NPL Memory System
# =============================================================================
# Chart:     weaviate/weaviate
# Repo:      https://weaviate.github.io/weaviate-helm
# Upstream:  cr.weaviate.io/semitechnologies/weaviate:1.34.0
#
# Vectorizer: text2vec-openai module pointed at self-hosted vLLM server
#   Model:  intfloat/e5-mistral-7b-instruct (4096-dim, MIT license)
#   Server: http://vllm.${namespace}.svc.cluster.local:8000/v1
#
# Secrets (Infisical -> weaviate-app-secrets):
#   AUTHENTICATION_APIKEY_ALLOWED_KEYS  — Weaviate admin API key
#   OPENAI_APIKEY                       — Dummy key (vLLM ignores it)
#
# Ingress is NOT part of this chart (upstream has none).
# Applied separately via ingress.yaml in upgrade.sh.
# =============================================================================
image:
  tag: 1.34.0
replicas: 1
# =============================================================================
# Storage
# =============================================================================
storage:
  size: 150Gi
  storageClassName: "${storage_class}"
# =============================================================================
# Services — ClusterIP (cluster uses NGINX ingress, not LoadBalancer)
# =============================================================================
service:
  name: weaviate
  ports:
    - name: http
      protocol: TCP
      port: 80
  type: ClusterIP
grpcService:
  enabled: true
  name: weaviate-grpc
  ports:
    - name: grpc
      protocol: TCP
      port: 50051
  type: ClusterIP
# =============================================================================
# Authentication — API key via envSecrets (Infisical-managed)
# =============================================================================
authentication:
  anonymous_access:
    enabled: false
  oidc:
    enabled: false
authorization:
  rbac:
    enabled: false
  admin_list:
    enabled: false
# =============================================================================
# Environment
# =============================================================================
env:
  CLUSTER_GOSSIP_BIND_PORT: 7000
  CLUSTER_DATA_BIND_PORT: 7001
  RAFT_BOOTSTRAP_TIMEOUT: 600
  GOGC: 100
  QUERY_MAXIMUM_RESULTS: 100000
  AUTHENTICATION_APIKEY_ENABLED: "true"
  AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED: "false"
  AUTHENTICATION_APIKEY_USERS: "npl-agent"
  # vLLM embedding server (replaces api.openai.com)
  OPENAI_BASEURL: "http://vllm.${namespace}.svc.cluster.local:8000/v1"
# =============================================================================
# Secret References — Infisical-managed weaviate-app-secrets
# =============================================================================
# envSecrets maps { ENV_VAR_NAME: "k8s-secret-name" }.
# The chart reads secret[ENV_VAR_NAME] and mounts it as that env var.
envSecrets:
  AUTHENTICATION_APIKEY_ALLOWED_KEYS: weaviate-app-secrets
  OPENAI_APIKEY: weaviate-app-secrets
# =============================================================================
# Modules — text2vec-openai pointed at self-hosted vLLM (e5-mistral-7b)
# =============================================================================
modules:
  text2vec-openai:
    enabled: true
    apiKey: ''
  text2vec-contextionary:
    enabled: false
  text2vec-transformers:
    enabled: false
  text2vec-huggingface:
    enabled: false
  text2vec-cohere:
    enabled: false
  text2vec-google:
    enabled: false
  text2vec-jinaai:
    enabled: false
  text2vec-ollama:
    enabled: false
  text2vec-voyageai:
    enabled: false
  ref2vec-centroid:
    enabled: false
  default_vectorizer_module: text2vec-openai
# =============================================================================
# Resources
# =============================================================================
resources:
  requests:
    cpu: "1500m"
    memory: "3Gi"
  limits:
    cpu: "6"
    memory: "12Gi"
