# =============================================================================
# Qdrant Helm Values — Livebook vector store (internal-only)
# =============================================================================
# Chart:    qdrant/qdrant 1.17.1
# Repo:     https://qdrant.github.io/qdrant-helm
# Upstream: docker.io/qdrant/qdrant:v1.17.1
#
# Access: ClusterIP only — http://qdrant.qdrant-ns.svc.cluster.local:6333 (REST)
#                          qdrant.qdrant-ns.svc.cluster.local:6334         (gRPC)
# No ingress — reach it from in-cluster consumers (Livebook, future agents).
#
# Secrets (Infisical -> qdrant-app-secrets):
#   QDRANT_API_KEY            — full read/write API key
#   QDRANT_READ_ONLY_API_KEY  — read-only API key (optional)
# =============================================================================
image:
  tag: v1.17.1
replicaCount: 1
# -----------------------------------------------------------------------------
# Storage — OpenEBS LVM (WaitForFirstConsumer)
# -----------------------------------------------------------------------------
persistence:
  size: 50Gi
  storageClassName: ${storage_class}
  accessModes: ["ReadWriteOnce"]
snapshotPersistence:
  enabled: false
# -----------------------------------------------------------------------------
# Authentication — API key sourced from Infisical-synced secret
# -----------------------------------------------------------------------------
apiKey:
  valueFrom:
    secretKeyRef:
      name: qdrant-app-secrets
      key: QDRANT_API_KEY
readOnlyApiKey:
  valueFrom:
    secretKeyRef:
      name: qdrant-app-secrets
      key: QDRANT_READ_ONLY_API_KEY
# -----------------------------------------------------------------------------
# Single-node — disable Raft/clustering overhead
# -----------------------------------------------------------------------------
config:
  cluster:
    enabled: false
  service:
    enable_tls: false
# -----------------------------------------------------------------------------
# Services — ClusterIP only
# -----------------------------------------------------------------------------
service:
  type: ClusterIP
  ports:
    - name: http
      port: 6333
      targetPort: 6333
      protocol: TCP
      checksEnabled: true
    - name: grpc
      port: 6334
      targetPort: 6334
      protocol: TCP
      checksEnabled: false
ingress:
  enabled: false
# -----------------------------------------------------------------------------
# Probes — health endpoints bypass API-key auth
# -----------------------------------------------------------------------------
livenessProbe:
  enabled: true
  initialDelaySeconds: 10
  periodSeconds: 10
  timeoutSeconds: 3
  failureThreshold: 6
readinessProbe:
  enabled: true
  initialDelaySeconds: 5
  periodSeconds: 5
  timeoutSeconds: 3
  failureThreshold: 6
startupProbe:
  enabled: true
  initialDelaySeconds: 10
  periodSeconds: 5
  failureThreshold: 30
# -----------------------------------------------------------------------------
# Resources
# -----------------------------------------------------------------------------
resources:
  requests:
    cpu: "500m"
    memory: "1Gi"
  limits:
    cpu: "2"
    memory: "4Gi"
# -----------------------------------------------------------------------------
# Pod scheduling — StatefulSet, one replica, no PDB needed
# -----------------------------------------------------------------------------
podManagementPolicy: Parallel
podDisruptionBudget:
  enabled: false
