# =============================================================================
# JupyterHub Helm Values (for upstream jupyterhub/jupyterhub chart)
# =============================================================================
# Reference: https://z2jh.jupyter.org/en/stable/resources/reference.html
# Chart repo: https://hub.jupyter.org/helm-chart/
# =============================================================================

# =============================================================================
# Hub Configuration
# =============================================================================
hub:
  config:
    # ---------------------------------------------------------------------
    # Authentication - Choose ONE of the following options:
    # ---------------------------------------------------------------------

    # OPTION 1: Native Authenticator (local accounts with signup)
    # Uncomment for local auth with open signup
    # JupyterHub:
    #   authenticator_class: nativeauthenticator.NativeAuthenticator
    # NativeAuthenticator:
    #   open_signup: true
    #   minimum_password_length: 8
    #   enable_signup: true
    #   ask_email_on_signup: true

    # OPTION 2: GitHub OAuth
    # JupyterHub:
    #   authenticator_class: github
    # GitHubOAuthenticator:
    #     client_id: ""     # Set from Infisical: GITHUB_CLIENT_ID
    #     client_secret: "" # Set from Infisical: GITHUB_CLIENT_SECRET
    #     oauth_callback_url: "https://jupyter.noizu.com/hub/oauth_callback"
    #     # Optional: restrict to specific orgs/teams
    #     # allowed_organizations:
    #     #   - your-org-name
    #     allow_all: true

    # OPTION 3: Google OAuth (default)
    # OAuth credentials loaded from Infisical-managed jupyter-app-secrets
    # via extraEnv secretKeyRef (no --set flags needed)
    JupyterHub:
      authenticator_class: google
    GoogleOAuthenticator:
      oauth_callback_url: "https://jupyter.noizu.com/hub/oauth_callback"
      # Optional: Restrict to specific domain(s)
      # hosted_domain:
      #   - noizu.com
      allow_all: true # Allow any Google user (open signup equivalent)
      # OPTION 4: Generic OAuth2 (Keycloak, Authentik, Auth0, etc.)
      # JupyterHub:
      #   authenticator_class: generic-oauth
      # GenericOAuthenticator:
      #     client_id: ""     # Set from Infisical: OAUTH_CLIENT_ID
      #     client_secret: "" # Set from Infisical: OAUTH_CLIENT_SECRET
      #     oauth_callback_url: "https://jupyter.noizu.com/hub/oauth_callback"
      #     authorize_url: "https://auth.example.com/oauth/authorize"
      #     token_url: "https://auth.example.com/oauth/token"
      #     userdata_url: "https://auth.example.com/oauth/userinfo"
      #     username_claim: "preferred_username"
      #     allow_all: true

      # ---------------------------------------------------------------------
      # SMTP Configuration (for password reset, notifications)
      # ---------------------------------------------------------------------
      # Values are set from Infisical-managed secrets via environment variables
      # JupyterHub:
      #   template_vars:
      #     smtp_host: "smtp.example.com"
  # Extra configuration
  extraConfig:
    00-spawner-resilience: |
      # --- Spawn timeout ---
      # Give reflector 10 minutes to recover after transient API connectivity
      # loss before giving up on a spawn. Default 300s is too tight.
      c.KubeSpawner.start_timeout = 600

      # --- K8s API resilience ---
      # Individual API call timeout (default 3s). Increase to tolerate brief
      # API latency spikes without triggering reflector error/backoff cascade.
      c.KubeSpawner.k8s_api_request_timeout = 10

      # Total retry budget for a single API call before the reflector considers
      # it failed (default 30s). Set to 30 MINUTES so the reflector survives
      # the full control-plane restart cycle (~31min on this NixOS cluster)
      # without entering the permanent give-up backoff.
      c.KubeSpawner.k8s_api_request_retry_timeout = 1800
    00-health-monitor: |
      # Periodic K8s API connectivity monitor. Logs clearly when the API is
      # unreachable so kubectl logs shows exactly what's happening. Sends
      # email notification to keith.brings@noizu.com on sustained outage.
      import asyncio, logging, os, smtplib, socket
      from email.mime.text import MIMEText
      from datetime import datetime, timezone
      from urllib.request import urlopen, Request
      from urllib.error import URLError
      import ssl

      _log = logging.getLogger('JupyterHub.health-monitor')
      _api_host = os.environ.get('KUBERNETES_SERVICE_HOST', '10.0.0.1')
      _api_port = os.environ.get('KUBERNETES_SERVICE_PORT', '443')
      _token_path = '/var/run/secrets/kubernetes.io/serviceaccount/token'
      _ca_path = '/var/run/secrets/kubernetes.io/serviceaccount/ca.crt'

      _consecutive_failures = 0
      _email_sent = False

      def _send_alert(subject, body):
          smtp_host = os.environ.get('SMTP_HOST', '')
          if not smtp_host:
              _log.warning('[HEALTH] SMTP not configured, cannot send alert email')
              return
          try:
              msg = MIMEText(body)
              msg['Subject'] = subject
              msg['From'] = os.environ.get('SMTP_FROM', 'jupyter@noizu.com')
              msg['To'] = 'keith.brings@noizu.com'
              with smtplib.SMTP(smtp_host, int(os.environ.get('SMTP_PORT', '587')), timeout=10) as s:
                  s.starttls()
                  user = os.environ.get('SMTP_USER', '')
                  if user:
                      s.login(user, os.environ.get('SMTP_PASS', ''))
                  s.sendmail(msg['From'], [msg['To']], msg.as_string())
              _log.info('[HEALTH] Alert email sent: %s', subject)
          except Exception as e:
              _log.error('[HEALTH] Failed to send alert email: %s', e)

      def _check_k8s_api():
          """TCP connect to K8s API. Returns True if reachable."""
          try:
              sock = socket.create_connection((_api_host, int(_api_port)), timeout=5)
              sock.close()
              return True
          except (OSError, socket.timeout):
              return False

      async def _health_loop():
          global _consecutive_failures, _email_sent
          _log.info(
              '[HEALTH] ======== Health monitor started ========\n'
              '[HEALTH] Monitoring K8s API at %s:%s every 30s\n'
              '[HEALTH] Alert email -> keith.brings@noizu.com\n'
              '[HEALTH] =========================================',
              _api_host, _api_port
          )
          while True:
              await asyncio.sleep(30)
              now = datetime.now(timezone.utc).strftime('%H:%M:%SZ')
              if _check_k8s_api():
                  if _consecutive_failures > 0:
                      _log.warning(
                          '[HEALTH] [%s] K8s API RECOVERED after %d consecutive failures (%.0fs outage)',
                          now, _consecutive_failures, _consecutive_failures * 30
                      )
                      if _email_sent:
                          _send_alert(
                              '[jupyter.noizu.com] K8s API recovered',
                              f'K8s API connectivity restored after {_consecutive_failures * 30}s outage.\n'
                              f'Time: {now}\nPod: {os.environ.get("HOSTNAME", "unknown")}'
                          )
                  _consecutive_failures = 0
                  _email_sent = False
              else:
                  _consecutive_failures += 1
                  outage_secs = _consecutive_failures * 30
                  _log.error(
                      '[HEALTH] [%s] K8s API UNREACHABLE at %s:%s '
                      '(failure #%d, ~%ds total outage)',
                      now, _api_host, _api_port, _consecutive_failures, outage_secs
                  )
                  # Send email after 2 minutes of sustained outage (4 failures)
                  if _consecutive_failures == 4 and not _email_sent:
                      _email_sent = True
                      _send_alert(
                          '[jupyter.noizu.com] K8s API unreachable for 2+ minutes',
                          f'The JupyterHub hub pod cannot reach the Kubernetes API server.\n\n'
                          f'API endpoint: {_api_host}:{_api_port}\n'
                          f'Outage duration: ~{outage_secs}s and counting\n'
                          f'Time: {now}\n'
                          f'Pod: {os.environ.get("HOSTNAME", "unknown")}\n\n'
                          f'The KubeSpawner reflector has a 30-minute retry budget and\n'
                          f'should survive this outage. If the API does not recover within\n'
                          f'30 minutes, the hub will be unable to spawn user servers.\n\n'
                          f'If the liveness probe detects sustained unhealthiness for 7\n'
                          f'minutes, Kubernetes will auto-restart the hub pod.'
                      )

      # Launch the monitor as a background task when the hub starts
      import jupyterhub.app as _app
      _orig_start = _app.JupyterHub.start
      async def _start_with_monitor(self):
          asyncio.ensure_future(_health_loop())
          return await _orig_start(self)
      _app.JupyterHub.start = _start_with_monitor
    00-oauth-from-env: |
      import os
      # Load OAuth credentials from environment (Infisical-managed secrets)
      google_client_id = os.environ.get('GOOGLE_CLIENT_ID', '')
      google_client_secret = os.environ.get('GOOGLE_CLIENT_SECRET', '')
      if google_client_id and google_client_secret:
          c.GoogleOAuthenticator.client_id = google_client_id
          c.GoogleOAuthenticator.client_secret = google_client_secret
    01-smtp-config: |
      import os
      # SMTP configuration for sending emails
      # Values are loaded from Infisical-managed jupyterhub-smtp secret
      smtp_host = os.environ.get('SMTP_HOST', '')
      smtp_port = int(os.environ.get('SMTP_PORT', '587'))
      smtp_user = os.environ.get('SMTP_USER', '')
      smtp_pass = os.environ.get('SMTP_PASS', '')
      smtp_from = os.environ.get('SMTP_FROM', 'jupyter@noizu.com')

      if smtp_host:
          c.JupyterHub.template_vars = {
              'smtp_host': smtp_host,
              'smtp_port': smtp_port,
              'smtp_user': smtp_user,
              'smtp_from': smtp_from,
          }
          # Configure for services that support SMTP
          import logging
          logging.info(f"SMTP configured: {smtp_host}:{smtp_port}")
  # Environment variables (loaded from Infisical-managed secrets)
  extraEnv:
    # OAuth credentials from Infisical jupyter-app-secrets
    GOOGLE_CLIENT_ID:
      valueFrom:
        secretKeyRef:
          name: jupyter-app-secrets
          key: GOOGLE_CLIENT_ID
    GOOGLE_CLIENT_SECRET:
      valueFrom:
        secretKeyRef:
          name: jupyter-app-secrets
          key: GOOGLE_CLIENT_SECRET
    # SMTP from Infisical jupyterhub-smtp secret
    SMTP_HOST:
      valueFrom:
        secretKeyRef:
          name: jupyterhub-smtp
          key: host
          optional: true
    SMTP_PORT:
      valueFrom:
        secretKeyRef:
          name: jupyterhub-smtp
          key: port
          optional: true
    SMTP_USER:
      valueFrom:
        secretKeyRef:
          name: jupyterhub-smtp
          key: user
          optional: true
    SMTP_PASS:
      valueFrom:
        secretKeyRef:
          name: jupyterhub-smtp
          key: password
          optional: true
    SMTP_FROM:
      valueFrom:
        secretKeyRef:
          name: jupyterhub-smtp
          key: from
          optional: true
  # Liveness probe — auto-restart hub when unhealthy.
  #
  # "Unhealthy" = hub process not responding to HTTP on /hub/health.
  # This catches: OOM, deadlocked event loop, wedged tornado handler,
  # or any state where the hub process is alive but non-functional.
  #
  # The K8s API reflector has its own 30-minute retry budget (see
  # 00-spawner-resilience) so transient API blips won't trigger this.
  # This probe is a safety net for truly catastrophic hub failures.
  #
  # Timing: 7 minutes before restart (failureThreshold=7 x periodSeconds=60)
  # to ride out the ~2min control-plane restart cycle with margin.
  livenessProbe:
    enabled: true
    initialDelaySeconds: 90
    periodSeconds: 60
    failureThreshold: 7 # 7 failures x 60s = 7min before restart
  # Resource limits for hub
  resources:
    requests:
      memory: "256Mi"
      cpu: "100m"
    limits:
      memory: "1Gi"
      cpu: "1"
  # Hub database storage
  db:
    type: sqlite-pvc
    pvc:
      storage: 1Gi
      storageClassName: ${storage_class}
# =============================================================================
# Single User Server Configuration
# =============================================================================
singleuser:
  # Default image with JupyterLab
  image:
    name: quay.io/jupyterhub/k8s-singleuser-sample
    tag: "4.3.2"
  # Default to JupyterLab interface
  defaultUrl: "/lab"
  # Resource limits per user
  cpu:
    limit: 2
    guarantee: 0.5
  memory:
    limit: 4G
    guarantee: 1G
  # Disable cloud metadata blocking (not on cloud provider, and iptables
  # filter table unavailable after networking changes)
  cloudMetadata:
    blockWithIptables: false
  # Storage for user notebooks - dynamic per-user PVC via OpenEBS
  storage:
    type: dynamic
    capacity: 10Gi
    dynamic:
      storageClass: ${storage_class}
# =============================================================================
# Proxy Configuration
# =============================================================================
proxy:
  service:
    type: ClusterIP
# =============================================================================
# Scheduling - Use existing nodes
# =============================================================================
scheduling:
  userScheduler:
    enabled: false
# =============================================================================
# Ingress Configuration - Cloudflare Protected
# =============================================================================
ingress:
  enabled: true
  ingressClassName: nginx
  annotations:
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
    nginx.ingress.kubernetes.io/proxy-read-timeout: "3600"
    nginx.ingress.kubernetes.io/proxy-send-timeout: "3600"
    # WebSocket support for JupyterLab
    nginx.ingress.kubernetes.io/proxy-http-version: "1.1"
    nginx.ingress.kubernetes.io/connection-upgrade: "true"
    # Cloudflare IP ranges (as of 2024 - verify at https://cloudflare.com/ips/)
    nginx.ingress.kubernetes.io/whitelist-source-range: >-
      173.245.48.0/20, 103.21.244.0/22, 103.22.200.0/22, 103.31.4.0/22, 141.101.64.0/18, 108.162.192.0/18, 190.93.240.0/20, 188.114.96.0/20, 197.234.240.0/22, 198.41.128.0/17, 162.158.0.0/15, 104.16.0.0/13, 104.24.0.0/14, 172.64.0.0/13, 131.0.72.0/22, 2400:cb00::/32, 2606:4700::/32, 2803:f800::/32, 2405:b500::/32, 2405:8100::/32, 2a06:98c0::/29, 2c0f:f248::/32
    # Cloudflare Authenticated Origin Pull - verify requests are from Cloudflare
    nginx.ingress.kubernetes.io/auth-tls-verify-client: "on"
    nginx.ingress.kubernetes.io/auth-tls-secret: "${namespace}/cloudflare-origin-pull-ca"
  hosts:
    - jupyter.noizu.com
  tls:
    # TLS secret is managed by Infisical Operator
    - secretName: cloudflare-tls-synced
      hosts:
        - jupyter.noizu.com
# =============================================================================
# Culling - Auto-shutdown idle servers
# =============================================================================
cull:
  enabled: true
  timeout: 3600 # 1 hour of inactivity
  every: 300 # Check every 5 minutes
  maxAge: 0 # No max age limit
