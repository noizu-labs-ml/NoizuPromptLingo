# Terraform working dirs / lock are fine to commit (.terraform.lock.hcl), but not:
.terraform/

# Variable files that may hold secrets
terraform.tfvars
*.secret.tfvars
*.secret.tfvars.json

# Backend credential files, if used instead of AWS_* env vars
backend.secret.hcl

# Any local state that slips in (state should live in MinIO)
*.tfstate
*.tfstate.*
