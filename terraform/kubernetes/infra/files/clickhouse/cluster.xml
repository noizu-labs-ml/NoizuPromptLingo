<?xml version="1.0"?>
<clickhouse>
    <macros>
        <cluster>cluster</cluster>
        <shard>01</shard>
        <replica>clickhouse</replica>
    </macros>
    <remote_servers>
        <cluster>
            <shard>
                <internal_replication>false</internal_replication>
                <replica>
                    <!-- Single-node cluster: address the replica as localhost so the
                         node recognizes itself (system.clusters.is_local = 1). With the
                         service name it resolves to the Service ClusterIP (not the pod
                         IP), is_local = 0, and ON CLUSTER DDL (used by PostHog) never
                         gets executed by the distributed-DDL worker and times out.
                         Use 127.0.0.1 (not "localhost", which may resolve to the IPv6
                         ::1 while the server listens on IPv4 0.0.0.0 → still is_local=0). -->
                    <host>127.0.0.1</host>
                    <port>9000</port>
                    <default_database>default</default_database>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
    <zookeeper>
        <node>
            <host>infra-zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
</clickhouse>
