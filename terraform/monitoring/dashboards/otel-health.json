{
  "layout": [
    { "i": "spans-received", "x": 0, "y": 0, "w": 6, "h": 8 },
    { "i": "spans-exported", "x": 6, "y": 0, "w": 6, "h": 8 },
    { "i": "export-failures", "x": 0, "y": 8, "w": 6, "h": 8 },
    { "i": "queue-length", "x": 6, "y": 8, "w": 6, "h": 8 },
    { "i": "dropped-spans", "x": 0, "y": 16, "w": 4, "h": 6 },
    { "i": "dropped-logs", "x": 4, "y": 16, "w": 4, "h": 6 },
    { "i": "dropped-metrics", "x": 8, "y": 16, "w": 4, "h": 6 }
  ],
  "widgets": [
    {
      "id": "spans-received",
      "title": "Spans Received/sec",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "otelcol_receiver_accepted_spans", "dataType": "float64", "type": "Sum" },
            "groupBy": [{ "key": "receiver", "dataType": "string", "type": "tag" }],
            "filters": { "items": [], "op": "AND" }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "spans-exported",
      "title": "Spans Exported/sec",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "otelcol_exporter_sent_spans", "dataType": "float64", "type": "Sum" },
            "groupBy": [{ "key": "exporter", "dataType": "string", "type": "tag" }],
            "filters": { "items": [], "op": "AND" }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "export-failures",
      "title": "Export Failures/sec",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "otelcol_exporter_send_failed_spans", "dataType": "float64", "type": "Sum" },
            "groupBy": [{ "key": "exporter", "dataType": "string", "type": "tag" }],
            "filters": { "items": [], "op": "AND" }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "queue-length",
      "title": "Exporter Queue Size",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "avg",
            "aggregateAttribute": { "key": "otelcol_exporter_queue_size", "dataType": "float64", "type": "Gauge" },
            "groupBy": [{ "key": "exporter", "dataType": "string", "type": "tag" }],
            "filters": { "items": [], "op": "AND" }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "dropped-spans",
      "title": "Dropped Spans",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "sum",
            "aggregateAttribute": { "key": "otelcol_processor_dropped_spans", "dataType": "float64", "type": "Sum" },
            "filters": { "items": [], "op": "AND" }
          }]
        }
      }
    },
    {
      "id": "dropped-logs",
      "title": "Dropped Logs",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "sum",
            "aggregateAttribute": { "key": "otelcol_processor_dropped_log_records", "dataType": "float64", "type": "Sum" },
            "filters": { "items": [], "op": "AND" }
          }]
        }
      }
    },
    {
      "id": "dropped-metrics",
      "title": "Dropped Metrics",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "sum",
            "aggregateAttribute": { "key": "otelcol_processor_dropped_metric_points", "dataType": "float64", "type": "Sum" },
            "filters": { "items": [], "op": "AND" }
          }]
        }
      }
    }
  ],
  "variables": {}
}
