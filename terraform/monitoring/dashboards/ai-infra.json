{
  "layout": [
    { "i": "vllm-gpu-mem", "x": 0, "y": 0, "w": 4, "h": 8 },
    { "i": "vllm-latency", "x": 4, "y": 0, "w": 4, "h": 8 },
    { "i": "vllm-requests", "x": 8, "y": 0, "w": 4, "h": 8 },
    { "i": "weaviate-latency", "x": 0, "y": 8, "w": 4, "h": 8 },
    { "i": "weaviate-memory", "x": 4, "y": 8, "w": 4, "h": 8 },
    { "i": "openwebui-requests", "x": 8, "y": 8, "w": 4, "h": 8 },
    { "i": "ai-errors", "x": 0, "y": 16, "w": 12, "h": 6 }
  ],
  "widgets": [
    {
      "id": "vllm-gpu-mem",
      "title": "vLLM GPU Memory Utilization",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "avg",
            "aggregateAttribute": { "key": "gpu.memory.utilization", "dataType": "float64", "type": "Gauge" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "ai-ns" },
                { "key": { "key": "k8s.deployment.name", "dataType": "string", "type": "resource" }, "op": "regex", "value": "vllm.*" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "softMax": 100
    },
    {
      "id": "vllm-latency",
      "title": "vLLM Inference Latency p95",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "p95",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "filters": {
              "items": [
                { "key": { "key": "serviceName", "dataType": "string", "type": "tag" }, "op": "regex", "value": "vllm.*" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "ns"
    },
    {
      "id": "vllm-requests",
      "title": "vLLM Requests/sec",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "filters": {
              "items": [
                { "key": { "key": "serviceName", "dataType": "string", "type": "tag" }, "op": "regex", "value": "vllm.*" },
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "weaviate-latency",
      "title": "Weaviate Query Latency p95",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "p95",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "filters": {
              "items": [
                { "key": { "key": "serviceName", "dataType": "string", "type": "tag" }, "op": "regex", "value": "weaviate.*" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "ns"
    },
    {
      "id": "weaviate-memory",
      "title": "Weaviate Pod Memory",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "avg",
            "aggregateAttribute": { "key": "k8s.pod.memory.usage", "dataType": "float64", "type": "Gauge" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "ai-ns" },
                { "key": { "key": "k8s.pod.name", "dataType": "string", "type": "resource" }, "op": "regex", "value": "weaviate.*" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "bytes"
    },
    {
      "id": "openwebui-requests",
      "title": "Open-WebUI Request Rate",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "filters": {
              "items": [
                { "key": { "key": "serviceName", "dataType": "string", "type": "tag" }, "op": "regex", "value": "open-webui.*" },
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "ai-errors",
      "title": "AI Namespace Error Logs",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "logs",
            "queryName": "A",
            "aggregateOperator": "count",
            "groupBy": [{ "key": "k8s.deployment.name", "dataType": "string", "type": "resource" }],
            "filters": {
              "items": [
                { "key": { "key": "severity_text", "dataType": "string", "type": "tag" }, "op": "=", "value": "ERROR" },
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "ai-ns" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    }
  ],
  "variables": {}
}
