{
  "layout": [
    { "i": "ingestion-rate", "x": 0, "y": 0, "w": 8, "h": 8 },
    { "i": "total-logs-value", "x": 8, "y": 0, "w": 4, "h": 4 },
    { "i": "error-count-value", "x": 8, "y": 4, "w": 4, "h": 4 },
    { "i": "error-warning-ratio", "x": 0, "y": 8, "w": 6, "h": 8 },
    { "i": "top-producers", "x": 6, "y": 8, "w": 6, "h": 8 }
  ],
  "widgets": [
    {
      "id": "ingestion-rate",
      "title": "Log Ingestion Rate by Namespace",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "logs",
            "queryName": "A",
            "aggregateOperator": "rate",
            "groupBy": [{ "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }],
            "filters": { "items": [], "op": "AND" }
          }]
        }
      },
      "fillSpans": true,
      "softMin": 0
    },
    {
      "id": "total-logs-value",
      "title": "Total Logs (1h)",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "logs",
            "queryName": "A",
            "aggregateOperator": "count",
            "filters": { "items": [], "op": "AND" }
          }]
        }
      }
    },
    {
      "id": "error-count-value",
      "title": "Error Logs (1h)",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "logs",
            "queryName": "A",
            "aggregateOperator": "count",
            "filters": {
              "items": [
                { "key": { "key": "severity_text", "dataType": "string", "type": "tag" }, "op": "=", "value": "ERROR" }
              ],
              "op": "AND"
            }
          }]
        }
      }
    },
    {
      "id": "error-warning-ratio",
      "title": "Errors vs Warnings by Namespace",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "logs",
              "queryName": "A",
              "aggregateOperator": "count",
              "groupBy": [{ "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }],
              "filters": {
                "items": [
                  { "key": { "key": "severity_text", "dataType": "string", "type": "tag" }, "op": "=", "value": "ERROR" }
                ],
                "op": "AND"
              },
              "legend": "errors - {{k8s.namespace.name}}"
            },
            {
              "dataSource": "logs",
              "queryName": "B",
              "aggregateOperator": "count",
              "groupBy": [{ "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }],
              "filters": {
                "items": [
                  { "key": { "key": "severity_text", "dataType": "string", "type": "tag" }, "op": "=", "value": "WARN" }
                ],
                "op": "AND"
              },
              "legend": "warnings - {{k8s.namespace.name}}"
            }
          ]
        }
      },
      "softMin": 0
    },
    {
      "id": "top-producers",
      "title": "Top 10 Log-Producing Pods",
      "panelTypes": "table",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "logs",
            "queryName": "A",
            "aggregateOperator": "count",
            "groupBy": [
              { "key": "k8s.pod.name", "dataType": "string", "type": "resource" },
              { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }
            ],
            "filters": { "items": [], "op": "AND" },
            "orderBy": [{ "columnName": "A", "order": "desc" }],
            "limit": 10
          }]
        }
      }
    }
  ],
  "variables": {}
}
