{
  "layout": [
    { "i": "pod-count-by-ns", "x": 0, "y": 0, "w": 6, "h": 8 },
    { "i": "node-cpu", "x": 6, "y": 0, "w": 6, "h": 8 },
    { "i": "node-memory", "x": 0, "y": 8, "w": 6, "h": 8 },
    { "i": "pod-restarts", "x": 6, "y": 8, "w": 6, "h": 8 },
    { "i": "oom-killed", "x": 0, "y": 16, "w": 4, "h": 6 },
    { "i": "disk-usage", "x": 4, "y": 16, "w": 8, "h": 6 }
  ],
  "widgets": [
    {
      "id": "pod-count-by-ns",
      "title": "Running Pods by Namespace",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "sum",
              "aggregateAttribute": { "key": "k8s.pod.phase", "dataType": "float64", "type": "Gauge" },
              "groupBy": [{ "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }],
              "filters": {
                "items": [
                  { "key": { "key": "k8s.pod.phase", "dataType": "string", "type": "resource" }, "op": "=", "value": "Running" }
                ],
                "op": "AND"
              }
            }
          ]
        }
      },
      "fillSpans": false,
      "softMin": 0
    },
    {
      "id": "node-cpu",
      "title": "Node CPU Utilization %",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "avg",
              "aggregateAttribute": { "key": "system.cpu.utilization", "dataType": "float64", "type": "Gauge" },
              "groupBy": [{ "key": "host.name", "dataType": "string", "type": "resource" }],
              "filters": { "items": [], "op": "AND" }
            }
          ]
        }
      },
      "fillSpans": true,
      "softMin": 0,
      "softMax": 100
    },
    {
      "id": "node-memory",
      "title": "Node Memory Utilization %",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "avg",
              "aggregateAttribute": { "key": "system.memory.utilization", "dataType": "float64", "type": "Gauge" },
              "groupBy": [{ "key": "host.name", "dataType": "string", "type": "resource" }],
              "filters": { "items": [], "op": "AND" }
            }
          ]
        }
      },
      "fillSpans": true,
      "softMin": 0,
      "softMax": 100
    },
    {
      "id": "pod-restarts",
      "title": "Pod Restarts (rate)",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "rate",
              "aggregateAttribute": { "key": "k8s.container.restarts", "dataType": "float64", "type": "Sum" },
              "groupBy": [
                { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" },
                { "key": "k8s.pod.name", "dataType": "string", "type": "resource" }
              ],
              "filters": { "items": [], "op": "AND" }
            }
          ]
        }
      },
      "fillSpans": false,
      "softMin": 0
    },
    {
      "id": "oom-killed",
      "title": "OOMKilled Events (24h)",
      "panelTypes": "value",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "logs",
              "queryName": "A",
              "aggregateOperator": "count",
              "filters": {
                "items": [
                  { "key": { "key": "body", "dataType": "string", "type": "tag" }, "op": "contains", "value": "OOMKilled" }
                ],
                "op": "AND"
              }
            }
          ]
        }
      }
    },
    {
      "id": "disk-usage",
      "title": "Node Disk Usage %",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [
            {
              "dataSource": "metrics",
              "queryName": "A",
              "aggregateOperator": "avg",
              "aggregateAttribute": { "key": "system.filesystem.utilization", "dataType": "float64", "type": "Gauge" },
              "groupBy": [
                { "key": "host.name", "dataType": "string", "type": "resource" },
                { "key": "device", "dataType": "string", "type": "tag" }
              ],
              "filters": { "items": [], "op": "AND" }
            }
          ]
        }
      },
      "fillSpans": true,
      "softMin": 0,
      "softMax": 100
    }
  ],
  "variables": {}
}
