{
  "layout": [
    { "i": "pg-connections", "x": 0, "y": 0, "w": 4, "h": 8 },
    { "i": "pg-latency", "x": 4, "y": 0, "w": 4, "h": 8 },
    { "i": "pg-memory", "x": 8, "y": 0, "w": 4, "h": 8 },
    { "i": "mysql-connections", "x": 0, "y": 8, "w": 4, "h": 8 },
    { "i": "mysql-slow-queries", "x": 4, "y": 8, "w": 4, "h": 8 },
    { "i": "mysql-memory", "x": 8, "y": 8, "w": 4, "h": 8 },
    { "i": "redis-memory", "x": 0, "y": 16, "w": 4, "h": 8 },
    { "i": "redis-ops", "x": 4, "y": 16, "w": 4, "h": 8 },
    { "i": "redis-clients", "x": 8, "y": 16, "w": 4, "h": 8 },
    { "i": "ch-queries", "x": 0, "y": 24, "w": 4, "h": 8 },
    { "i": "ch-memory", "x": 4, "y": 24, "w": 4, "h": 8 },
    { "i": "ch-parts", "x": 8, "y": 24, "w": 4, "h": 8 }
  ],
  "widgets": [
    {
      "id": "pg-connections",
      "title": "Postgres Active Connections",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "sum",
            "aggregateAttribute": { "key": "postgresql.backends", "dataType": "float64", "type": "Gauge" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "data-ns" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "pg-latency",
      "title": "Postgres Query Duration p99",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "p99",
            "aggregateAttribute": { "key": "postgresql.operations.duration", "dataType": "float64", "type": "Histogram" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "data-ns" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "pg-memory",
      "title": "Postgres Pod Memory",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "avg",
            "aggregateAttribute": { "key": "k8s.pod.memory.usage", "dataType": "float64", "type": "Gauge" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "data-ns" },
                { "key": { "key": "k8s.pod.name", "dataType": "string", "type": "resource" }, "op": "regex", "value": "shared-postgres.*" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "bytes"
    },
    {
      "id": "mysql-connections",
