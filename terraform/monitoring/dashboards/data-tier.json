              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "data-ns" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
