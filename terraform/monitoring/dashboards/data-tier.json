            "dataSource": "metrics",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "mysql.slow_queries", "dataType": "float64", "type": "Sum" },
            "filters": {
              "items": [
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "data-ns" }
              ],
