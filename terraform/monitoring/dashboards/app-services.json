{
  "layout": [
    { "i": "http-request-rate", "x": 0, "y": 0, "w": 6, "h": 8 },
    { "i": "http-error-rate", "x": 6, "y": 0, "w": 6, "h": 8 },
    { "i": "http-latency-p99", "x": 0, "y": 8, "w": 6, "h": 8 },
    { "i": "http-latency-p50", "x": 6, "y": 8, "w": 6, "h": 8 },
    { "i": "top-services", "x": 0, "y": 16, "w": 12, "h": 8 }
  ],
  "widgets": [
    {
      "id": "http-request-rate",
      "title": "HTTP Request Rate by Service",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "groupBy": [{ "key": "serviceName", "dataType": "string", "type": "tag" }],
            "filters": {
              "items": [
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" },
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "{{.namespace}}" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "http-error-rate",
      "title": "HTTP Error Rate (4xx + 5xx)",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "rate",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "groupBy": [{ "key": "serviceName", "dataType": "string", "type": "tag" }],
            "filters": {
              "items": [
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" },
                { "key": { "key": "httpStatusCode", "dataType": "string", "type": "tag" }, "op": ">=", "value": "400" },
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "{{.namespace}}" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0
    },
    {
      "id": "http-latency-p99",
      "title": "HTTP Latency p99 by Service",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "p99",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "groupBy": [{ "key": "serviceName", "dataType": "string", "type": "tag" }],
            "filters": {
              "items": [
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" },
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "{{.namespace}}" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "ns"
    },
    {
      "id": "http-latency-p50",
      "title": "HTTP Latency p50 by Service",
      "panelTypes": "graph",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "p50",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "groupBy": [{ "key": "serviceName", "dataType": "string", "type": "tag" }],
            "filters": {
              "items": [
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" },
                { "key": { "key": "k8s.namespace.name", "dataType": "string", "type": "resource" }, "op": "=", "value": "{{.namespace}}" }
              ],
              "op": "AND"
            }
          }]
        }
      },
      "softMin": 0,
      "unit": "ns"
    },
    {
      "id": "top-services",
      "title": "Top Services by Request Count",
      "panelTypes": "table",
      "query": {
        "queryType": "builder",
        "builder": {
          "queryData": [{
            "dataSource": "traces",
            "queryName": "A",
            "aggregateOperator": "count",
            "aggregateAttribute": { "key": "duration_nano", "dataType": "float64", "type": "tag" },
            "groupBy": [{ "key": "serviceName", "dataType": "string", "type": "tag" }],
            "filters": {
              "items": [
                { "key": { "key": "kind", "dataType": "int64", "type": "tag" }, "op": "=", "value": "2" }
              ],
              "op": "AND"
            },
            "orderBy": [{ "columnName": "A", "order": "desc" }],
            "limit": 20
          }]
        }
      }
    }
  ],
  "variables": {
    "namespace": {
      "name": "namespace",
      "type": "CUSTOM",
      "customValue": "apps-ns,ai-ns,platform-ns,creative-ns,data-ns,observability-ns,mail-ns",
      "selectedValue": "apps-ns",
      "description": "Filter by Kubernetes namespace"
    }
  }
}
