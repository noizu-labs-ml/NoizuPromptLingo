# ---------------------------------------------------------------------------
# SigNoz Monitoring — Example Configuration
# ---------------------------------------------------------------------------
# Copy to terraform.tfvars and fill in secrets.
# Alternatively, set SIGNOZ_ACCESS_TOKEN in your environment.
# ---------------------------------------------------------------------------

# SigNoz query service URL (default: https://apm.noizu.com)
# Use http://localhost:3301 with port-forward if Cloudflare Access blocks the provider.
# signoz_endpoint = "https://apm.noizu.com"

# API token from SigNoz Settings > Service Accounts / API Keys
signoz_access_token = ""

# --- Feature Gates (phased activation) ------------------------------------
# Enable after verifying channels are live and delivering.
alerts_enabled   = false
channels_enabled = false
routing_enabled  = false

# --- Notification Targets -------------------------------------------------
alert_owner_email   = "keith.brings@noizu.com"
slack_alert_channel = "#noizu-alerts"
slack_webhook_url   = ""
ops_webhook_url     = ""

# --- Channel Routing Preferences ------------------------------------------
warning_preferred_channels  = ["email_me", "slack_ops"]
critical_preferred_channels = ["email_me", "slack_ops"]
