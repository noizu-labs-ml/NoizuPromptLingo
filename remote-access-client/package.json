{
  "name": "@noizu/remote-access-client",
  "version": "0.1.0",
  "description": "Thin frpc wrapper: claims a named tunnel from the NoizuPromptLingo cloud (MCP JWT) and exposes a local port at https://<name>.remote-access.noizu.com through the cloud frps server.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "noizu-remote-access": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "postinstall": "node scripts/fetch-frpc.mjs"
  },
  "keywords": [
    "mcp",
    "frp",
    "frpc",
    "tunnel",
    "reverse-proxy",
    "noizu"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
