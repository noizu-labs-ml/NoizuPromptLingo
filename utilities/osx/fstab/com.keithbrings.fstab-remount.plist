<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.keithbrings.fstab-remount</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/fstab-remount</string>
    </array>

    <!-- Run once at boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Debug: sudo tail -f /var/log/fstab-remount.log -->
    <key>StandardOutPath</key>
    <string>/var/log/fstab-remount.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/fstab-remount.log</string>
</dict>
</plist>
