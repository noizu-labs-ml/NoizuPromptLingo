#!/usr/bin/env bash
set -euo pipefail

LABEL="${LOCAL_MODEL_LINK_LABEL:-com.keithbrings.colo-local-model-link}"
PLIST_DST="${LOCAL_MODEL_LINK_PLIST:-/Library/LaunchDaemons/${LABEL}.plist}"
LOG_PATH="${LOCAL_MODEL_LINK_LOG:-/var/log/colo-local-model-link.log}"

LOCAL_USER="${LOCAL_MODEL_LINK_LOCAL_USER:-keithbrings}"
LOCAL_HOME="${LOCAL_MODEL_LINK_LOCAL_HOME:-/Users/${LOCAL_USER}}"
SSH_CONFIG="${LOCAL_MODEL_LINK_SSH_CONFIG:-${LOCAL_HOME}/.ssh/config}"
SSH_IDENTITY="${LOCAL_MODEL_LINK_SSH_IDENTITY:-${LOCAL_HOME}/.ssh/id_rsa}"
SSH_KNOWN_HOSTS="${LOCAL_MODEL_LINK_SSH_KNOWN_HOSTS:-${LOCAL_HOME}/.ssh/known_hosts}"
SSH_HOST="${LOCAL_MODEL_LINK_SSH_HOST:-noizu.server}"
SSH_HOSTNAME="${LOCAL_MODEL_LINK_SSH_HOSTNAME:-208.64.36.80}"
SSH_PORT="${LOCAL_MODEL_LINK_SSH_PORT:-31337}"
SSH_USER="${LOCAL_MODEL_LINK_SSH_USER:-keith}"
REMOTE_PORT="${LOCAL_MODEL_LINK_REMOTE_PORT:-3713}"
LOCAL_HOST="${LOCAL_MODEL_LINK_LOCAL_HOST:-localhost}"
LOCAL_PORT="${LOCAL_MODEL_LINK_LOCAL_PORT:-3713}"

usage() {
  cat <<EOF
Usage:
  colo-local-model-link on
  colo-local-model-link off
  colo-local-model-link status
  colo-local-model-link logs
  colo-local-model-link print-plist

Installs/removes a system LaunchDaemon that maintains:
  ${SSH_HOST}:${REMOTE_PORT} -> ${LOCAL_HOST}:${LOCAL_PORT}

Environment overrides:
  LOCAL_MODEL_LINK_LOCAL_USER     default: ${LOCAL_USER}
  LOCAL_MODEL_LINK_SSH_HOST       default: ${SSH_HOST}
  LOCAL_MODEL_LINK_SSH_HOSTNAME   default: ${SSH_HOSTNAME}
  LOCAL_MODEL_LINK_SSH_PORT       default: ${SSH_PORT}
  LOCAL_MODEL_LINK_SSH_USER       default: ${SSH_USER}
  LOCAL_MODEL_LINK_REMOTE_PORT    default: ${REMOTE_PORT}
  LOCAL_MODEL_LINK_LOCAL_HOST     default: ${LOCAL_HOST}
  LOCAL_MODEL_LINK_LOCAL_PORT     default: ${LOCAL_PORT}
  LOCAL_MODEL_LINK_SSH_IDENTITY   default: ${SSH_IDENTITY}
  LOCAL_MODEL_LINK_SSH_CONFIG     default: ${SSH_CONFIG}
EOF
}

require_macos() {
  [[ "$(uname -s)" == "Darwin" ]] || {
    echo "ERROR: launchctl LaunchDaemons are only supported on macOS." >&2
    exit 1
  }
}

require_local_files() {
  [[ -d "$LOCAL_HOME" ]] || {
    echo "ERROR: local home not found: ${LOCAL_HOME}" >&2
    exit 1
  }
  [[ -f "$SSH_IDENTITY" ]] || {
    echo "ERROR: SSH identity not found: ${SSH_IDENTITY}" >&2
    exit 1
  }
  [[ -f "$SSH_CONFIG" ]] || {
    echo "ERROR: SSH config not found: ${SSH_CONFIG}" >&2
    exit 1
  }
  [[ -f "$SSH_KNOWN_HOSTS" ]] || {
    echo "ERROR: SSH known_hosts not found: ${SSH_KNOWN_HOSTS}" >&2
    exit 1
  }
}

print_plist() {
  cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${LABEL}</string>

    <key>UserName</key>
    <string>${LOCAL_USER}</string>

    <key>WorkingDirectory</key>
    <string>${LOCAL_HOME}</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>${LOCAL_HOME}</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/ssh</string>
        <string>-NT</string>
        <string>-i</string>
        <string>${SSH_IDENTITY}</string>
        <string>-p</string>
        <string>${SSH_PORT}</string>
        <string>-l</string>
        <string>${SSH_USER}</string>
        <string>-o</string>
        <string>ExitOnForwardFailure=yes</string>
        <string>-o</string>
        <string>BatchMode=yes</string>
        <string>-o</string>
        <string>IdentitiesOnly=yes</string>
        <string>-o</string>
        <string>UserKnownHostsFile=${SSH_KNOWN_HOSTS}</string>
        <string>-o</string>
        <string>StrictHostKeyChecking=yes</string>
        <string>-o</string>
        <string>ServerAliveInterval=30</string>
        <string>-o</string>
        <string>ServerAliveCountMax=3</string>
        <string>-R</string>
        <string>${REMOTE_PORT}:${LOCAL_HOST}:${LOCAL_PORT}</string>
        <string>${SSH_HOSTNAME}</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>${LOG_PATH}</string>
    <key>StandardErrorPath</key>
    <string>${LOG_PATH}</string>
</dict>
</plist>
EOF
}

on() {
  require_macos
  require_local_files

  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  print_plist > "$tmp"
  plutil -lint "$tmp" >/dev/null

  echo "==> Installing ${LABEL}"
  sudo install -m 644 "$tmp" "$PLIST_DST"
  sudo chown root:wheel "$PLIST_DST"
  sudo launchctl bootout "system/${LABEL}" 2>/dev/null || true
  sudo launchctl bootstrap system "$PLIST_DST"
  sudo launchctl kickstart -k "system/${LABEL}"
  echo "==> Enabled ${SSH_HOST}:${REMOTE_PORT} -> ${LOCAL_HOST}:${LOCAL_PORT}"
}

off() {
  require_macos

  echo "==> Removing ${LABEL}"
  sudo launchctl bootout "system/${LABEL}" 2>/dev/null || true
  sudo rm -f "$PLIST_DST"
  echo "==> Disabled local model reverse link"
}

status() {
  require_macos
  sudo launchctl print "system/${LABEL}" 2>/dev/null || {
    echo "Not loaded: ${LABEL}"
    exit 1
  }
}

logs() {
  require_macos
  sudo tail -100 "$LOG_PATH"
}

cmd="${1:-}"
case "$cmd" in
  on) on ;;
  off) off ;;
  status) status ;;
  logs) logs ;;
  print-plist) print_plist ;;
  --help|-h|help|"") usage ;;
  *)
    echo "ERROR: unknown command: ${cmd}" >&2
    usage >&2
    exit 1
    ;;
esac
