#!/usr/bin/env bash
# =============================================================================
# cluster-nodes — Node layout with capacity type, resources, and pod placement
#
# Usage:
#   cluster-nodes              # summary table
#   cluster-nodes --pods       # also list pods per node
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

BOLD=$'\033[1m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'
MAG=$'\033[0;35m'

SHOW_PODS=false
[[ "${1:-}" == "--pods" ]] && SHOW_PODS=true

echo -e "${BOLD}${CYAN}Node Layout${NC}  $(date '+%H:%M:%S')\n"

# Get node info as JSON
NODES_JSON=$(kubectl get nodes -o json 2>/dev/null)

# Header
printf "${BOLD}%-28s %-14s %-10s %-5s %-20s %-22s %-22s %-8s${NC}\n" \
  "NODE" "INSTANCE" "CAPACITY" "ZONE" "MANAGED-BY" "CPU (req/lim/alloc)" "MEM (req/lim/alloc)" "PODS"
echo "-----------------------------------------------------------------------------------------------------------------------------------"

# Process each node
kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' | while read -r node; do
  # Node metadata
  instance_type=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.node\.kubernetes\.io/instance-type}' 2>/dev/null || echo "?")
  capacity=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.karpenter\.sh/capacity-type}' 2>/dev/null || echo "")
  [[ -z "$capacity" ]] && capacity=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.lifecycle}' 2>/dev/null || echo "-")
  zone=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.topology\.kubernetes\.io/zone}' 2>/dev/null || echo "?")
  zone="${zone##*-}"  # us-east-1a → 1a

  # Determine manager: Karpenter vs EKS managed node group
  nodepool=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.karpenter\.sh/nodepool}' 2>/dev/null || echo "")
  nodegroup=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.node-group}' 2>/dev/null || echo "")
  if [[ -n "$nodepool" ]]; then
    manager="karpenter:${nodepool}"
  elif [[ -n "$nodegroup" ]]; then
    manager="eks:${nodegroup##*-}"
  else
    manager="-"
  fi

  # Allocatable resources
  alloc_cpu=$(kubectl get node "$node" -o jsonpath='{.status.allocatable.cpu}' 2>/dev/null || echo "0")
  alloc_mem=$(kubectl get node "$node" -o jsonpath='{.status.allocatable.memory}' 2>/dev/null || echo "0")
  alloc_pods=$(kubectl get node "$node" -o jsonpath='{.status.allocatable.pods}' 2>/dev/null || echo "0")

  # Convert alloc_mem to Gi
  alloc_mem_gi=$(echo "$alloc_mem" | awk '{
    val=$1
    if (val ~ /Ki$/) { gsub(/Ki/,"",val); printf "%.0fGi", val/1024/1024 }
    else if (val ~ /Mi$/) { gsub(/Mi/,"",val); printf "%.1fGi", val/1024 }
    else if (val ~ /Gi$/) { print val }
    else { printf "%.0fGi", val/1024/1024/1024 }
  }')

  # Pod resource requests/limits on this node
  pod_resources=$(kubectl get pods --all-namespaces --field-selector="spec.nodeName=${node}" \
    -o jsonpath='{range .items[*]}{range .spec.containers[*]}{.resources.requests.cpu}{" "}{.resources.limits.cpu}{" "}{.resources.requests.memory}{" "}{.resources.limits.memory}{"\n"}{end}{end}' 2>/dev/null || echo "")

  # Sum CPU requests/limits (convert to millicores) and memory (to Mi)
  # Use awk to handle the unit parsing reliably
  read -r cpu_req cpu_lim mem_req mem_lim <<< $(echo "$pod_resources" | awk '
    function to_milli(v) {
      if (v == "" || v == "0") return 0
      if (v ~ /m$/) { gsub(/m$/,"",v); return int(v) }
      return int(v) * 1000
    }
    function to_mi(v) {
      if (v == "" || v == "0") return 0
      if (v ~ /Ki$/) { gsub(/Ki$/,"",v); return int(v / 1024) }
      if (v ~ /Mi$/) { gsub(/Mi$/,"",v); return int(v) }
      if (v ~ /Gi$/) { gsub(/Gi$/,"",v); return int(v * 1024) }
      if (v ~ /[0-9]$/) return int(v / 1048576)
      return 0
    }
    {
      cr += to_milli($1); cl += to_milli($2)
      mr += to_mi($3); ml += to_mi($4)
    }
    END { printf "%d %d %d %d\n", cr, cl, mr, ml }
  ')

  # Pod count
  pod_count=$(kubectl get pods --all-namespaces --field-selector="spec.nodeName=${node}" --no-headers 2>/dev/null | wc -l | tr -d ' ')

  # Capacity type color
  cap_color="${NC}"
  [[ "$capacity" == "spot" ]] && cap_color="${YEL}"
  [[ "$capacity" == "on-demand" ]] && cap_color="${GRN}"

  # Shorten node name
  short_node="${node%%.*}"

  # Manager color
  mgr_color="${NC}"
  [[ "$manager" == karpenter:* ]] && mgr_color="${MAG:-\033[0;35m}"

  printf "%-28s %-14s ${cap_color}%-10s${NC} %-5s ${mgr_color}%-20s${NC} ${DIM}%5sm/%5sm/%-6s  %5sMi/%5sMi/%-6s${NC} %s/%s\n" \
    "$short_node" "$instance_type" "$capacity" "$zone" "$manager" \
    "$cpu_req" "$cpu_lim" "$alloc_cpu" \
    "$mem_req" "$mem_lim" "$alloc_mem_gi" \
    "$pod_count" "$alloc_pods"

  # Optionally list pods on this node
  if $SHOW_PODS; then
    kubectl get pods --all-namespaces --field-selector="spec.nodeName=${node}" --no-headers 2>/dev/null | \
      awk -v dim="$DIM" -v nc="$NC" '{ printf "  %s%-12s %-45s %5s  %s%s\n", dim, $1, $2, $3, $4, nc }'
    echo ""
  fi
done

echo ""
