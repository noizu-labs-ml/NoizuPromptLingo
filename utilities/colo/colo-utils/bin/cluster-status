#!/usr/bin/env bash
# =============================================================================
# cluster-status — Formatted pod dashboard grouped by category
#
# Usage:
#   cluster-status           # full dashboard
#   cluster-status --watch   # refresh every 5s
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# Colors
BOLD=$'\033[1m'
DIM=$'\033[2m'
CYAN=$'\033[0;36m'
MAG=$'\033[0;35m'

# Status colors
status_color() {
  case "$1" in
    Running)          echo "${GRN}" ;;
    Completed)        echo "${DIM}" ;;
    Pending|Init:*)   echo "${YEL}" ;;
    *)                echo "${RED}" ;;
  esac
}

# Get node capacity type (spot/on-demand) — cached per node
declare -A NODE_CAPACITY=()
get_capacity_type() {
  local node="$1"
  if [[ -z "${NODE_CAPACITY[$node]+x}" ]]; then
    NODE_CAPACITY[$node]=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.karpenter\.sh/capacity-type}' 2>/dev/null || echo "-")
    [[ -z "${NODE_CAPACITY[$node]}" ]] && NODE_CAPACITY[$node]=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.lifecycle}' 2>/dev/null || echo "-")
  fi
  echo "${NODE_CAPACITY[$node]}"
}

# Print a section of pods
print_section() {
  local title="$1"
  local pattern="$2"
  local pods

  pods=$(echo "$ALL_PODS" | grep -E "$pattern" || true)
  [[ -z "$pods" ]] && return

  echo -e "\n${BOLD}${CYAN}=== ${title} ===${NC}"
  echo "$pods" | while IFS='|' read -r ns name ready status restarts age node; do
    local color
    color=$(status_color "$status")
    local cap="-"
    if [[ -n "$node" && "$node" != "<none>" ]]; then
      cap=$(get_capacity_type "$node")
      node="${node%%.*}"  # trim .ec2.internal
    fi
    printf "  ${color}%-48s %5s  %-20s${NC} ${DIM}%-10s %s${NC}\n" \
      "$name" "$ready" "$status" "$cap" "$node"
  done
}

render() {
  # Fetch all pods across namespaces with node info
  ALL_PODS=$(kubectl get pods --all-namespaces -o custom-columns=\
NS:.metadata.namespace,\
NAME:.metadata.name,\
READY:.status.containerStatuses[*].ready,\
STATUS:.status.phase,\
RESTARTS:.status.containerStatuses[*].restartCount,\
AGE:.metadata.creationTimestamp,\
NODE:.spec.nodeName \
  --no-headers 2>/dev/null | \
  awk '{
    # Rebuild READY as count
    split($3, r, ",")
    total=0; ready=0
    for (i in r) { total++; if (r[i]=="true") ready++ }
    readyStr=ready"/"total

    # Get actual status from raw
    printf "%s|%s|%s|%s|%s|%s|%s\n", $1, $2, readyStr, $4, $5, $6, $7
  }')

  # Also get pod status more accurately (phase != container status)
  ALL_PODS=$(kubectl get pods --all-namespaces \
    -o custom-columns='NS:.metadata.namespace,NAME:.metadata.name,READY:custom,STATUS:custom,RESTARTS:custom,AGE:custom,NODE:.spec.nodeName' \
    --no-headers 2>/dev/null || true)

  # Use kubectl wide output to get node name in last column
  ALL_PODS=$(kubectl get pods --all-namespaces -o wide --no-headers 2>/dev/null | \
    awk '{ printf "%s|%s|%s|%s|%s|%s|%s\n", $1, $2, $3, $4, $5, $6, $8 }')

  echo -e "${BOLD}${MAG}Cluster Status${NC}  $(date '+%H:%M:%S')"

  print_section "Databases"      "${K8_STATUS_DB_PATTERN:-(timescaledb|mysqldb|redis|valkey)}"
  print_section "Search"          "${K8_STATUS_SEARCH_PATTERN:-(manticore|elasticsearch|opensearch)}"
  print_section "Applications"    "${K8_STATUS_APP_PATTERN:-(backend|frontend|wordpress|api|admin)}"
  print_section "Networking"      "${K8_STATUS_NET_PATTERN:-(pgbouncer|proxysql|haproxy)}"
  print_section "Infrastructure"  "${K8_STATUS_INFRA_PATTERN:-(infisical|signoz|karpenter|nginx-ingress|lb-controller|cert-manager)}"
  print_section "Jobs"            "${K8_STATUS_JOB_PATTERN:-(indexer|migrat|job)}"

  echo ""
}

if [[ "${1:-}" == "--watch" ]]; then
  while true; do
    clear
    render
    sleep 5
  done
else
  render
fi
