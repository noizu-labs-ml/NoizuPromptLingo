[Unit]
Description=GitHub Deployment Relay — polls for pending deployments and runs helm-upgrade
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/colo-deploy-relay
User=deploy
Group=deploy
Environment=DEPLOY_REPO=the-robot-lives/incubator
Environment=DEPLOY_ENV=production
Environment=STATE_DIR=/var/lib/deploy-relay
Environment=REGISTRY=ghcr.io/the-robot-lives
Environment=PATH=/usr/local/bin:/usr/bin:/bin:%h/.local/bin

# Hardening
ProtectSystem=strict
ReadWritePaths=/var/lib/deploy-relay
PrivateTmp=true
NoNewPrivileges=true
