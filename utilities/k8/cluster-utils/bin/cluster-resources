#!/usr/bin/env bash
# =============================================================================
# cluster-resources — Per-pod CPU/RAM usage vs requests
#
# Requires metrics-server to be installed (kubectl top pods).
#
# Usage:
#   cluster-resources              # all namespaces
#   cluster-resources -n <namespace> # specific namespace
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

BOLD=$'\033[1m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'

NS_FLAG="--all-namespaces"
NS_COL="NAMESPACE"
[[ "${1:-}" == "-n" && -n "${2:-}" ]] && NS_FLAG="-n $2" && NS_COL="(ns: $2)"

echo -e "${BOLD}${CYAN}Pod Resources${NC}  $(date '+%H:%M:%S')\n"

# Check if metrics-server is available
if ! kubectl top pods $NS_FLAG --no-headers 2>/dev/null | head -1 >/dev/null 2>&1; then
  echo -e "  ${FAIL} metrics-server not available — install it first:"
  echo "    kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml"
  exit 1
fi

# Get actual usage
USAGE=$(kubectl top pods $NS_FLAG --no-headers 2>/dev/null | sort)

# Get requests from pod specs
REQUESTS=$(kubectl get pods $NS_FLAG -o jsonpath='{range .items[*]}{.metadata.namespace}{"\t"}{.metadata.name}{"\t"}{range .spec.containers[*]}{.resources.requests.cpu}{","}{.resources.requests.memory}{","}{.resources.limits.cpu}{","}{.resources.limits.memory}{" "}{end}{"\n"}{end}' 2>/dev/null)

# Header
printf "${BOLD}%-12s %-45s %8s %8s %8s %8s  %s${NC}\n" \
  "$NS_COL" "POD" "CPU(req)" "CPU(use)" "MEM(req)" "MEM(use)" "FLAGS"
echo "--------------------------------------------------------------------------------------------------------------"

# Join usage + requests
echo "$USAGE" | while read -r line; do
  if [[ "$NS_FLAG" == "--all-namespaces" ]]; then
    ns=$(echo "$line" | awk '{print $1}')
    pod=$(echo "$line" | awk '{print $2}')
    cpu_use=$(echo "$line" | awk '{print $3}')
    mem_use=$(echo "$line" | awk '{print $4}')
  else
    ns="${2}"
    pod=$(echo "$line" | awk '{print $1}')
    cpu_use=$(echo "$line" | awk '{print $2}')
    mem_use=$(echo "$line" | awk '{print $3}')
  fi

  # Find matching request line
  req_line=$(echo "$REQUESTS" | grep "^${ns}	${pod}	" || echo "")
  cpu_req="-"
  mem_req="-"
  if [[ -n "$req_line" ]]; then
    # Sum container requests (pod may have multiple containers)
    containers=$(echo "$req_line" | cut -f3)
    total_cpu_req=0
    total_mem_req=0
    for c in $containers; do
      cr=$(echo "$c" | cut -d, -f1)
      mr=$(echo "$c" | cut -d, -f2)
      if [[ "$cr" == *m ]]; then total_cpu_req=$((total_cpu_req + ${cr%m}))
      elif [[ -n "$cr" && "$cr" != "," ]]; then total_cpu_req=$((total_cpu_req + ${cr} * 1000)); fi
      if [[ "$mr" == *Mi ]]; then total_mem_req=$((total_mem_req + ${mr%Mi}))
      elif [[ "$mr" == *Gi ]]; then total_mem_req=$((total_mem_req + ${mr%Gi} * 1024)); fi
    done
    [[ $total_cpu_req -gt 0 ]] && cpu_req="${total_cpu_req}m"
    [[ $total_mem_req -gt 0 ]] && mem_req="${total_mem_req}Mi"
  fi

  # Flags
  flags=""
  # Check if CPU usage > request
  cpu_use_m=${cpu_use%m}
  cpu_req_m=${cpu_req%m}
  if [[ "$cpu_req" != "-" && "$cpu_use_m" =~ ^[0-9]+$ && "$cpu_req_m" =~ ^[0-9]+$ ]]; then
    if [[ $cpu_use_m -gt $cpu_req_m ]]; then
      flags="${YEL}OVER-CPU${NC}"
    fi
  fi
  # Check if MEM usage > request
  mem_use_num=$(echo "$mem_use" | sed 's/[^0-9]//g')
  mem_req_num=$(echo "$mem_req" | sed 's/[^0-9]//g')
  if [[ "$mem_req" != "-" && -n "$mem_use_num" && -n "$mem_req_num" ]]; then
    # Rough comparison (both should be in Mi)
    mem_use_mi=$mem_use_num
    [[ "$mem_use" == *Gi ]] && mem_use_mi=$((mem_use_num * 1024))
    mem_req_mi=$mem_req_num
    [[ "$mem_req" == *Gi ]] && mem_req_mi=$((mem_req_num * 1024))
    if [[ $mem_use_mi -gt $mem_req_mi ]]; then
      [[ -n "$flags" ]] && flags="${flags} "
      flags="${flags}${RED}OVER-MEM${NC}"
    fi
  fi
  [[ -z "$flags" ]] && flags="${DIM}ok${NC}"

  # Truncate pod name
  short_pod="${pod:0:44}"

  printf "%-12s %-45s %8s %8s %8s %8s  ${flags}\n" \
    "$ns" "$short_pod" "$cpu_req" "$cpu_use" "$mem_req" "$mem_use"
done

echo ""
