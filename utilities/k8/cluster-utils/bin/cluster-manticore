#!/usr/bin/env bash
# =============================================================================
# cluster-manticore — Manticore search status dashboard
#
# Shows reader pod status, index versions, S3 state, and job history.
#
# Usage:
#   cluster-manticore
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

BOLD=$'\033[1m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'
MAG=$'\033[0;35m'

S3_BUCKET="${K8_MANTICORE_S3_BUCKET:-manticore-indexes}"
S3_PREFIX="indexes"

echo -e "${BOLD}${MAG}Manticore Search Status${NC}  $(date '+%H:%M:%S')\n"

# === Reader Pods ===
echo -e "${BOLD}${CYAN}=== Reader ===${NC}"
kubectl get pods -n "${K8_NAMESPACE:-default}" -l app.kubernetes.io/name=${K8_MANTICORE_APP_LABEL:-manticore} -o wide --no-headers 2>/dev/null | \
  grep -v indexer | while read -r line; do
    echo "  $line"
  done

# Index versions on reader
echo ""
for idx in main delta; do
  ver=$(kubectl exec -n "${K8_NAMESPACE:-default}" ${K8_MANTICORE_READER_POD:-manticore-reader-0} -c index-pull -- \
    cat "/var/lib/manticore/data/.version-${idx}" 2>/dev/null || echo "none")
  if [[ "$ver" != "none" && "$ver" =~ ^[0-9]+$ ]]; then
    age=$(( $(date +%s) - ver ))
    if (( age < 60 )); then age_str="${age}s ago"
    elif (( age < 3600 )); then age_str="$(( age / 60 ))m ago"
    else age_str="$(( age / 3600 ))h ago"; fi
    echo -e "  ${idx} index:  ${GRN}${ver}${NC}  (${age_str})"
  else
    echo -e "  ${idx} index:  ${YEL}not synced${NC}"
  fi
done

# Document counts
echo ""
doc_count=$(kubectl exec -n "${K8_NAMESPACE:-default}" ${K8_MANTICORE_READER_POD:-manticore-reader-0} -c manticore -- \
  mysql -h 127.0.0.1 -P 9306 -N -e "SELECT COUNT(*) FROM main;" 2>/dev/null || echo "?")
delta_count=$(kubectl exec -n "${K8_NAMESPACE:-default}" ${K8_MANTICORE_READER_POD:-manticore-reader-0} -c manticore -- \
  mysql -h 127.0.0.1 -P 9306 -N -e "SELECT COUNT(*) FROM delta;" 2>/dev/null || echo "?")
echo -e "  main docs:   ${BOLD}${doc_count}${NC}"
echo -e "  delta docs:  ${BOLD}${delta_count}${NC}"

# === S3 ===
echo -e "\n${BOLD}${CYAN}=== S3 (${S3_BUCKET}) ===${NC}"

s3_main=$(aws s3 cp "s3://${S3_BUCKET}/${S3_PREFIX}/latest-main" - 2>/dev/null || echo "none")
s3_delta=$(aws s3 cp "s3://${S3_BUCKET}/${S3_PREFIX}/latest-delta" - 2>/dev/null || echo "none")
echo "  latest-main:   ${s3_main}"
echo "  latest-delta:  ${s3_delta}"

if [[ "$s3_main" != "none" && "$s3_main" =~ ^[0-9]+$ ]]; then
  file_count=$(aws s3 ls "s3://${S3_BUCKET}/${S3_PREFIX}/main/${s3_main}/" 2>/dev/null | wc -l | tr -d ' ')
  total_size=$(aws s3 ls "s3://${S3_BUCKET}/${S3_PREFIX}/main/${s3_main}/" 2>/dev/null | \
    awk '{sum+=$3} END {printf "%.1f GB", sum/1024/1024/1024}')
  echo "  main files:    ${file_count} files, ${total_size}"
fi

# === Jobs ===
echo -e "\n${BOLD}${CYAN}=== Jobs ===${NC}"

# Main indexer
main_job=$(kubectl get jobs -n "${K8_NAMESPACE:-default}" -l app.kubernetes.io/component=indexer --sort-by=.metadata.creationTimestamp --no-headers 2>/dev/null | tail -1)
if [[ -n "$main_job" ]]; then
  echo -e "  Main indexer:   $(echo "$main_job" | awk '{printf "%s  %s  age:%s", $1, $2, $4}')"
else
  echo -e "  Main indexer:   ${DIM}no recent jobs${NC}"
fi

# Delta indexer
delta_job=$(kubectl get jobs -n "${K8_NAMESPACE:-default}" -l app.kubernetes.io/component=delta-indexer --sort-by=.metadata.creationTimestamp --no-headers 2>/dev/null | tail -1)
if [[ -n "$delta_job" ]]; then
  echo -e "  Delta indexer:  $(echo "$delta_job" | awk '{printf "%s  %s  age:%s", $1, $2, $4}')"
else
  echo -e "  Delta indexer:  ${DIM}no recent jobs${NC}"
fi

# Next delta run
next_delta=$(kubectl get cronjob ${K8_MANTICORE_DELTA_CRONJOB:-manticore-delta-indexer} -n "${K8_NAMESPACE:-default}" -o jsonpath='{.spec.schedule}' 2>/dev/null || echo "?")
echo -e "  Delta schedule: ${next_delta}"

echo ""
