#!/usr/bin/env bash
# =============================================================================
# cluster-helm — Helm release status with failure highlighting
#
# Usage:
#   cluster-helm               # all namespaces
#   cluster-helm -n <namespace> # specific namespace
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

BOLD=$'\033[1m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'

NS_FLAG="--all-namespaces"
[[ "${1:-}" == "-n" && -n "${2:-}" ]] && NS_FLAG="-n $2"

echo -e "${BOLD}${CYAN}Helm Releases${NC}  $(date '+%H:%M:%S')\n"

printf "${BOLD}%-12s %-28s %-8s %-10s %-35s %s${NC}\n" \
  "NAMESPACE" "RELEASE" "REV" "STATUS" "CHART" "UPDATED"
echo "--------------------------------------------------------------------------------------------------------------"

helm list $NS_FLAG --output json 2>/dev/null | \
  python3 -c "
import json, sys
releases = json.load(sys.stdin)
for r in sorted(releases, key=lambda x: (x.get('namespace',''), x.get('name',''))):
    ns = r.get('namespace', '?')
    name = r.get('name', '?')
    rev = str(r.get('revision', '?'))
    status = r.get('status', '?')
    chart = r.get('chart', '?')
    updated = r.get('updated', '?')[:19] if r.get('updated') else '?'

    # Color by status
    if status == 'deployed':
        color = '\033[0;32m'  # green
    elif status == 'failed':
        color = '\033[0;31m'  # red
        status += '  <--'
    elif status in ('pending-install', 'pending-upgrade'):
        color = '\033[1;33m'  # yellow
    else:
        color = '\033[0m'

    print(f'{ns:<12s} {name:<28s} {rev:<8s} {color}{status:<10s}\033[0m {chart:<35s} {updated}')
" 2>/dev/null

# ── Database State ─────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}${CYAN}Database Pods${NC}  (timescaledb, postgres, manticore)\n"

printf "${BOLD}%-12s %-40s %-10s %-8s %s${NC}\n" \
  "NAMESPACE" "POD" "STATUS" "READY" "RESTARTS"
echo "--------------------------------------------------------------------------------------------------------------"

kubectl get pods $NS_FLAG -l 'app.kubernetes.io/name in (gnp-timescaledb,timescaledb,postgres,postgresql,manticore,manticoresearch)' \
  -o json 2>/dev/null | python3 -c "
import json, sys
data = json.load(sys.stdin)
for pod in sorted(data.get('items', []), key=lambda p: (p['metadata'].get('namespace',''), p['metadata']['name'])):
    ns = pod['metadata'].get('namespace', '?')
    name = pod['metadata']['name']
    phase = pod['status'].get('phase', '?')
    containers = pod['status'].get('containerStatuses', [])
    ready = sum(1 for c in containers if c.get('ready'))
    total = len(containers)
    restarts = sum(c.get('restartCount', 0) for c in containers)

    if phase == 'Running' and ready == total:
        color = '\033[0;32m'
    elif phase == 'Running':
        color = '\033[1;33m'
    else:
        color = '\033[0;31m'

    print(f'{ns:<12s} {name:<40s} {color}{phase:<10s}\033[0m {ready}/{total:<6s} {restarts}')
" 2>/dev/null

echo ""
echo -e "${BOLD}${CYAN}Database PVCs${NC}\n"

printf "${BOLD}%-12s %-45s %-10s %-10s %s${NC}\n" \
  "NAMESPACE" "PVC" "STATUS" "SIZE" "STORAGECLASS"
echo "--------------------------------------------------------------------------------------------------------------"

kubectl get pvc $NS_FLAG -o json 2>/dev/null | python3 -c "
import json, sys
data = json.load(sys.stdin)
db_keywords = ('timescaledb', 'postgres', 'manticore', 'tsdb')
for pvc in sorted(data.get('items', []), key=lambda p: (p['metadata'].get('namespace',''), p['metadata']['name'])):
    name = pvc['metadata']['name']
    if not any(k in name.lower() for k in db_keywords):
        continue
    ns = pvc['metadata'].get('namespace', '?')
    phase = pvc['status'].get('phase', '?')
    capacity = pvc['status'].get('capacity', {}).get('storage', '?')
    sc = pvc['spec'].get('storageClassName', '?')

    color = '\033[0;32m' if phase == 'Bound' else '\033[0;31m'
    print(f'{ns:<12s} {name:<45s} {color}{phase:<10s}\033[0m {capacity:<10s} {sc}')
" 2>/dev/null

echo ""
