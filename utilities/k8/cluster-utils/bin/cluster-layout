#!/usr/bin/env bash
# =============================================================================
# cluster-layout — Node-to-pod mapping + storage layout
#
# Outputs markdown-formatted layout showing which pods run on which nodes,
# grouped by node pool, plus PVC→PV storage map and per-node volume inventory.
#
# Usage:
#   cluster-layout              # terminal output (markdown)
#   cluster-layout > .tmp/cluster-layout.md   # save to file
# =============================================================================
set -euo pipefail

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
[[ -f "$_K8_ASSIST_LIB" ]] && { source "$_K8_ASSIST_LIB"; _k8_check_assist "$0" "$@"; }

# Pool name → display label mapping (override via K8_NODEPOOL_LABELS)
# Format: "raw_name=display_label,raw_name=display_label,..."
K8_NODEPOOL_LABELS="${K8_NODEPOOL_LABELS:-general=karpenter,indexer=karpenter:indexer,managed=eks}"
declare -A POOL_LABELS=()
IFS=',' read -ra _pairs <<< "$K8_NODEPOOL_LABELS"
for _pair in "${_pairs[@]}"; do
  _raw="${_pair%%=*}"
  _label="${_pair#*=}"
  POOL_LABELS[$_raw]="$_label"
done
map_pool_label() {
  echo "${POOL_LABELS[$1]:-$1}"
}

# Build the joined dataset: nodepool, namespace/pod, ready, status, restarts, age, nodename
DATA=$(join -1 1 -2 1 -o '1.2,2.2,2.3,2.4,2.5,2.6,2.1' \
  <(kubectl get nodes --no-headers \
      -o custom-columns='N:.metadata.name,P:.metadata.labels.karpenter\.sh/nodepool' \
    | sed 's/<none>/managed/' | sort) \
  <(kubectl get pods -A -o wide --no-headers \
    | awk '{print $8,$1"/"$2,$3,$4,$5,$6}' | sort) \
  | sort -k1,1 -k2,2)

# Get node metadata
declare -A NODE_TYPE=()
declare -A NODE_CAP=()
declare -A NODE_ZONE=()
while read -r node; do
  short="${node%%.*}"
  NODE_TYPE[$short]=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.node\.kubernetes\.io/instance-type}' 2>/dev/null || echo "?")
  NODE_CAP[$short]=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.karpenter\.sh/capacity-type}' 2>/dev/null || echo "")
  [[ -z "${NODE_CAP[$short]}" ]] && NODE_CAP[$short]=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.lifecycle}' 2>/dev/null || echo "-")
  zone=$(kubectl get node "$node" -o jsonpath='{.metadata.labels.topology\.kubernetes\.io/zone}' 2>/dev/null || echo "?")
  NODE_ZONE[$short]="${zone##*-}"
done < <(kubectl get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}')

# Generate markdown
echo "# Cluster Layout"
echo ""
echo "_Generated: $(date '+%Y-%m-%d %H:%M:%S')_"
echo ""

# Group by namespace, then show pool per pod
NAMESPACES=$(echo "$DATA" | awk '{split($2,a,"/"); print a[1]}' | sort -u)

for ns in $NAMESPACES; do
  echo "## $ns"
  echo ""
  echo "| Pod | Ready | Status | Age | Pool | Capacity |"
  echo "|-----|-------|--------|-----|------|----------|"

  # Process each pod in this namespace, look up capacity from node name
  echo "$DATA" | while read -r pool nspod ready status restarts age nodename; do
    podns="${nspod%%/*}"
    [[ "$podns" != "$ns" ]] && continue
    pod="${nspod#*/}"
    # Map pool name
    pool_label=$(map_pool_label "$pool")
    # Look up capacity type from node
    short_node="${nodename%%.*}"
    cap="${NODE_CAP[$short_node]:-?}"
    echo "| $pod | $ready | $status | $age | $pool_label | $cap |"
  done
  echo ""
done

# Node summary table
echo "## Node Summary"
echo ""
echo "| Node | Instance | Capacity | Zone | Manager |"
echo "|------|----------|----------|------|---------|"

kubectl get nodes --no-headers \
  -o custom-columns='N:.metadata.name,P:.metadata.labels.karpenter\.sh/nodepool' \
  | sed 's/<none>/managed/' | sort -k2,2 -k1,1 | while read -r node pool; do
    short="${node%%.*}"
    type="${NODE_TYPE[$short]:-?}"
    cap="${NODE_CAP[$short]:-?}"
    zone="${NODE_ZONE[$short]:-?}"
    label=$(map_pool_label "$pool")
    if [[ "$pool" == "managed" || "$label" == "eks" ]]; then
      mgr="EKS managed"
    else
      mgr="Karpenter: $pool"
    fi
    echo "| $short | $type | $cap | $zone | $mgr |"
  done
echo ""

# =============================================================================
# PVC → PV Storage Map
# =============================================================================
echo "## PVC → PV Storage"
echo ""
echo "| Namespace | PVC | Status | Volume | Capacity | Access | StorageClass | Node |"
echo "|-----------|-----|--------|--------|----------|--------|--------------|------|"

# Build PV → node mapping from nodeAffinity (EBS/local volumes are node-pinned)
declare -A PV_NODE=()
while IFS=$'\t' read -r pvname nodevals; do
  PV_NODE[$pvname]="${nodevals:-—}"
done < <(kubectl get pv -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{range .spec.nodeAffinity.required.nodeSelectorTerms[*].matchExpressions[*]}{range .values[*]}{@}{end}{end}{"\n"}{end}' 2>/dev/null)

# List all PVCs with their bound PV details
kubectl get pvc -A --no-headers --sort-by='.metadata.namespace' 2>/dev/null | while read -r ns name status volume capacity access sc age; do
  # Shorten node name for display
  node="${PV_NODE[$volume]:-—}"
  short_node="${node%%.*}"
  # Shorten PV name if it's a long pvc- uuid
  short_vol="$volume"
  if [[ "$volume" == pvc-* ]] && (( ${#volume} > 20 )); then
    short_vol="pvc-…${volume: -8}"
  fi
  echo "| $ns | $name | $status | $short_vol | $capacity | $access | $sc | $short_node |"
done
echo ""

# =============================================================================
# Node Volumes — EBS + Local attached to each node
# =============================================================================
echo "## Node Volumes"
echo ""
echo "| Node | PV | Capacity | StorageClass | Type | Claim |"
echo "|------|----|----------|--------------|------|-------|"

# Walk PVs grouped by node
kubectl get pv -o json 2>/dev/null | python3 -c '
import json, sys
data = json.load(sys.stdin)
rows = []
for pv in data.get("items", []):
    name = pv["metadata"]["name"]
    cap = pv["spec"]["capacity"].get("storage", "?")
    sc = pv["spec"].get("storageClassName", "—")
    claim_ref = pv["spec"].get("claimRef", {})
    if claim_ref:
        ns = claim_ref.get("namespace", "")
        cn = claim_ref.get("name", "")
        claim = ns + "/" + cn
    else:
        claim = "—"

    # Determine volume type
    if "local" in pv["spec"]:
        vtype = "local"
    elif "csi" in pv["spec"]:
        driver = pv["spec"]["csi"].get("driver", "")
        if "ebs" in driver:
            vtype = "ebs"
        elif "efs" in driver:
            vtype = "efs"
        else:
            vtype = driver.split(".")[-2] if "." in driver else driver
    elif "hostPath" in pv["spec"]:
        vtype = "hostPath"
    elif "nfs" in pv["spec"]:
        vtype = "nfs"
    else:
        vtype = "—"

    # Get node from nodeAffinity
    node = "—"
    na = pv["spec"].get("nodeAffinity", {})
    req = na.get("required", {})
    for term in req.get("nodeSelectorTerms", []):
        for expr in term.get("matchExpressions", []):
            if expr.get("values"):
                node = expr["values"][0].split(".")[0]
                break

    # EFS is not node-pinned
    if vtype == "efs":
        node = "(shared)"

    short_name = name
    if name.startswith("pvc-") and len(name) > 20:
        short_name = f"pvc-…{name[-8:]}"

    rows.append((node, short_name, cap, sc, vtype, claim))

rows.sort(key=lambda r: (r[0], r[1]))
for node, pv, cap, sc, vtype, claim in rows:
    print(f"| {node} | {pv} | {cap} | {sc} | {vtype} | {claim} |")
'
echo ""
