#!/usr/bin/env bash
set -euo pipefail
# =============================================================================
# deploy-service - Headless build -> push -> chart bump -> helm upgrade.
#
# Reads each image's deploy target from project.yaml files under
# paths.projects_dir from infra-config.yaml. An image declares where it ships via:
#
#   # docker.images[].helm                 (flat / standalone images)
#   # projects[].services[].helm           (composite projects)
#   helm:
#     chart_path:  helm/<domain>/<chart>      # dir containing values.yaml
#     values_path: .some.yq.path              # yq target inside values.yaml
#     format:      tag | image                # default: tag
#
# format=tag   -> values_path points to a bare version string (".image.tag")
# format=image -> values_path points to a full image string (".backend.image");
#                the registry prefix of the existing value is preserved.
#
# Usage:
#   deploy-service <image-key> [<image-key>...] [flags]
#
# Batched behaviour:
#   Multiple image-keys are built sequentially (fail-fast), then each chart's
#   values.yaml is updated, then each unique helm release is upgraded exactly
#   once at the end, so a coupled backend+frontend ship as one deploy.
#
# Arguments:
#   <image-key>    docker-build target.  Flat name (e.g., webstudio-builder)
#                  or composite (e.g., codefre.sh/backend).  Repeatable.
#
# Flags:
#   --tag TAG      Override the tag (rejected if >1 image-key given).
#   --stage        Set BUILD_ENV=stage.
#   --prod         Set BUILD_ENV=prod.
#   --dev          Set BUILD_ENV=dev.
#   --env ENV      Set BUILD_ENV to a custom value.
#   --no-cache     Pass through to docker-build for every image.
#   --skip-build   Skip build/push (images must already exist at their tags).
#   --skip-deploy  Build (+ bump values) only; no helm-upgrade.
#   --dry-run      Print planned actions; touch nothing.
#   --config PATH  Path to infra-config.yaml.
#   -v, --verbose  Show sub-commands before executing.
#   -h, --help     Show this help.
#
# Requires: docker-build, helm-upgrade, yq, git on PATH.
# =============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/project-registry.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# --- Parse args --------------------------------------------------------------
IMAGE_KEYS=()
TAG_OVERRIDE=""
FLAG_NO_CACHE=false
FLAG_SKIP_BUILD=false
FLAG_SKIP_DEPLOY=false
FLAG_DRY_RUN=false
FLAG_VERBOSE=false

usage() {
  sed -n '3,/^# ===/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//' >&2
  exit "${1:-0}"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tag)          TAG_OVERRIDE="$2"; shift 2 ;;
    --no-cache)     FLAG_NO_CACHE=true; shift ;;
    --skip-build)   FLAG_SKIP_BUILD=true; shift ;;
    --skip-deploy)  FLAG_SKIP_DEPLOY=true; shift ;;
    --stage)        export BUILD_ENV=stage; shift ;;
    --prod)         export BUILD_ENV=prod; shift ;;
    --dev)          export BUILD_ENV=dev; shift ;;
    --env=*)        export BUILD_ENV="${1#--env=}"; shift ;;
    --env)          export BUILD_ENV="$2"; shift 2 ;;
    --dry-run)      FLAG_DRY_RUN=true; shift ;;
    --config=*)     shift ;;
    --config)       shift 2 ;;
    -v|--verbose)   FLAG_VERBOSE=true; shift ;;
    -h|--help)      usage 0 ;;
    --)             shift; IMAGE_KEYS+=("$@"); break ;;
    -*)             die "Unknown flag: $1 (see --help)" ;;
    *)              IMAGE_KEYS+=("$1"); shift ;;
  esac
done

(( ${#IMAGE_KEYS[@]} >= 1 )) || die "Missing <image-key> (see --help)"
if [[ -n "$TAG_OVERRIDE" && ${#IMAGE_KEYS[@]} -gt 1 ]]; then
  die "--tag is only allowed with a single image-key; got ${#IMAGE_KEYS[@]} keys"
fi

command -v yq >/dev/null            || die "yq not on PATH"
command -v docker-build >/dev/null  || die "docker-build not on PATH"
$FLAG_SKIP_DEPLOY || command -v helm-upgrade >/dev/null \
  || die "helm-upgrade not on PATH"

_k8_require_yq
load_project_registry "${PROJECTS_DIR:-}"

# --- Resolve image → helm target from project.yaml --------------------------
resolve_image_helm() {
  local key="$1"
  local yaml helm_json
  local projects_dir="${PROJECTS_DIR:-$INFRA_ROOT/projects}"
  local -a project_yamls
  mapfile -t project_yamls < <(find "$projects_dir" -maxdepth 5 -name project.yaml 2>/dev/null)

  if [[ "$key" == */* ]]; then
    local domain="${key%%/*}" svc="${key#*/}"
    for yaml in "${project_yamls[@]}"; do
      [[ "$(yq -r '.type // ""' "$yaml" 2>/dev/null)" == "composite" ]] || continue
      helm_json="$(yq -o=json \
        ".projects[]? | select(.domain == \"$domain\") | .services[]? | select(.name == \"$svc\") | .helm // \"\"" \
        "$yaml" 2>/dev/null || true)"
      if [[ -n "$helm_json" && "$helm_json" != '""' && "$helm_json" != "null" ]]; then
        printf '%s\n%s\n' "$yaml" "$helm_json"
        return 0
      fi
    done
  else
    for yaml in "${project_yamls[@]}"; do
      helm_json="$(yq -o=json \
        ".docker.images[]? | select(.name == \"$key\") | .helm // \"\"" \
        "$yaml" 2>/dev/null || true)"
      if [[ -n "$helm_json" && "$helm_json" != '""' && "$helm_json" != "null" ]]; then
        printf '%s\n%s\n' "$yaml" "$helm_json"
        return 0
      fi
    done
  fi
  return 1
}

resolve_release_for_chart_path() {
  local target="$1" i=0
  while [[ $i -lt ${#PROJECT_RELEASES[@]} ]]; do
    local proj_full="${PROJECT_DIRS[$i]}/${PROJECT_CHART_PATHS[$i]%/}"
    proj_full="${proj_full%/}"
    if [[ "$proj_full" == "$INFRA_ROOT/${target%/}" ]] || \
       [[ "$proj_full" == "${target%/}" ]]; then
      echo "${PROJECT_RELEASES[$i]}"
      return 0
    fi
    i=$((i + 1))
  done
  echo ""
}

# --- Build parallel arrays describing each image's plan ---------------------
declare -a PLAN_KEYS PLAN_OWNING_YAML PLAN_CHART_PATH PLAN_RELEASE
declare -a PLAN_VALUES_FILE PLAN_YQ_PATH PLAN_FORMAT
declare -a PLAN_CURRENT PLAN_TARGET PLAN_NEW_TAG

for key in "${IMAGE_KEYS[@]}"; do
  resolved="$(resolve_image_helm "$key")" || \
    die "No project.yaml declares helm: for image '$key'."
  owning_yaml="$(echo "$resolved" | head -n1)"
  helm_json="$(echo "$resolved" | tail -n +2)"

  chart_path="$(echo "$helm_json" | yq -r '.chart_path // ""')"
  yq_path="$(echo "$helm_json" | yq -r '.values_path // ""')"
  fmt="$(echo "$helm_json" | yq -r '.format // "tag"')"

  [[ -z "$chart_path" ]] && die "$owning_yaml: helm.chart_path is required"
  [[ -z "$yq_path" ]]    && die "$owning_yaml: helm.values_path is required"
  [[ "$fmt" == "tag" || "$fmt" == "image" ]] \
    || die "$owning_yaml: helm.format must be 'tag' or 'image' (got '$fmt')"
  [[ "$yq_path" != .* ]] && yq_path=".$yq_path"

  values_file="$INFRA_ROOT/$chart_path/values.yaml"
  [[ -f "$values_file" ]] || die "values.yaml not found: $values_file"

  release="$(resolve_release_for_chart_path "$chart_path")"
  if ! $FLAG_SKIP_DEPLOY && [[ -z "$release" ]]; then
    die "Could not reverse-map chart_path '$chart_path' to a helm release"
  fi

  current_val="$(yq -r "${yq_path} // \"\"" "$values_file")"
  [[ -z "$current_val" || "$current_val" == "null" ]] && \
    die "values.yaml has no value at $yq_path in $values_file"

  if [[ "$fmt" == "image" ]]; then
    [[ "$current_val" == *:* ]] || die "Image string lacks tag: $current_val ($values_file)"
    cur_tag="${current_val##*:}"
  else
    cur_tag="$current_val"
  fi

  clean_cur="${cur_tag#v}"
  if [[ -n "$TAG_OVERRIDE" ]]; then
    build_vsn="$TAG_OVERRIDE"
  elif [[ "$clean_cur" =~ ^([0-9]+)\.([0-9]+)\.edge([-.].*)?$ ]] || \
       [[ "$clean_cur" =~ ^([0-9]+)\.([0-9]+)\.edge$ ]]; then
    build_vsn="v$clean_cur"
  elif [[ "$clean_cur" =~ ^([0-9]+)\.([0-9]+)\. ]]; then
    env_sfx=""
    env_val="${BUILD_ENV:-dev}"
    [[ "$env_val" != "prod" && "$env_val" != "production" ]] && env_sfx="-${env_val}"
    build_vsn="v${BASH_REMATCH[1]}.${BASH_REMATCH[2]}.edge${env_sfx}"
  else
    die "Cannot derive edge tag from current value '$cur_tag' in $values_file (need M.m.patch form)"
  fi

  PLAN_KEYS+=("$key")
  PLAN_OWNING_YAML+=("$owning_yaml")
  PLAN_CHART_PATH+=("$chart_path")
  PLAN_RELEASE+=("$release")
  PLAN_VALUES_FILE+=("$values_file")
  PLAN_YQ_PATH+=("$yq_path")
  PLAN_FORMAT+=("$fmt")
  PLAN_CURRENT+=("$current_val")
  PLAN_TARGET+=("auto (docker-push promotes edge → next patch)")
  PLAN_NEW_TAG+=("$build_vsn")
done

# --- Plan summary ------------------------------------------------------------
step "deploy-service plan (${#PLAN_KEYS[@]} image$([ ${#PLAN_KEYS[@]} -gt 1 ] && echo s))"
for i in "${!PLAN_KEYS[@]}"; do
  printf "  ${BOLD:-}[%d] %s${NC}\n" "$((i + 1))" "${PLAN_KEYS[$i]}"
  printf "      %-16s %s\n" "project.yaml"  "${PLAN_OWNING_YAML[$i]#$INFRA_ROOT/}"
  printf "      %-16s %s\n" "chart_path"    "${PLAN_CHART_PATH[$i]}"
  printf "      %-16s %s\n" "release"       "${PLAN_RELEASE[$i]:-<skip-deploy>}"
  printf "      %-16s %s\n" "values_path"   "${PLAN_YQ_PATH[$i]}"
  printf "      %-16s %s\n" "format"        "${PLAN_FORMAT[$i]}"
  printf "      %-16s %s\n" "current"       "${PLAN_CURRENT[$i]}"
  printf "      %-16s %s\n" "edge build"    "${PLAN_NEW_TAG[$i]}"
  printf "      %-16s %s\n" "target"        "${PLAN_TARGET[$i]}"
done
echo

UNIQUE_RELEASES=()
for rel in "${PLAN_RELEASE[@]}"; do
  [[ -z "$rel" ]] && continue
  seen=false
  for existing in "${UNIQUE_RELEASES[@]:-}"; do
    [[ "$existing" == "$rel" ]] && { seen=true; break; }
  done
  $seen || UNIQUE_RELEASES+=("$rel")
done
echo "  build step:  $($FLAG_SKIP_BUILD && echo 'skip (--skip-build)' || { s="docker-build --push --vsn <tag>"; $FLAG_NO_CACHE && s+=" --no-cache"; echo "$s × ${#PLAN_KEYS[@]}"; })"
if $FLAG_SKIP_DEPLOY; then
  echo "  deploy step: skip (--skip-deploy)"
else
  echo "  deploy step: helm-upgrade --include ${UNIQUE_RELEASES[*]:-<none>}"
fi
echo

run() {
  $FLAG_VERBOSE && echo "  \$ $*"
  if $FLAG_DRY_RUN; then
    echo "  [dry-run] $*"
    return 0
  fi
  "$@"
}

# --- Stage 1: build + push ---------------------------------------------------
export DOCKER_PUSH_HELM_UPDATE_MODE=yes

if ! $FLAG_SKIP_BUILD; then
  for i in "${!PLAN_KEYS[@]}"; do
    step "[$((i + 1))/${#PLAN_KEYS[@]}] Build & push ${PLAN_KEYS[$i]} (edge: ${PLAN_NEW_TAG[$i]})"
    build_args=(docker-build --push --multiarch --vsn "${PLAN_NEW_TAG[$i]}")
    $FLAG_NO_CACHE && build_args+=(--no-cache)
    build_args+=("${PLAN_KEYS[$i]}")
    run "${build_args[@]}" < /dev/null
    ok "${PLAN_KEYS[$i]} built + pushed (values.yaml rewritten by docker-push)"
  done
else
  warn "Skipping build (--skip-build)"
fi

# --- Stage 2: helm upgrade ---------------------------------------------------
if ! $FLAG_SKIP_DEPLOY; then
  for rel in "${UNIQUE_RELEASES[@]:-}"; do
    [[ -z "$rel" ]] && continue
    step "helm-upgrade --include $rel"
    run helm-upgrade --include "$rel"
    ok "$rel upgrade dispatched"
  done
else
  warn "Skipping deploy (--skip-deploy)"
fi

step "Done"
