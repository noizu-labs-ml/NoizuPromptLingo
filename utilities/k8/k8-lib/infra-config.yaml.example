# infra-config.yaml — Unified infrastructure config for k8-lib devops tools
# Copy to your project root and customize. This file is safe to commit.
#
# Contains structural/topology data (tiers, namespace overrides, timeouts,
# paths, patterns) and project build/deploy metadata.
#
# Scalar config (AWS, Docker, Helm, Infisical, etc.) lives in .envrc.k8.dc
# via direnv-config. See .envrc.k8.dc.example for the template.
#
# PATHS: All path values are resolved relative to this file's directory.

apiVersion: k8-lib/v1

# --- Paths (relative to this file) ------------------------------------------
paths:
  helm_dir: helm                          # Helm charts root
  terraform_dir: terraform                # Terraform root
  projects_dir: repos/incubator/projects  # project.yaml discovery root

# --- Cluster Status Patterns (grep -E regex) ---------------------------------
status_patterns:
  db: "(timescaledb|mysqldb|redis|valkey)"
  search: "(manticore|elasticsearch|opensearch)"
  app: "(backend|frontend|wordpress|api|admin)"
  net: "(pgbouncer|proxysql|haproxy)"
  infra: "(infisical|signoz|karpenter|nginx-ingress|lb-controller|cert-manager)"
  job: "(indexer|migrat|job)"

# --- Cluster Layout -----------------------------------------------------------
nodepool_labels:
  general: karpenter
  indexer: "karpenter:indexer"
  managed: eks

# --- Deploy One-Off -----------------------------------------------------------
placement_exclude_pattern: "aws-node|kube-proxy|ebs-csi-node|efs-csi-node|signoz-node-agent|nginx-ingress"

# --- Deployment Tiers ---------------------------------------------------------
# Tier N completes before tier N+1 begins. Charts within a tier run in parallel.
tiers:
  - name: "Secrets Management"
    tier: 0
    charts:
      - infisical
  - name: "Data & Observability"
    tier: 1
    charts:
      - shared-postgres
      - shared-redis
  # - name: "Platform & Admin"
  #   tier: 2
  #   charts:
  #     - cockpit
  #     - headlamp
  # - name: "Core Applications"
  #   tier: 3
  #   charts:
  #     - my-app

# --- Namespace Overrides ------------------------------------------------------
# chart-name: target-namespace
# Overrides namespace resolution for charts where global.namespace doesn't match.
namespace_overrides: {}
  # nginx-ingress: ingress-nginx
  # my-app: apps-ns

# --- Timeout Overrides --------------------------------------------------------
# chart-name: timeout
# Override the default 5m Helm upgrade timeout for specific charts.
timeout_overrides: {}
  # my-database: 30m
  # my-backend: 15m

# --- Helm Scan Directories ---------------------------------------------------
# Directories to scan for Helm charts (relative to this file).
helm_scan_dirs:
  - helm/platform
  - helm/apps
  - helm/data
  - helm/observability
  - helm/ai
  - helm/creative
  - helm/mail

# --- Chart Path Overrides -----------------------------------------------------
# Explicit chart-name → directory overrides (for non-standard locations).
chart_path_overrides: {}

# =============================================================================
# Project Registry — build/deploy metadata for portfolio projects
# =============================================================================
# project:
#   name: my-project
#   status: active                        # active | disabled | kickoff-only
#   type: composite                       # composite (multi-domain) or omit for flat
#   projects:
#     - domain: example.com
#       services:
#         - name: backend
#           dockerfile: app/backend/Dockerfile
#           context: app/backend
#           registry_path: example.com/backend
#           helm:
#             chart_path: helm/apps/example
#             values_path: .example.backend.image
#             format: image                # image (full URI) or tag (version only)
#       helm:
#         charts:
#           - name: example
#             path: helm/example
