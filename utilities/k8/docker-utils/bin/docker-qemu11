#!/usr/bin/env bash
# Register Debian unstable qemu-user-binfmt 11.x for amd64 emulation.
#
# This patches the Docker VM binfmt registration used by buildx/QEMU. It is
# intentionally separate from docker-build because it requires --privileged and
# may need to be rerun after Docker Desktop or OrbStack restarts.
set -euo pipefail

IMAGE="${DOCKER_QEMU11_INSTALLER_IMAGE:-debian:unstable-slim}"

usage() {
  cat <<'EOF'
docker-qemu11 - register QEMU 11.x binfmt for Docker amd64 emulation

Usage:
  docker-qemu11            install/replace qemu-x86_64 registration
  docker-qemu11 --check    show active qemu-x86_64 registration

Environment:
  DOCKER_QEMU11_INSTALLER_IMAGE=debian:unstable-slim

Notes:
  - Requires Docker privileged container support.
  - Rerun after Docker Desktop/OrbStack VM restarts.
  - This currently targets amd64-on-arm64, the failing Elixir build path.
EOF
}

check_registration() {
  docker run --privileged --rm "$IMAGE" sh -lc '
    set -e
    mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true
    if [ -r /proc/sys/fs/binfmt_misc/qemu-x86_64 ]; then
      cat /proc/sys/fs/binfmt_misc/qemu-x86_64
    else
      echo "qemu-x86_64 is not registered"
      exit 1
    fi
  '
}

install_registration() {
  docker run --privileged --rm "$IMAGE" sh -lc '
    set -e
    mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true
    apt-get update >/dev/null
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends qemu-user-binfmt >/dev/null
    qemu-x86_64 --version | head -1
    echo -1 > /proc/sys/fs/binfmt_misc/qemu-x86_64 2>/dev/null || true
    cat /usr/lib/binfmt.d/qemu-x86_64.conf > /proc/sys/fs/binfmt_misc/register
    echo "registered qemu-x86_64:"
    cat /proc/sys/fs/binfmt_misc/qemu-x86_64
  '
}

case "${1:-}" in
  -h|--help)
    usage
    ;;
  --check)
    check_registration
    ;;
  "")
    install_registration
    ;;
  *)
    echo "Unknown argument: $1" >&2
    usage >&2
    exit 2
    ;;
esac
