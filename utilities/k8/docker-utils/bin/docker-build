#!/usr/bin/env bash
# =============================================================================
# docker-build — Centralized Docker build for Docker services
#
# Usage:
#   docker-build                         # auto-detect repo from CWD
#   docker-build my-frontend             # explicit target
#   docker-build my-backend --push       # build then push
#   docker-build codefre.sh/backend      # incubator nested project
#   docker-build --silent                # suppress push prompt
#   docker-build --all                   # build all repos in parallel
#   docker-build --pick                  # interactive selection, parallel build
#   docker-build --all --push            # build all + push each
#   docker-build --pick --push           # pick + push
#   docker-build my-frontend --push --release  # build, push, update helm tag
#   docker-build --include my-backend,my-frontend --stage  # specific targets
#   docker-build --native my-frontend    # native arch only → local docker
#   docker-build --multiarch my-frontend # both linux/amd64+arm64
#   docker-build --platform linux/amd64,linux/arm64 my-frontend
#   docker-build --dev                   # dev build (next dev server, no prod optimization)
#   docker-build --vsn 3.2.edge my-img   # explicit version tag
#   docker-build --verbose my-img        # show docker command before running
#   docker-build --no-buildx             # plain docker build (amd64 only, no persistent cache)
#   docker-build --no-cache              # build without Docker layer cache
#   docker-build --no-zellij             # multi-build without zellij (background jobs + logs)
#   BUILD_ENV=prod docker-build          # production build
#
# Platforms (default = multi-arch amd64+arm64 when K8_DOCKER_MULTIARCH=true):
#   buildx cannot --load a multi-platform build into the local docker daemon
#   (unless containerd image store is enabled), so multi-arch builds use --push
#   to publish directly, or cache-only without --push.
#   Use --native for fast local iteration (single-arch, --load, no push).
#   Run `docker login ops.noizu.com` before the first multi-arch build.
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/docker-config.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"
[[ -f "${INFRA_ROOT}/docker-hooks.sh" ]] && source "${INFRA_ROOT}/docker-hooks.sh"

# --- Colours (supplement k8-lib's common.sh if available) --------------------
# k8-lib common.sh provides step/ok/warn/fail/info/die, but we need banner()
# and the raw colour vars for inline use. Define everything; harmless if
# already set.
RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'
BLU=$'\033[0;34m'; CYN=$'\033[0;36m'; NC=$'\033[0m'
BOLD=$'\033[1m'

# Override k8-lib helpers with richer versions that match the local style
banner()  { echo -e "\n${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; echo -e "${BLU}${BOLD}  $1${NC}"; echo -e "${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; }
step()    { echo -e "\n${BLU}▶ $1${NC}"; }
ok()      { echo -e "  ${GRN}✅ $1${NC}"; }
warn()    { echo -e "  ${YEL}⚠️  $1${NC}"; }
fail()    { echo -e "  ${RED}❌ $1${NC}"; }
info()    { echo -e "  ${CYN}ℹ️  $1${NC}"; }
die()     { echo -e "\n${RED}❌ $1${NC}\n"; exit 1; }

# --- Log directory -----------------------------------------------------------
LOG_DIR="${INFRA_ROOT}/.tmp/docker-build-logs"
mkdir -p "$LOG_DIR"

# =============================================================================
# Usage / Help
# =============================================================================
usage() {
cat <<EOF

  ${BLU}docker-build${NC} — Build Docker images for Noizu services

  ${BLU}Usage:${NC}
    docker-build [flags] [image]

  ${BLU}Flags:${NC}
    --all              Build all known images (parallel via zellij or background)
    --pick             Interactive selection from known images
    --include LIST     Comma-separated list of specific targets (supports globs: startapp/*)
    --native           Native arch only — local docker (no push)
    --multiarch        Build both linux/amd64 and linux/arm64 (opt-in)
    --platform LIST    Explicit platform list (e.g. linux/amd64,linux/arm64)
    --push             Auto-push to registry after build
    --silent           Suppress push prompt
    --no-buildx        Disable buildx (legacy single-arch docker build)
    --dev              Target the "dev" stage in multi-stage Dockerfile
    --stage            Set BUILD_ENV=stage
    --prod             Set BUILD_ENV=prod
    --env ENV, --env=ENV  Set BUILD_ENV to a custom value
    --vsn VERSION      Explicit version tag (e.g., 3.2.edge, v1.0.edge-stage)
    --no-cache         Build with --no-cache
    --no-zellij        Multi-build without zellij (background jobs + logs)
    --release          Pass --release to docker-push (update helm tag)
    --dry-run          Show what would be built without executing
    --verbose, -v      Show the exact docker command before running
    --publish-chart    Auto-publish helm chart to OCI registry after push
    --no-publish-chart Skip helm chart publish prompt after push
    --yes, -y          Auto-confirm all prompts
    --config <path>    Use alternate k8-lib config file
    -h, --help         Show this help

  ${BLU}Default behavior:${NC}
    Builds ${BOLD}linux/amd64 + linux/arm64${NC} (multiarch) when K8_DOCKER_MULTIARCH=true
    in .envrc.k8.dc (default). Uses QEMU on arm64 hosts.
    Use ${BOLD}--native${NC} to build for the host arch only (fast local iteration).

  ${BLU}Environment:${NC}
    K8_DOCKER_MULTIARCH=true/false          Default multiarch mode (.envrc.k8.dc)
    DOCKER_BUILD_QUIET_CONTAINERD_NUDGE=1   Silence the containerd-store nudge
    DOCKER_YES=true                         Auto-confirm prompts

  ${BLU}Examples:${NC}
    docker-build                           # auto-detect from CWD
    docker-build bottlecrm                 # explicit target
    docker-build codefre.sh/backend        # incubator nested project
    docker-build --push webstudio-builder  # build + push
    docker-build --all                     # build everything
    docker-build --pick --push             # pick interactively, push after
    docker-build --native bottlecrm        # native arch only, fast local
    docker-build --dev --vsn 2.1.edge-dev excalidraw

EOF
}

# =============================================================================
# Parse flags
# =============================================================================
SILENT=false
AUTO_PUSH=false
BUILD_ALL=false
BUILD_PICK=false
DEV_BUILD=false
USE_BUILDX=true
NO_CACHE=false
NO_ZELLIJ=false
FLAG_DRY_RUN=false
FLAG_VERBOSE=false
FLAG_NATIVE_ONLY=false
FLAG_MULTIARCH="${K8_DOCKER_MULTIARCH:-true}"
EXPLICIT_VSN=""
EXPLICIT_PLATFORMS=""
INCLUDE_LIST=""
TARGET=""
PUSH_PASSTHROUGH=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --silent)  SILENT=true ;;
    --push)    AUTO_PUSH=true ;;
    --dry-run) FLAG_DRY_RUN=true; PUSH_PASSTHROUGH+=(--dry-run) ;;
    -up)       PUSH_PASSTHROUGH+=(-up) ;;
    --verbose|-v) FLAG_VERBOSE=true; PUSH_PASSTHROUGH+=(--verbose) ;;
    --yes|-y)  export DOCKER_YES=true; export AUTO_YES=true; PUSH_PASSTHROUGH+=(-y) ;;
    --all)     BUILD_ALL=true ;;
    --pick)    BUILD_PICK=true ;;
    --dev)     DEV_BUILD=true ;;
    --stage)   export BUILD_ENV=stage ;;
    --prod)    export BUILD_ENV=prod ;;
    --env=*)   export BUILD_ENV="${1#--env=}" ;;
    --env)     export BUILD_ENV="$2"; shift ;;
    --no-buildx) USE_BUILDX=false ;;
    --no-cache)  NO_CACHE=true ;;
    --no-zellij) NO_ZELLIJ=true ;;
    --release) PUSH_PASSTHROUGH+=(--release) ;;
    --native)    FLAG_NATIVE_ONLY=true ;;
    --multiarch) FLAG_MULTIARCH=true ;;
    --platform)  EXPLICIT_PLATFORMS="$2"; shift ;;
    --vsn)       EXPLICIT_VSN="$2"; shift ;;
    --publish-chart)    export DOCKER_PUSH_HELM_PUBLISH_MODE=yes ;;
    --no-publish-chart) export DOCKER_PUSH_HELM_PUBLISH_MODE=no ;;
    --config) shift ;;
    --config=*) ;;
    --include=*) INCLUDE_LIST="${1#--include=}" ;;
    --include)   INCLUDE_LIST="$2"; shift ;;
    -h|--help)   usage; exit 0 ;;
    -*)          warn "Unknown flag: $1" ;;
    *)
      if [[ -z "$TARGET" ]]; then
        if resolved=$(normalize_repo_name "$1"); then
          TARGET="$resolved"
        else
          die "Unknown target: $1\n   Known repos: $(get_all_docker_repos 2>/dev/null | tr '\n' ' ')"
        fi
      fi
      ;;
  esac
  shift
done

# =============================================================================
# Platform resolution
# =============================================================================
_detect_native_platform() {
  local arch
  arch="$(uname -m)"
  case "$arch" in
    x86_64|amd64)  echo "linux/amd64" ;;
    aarch64|arm64) echo "linux/arm64" ;;
    *)             echo "linux/amd64" ;;  # conservative default
  esac
}

# _has_containerd_image_store — true if docker daemon uses containerd
#   snapshotter (supports multi-arch --load).
_has_containerd_image_store() {
  docker info --format '{{.DriverStatus}}' 2>/dev/null \
    | grep -q 'io.containerd.snapshotter'
}

# _nudge_containerd_store — colorful one-shot notice about enabling
#   containerd image store. Suppress via: DOCKER_BUILD_QUIET_CONTAINERD_NUDGE=1
_NUDGE_PRINTED=false
_nudge_containerd_store() {
  [[ "${DOCKER_BUILD_QUIET_CONTAINERD_NUDGE:-}" == "1" ]] && return 0
  $_NUDGE_PRINTED && return 0
  _NUDGE_PRINTED=true
  echo ""
  echo -e "${YEL}${BOLD}╔═══════════════════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${YEL}${BOLD}║  🐳  Classic docker image store detected (no containerd snapshotter)      ║${NC}"
  echo -e "${YEL}${BOLD}╚═══════════════════════════════════════════════════════════════════════════╝${NC}"
  echo -e "   ${CYN}✨  Enable the containerd image store to load full multi-arch manifests"
  echo -e "       into the local daemon in one pass (today we do a native-arch fallback)."
  echo ""
  echo -e "       🖥️   ${BOLD}Docker Desktop:${NC}  Settings → General →"
  echo -e "                            '☑ Use containerd for pulling and storing images'"
  echo -e "       🐧  ${BOLD}Linux Engine:${NC}    /etc/docker/daemon.json →"
  echo -e "                            ${BOLD}\"features\": { \"containerd-snapshotter\": true }${NC}"
  echo -e "                            sudo systemctl restart docker"
  echo -e "       📚  ${BOLD}Docs:${NC}            https://docs.docker.com/engine/storage/containerd/"
  echo ""
  echo -e "       🔕  ${CYN}Silence:${NC} ${BOLD}export DOCKER_BUILD_QUIET_CONTAINERD_NUDGE=1${NC}"
  echo ""
}

# Detect daemon capability once up front
HAS_CONTAINERD_STORE=false
if ! $FLAG_DRY_RUN; then
  _has_containerd_image_store && HAS_CONTAINERD_STORE=true
fi

# Resolve target platforms
if [[ -n "$EXPLICIT_PLATFORMS" ]]; then
  TARGET_PLATFORMS="$EXPLICIT_PLATFORMS"
elif $FLAG_NATIVE_ONLY; then
  TARGET_PLATFORMS="$(_detect_native_platform)"
elif [[ "$FLAG_MULTIARCH" == "true" ]]; then
  TARGET_PLATFORMS="linux/amd64,linux/arm64"
else
  TARGET_PLATFORMS="linux/amd64"
fi

MULTI_PLATFORM=false
if [[ "$TARGET_PLATFORMS" == *","* ]]; then
  MULTI_PLATFORM=true
fi

# =============================================================================
# Buildx builder provisioning for multi-platform builds
# =============================================================================
BUILDX_BUILDER_NAME="${BUILDX_BUILDER_NAME:-noizu-multi}"

_ensure_buildx_builder() {
  $USE_BUILDX || return 0
  $MULTI_PLATFORM || return 0

  local current_driver
  current_driver=$(docker buildx inspect 2>/dev/null | awk '/^Driver:/ {print $2; exit}') || true
  if [[ "$current_driver" == "docker-container" || "$current_driver" == "kubernetes" || "$current_driver" == "remote" ]]; then
    return 0
  fi

  if docker buildx inspect "$BUILDX_BUILDER_NAME" >/dev/null 2>&1; then
    info "Activating buildx builder: ${BUILDX_BUILDER_NAME}"
    docker buildx use "$BUILDX_BUILDER_NAME" 2>/dev/null || {
      warn "Builder '${BUILDX_BUILDER_NAME}' exists but failed to activate — recreating"
      docker buildx rm "$BUILDX_BUILDER_NAME" 2>/dev/null || true
      docker buildx create \
        --name "$BUILDX_BUILDER_NAME" \
        --driver docker-container \
        --use \
        --bootstrap \
        >/dev/null || die "Failed to create buildx builder '${BUILDX_BUILDER_NAME}'"
      ok "Builder recreated: ${BUILDX_BUILDER_NAME}"
    }
  else
    step "Creating buildx builder '${BUILDX_BUILDER_NAME}' (docker-container driver)"
    docker buildx create \
      --name "$BUILDX_BUILDER_NAME" \
      --driver docker-container \
      --use \
      --bootstrap \
      >/dev/null || die "Failed to create buildx builder '${BUILDX_BUILDER_NAME}'"
    ok "Builder ready: ${BUILDX_BUILDER_NAME}"
  fi
}

_ensure_buildx_builder

# =============================================================================
# Validate flag combinations
# =============================================================================
BUILD_INCLUDE=false
if [[ -n "$INCLUDE_LIST" ]]; then
  BUILD_INCLUDE=true
fi

_multi_count=0
$BUILD_ALL && ((_multi_count++)) || true
$BUILD_PICK && ((_multi_count++)) || true
$BUILD_INCLUDE && ((_multi_count++)) || true
if (( _multi_count > 1 )); then
  die "--all, --pick, and --include are mutually exclusive"
fi

if [[ -n "$TARGET" ]] && ($BUILD_ALL || $BUILD_PICK || $BUILD_INCLUDE); then
  die "Cannot specify a target with --all, --pick, or --include"
fi

# =============================================================================
# Elixir / BEAM build diagnostics
# =============================================================================
_is_elixir_dockerfile() {
  local dockerfile="$1"
  grep -Eq '^(FROM|ARG[[:space:]]+BASE_IMAGE=).*elixir:' "$dockerfile"
}

_has_qemu_safe_beam_jit() {
  local dockerfile="$1"
  grep -Eq 'ERL_AFLAGS=.*\+JMsingle[[:space:]]+true' "$dockerfile"
}

_has_scheduler_cap() {
  local dockerfile="$1"
  grep -Eq '(^ENV[[:space:]]+ERL_FLAGS=.*\+S[[:space:]]+[0-9]+:[0-9]+|^ENV[[:space:]]+ELIXIR_ERL_OPTIONS=.*\+S[[:space:]]+[0-9]+:[0-9]+|ERL_FLAGS="\+S[[:space:]]+[0-9]+:[0-9]+")' "$dockerfile"
}

_is_cross_platform_build() {
  local platforms="$1"
  local native
  native="$(_detect_native_platform)"
  [[ "$platforms" == *","* || "$platforms" != "$native" ]]
}

_buildx_stack_summary() {
  local buildx_version buildkit_version
  buildx_version="$(docker buildx version 2>/dev/null | awk '{print $2}' || true)"
  buildkit_version="$(docker buildx inspect 2>/dev/null | awk '/^BuildKit version:/ {print $3; exit}' || true)"
  [[ -n "$buildx_version$buildkit_version" ]] || return 0
  echo "buildx=${buildx_version:-unknown} buildkit=${buildkit_version:-unknown}"
}

# =============================================================================
# _build_single — Core build logic for one image
# =============================================================================
_build_single() {
  local image="$1"
  local repo_dir
  repo_dir="$(get_repo_dir "$image")"

  if [[ ! -d "$repo_dir" ]]; then
    fail "Repo directory not found: $repo_dir"
    return 1
  fi

  # --- Per-image platform override ---
  local TARGET_PLATFORMS="$TARGET_PLATFORMS"
  local MULTI_PLATFORM="$MULTI_PLATFORM"
  if declare -f _platform_for_image &>/dev/null; then
    local _img_platform
    _img_platform="$(_platform_for_image "$image")"
    if [[ -n "$_img_platform" ]]; then
      TARGET_PLATFORMS="$_img_platform"
      MULTI_PLATFORM=false
      [[ "$TARGET_PLATFORMS" == *","* ]] && MULTI_PLATFORM=true
    fi
  fi

  # --- Resolve registry path ---
  local registry_path
  if declare -f _registry_path_for_image &>/dev/null; then
    registry_path="$(_registry_path_for_image "$image")"
  else
    registry_path="$image"
  fi
  local full_image="${REGISTRY}/${registry_path}"

  banner "Building: ${image}"
  info "Registry path : ${full_image}"
  info "Source dir     : ${repo_dir}"

  cd "$repo_dir"

  # --- Version setup ---
  local vsn_major=${VSN_MAJOR:-${DEFAULT_VSN_MAJOR:-1}}
  local vsn_minor=${VSN_MINOR:-${DEFAULT_VSN_MINOR:-0}}
  local vsn_sub=${VSN_SUB:-edge}
  local build_env=${BUILD_ENV:-dev}

  local git_sha timestamp build_vsn
  git_sha=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")
  timestamp=$(date +%Y%m%d%H%M%S)

  # --- Version tag ---
  local env_suffix=""
  if [[ "$build_env" != "prod" && "$build_env" != "production" ]]; then
    env_suffix="-${build_env}"
  fi

  if [[ -n "$EXPLICIT_VSN" ]]; then
    local clean_vsn="${EXPLICIT_VSN#v}"
    build_vsn="v${clean_vsn}"
  else
    build_vsn="v${vsn_major}.${vsn_minor}.${vsn_sub}${env_suffix}"
  fi

  local tags=(
    "${full_image}:latest"
    "${full_image}:${git_sha}"
    "${full_image}:${timestamp}-${git_sha}"
    "${full_image}:${build_vsn}"
  )

  # --- Resolve Dockerfile ---
  local dockerfile_flag=()
  local dockerfile_path="${repo_dir}/Dockerfile"
  local custom_df
  custom_df="$(_dockerfile_for_image "$image")"
  if [[ -n "$custom_df" ]]; then
    local df_path="${repo_dir}/${custom_df}"
    if [[ -f "$df_path" ]]; then
      dockerfile_path="$df_path"
      dockerfile_flag=(-f "$df_path")
      info "Dockerfile     : ${custom_df}"
    else
      fail "Dockerfile not found: ${df_path}"
      return 1
    fi
  else
    if [[ ! -f "${repo_dir}/Dockerfile" ]]; then
      fail "No Dockerfile in ${repo_dir}"
      return 1
    fi
    dockerfile_path="${repo_dir}/Dockerfile"
    info "Dockerfile     : Dockerfile (default)"
  fi

  if _is_elixir_dockerfile "$dockerfile_path"; then
    info "Elixir build   : detected"
    if _is_cross_platform_build "$TARGET_PLATFORMS"; then
      local stack_summary
      stack_summary="$(_buildx_stack_summary)"
      [[ -n "$stack_summary" ]] && info "Buildx stack   : $stack_summary"
      if ! _has_qemu_safe_beam_jit "$dockerfile_path"; then
        warn "Elixir cross-arch build lacks ERL_AFLAGS='+JMsingle true'"
      fi
      if ! _has_scheduler_cap "$dockerfile_path"; then
        warn "Elixir cross-arch build lacks a BEAM scheduler cap"
      fi
      info "QEMU 11 helper : docker-qemu11 registers Debian qemu-user-binfmt 11.x"
    fi
  fi

  # --- Per-repo build args ---
  local build_args=()

  # Try YAML-based build args first (incubator pattern)
  if declare -f _get_build_args &>/dev/null; then
    local yaml_build_args=()
    while IFS= read -r arg_line; do
      [[ -n "$arg_line" ]] && yaml_build_args+=("$arg_line")
    done < <(_get_build_args "$image")
    if [[ ${#yaml_build_args[@]} -gt 0 ]]; then
      build_args+=("${yaml_build_args[@]}")
      info "Build args     : ${#yaml_build_args[@]} from project.yaml"
    fi
  fi

  # Per-repo build args — override _build_args_for_image in docker-hooks.sh
  if declare -f _build_args_for_image &>/dev/null; then
    _build_args_for_image "$image" "$build_env" build_args
  fi

  # --- Secret injection for frontend builds (npm registry auth) ---
  local secret_flags=()
  if [[ "$image" =~ /frontend$ ]]; then
    # Resolve NPM_TOKEN: env var → ~/.npmrc extraction
    if [[ -z "${NPM_TOKEN:-}" ]]; then
      NPM_TOKEN="$(grep '//npm.noizu.com/:_authToken=' ~/.npmrc 2>/dev/null | sed 's/.*_authToken=//' | tr -d '"' || true)"
    fi
    if [[ -n "${NPM_TOKEN:-}" ]]; then
      export NPM_TOKEN
      secret_flags=(--secret id=npm_token,env=NPM_TOKEN)
      info "Secret         : npm_token (Verdaccio auth)"
    else
      warn "No NPM_TOKEN found — private @noizu packages will fail to install"
    fi
  fi

  # --- Target stage (dev vs production) ---
  local target_flag=()
  if _is_single_stage "$image"; then
    : # single-stage Dockerfile, no --target needed
  elif $DEV_BUILD; then
    target_flag=(--target dev)
    info "Target stage   : dev"
  else
    target_flag=(--target production)
  fi

  # --- No-cache flag ---
  local nocache_flag=()
  if $NO_CACHE; then
    nocache_flag=(--no-cache)
    info "No-cache       : forcing full rebuild"
  fi

  # --- Tags ---
  local tag_args=()
  for tag in "${tags[@]}"; do
    tag_args+=(-t "$tag")
  done

  step "Tags"
  for tag in "${tags[@]}"; do
    echo "     ${tag}"
  done

  # --- Assemble the final build command ---
  local CMD=()
  local OUTPUT_MODE=""

  export DOCKER_BUILDKIT=1

  if $USE_BUILDX; then
    # buildx: multi-platform with persistent local cache
    local cache_dir="${INFRA_ROOT}/.tmp/buildx-cache/${image}"
    mkdir -p "$cache_dir"
    local cache_flags=(
      --cache-from "type=local,src=${cache_dir}"
      --cache-to   "type=local,dest=${cache_dir},mode=max"
    )
    if $NO_CACHE; then
      cache_flags=(--cache-to "type=local,dest=${cache_dir},mode=max")
    fi

    CMD=(docker buildx build --platform "$TARGET_PLATFORMS")

    # Output mode:
    #   --push        → publish multi-arch manifest to the registry
    #   multi + !push → build both arches into buildx cache only; no --load
    #                   (classic docker store can't --load multi-arch, and we
    #                   want the follow-up push confirmation to be instant)
    #   single        → --load: runnable image in local docker
    if $AUTO_PUSH; then
      CMD+=("${cache_flags[@]}" --push)
      OUTPUT_MODE="push"
    elif $MULTI_PLATFORM; then
      CMD+=("${cache_flags[@]}")
      # Multi-platform without --push: cache only
      # (--load only works for multi-arch with containerd image store)
      OUTPUT_MODE="cache"
      if ! $HAS_CONTAINERD_STORE; then
        _nudge_containerd_store
      fi
    else
      # --load (native): skip cache export on classic docker driver
      if $HAS_CONTAINERD_STORE; then
        CMD+=("${cache_flags[@]}")
      fi
      CMD+=(--load)
      OUTPUT_MODE="load"
    fi
  else
    # --no-buildx: plain docker build, uses BuildKit layer cache
    CMD=(docker build --platform "$TARGET_PLATFORMS")
    OUTPUT_MODE="legacy"
  fi

  CMD+=(
    "${nocache_flag[@]+"${nocache_flag[@]}"}"
    "${target_flag[@]}"
    "${dockerfile_flag[@]+"${dockerfile_flag[@]}"}"
    "${build_args[@]+"${build_args[@]}"}"
    "${secret_flags[@]+"${secret_flags[@]}"}"
    "${tag_args[@]}"
    "$repo_dir"
  )

  # --- Show plan: platforms + output mode ---
  info "Platforms      : ${TARGET_PLATFORMS}"
  info "Output mode    : ${OUTPUT_MODE}"

  # --- Dry run exit ---
  if $FLAG_DRY_RUN; then
    step "Dry run — would execute:"
    echo "     ${CMD[*]}"
    return 0
  fi

  # --- Verbose: show the actual command before executing ---
  if $FLAG_VERBOSE; then
    step "Executing command:"
    echo "     ${CMD[*]}"
    echo ""
  fi

  # --- Execute build ---
  step "Building..."
  local BUILD_START
  BUILD_START=$(date +%s)

  "${CMD[@]}"

  local BUILD_END
  BUILD_END=$(date +%s)
  local BUILD_DURATION=$(( BUILD_END - BUILD_START ))
  ok "Build completed in ${BUILD_DURATION}s"

  echo ""
  ok "Done: ${image} (${git_sha})"
  echo ""
  echo "  Built and tagged:"
  printf '    %s\n' "${tags[@]}"
  echo ""

  # --- Record build state ---
  save_build_state "$image" "$git_sha" "$build_vsn"

  # Expose to caller (single-build mode only — subshells won't propagate)
  _BUILT_SHA="$git_sha"
  _BUILT_VSN="$build_vsn"

  return 0
}

# =============================================================================
# Resolve build targets
# =============================================================================
TARGETS=()

if $BUILD_ALL; then
  TARGETS=($(get_all_docker_repos 2>/dev/null))
  [[ ${#TARGETS[@]} -eq 0 ]] && die "No docker repos discovered"
  echo "Building all repos: ${TARGETS[*]}"

elif $BUILD_INCLUDE; then
  IFS=',' read -ra _inc_items <<< "$INCLUDE_LIST"
  for item in "${_inc_items[@]}"; do
    item="${item## }"; item="${item%% }"
    # Glob expansion: "startapp/*" matches all repos prefixed with "startapp/"
    if [[ "$item" == *'*'* || "$item" == *'?'* ]]; then
      _glob_matched=false
      for repo in "${DOCKER_REPOS[@]}"; do
        # shellcheck disable=SC2053
        if [[ "$repo" == $item ]]; then
          TARGETS+=("$repo")
          _glob_matched=true
        fi
      done
      if ! $_glob_matched; then
        die "No repos matched glob pattern: $item\n   Known repos: $(get_all_docker_repos 2>/dev/null | tr '\n' ' ')"
      fi
    elif resolved=$(normalize_repo_name "$item"); then
      TARGETS+=("$resolved")
    else
      die "Unknown target in --include: $item\n   Known repos: $(get_all_docker_repos 2>/dev/null | tr '\n' ' ')"
    fi
  done
  echo "Building: ${TARGETS[*]}"

elif $BUILD_PICK; then
  # --- Interactive pick (toggle list) ---
  SELECTED=()
  ALL_REPOS=($(get_all_docker_repos 2>/dev/null))
  [[ ${#ALL_REPOS[@]} -eq 0 ]] && die "No docker repos discovered"

  for _repo in "${ALL_REPOS[@]}"; do
    SELECTED+=(false)
  done

  echo ""
  echo "  ${BLU}Select repos to build:${NC}"
  for i in "${!ALL_REPOS[@]}"; do
    echo "  [ ] $((i+1))) ${ALL_REPOS[$i]}"
  done
  echo ""
  echo "Toggle by number, 'a' = all, 'n' = none, Enter = go, 'q' = quit"

  while true; do
    read -r -p "> " input
    [[ "$input" == "q" ]] && { echo "Aborted."; exit 0; }
    [[ -z "$input" ]] && break

    if [[ "$input" == "a" ]]; then
      for i in "${!SELECTED[@]}"; do SELECTED[$i]=true; done
    elif [[ "$input" == "n" ]]; then
      for i in "${!SELECTED[@]}"; do SELECTED[$i]=false; done
    elif [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 1 && input <= ${#ALL_REPOS[@]} )); then
      ti=$((input - 1))
      if [[ "${SELECTED[$ti]}" == "true" ]]; then
        SELECTED[$ti]=false
      else
        SELECTED[$ti]=true
      fi
    fi

    # Redisplay
    for i in "${!ALL_REPOS[@]}"; do
      mark="[ ]"
      [[ "${SELECTED[$i]}" == "true" ]] && mark="[x]"
      echo "  ${mark} $((i+1))) ${ALL_REPOS[$i]}"
    done
  done

  for i in "${!ALL_REPOS[@]}"; do
    if [[ "${SELECTED[$i]}" == "true" ]]; then
      TARGETS+=("${ALL_REPOS[$i]}")
    fi
  done

  if (( ${#TARGETS[@]} == 0 )); then
    echo "No repos selected."
    exit 0
  fi

  echo ""
  echo "Building: ${TARGETS[*]}"

elif [[ -n "$TARGET" ]]; then
  TARGETS=("$TARGET")

else
  # --- Auto-detect from CWD ---
  ORIGINAL_DIR="$(pwd)"
  if detect_docker_repo "$ORIGINAL_DIR"; then
    TARGETS=("$DETECTED_REPO")
    info "Auto-detected image: ${DETECTED_REPO}"
  else
    die "Could not detect a Docker project from $(pwd)\n   Specify an image name or use --all / --pick"
  fi
fi

# =============================================================================
# Upfront push decision
#
# Without this, a default (non --push) run builds into buildx cache, prompts
# to push, then re-execs the script with --push — causing buildx to redo the
# export-and-push pass. Asking once up front collapses it to a single buildx
# invocation with the correct output mode.
# =============================================================================
ASKED_UPFRONT=false
if ! $AUTO_PUSH && ! $FLAG_DRY_RUN && ! $SILENT && [[ -t 0 ]]; then
  if [[ ${#TARGETS[@]} -eq 1 ]]; then
    _upfront_prompt="Push ${TARGETS[0]} to ${REGISTRY} after successful build?"
  else
    _upfront_prompt="Push ${#TARGETS[@]} images to ${REGISTRY} after successful build?"
  fi
  echo ""
  if _confirm "$_upfront_prompt"; then
    AUTO_PUSH=true
  fi
  ASKED_UPFRONT=true
fi

# =============================================================================
# SINGLE-BUILD MODE
# =============================================================================
if [[ ${#TARGETS[@]} -eq 1 ]]; then
  ORIGINAL_DIR="$(pwd)"
  IMAGE="${TARGETS[0]}"

  _build_single "$IMAGE"

  cd "$ORIGINAL_DIR"

  # Export so docker-push can pick these up in the same invocation
  export LAST_BUILD_IMAGE="$IMAGE"
  export LAST_BUILD_SHA="${_BUILT_SHA:-}"
  export LAST_BUILD_VSN="${_BUILT_VSN:-}"

  # --- Push handling ---
  if $AUTO_PUSH && $MULTI_PLATFORM; then
    # buildx --push already published the multi-arch manifest. Hand off to
    # docker-push in --remote mode so it can resolve the next patch version
    # and attach :v<M>.<m>.N[-env] via `buildx imagetools create`.
    info "Multi-arch manifest pushed to ${REGISTRY}"
    echo ""
    docker-push --remote "$IMAGE" "${_BUILT_VSN:-}" \
      "${PUSH_PASSTHROUGH[@]+"${PUSH_PASSTHROUGH[@]}"}"

  elif $AUTO_PUSH; then
    # Single-arch + --push: buildx --push published directly to registry.
    # Hand off in --remote mode with the edge VSN.
    info "Single-arch manifest pushed to ${REGISTRY}"
    echo ""
    docker-push --remote "$IMAGE" "${_BUILT_VSN:-}" \
      "${PUSH_PASSTHROUGH[@]+"${PUSH_PASSTHROUGH[@]}"}"

  elif ! $SILENT; then
    # No --push: image is locally loaded (single-arch) or cached (multi-arch).
    if $MULTI_PLATFORM; then
      info "Multi-arch build cached (${TARGET_PLATFORMS}); push will reuse cache"
    else
      info "Native image loaded into local docker (${TARGET_PLATFORMS})"
    fi
    echo ""
    if $ASKED_UPFRONT; then
      # User already declined the upfront prompt — do not re-ask.
      echo "To push later:  docker-build --push ${IMAGE}"
    elif _confirm "Push ${IMAGE} to ${REGISTRY}?"; then
      exec "$0" --push "$IMAGE"
    else
      echo "To push later:  docker-build --push ${IMAGE}"
    fi
  fi

  exit 0
fi

# =============================================================================
# MULTI-BUILD MODE (--all, --pick, or --include)
# =============================================================================

# --- Build passthrough flags for zellij panes --------------------------------
PANE_FLAGS=""
$AUTO_PUSH && PANE_FLAGS+=" --push"
$SILENT && PANE_FLAGS+=" --silent"
$DEV_BUILD && PANE_FLAGS+=" --dev"
$NO_CACHE && PANE_FLAGS+=" --no-cache"
! $USE_BUILDX && PANE_FLAGS+=" --no-buildx"
$FLAG_NATIVE_ONLY && PANE_FLAGS+=" --native"
[[ "$FLAG_MULTIARCH" == "true" ]] && ! $FLAG_NATIVE_ONLY && [[ -z "$EXPLICIT_PLATFORMS" ]] && PANE_FLAGS+=" --multiarch"
[[ -n "$EXPLICIT_PLATFORMS" ]] && PANE_FLAGS+=" --platform ${EXPLICIT_PLATFORMS}"
[[ -n "${BUILD_ENV:-}" ]] && PANE_FLAGS+=" --env=${BUILD_ENV}"
[[ -n "$EXPLICIT_VSN" ]] && PANE_FLAGS+=" --vsn ${EXPLICIT_VSN}"
$FLAG_VERBOSE && PANE_FLAGS+=" --verbose"
[[ "${DOCKER_YES:-}" == "true" ]] && PANE_FLAGS+=" --yes"
for pt in "${PUSH_PASSTHROUGH[@]+"${PUSH_PASSTHROUGH[@]}"}"; do
  PANE_FLAGS+=" ${pt}"
done

# --- Zellij multi-build mode ------------------------------------------------
if command -v zellij &>/dev/null && ! $NO_ZELLIJ && (( ${#TARGETS[@]} > 1 )); then
  SESSION_NAME="build-$(date +%H%M%S)"
  layout_file="/tmp/docker-build-zj-$(head -c6 /dev/urandom | base64 | tr -dc 'a-zA-Z0-9' | head -c8).kdl"

  {
    echo "layout {"
    echo "  tab name=\"builds\" {"
    for image in "${TARGETS[@]}"; do
      echo "    pane name=\"${image}\" {"
      echo "      command \"bash\""
      echo "      args \"-c\" \"docker-build ${image}${PANE_FLAGS}; exec bash\""
      echo "    }"
    done
    echo "  }"
    echo "}"
  } > "$layout_file"

  echo ""
  echo "Launching zellij session '${SESSION_NAME}' with ${#TARGETS[@]} pane(s)..."

  unset ZELLIJ ZELLIJ_SESSION_NAME
  zellij -s "$SESSION_NAME" -n "$layout_file"
  rm -f "$layout_file"
  exit 0
fi

# --- Fallback: parallel builds (no zellij) ----------------------------------
banner "Building ${#TARGETS[@]} images"
echo ""
for img in "${TARGETS[@]}"; do
  echo "     • ${img}"
done
echo ""

RUN_TS=$(date +%Y%m%d-%H%M%S)
PIDS=()
LOG_FILES=()

step "Starting parallel builds..."
echo ""
for image in "${TARGETS[@]}"; do
  log_file="${LOG_DIR}/${image//\//_}-${RUN_TS}.log"
  LOG_FILES+=("$log_file")
  echo "  Starting ${image} → ${log_file}"

  ( _build_single "$image" ) > "$log_file" 2>&1 &
  PIDS+=($!)
done

echo ""
echo "Waiting for ${#PIDS[@]} parallel build(s)..."
echo ""

# --- Wait and collect results ------------------------------------------------
RESULTS=()
for i in "${!PIDS[@]}"; do
  if wait "${PIDS[$i]}"; then
    RESULTS+=("ok")
  else
    RESULTS+=("fail")
  fi
done

# --- Summary -----------------------------------------------------------------
FAILED=()
SUCCEEDED=()

banner "Build Summary"
for i in "${!TARGETS[@]}"; do
  image="${TARGETS[$i]}"
  log="${LOG_FILES[$i]}"
  if [[ "${RESULTS[$i]}" == "ok" ]]; then
    ok "${image}  →  ${log##*/}"
    SUCCEEDED+=("$image")
  else
    fail "${image}  →  ${log##*/}"
    FAILED+=("$image")
  fi
done
echo ""
echo "  ${#SUCCEEDED[@]} succeeded, ${#FAILED[@]} failed"
echo "  Logs: ${LOG_DIR}/"
echo ""

# --- Push phase (sequential — Infisical auth is interactive) -----------------
if (( ${#SUCCEEDED[@]} > 0 )) && ! $FLAG_DRY_RUN; then
  _push_flags=()
  $MULTI_PLATFORM && _push_flags+=(--remote)

  if $AUTO_PUSH; then
    echo ""
    for image in "${SUCCEEDED[@]}"; do
      echo "--- Pushing ${image} ---"
      docker-push "${_push_flags[@]+"${_push_flags[@]}"}" "$image" \
        "${PUSH_PASSTHROUGH[@]+"${PUSH_PASSTHROUGH[@]}"}"
    done
  elif $ASKED_UPFRONT; then
    # User already declined the upfront prompt — do not re-ask.
    echo ""
    echo "To push later:  docker-build --push <image>"
  elif ! $SILENT; then
    echo ""
    if _confirm "Push ${#SUCCEEDED[@]} successful build(s)?"; then
      for image in "${SUCCEEDED[@]}"; do
        echo "--- Pushing ${image} ---"
        docker-push "${_push_flags[@]+"${_push_flags[@]}"}" "$image" \
          "${PUSH_PASSTHROUGH[@]+"${PUSH_PASSTHROUGH[@]}"}"
      done
    else
      echo "To push later:  docker-build --push <image>"
    fi
  fi
fi

(( ${#FAILED[@]} > 0 )) && exit 1
exit 0
