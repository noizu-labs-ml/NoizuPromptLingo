# =============================================================================
# Secret Topology Configuration (v1) for infisical-populate-secrets
#
# Copy to infisical-secrets.yaml and customize for your infrastructure.
#
# Value resolution: override env → dc get → fallback env → auto → default → file
# =============================================================================

apiVersion: secrets-tools/v1

project:
  slug: my-project

# ---------------------------------------------------------------------------
# Reusable blocks (YAML anchors)
# ---------------------------------------------------------------------------
templates:
  smtp: &smtp
    SMTP_HOST: { dc: secrets smtp.host, override: SMTP_HOST }
    SMTP_PORT: { dc: secrets smtp.port, override: SMTP_PORT }
    SMTP_USER: { dc: secrets smtp.user, override: SMTP_USER }
    SMTP_FROM: { dc: secrets smtp.from, override: SMTP_FROM }

  ops_registry: &ops_registry
    OPS_REGISTRY_USER:     { dc: secrets registry.ops_user, override: OPS_REGISTRY_USER }
    OPS_REGISTRY_PASSWORD: { dc: secrets registry.ops_password, override: OPS_REGISTRY_PASSWORD }

# ---------------------------------------------------------------------------
# Groups for --section filtering
# ---------------------------------------------------------------------------
groups:
  database:    [postgres, redis]
  apps:        [myapp, otherapp]
  tls:         [shared-tls]

# ---------------------------------------------------------------------------
# Sections: each maps to one Infisical folder path
# ---------------------------------------------------------------------------
sections:
  # --- Simple: dc get with auto-generation ---
  - id: postgres
    title: "Shared PostgreSQL"
    path: /data/postgres
    secrets:
      POSTGRES_PASSWORD:
        dc: auto pg_superuser_password
        override: PG_SUPERUSER_PASSWORD
        auto: password 32
      APP_DB_USER:
        dc: services design.app_db_user
        override: APP_DB_USER
        default: myapp
      APP_DB_PASSWORD:
        dc: auto app_db_password
        override: APP_DB_PASSWORD
        auto: password 32

  # --- Computed values (DATABASE_URL from vars) ---
  - id: myapp
    title: "My Application"
    path: /apps/myapp
    vars:
      _db_user: { dc: auto app_db_user, override: APP_DB_USER, default: myapp }
      _db_pass: { dc: auto app_db_password, override: APP_DB_PASSWORD, auto: password 32 }
    secrets:
      APP_DB_USER:      { ref: _db_user }
      APP_DB_PASSWORD:  { ref: _db_pass }
      DATABASE_URL:
        template: "postgresql://{{_db_user}}:{{_db_pass|urlencode}}@postgres.db-ns:5432/myapp"
      SECRET_KEY:
        dc: auto app_secret_key
        override: APP_SECRET_KEY
        auto: hex 32
      # Merge in shared SMTP block
      <<: *smtp
      SMTP_PASSWORD:
        dc: secrets sendgrid.myapp
      # Env-only optional (API keys)
      OPENAI_API_KEY: { env: OPENAI_API_KEY, optional: true }

  # --- TLS certificates from PEM files ---
  - id: shared-tls
    title: "Shared TLS"
    path: /shared/tls
    secrets:
      TLS_CRT:
        file: .secrets/tls/example.com/cert.pem
        override: TLS_CRT
        decode: base64
      TLS_KEY:
        file: .secrets/tls/example.com/key.pem
        override: TLS_KEY
        decode: base64

  # --- Simple key-value ---
  - id: redis
    title: "Shared Redis"
    path: /data/redis
    secrets:
      REDIS_PASSWORD:
        dc: auto redis_password
        override: REDIS_PASSWORD
        auto: password 32
