#!/usr/bin/env bash
# =============================================================================
# Infisical Secret Export — Full backup of all secrets
#
# Usage:
#   export-infisical-secrets --env=prod                  # export prod (default)
#   export-infisical-secrets --env=staging               # export staging only
#   export-infisical-secrets --env=prod --env=staging    # export both
#   export-infisical-secrets --show-secrets               # include actual values
#   export-infisical-secrets --config=FILE               # explicit config path
#
# Output: .tmp/infisical-backup-<env>-<timestamp>.json
#
# Dependencies: jq, curl, yq (v4+), bash 4+
# =============================================================================
set -euo pipefail

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
[[ -f "$_K8_ASSIST_LIB" ]] && { source "$_K8_ASSIST_LIB"; _k8_check_assist "$0" "$@"; }

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

# -- Flags --------------------------------------------------------------------
SHOW_SECRETS=false
ENV_ARGS=()
CONFIG_ARG=""
SECRETS_CONFIG_ARG=""

_next_is=""
for arg in "$@"; do
  if [[ -n "$_next_is" ]]; then
    case "$_next_is" in
      env)            ENV_ARGS+=("$arg") ;;
      config)         CONFIG_ARG="$arg" ;;
      secrets-config) SECRETS_CONFIG_ARG="$arg" ;;
    esac
    _next_is=""; continue
  fi
  case "$arg" in
    --show-secrets)     SHOW_SECRETS=true ;;
    --stage)            ENV_ARGS+=(stage) ;;
    --prod)             ENV_ARGS+=(prod) ;;
    --dev)              ENV_ARGS+=(dev) ;;
    --env=*)            ENV_ARGS+=("${arg#--env=}") ;;
    --config=*)         CONFIG_ARG="${arg#--config=}" ;;
    --secrets-config=*) SECRETS_CONFIG_ARG="${arg#--secrets-config=}" ;;
    --env)              _next_is=env ;;
    --config)           _next_is=config ;;
    --secrets-config)   _next_is=secrets-config ;;
    --help|-h)
      cat <<'USAGE'
Usage: export-infisical-secrets [OPTIONS]

  --env=ENV             Target environment(s) (default: prod). Repeat for multiple.
  --stage               Shorthand for --env=stage
  --prod                Shorthand for --env=prod
  --dev                 Shorthand for --env=dev
  --config=FILE         Path to k8-util-config.yaml
  --secrets-config=FILE Path to secrets YAML config (for folder list)
  --show-secrets        Include actual secret values in output (SENSITIVE)
USAGE
      exit 0 ;;
  esac
done
unset _next_is

# -- Dependencies -------------------------------------------------------------
for cmd in jq curl; do
  command -v "$cmd" &>/dev/null || { echo "❌  $cmd required but not found." >&2; exit 1; }
done

# -- Secrets config discovery (for folder list) --------------------------------
SECRETS_CONFIG=""
for candidate in \
  "$SECRETS_CONFIG_ARG" \
  "${INFISICAL_SECRETS_FILE:-}" \
  "./.infisical-secrets.yaml" \
  "./infisical-secrets.yaml" \
  "./secrets.yaml"; do
  [[ -n "$candidate" && -f "$candidate" ]] && SECRETS_CONFIG="$candidate" && break
done

# -- Folder list ---------------------------------------------------------------
if [[ -n "$SECRETS_CONFIG" ]] && command -v yq &>/dev/null; then
  config_version="legacy"
  yq -e '.apiVersion == "secrets-tools/v1"' "$SECRETS_CONFIG" &>/dev/null && config_version="v1"
  if [[ "$config_version" == "v1" ]]; then
    mapfile -t SECRET_FOLDERS < <(yq -r '.sections[].path' "$SECRETS_CONFIG")
  else
    mapfile -t SECRET_FOLDERS < <(yq -r '.folders[]' "$SECRETS_CONFIG")
  fi
  echo "📄  Folder list from: ${SECRETS_CONFIG} (${config_version})"
else
  SECRET_FOLDERS=(
    gnp-mysqldb
    gnp-wordpress
    wordpress-cms
    gnp-manticore
    gnp-redis
    gnp-timescaledb
    gnp-pgbouncer
    gnp-proxysql
    gnp-backend
    gnp-frontend
    gnp-api
    gnp-admin
    gnp-donation
    gnp-fblogin
    gnp-valkey
    infra-valkey
    infra-directus
    infra-posthog
    verdaccio
  )
  echo "📄  Using built-in folder list (no secrets config found)"
fi

# -- Environment(s) -----------------------------------------------------------
if [[ ${#ENV_ARGS[@]} -eq 0 ]]; then
  ENV_SLUG="${INFISICAL_ENV:-$(dc get secrets infisical.env 2>/dev/null || echo prod)}"
  ENV_ARGS=("$ENV_SLUG")
fi

for e in "${ENV_ARGS[@]}"; do
  [[ "$e" != "prod" && "$e" != "staging" ]] && { echo "❌  Unknown env: $e" >&2; exit 1; }
done

# -- Infisical connection + auth -----------------------------------------------
INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-$(dc get secrets infisical.host 2>/dev/null || true)}}"
PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-${K8_INFISICAL_PROJECT_SLUG:-$(dc get secrets infisical.project_slug 2>/dev/null || true)}}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-$(dc get secrets operator.client_id 2>/dev/null || true)}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-$(dc get secrets operator.client_secret 2>/dev/null || true)}}"

[[ -z "$INFISICAL_HOST" ]] && { echo "❌  INFISICAL_HOST not set (env, dc secrets.infisical.host, or K8_INFISICAL_HOST)" >&2; exit 1; }
INFISICAL_HOST="${INFISICAL_HOST%/api}"
INFISICAL_HOST="${INFISICAL_HOST%/}"
for v in EKS_OPERATOR_CLIENT_ID EKS_OPERATOR_CLIENT_SECRET; do
  [[ -z "${!v:-}" ]] && { echo "❌  $v is not set." >&2; exit 1; }
done

# Cloudflare Access headers (if Infisical is behind Zero Trust)
CF_ACCESS_ID="${CF_ACCESS_CLIENT_ID:-$(dc get cf access.client_id 2>/dev/null || true)}"
CF_ACCESS_SECRET="${CF_ACCESS_CLIENT_SECRET:-$(dc get cf access.client_secret 2>/dev/null || true)}"
CF_HEADERS=()
if [[ -n "$CF_ACCESS_ID" && -n "$CF_ACCESS_SECRET" ]]; then
  CF_HEADERS=(-H "CF-Access-Client-Id: ${CF_ACCESS_ID}" -H "CF-Access-Client-Secret: ${CF_ACCESS_SECRET}")
fi

echo "🔑  Logging in via universal auth ..."
API_TOKEN=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}" \
  | jq -r '.accessToken // empty')
[[ -z "$API_TOKEN" ]] && { echo "❌  Auth failed." >&2; exit 1; }

# Resolve project ID from slug if needed
if [[ -z "$PROJECT_ID" && -n "${PROJECT_SLUG:-}" ]]; then
  PROJECT_ID=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X GET "${INFISICAL_HOST}/api/v1/projects/slug/${PROJECT_SLUG}" \
    -H "Authorization: Bearer ${API_TOKEN}" \
    -H "Content-Type: application/json" | jq -r '.id // .project.id // empty')
fi
[[ -z "$PROJECT_ID" ]] && { echo "❌  Could not resolve project ID (set INFISICAL_PROJECT_ID or INFISICAL_PROJECT_SLUG)" >&2; exit 1; }

echo "✅  Authenticated — project=$PROJECT_ID"
echo ""

# -- Output directory ----------------------------------------------------------
OUT_DIR="${REPO_ROOT}/.tmp"
mkdir -p "$OUT_DIR"
TIMESTAMP=$(date +%Y%m%d-%H%M%S)

# -- Export function -----------------------------------------------------------
export_env() {
  local env_slug="$1"
  local outfile="${OUT_DIR}/infisical-backup-${env_slug}-${TIMESTAMP}.json"

  echo "📦  Exporting ${env_slug} secrets ..."

  {
    echo "{"
    echo "  \"exported_at\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\","
    echo "  \"project_id\": \"${PROJECT_ID}\","
    echo "  \"environment\": \"${env_slug}\","
    echo "  \"host\": \"${INFISICAL_HOST}\","
    echo "  \"folders\": {"

    local first_folder=true

    for folder in "${SECRET_FOLDERS[@]}"; do
      local response
      response=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} \
        -X GET "${INFISICAL_HOST}/api/v3/secrets/raw?workspaceId=${PROJECT_ID}&environment=${env_slug}&secretPath=${folder}&recursive=false" \
        -H "Authorization: Bearer ${API_TOKEN}" || echo '{"secrets":[]}')

      local count
      count=$(echo "$response" | jq '[.secrets[]?] | length')

      if $first_folder; then
        first_folder=false
      else
        echo ","
      fi

      echo -n "    \"${folder}\": {"
      echo ""
      echo "      \"count\": ${count},"
      echo "      \"secrets\": ["

      if [[ "$count" -gt 0 ]]; then
        if $SHOW_SECRETS; then
          echo "$response" | jq -r '
            [.secrets[] | {key: .secretKey, value: .secretValue}]
            | to_entries[]
            | (if .key > 0 then "," else "" end)
              + "        {\"key\": " + (.value.key | @json) + ", \"value\": " + (.value.value | @json) + "}"
          '
        else
          echo "$response" | jq -r '
            [.secrets[] | {key: .secretKey, len: (.secretValue | length), preview: (
              if (.secretValue | length) > 4 then .secretValue[:2] + "..." + .secretValue[-2:]
              elif (.secretValue | length) > 0 then "***"
              else "(empty)" end
            )}]
            | to_entries[]
            | (if .key > 0 then "," else "" end)
              + "        {\"key\": " + (.value.key | @json) + ", \"value_preview\": " + (.value.preview | @json) + ", \"length\": " + (.value.len | tostring) + "}"
          '
        fi
      fi

      echo "      ]"
      echo -n "    }"

      if [[ "$count" -gt 0 ]]; then
        echo "  ✅  ${folder} — ${count} secrets" >&2
      else
        echo "  ⚠️   ${folder} — empty or not found" >&2
      fi
    done

    echo ""
    echo "  }"
    echo "}"
  } > "$outfile"

  echo "" >&2
  echo "📄  Saved: ${outfile}" >&2
  echo "" >&2
}

# -- Run -----------------------------------------------------------------------
for env in "${ENV_ARGS[@]}"; do
  export_env "$env"
done

echo "=============================================="
echo "✅  Export complete!"
echo ""
echo "  Files saved to ${OUT_DIR}/"
echo ""
if ! $SHOW_SECRETS; then
  echo "  ⚠️   Secret values are REDACTED by default."
  echo "       Re-run with --show-secrets to include actual values."
fi
echo ""
echo "  🔒  If you used --show-secrets, treat these files as HIGHLY SENSITIVE."
echo "      Delete after use: rm ${OUT_DIR}/infisical-backup-*.json"
echo "=============================================="
