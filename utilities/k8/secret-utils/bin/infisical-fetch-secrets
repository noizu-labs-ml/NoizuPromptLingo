#!/usr/bin/env bash
# =============================================================================
# infisical-fetch-secrets — Fetch and display secrets at an Infisical path
#
# Usage:
#   infisical-fetch-secrets /livebook                    # table (default)
#   infisical-fetch-secrets /livebook --env=prod         # explicit env
#   infisical-fetch-secrets /livebook --format=env       # sourceable exports
#   infisical-fetch-secrets /livebook --format=json      # raw JSON
#
# Flags:
#   --env=ENV          Target environment (default: prod)
#   --format=FMT       Output format: table | env | json (default: table)
#   --redact           Mask credential values in the header
#   -q, --quiet        Suppress the context header entirely
#   --config=FILE      Path to k8-util-config.yaml
#
# Dependencies: jq, curl, bash 4+
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

# Pre-parse --config
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# -- Flags --------------------------------------------------------------------
REDACT=false
QUIET=false
ENV_ARG=""
FORMAT="table"
POSITIONAL=()

for arg in "$@"; do
  case "$arg" in
    --redact)       REDACT=true ;;
    --show-secrets) REDACT=false ;;
    -q|--quiet)     QUIET=true ;;
    --stage)        ENV_ARG="stage" ;;
    --prod)         ENV_ARG="prod" ;;
    --dev)          ENV_ARG="dev" ;;
    --env=*)        ENV_ARG="${arg#--env=}" ;;
    --format=*)     FORMAT="${arg#--format=}" ;;
    --config=*)     ;; # already parsed
    --help|-h)
      cat <<'USAGE'
Usage: infisical-fetch-secrets <secret-path> [OPTIONS]

  <secret-path>      Infisical path to fetch (e.g. /livebook, /shared-postgres)
  --env=ENV          Target environment: prod | staging (default: prod)
  --stage            Shorthand for --env=stage
  --prod             Shorthand for --env=prod
  --dev              Shorthand for --env=dev
  --format=FMT       Output format: table | env | json (default: table)
  --redact           Mask credential values in the context header
  --show-secrets     Show full values in header (default)
  -q, --quiet        Suppress the context header
  --config=FILE      Path to k8-util-config.yaml
USAGE
      exit 0 ;;
    *)              POSITIONAL+=("$arg") ;;
  esac
done
set -- "${POSITIONAL[@]:-}"

SECRET_PATH="${1:-/livebook}"

# -- Dependencies -------------------------------------------------------------
for cmd in jq curl; do
  command -v "$cmd" &>/dev/null || die "$cmd required but not found."
done

# -- Infisical connection -----------------------------------------------------
INFISICAL_HOST="${INFISICAL_HOST:-${K8_INFISICAL_HOST:-$(dc get secrets infisical.host 2>/dev/null || true)}}"
PROJECT_SLUG="${INFISICAL_PROJECT_SLUG:-${K8_INFISICAL_PROJECT_SLUG:-$(dc get secrets infisical.project_slug 2>/dev/null || true)}}"
ENV_SLUG="${ENV_ARG:-${INFISICAL_ENV:-$(dc get secrets infisical.env 2>/dev/null || echo prod)}}"
PROJECT_ID="${INFISICAL_PROJECT_ID:-${K8_INFISICAL_PROJECT_ID:-}}"
EKS_OPERATOR_CLIENT_ID="${EKS_OPERATOR_CLIENT_ID:-${K8_INFISICAL_CLIENT_ID:-$(dc get secrets operator.client_id 2>/dev/null || true)}}"
EKS_OPERATOR_CLIENT_SECRET="${EKS_OPERATOR_CLIENT_SECRET:-${K8_INFISICAL_CLIENT_SECRET:-$(dc get secrets operator.client_secret 2>/dev/null || true)}}"

[[ -z "$INFISICAL_HOST" ]] && die "INFISICAL_HOST not set (env, dc secrets.infisical.host, or K8_INFISICAL_HOST)"
INFISICAL_HOST="${INFISICAL_HOST%/api}"
INFISICAL_HOST="${INFISICAL_HOST%/}"
for v in EKS_OPERATOR_CLIENT_ID EKS_OPERATOR_CLIENT_SECRET; do
  [[ -z "${!v:-}" ]] && die "$v is not set."
done

# Cloudflare Access headers
CF_ACCESS_ID="${CF_ACCESS_CLIENT_ID:-$(dc get cf access.client_id 2>/dev/null || true)}"
CF_ACCESS_SECRET="${CF_ACCESS_CLIENT_SECRET:-$(dc get cf access.client_secret 2>/dev/null || true)}"
CF_HEADERS=()
if [[ -n "$CF_ACCESS_ID" && -n "$CF_ACCESS_SECRET" ]]; then
  CF_HEADERS=(-H "CF-Access-Client-Id: ${CF_ACCESS_ID}" -H "CF-Access-Client-Secret: ${CF_ACCESS_SECRET}")
fi

# -- Credential display -------------------------------------------------------
redact_value() {
  local value="${1:-}"
  if [[ -z "$value" ]]; then
    echo "${RED}(unset)${NC}"
  elif $REDACT; then
    local len=${#value}
    if (( len <= 8 )); then
      printf '%s' '••••••••'
    else
      printf '%s…%s' "${value:0:4}" "${value: -2}"
    fi
  else
    echo "$value"
  fi
}

print_header() {
  $QUIET && return
  echo ""
  echo -e "${BLU}╔══════════════════════════════════════════════════════════════╗${NC}"
  echo -e "${BLU}║  Infisical Fetch — context                                   ║${NC}"
  echo -e "${BLU}╚══════════════════════════════════════════════════════════════╝${NC}"
  echo -e "  ${BLU}INFISICAL_HOST:${NC}           ${INFISICAL_HOST}"
  echo -e "  ${BLU}PROJECT_SLUG:${NC}             ${PROJECT_SLUG:-(unset)}"
  echo -e "  ${BLU}PROJECT_ID:${NC}               ${PROJECT_ID:-(resolve from slug)}"
  echo -e "  ${BLU}ENV:${NC}                      ${ENV_SLUG}"
  echo -e "  ${BLU}SECRET_PATH:${NC}              ${SECRET_PATH}"
  echo ""
  echo -e "  ${BLU}OPERATOR_CLIENT_ID:${NC}       $(redact_value "${EKS_OPERATOR_CLIENT_ID:-}")"
  echo -e "  ${BLU}OPERATOR_CLIENT_SECRET:${NC}   $(redact_value "${EKS_OPERATOR_CLIENT_SECRET:-}")"
  if [[ -n "$CF_ACCESS_ID" || -n "$CF_ACCESS_SECRET" ]]; then
    echo -e "  ${BLU}CF_ACCESS_CLIENT_ID:${NC}      $(redact_value "${CF_ACCESS_ID:-}")"
    echo -e "  ${BLU}CF_ACCESS_CLIENT_SECRET:${NC}  $(redact_value "${CF_ACCESS_SECRET:-}")"
  else
    echo -e "  ${BLU}CF Access:${NC}                ${YEL}(not configured — bypassing CF)${NC}"
  fi
  echo ""
}

print_header

# -- Auth ---------------------------------------------------------------------
API_TOKEN=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X POST "${INFISICAL_HOST}/api/v1/auth/universal-auth/login" \
  -H "Content-Type: application/json" \
  -d "{\"clientId\":\"${EKS_OPERATOR_CLIENT_ID}\",\"clientSecret\":\"${EKS_OPERATOR_CLIENT_SECRET}\"}" \
  | jq -r '.accessToken // empty')
[[ -z "$API_TOKEN" ]] && die "Auth failed."

if [[ -z "$PROJECT_ID" && -n "${PROJECT_SLUG:-}" ]]; then
  PROJECT_ID=$(curl -s ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} -X GET "${INFISICAL_HOST}/api/v1/projects/slug/${PROJECT_SLUG}" \
    -H "Authorization: Bearer ${API_TOKEN}" \
    -H "Content-Type: application/json" | jq -r '.id // .project.id // empty')
fi
[[ -z "$PROJECT_ID" ]] && die "Could not resolve project ID (set INFISICAL_PROJECT_ID or PROJECT_SLUG)"

# -- Fetch secrets ------------------------------------------------------------
RESP=$(curl -sf -G "${INFISICAL_HOST}/api/v3/secrets/raw" \
  ${CF_HEADERS[@]+"${CF_HEADERS[@]}"} \
  -H "Authorization: Bearer ${API_TOKEN}" \
  --data-urlencode "workspaceId=${PROJECT_ID}" \
  --data-urlencode "environment=${ENV_SLUG}" \
  --data-urlencode "secretPath=${SECRET_PATH}" \
  --data-urlencode "expandSecretReferences=true" \
  --data-urlencode "recursive=false") || die "Fetch failed for ${SECRET_PATH} (${ENV_SLUG})"

# -- Output -------------------------------------------------------------------
case "$FORMAT" in
  json)
    echo "$RESP" | jq '.secrets | map({key: .secretKey, value: .secretValue})'
    ;;
  env)
    echo "$RESP" | jq -r '.secrets[] | "export \(.secretKey)=\(.secretValue | @sh)"'
    ;;
  table|*)
    $QUIET || {
      echo -e "${BLU}Path:${NC} ${SECRET_PATH}    ${BLU}Env:${NC} ${ENV_SLUG}"
      echo ""
    }
    echo "$RESP" | jq -r '.secrets | sort_by(.secretKey)[] | "\(.secretKey)=\(.secretValue)"'
    echo ""
    ;;
esac
