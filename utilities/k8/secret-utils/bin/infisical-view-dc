#!/usr/bin/env bash
# =============================================================================
# infisical-view-dc — View dc configuration items
#
# Usage:
#   infisical-view-dc                        # List all dc get directives
#   infisical-view-dc --scope secrets        # Filter by scope
#   infisical-view-dc --path infisical.host  # Filter by item.path
#   infisical-view-dc --show-values          # Show resolved values
#   infisical-view-dc --format json|table    # Output format
# =============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../lib/secret-engine.sh"

# -- Flags --------------------------------------------------------------------
SHOW_VALUES=false
SCOPE_FILTER=""
PATH_FILTER=""
FORMAT="table"
ENVRC_FILE=""

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    --scope) SCOPE_FILTER="$2"; shift 2 ;;
    --path) PATH_FILTER="$2"; shift 2 ;;
    --show-values) SHOW_VALUES=true; shift ;;
    --format)
      case "$2" in
        table|json) FORMAT="$2"; shift 2 ;;
        *) log_error "Invalid format: $2 (use table|json)"; exit 1 ;;
      esac
      ;;
    --file) ENVRC_FILE="$2"; shift 2 ;;
    -h|--help)
      cat <<'USAGE'
Usage: infisical-view-dc [OPTIONS]

View dc get directives from .envrc.dc file.

Options:
  --scope SCOPE           Filter by scope (e.g., secrets, infra)
  --path PATTERN          Filter by item path (e.g., infisical.host)
  --show-values           Show resolved values via dc get
  --format {table|json}   Output format (default: table)
  --file PATH             Path to .envrc.dc file (default: auto-discover)
  -h, --help              Show this help message

Examples:
  infisical-view-dc                          # List all directives
  infisical-view-dc --scope secrets         # Filter by secrets scope
  infisical-view-dc --path infisical.host   # Filter by path
  infisical-view-dc --show-values           # Show resolved values
  infisical-view-dc --format json           # JSON output
USAGE
      exit 0
      ;;
    *)
      log_error "Unknown option: $1"
      exit 1
      ;;
  esac
done

# -- Find .envrc.dc file ------------------------------------------------------
if [[ -z "$ENVRC_FILE" ]]; then
  ENVRC_FILE=$(envrc_find_file)
  if [[ -z "$ENVRC_FILE" ]]; then
    die ".envrc.dc file not found in current directory or parent chain"
  fi
fi

log_info "Reading: $ENVRC_FILE"

# -- Parse dc get lines ------------------------------------------------------
lines_json=$(envrc_parse_get_lines "$ENVRC_FILE")

# -- Apply filters -----------------------------------------------------------
if [[ -n "$SCOPE_FILTER" ]] || [[ -n "$PATH_FILTER" ]]; then
  local filter='.[] | '
  if [[ -n "$SCOPE_FILTER" ]]; then
    filter+="select(.scope == \"$SCOPE_FILTER\")"
  else
    filter+="select(true)"
  fi
  if [[ -n "$PATH_FILTER" ]]; then
    $SCOPE_FILTER && filter+=" | "
    filter+="select(.item_path | contains(\"$PATH_FILTER\"))"
  fi
  lines_json=$(echo "$lines_json" | jq -r "$filter")
fi

# -- Get line count ----------------------------------------------------------
line_count=$(echo "$lines_json" | jq 'length')

if [[ "$line_count" -eq 0 ]]; then
  log_warn "No matching dc get directives found"
  exit 0
fi

# -- Show values if requested ------------------------------------------------
if $SHOW_VALUES; then
  lines_json=$(echo "$lines_json" | jq -c '
    map(. + {
      value: (
        if .scope and .item_path then
          ("dc get \(.scope) \(.item_path)" | try {
            output: ("dc get \(.scope) \(.item_path)" | split("\n")[0]),
            status: "ok"
          } catch {output: "—", status: "error"})
        else
          {output: "—", status: "error"}
        end
      )
    })
  ')
fi

# -- Output ------------------------------------------------------------------
case "$FORMAT" in
  json)
    echo "$lines_json" | jq '.'
    ;;
  table)
    # Print table header
    printf "%-6s %-12s %-40s " "Line" "Scope" "Item Path"
    $SHOW_VALUES && printf "%-30s" "Value"
    echo

    # Print separator
    printf "%-6s %-12s %-40s " "------" "------------" "----------------------------------------"
    $SHOW_VALUES && printf "%-30s" "------------------------------"
    echo

    # Print data rows
    echo "$lines_json" | jq -r '.[] | @json' | while IFS= read -r line; do
      ln=$(echo "$line" | jq -r '.line_number')
      scope=$(echo "$line" | jq -r '.scope')
      item_path=$(echo "$line" | jq -r '.item_path | .[0:39]')  # truncate to 40 chars
      value=""
      if $SHOW_VALUES; then
        value=$(echo "$line" | jq -r '.value.output // "—"')
        [[ ${#value} -gt 28 ]] && value="${value:0:27}…"
      fi

      printf "%-6s %-12s %-40s " "$ln" "$scope" "$item_path"
      $SHOW_VALUES && printf "%-30s" "$value"
      echo
    done

    echo ""
    log_info "Total: $line_count directive(s)"
    ;;
esac

exit 0