# =============================================================================
# 9. _dc (flatten rules + aliases)
# =============================================================================
dc_yaml --no-bump _dc --replace <<'YAML'
# Only export vars that external tools read directly from the environment.
# Everything else stays in the dc store — use `dc get <config> <path>` to access.
export: [infra, cluster, cf] 

#m tab]

flatten:
  # --- Structural (read by devops toolchain, makefiles, scripts) ---
  infra.root: INFRA_ROOT
  infra.k8_lib_dir: K8_LIB_DIR
  infra.build_env: BUILD_ENV
  infra.npl_project: NPL_PROJECT

  # --- Kubernetes (read by kubectl, helm, kubectx) ---
  cluster.kubeconfig: KUBECONFIG
  cluster.context: KUBECTX_CURRENT_CONTEXT

  # --- Cloudflare (read by terraform scripts, cf-livebook-idp) ---
  cf.account_id: CF_ACCOUNT_ID
  cf.zone_id: CF_ZONE_ID
  cf.zone_id_trl: CF_ZONE_ID_THEROBOTLIVES
  cf.api_token: CF_API_TOKEN
  cf.access.client_id: CF_ACCESS_CLIENT_ID
  cf.access.client_secret: CF_ACCESS_CLIENT_SECRET

  # --- Tab (shell theming) ---
  # tab.*: TAB_*

  # --- MinIO platform instance (Terraform S3 backend credentials) ---
  platform.minio.root_user: MINIO_TF_ACCESS_KEY
  platform.minio.root_password: MINIO_TF_SECRET_KEY

# No aliases needed — infisical-populate-secrets uses dc get directly.
YAML

dc_bump
dc_export

# Runtime cert population (file-based TLS certs for registry)
export REGISTRY_TLS_CRT="$(cat "$REGISTRY_TLS_CRT_FILE" 2>/dev/null)"
export REGISTRY_TLS_KEY="$(cat "$REGISTRY_TLS_KEY_FILE" 2>/dev/null)"

# MinIO TLS — reuses the wildcard *.noizu.com cert
export MINIO_TLS_CRT="$(cat .secrets/tls/noizu.com/cert.pem 2>/dev/null)"
export MINIO_TLS_KEY="$(cat .secrets/tls/noizu.com/key.pem 2>/dev/null)"
