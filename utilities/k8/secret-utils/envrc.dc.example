PATH_add ./utils/

# =============================================================================
# 1. infra (base)
# =============================================================================
dc_yaml --no-bump infra <<'YAML'
root: /Users/keithbrings/Github/infra/noizu-infra
k8_lib_dir: ${HOME}/.local/share/k8-lib
build_env: prod
npl_project: noizu-infra
YAML

# =============================================================================
# 2. cluster (base)
# =============================================================================
dc_yaml --no-bump cluster <<'YAML'
kubeconfig: "/Users/keithbrings/.kube/noizu/config"
context: noizu
YAML

# =============================================================================
# 3. cf (base + secrets)
# =============================================================================
dc_yaml --no-bump cf <<'YAML'
account_id: <SECRET>
zone_id: <SECRET>
zone_id_trl: <SECRET>
access:
  client_id: <SECRET>
YAML

dc_yaml --no-bump cf --layer secrets <<'YAML'
api_token: <SECRET>
access:
  client_secret: <SECRET>
namecheap_trl_token: <SECRET>
YAML

