#!/bin/zsh
# tf-plan-all: Run terraform plan in every subdirectory that contains .tf files.
# Logs full output for any dir that is NOT "No changes." — skips logging clean dirs.
# Prints a status table at the end: No Changes | Has Changes | Error | Skipped
#
# Usage:
#   tf-plan-all [--verbose|-v] [dir]
#
# Options:
#   --verbose, -v   Show which folder is being planned, per-plan timing,
#                   and warn on plans exceeding 5 minutes.
#
# Examples:
#   tf-plan-all
#   tf-plan-all --verbose
#   tf-plan-all -v terraform/production/imported

setopt nounset

# --assist: AI-powered help
_K8_ASSIST_LIB="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}/bin/assist.sh"
if [[ -f "$_K8_ASSIST_LIB" ]]; then
  source "$_K8_ASSIST_LIB"
  _k8_check_assist "$0" "$@"
fi

verbose=0
positional=()
for arg in "$@"; do
  case "$arg" in
    --verbose|-v) verbose=1 ;;
    *) positional+=("$arg") ;;
  esac
done

base_dir="${positional[1]:-.}"
log_dir="${base_dir}/tf-plan-logs"
mkdir -p "$log_dir"

timestamp=$(date +%Y%m%d-%H%M%S)

# status arrays: dir_name|status
typeset -a results

for dir in "$base_dir" "$base_dir"/**/*(/N); do
  dir_name="${dir#$base_dir/}"   # relative path from base, e.g. dns/us-east-1
  tf_files=("$dir"/*.tf(N))

  # Silently ignore the log output directory (at any depth)
  if [[ "$dir" == *"/tf-plan-logs"* ]]; then
    continue
  fi

  # Skip dirs with no .tf files (parent/container dirs)
  if (( ${#tf_files[@]} == 0 )); then
    continue
  fi

  # Skip child modules — only plan root modules (those with a provider block)
  if ! grep -rlq '^provider\s' "$dir"/*.tf 2>/dev/null; then
    continue
  fi

  log_file="$log_dir/${timestamp}-${dir_name}.log"
  mkdir -p "${log_file:h}"

  if (( verbose )); then
    echo "--- planning: $dir_name ..."
  fi

  plan_start=$SECONDS
  direnv exec "$dir" terraform -chdir="$dir" plan -input=false > "$log_file" 2>&1
  rc=$?
  plan_elapsed=$(( SECONDS - plan_start ))

  elapsed_fmt="${plan_elapsed}s"
  slow_warn=""
  if (( plan_elapsed >= 300 )); then
    slow_warn=" [SLOW: $(( plan_elapsed / 60 ))m$(( plan_elapsed % 60 ))s]"
  fi

  if [[ $rc -ne 0 ]]; then
    echo "==> ❌ ERROR: $dir_name (exit $rc, ${elapsed_fmt})${slow_warn}"
    results+=("$dir_name|ERROR|$plan_elapsed")
  elif grep -q "No changes\." "$log_file" 2>/dev/null; then
    if (( verbose )); then
      echo "==> ✅ NO CHANGES: $dir_name (${elapsed_fmt})${slow_warn}"
    else
      echo "==> ✅ NO CHANGES: $dir_name"
    fi
    results+=("$dir_name|NO_CHANGES|$plan_elapsed")
    rm -f "$log_file"
  else
    echo "==> ⚠️  HAS CHANGES: $dir_name (${elapsed_fmt})${slow_warn}"
    results+=("$dir_name|HAS_CHANGES|$plan_elapsed")
  fi
done

# ── Summary table ────────────────────────────────────────────────────────────
echo
typeset -a slow_plans

if (( verbose )); then
  echo "╔═══════════════════════════════════════════════════════════════════════════╗"
  echo "║                          tf-plan-all  SUMMARY                            ║"
  echo "╠═══════════════════════════════════════════════════════════════════════════╣"
  printf "║  %-38s  %-16s  %-8s ║\n" "Directory" "Status" "Time"
  echo "╠═══════════════════════════════════════════════════════════════════════════╣"
else
  echo "╔══════════════════════════════════════════════════════════════╗"
  echo "║                   tf-plan-all  SUMMARY                      ║"
  echo "╠══════════════════════════════════════════════════════════════╣"
  printf "║  %-38s  %-16s ║\n" "Directory" "Status"
  echo "╠══════════════════════════════════════════════════════════════╣"
fi

n_clean=0; n_changes=0; n_errors=0; n_skip=0

for entry in "${results[@]}"; do
  name="${entry%%|*}"
  rest="${entry#*|}"
  result_status="${rest%%|*}"
  elapsed="${rest##*|}"
  label="?? Unknown"
  case "$result_status" in
    NO_CHANGES)  label="✅ No Changes";  n_clean=$(( n_clean + 1 ))     ;;
    HAS_CHANGES) label="⚠️  Has Changes"; n_changes=$(( n_changes + 1 )) ;;
    ERROR)       label="❌ Error";        n_errors=$(( n_errors + 1 ))   ;;
    SKIP)        label="-- Skipped";     n_skip=$(( n_skip + 1 ))       ;;
  esac

  if (( elapsed >= 300 )); then
    slow_plans+=("$name ($(( elapsed / 60 ))m$(( elapsed % 60 ))s)")
  fi

  if (( verbose )); then
    if (( elapsed >= 60 )); then
      time_str="$(( elapsed / 60 ))m$(( elapsed % 60 ))s"
    else
      time_str="${elapsed}s"
    fi
    printf "║  %-38s  %-16s  %-8s ║\n" "$name" "$label" "$time_str"
  else
    printf "║  %-38s  %-16s ║\n" "$name" "$label"
  fi
done

if (( verbose )); then
  echo "╠═══════════════════════════════════════════════════════════════════════════╣"
  printf "║  ✅ No Changes: %-3d  ⚠️  Has Changes: %-3d  ❌ Errors: %-3d              ║\n" \
    $n_clean $n_changes $n_errors
  echo "╚═══════════════════════════════════════════════════════════════════════════╝"
else
  echo "╠══════════════════════════════════════════════════════════════╣"
  printf "║  ✅ No Changes: %-3d  ⚠️  Has Changes: %-3d  ❌ Errors: %-3d  ║\n" \
    $n_clean $n_changes $n_errors
  echo "╚══════════════════════════════════════════════════════════════╝"
fi

if (( ${#slow_plans[@]} > 0 )); then
  echo
  echo "⏱  SLOW PLANS (>5 min):"
  for sp in "${slow_plans[@]}"; do
    echo "  - $sp"
  done
fi

if [[ $n_changes -gt 0 || $n_errors -gt 0 ]]; then
  echo
  echo "Logs saved to: $log_dir/"
  for f in "$log_dir"/${timestamp}-*.log(N); do
    echo "  $f"
  done
fi

[[ $n_errors -eq 0 ]]
