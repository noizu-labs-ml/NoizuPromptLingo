#!/usr/bin/env bash
# Interactive Liquibase shell with kubectl port-forward to K8s databases.
# Loads targets from infra-config.yaml config files.
#
# Usage: liquibase-shell [target] [--shell | -- liquibase-args...]
#
# Config resolution (first match wins):
#   1. $LIQUIBASE_CONFIG (env var, explicit path)
#   2. ./infra-config.yaml (cwd)
#   3. <repo-root>/infra-config.yaml
#   4. ./.infra-config.yaml / <repo-root>/.infra-config.yaml
#
# Reads the `liquibase_targets` section from infra-config.yaml.
#
# Examples:
#   liquibase-shell prod                    # interactive menu
#   liquibase-shell prod -- status          # one-shot: show pending changesets
#   liquibase-shell prod -- update-sql      # one-shot: preview SQL
#   liquibase-shell prod -- update          # one-shot: apply migrations
#   liquibase-shell prod --shell            # drop into free-form liquibase prompt
set -euo pipefail

SCRIPT_PATH="$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
PWD_ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
SCRIPT_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"

PF_PID=""
TMPDIR_LB=""
BASE64_DECODE_ARGS=()

cleanup() {
  if [[ -n "$PF_PID" ]] && kill -0 "$PF_PID" 2>/dev/null; then
    kill "$PF_PID" 2>/dev/null
    wait "$PF_PID" 2>/dev/null || true
  fi
  [[ -n "$TMPDIR_LB" && -d "$TMPDIR_LB" ]] && rm -rf "$TMPDIR_LB"
}
trap cleanup EXIT INT TERM

# --- Locate config file ---
find_config_in_tree() {
  local start="$1"
  local dir
  dir="$(cd "$start" 2>/dev/null && pwd)" || return 1

  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/infra-config.yaml" ]]; then
      echo "$dir/infra-config.yaml"
      return 0
    fi
    if [[ -f "$dir/.infra-config.yaml" ]]; then
      echo "$dir/.infra-config.yaml"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

find_config() {
  local candidates=(
    "${LIQUIBASE_CONFIG:-}"
    "./infra-config.yaml"
    "./.infra-config.yaml"
    "${PWD_ROOT:+$PWD_ROOT/infra-config.yaml}"
    "${PWD_ROOT:+$PWD_ROOT/.infra-config.yaml}"
    "${SCRIPT_ROOT:+$SCRIPT_ROOT/infra-config.yaml}"
    "${SCRIPT_ROOT:+$SCRIPT_ROOT/.infra-config.yaml}"
  )
  for f in "${candidates[@]}"; do
    [[ -n "$f" && -f "$f" ]] && { echo "$f"; return 0; }
  done

  find_config_in_tree "$PWD" && return 0
  find_config_in_tree "$SCRIPT_DIR" && return 0

  echo "ERROR: No infra-config.yaml found." >&2
  echo "Searched:" >&2
  for f in "${candidates[@]}"; do
    [[ -n "$f" ]] && echo "  $f" >&2
  done
  return 1
}

CONFIG_FILE="$(find_config)"
CONFIG_ROOT="$(cd "$(dirname "$CONFIG_FILE")" && pwd)"

if printf '' | base64 --decode >/dev/null 2>&1; then
  BASE64_DECODE_ARGS=(--decode)
elif printf '' | base64 -d >/dev/null 2>&1; then
  BASE64_DECODE_ARGS=(-d)
elif printf '' | base64 -D >/dev/null 2>&1; then
  BASE64_DECODE_ARGS=(-D)
else
  echo "ERROR: base64 does not support --decode, -d, or -D on this system." >&2
  exit 1
fi

resolve_config_path() {
  local path="$1"
  if [[ "$path" == /* ]]; then
    echo "$path"
  else
    echo "$CONFIG_ROOT/$path"
  fi
}

# --- Helper: read a target field from config ---
cfg() {
  local target="$1" field="$2"
  yq -r "(.liquibase_targets.\"$target\".\"$field\" // \"\")" "$CONFIG_FILE"
}

cfg_list() {
  local target="$1" field="$2"
  yq -r "(.liquibase_targets.\"$target\".\"$field\" // [])[]?" "$CONFIG_FILE"
}

# --- List available targets ---
list_targets() {
  yq -r '(.liquibase_targets // {}) | keys[]' "$CONFIG_FILE"
}

target_exists() {
  local target="$1"
  [[ "$(yq -r "((.liquibase_targets // {}) | has(\"$target\"))" "$CONFIG_FILE")" == "true" ]]
}

fetch_secret_value() {
  local namespace="$1" secret_name="$2" secret_key="$3"
  local encoded
  encoded="$(kubectl get secret -n "$namespace" "$secret_name" -o jsonpath="{.data.$secret_key}" 2>/dev/null)" || return 1
  [[ -n "$encoded" ]] || return 1
  printf '%s' "$encoded" | base64 "${BASE64_DECODE_ARGS[@]}"
}

fetch_secret_value_from_keys() {
  local namespace="$1" secret_name="$2"
  shift 2

  local secret_key value
  for secret_key in "$@"; do
    [[ -z "$secret_key" ]] && continue
    if value="$(fetch_secret_value "$namespace" "$secret_name" "$secret_key")" && [[ -n "$value" ]]; then
      printf '%s' "$value"
      return 0
    fi
  done
  return 1
}

# --- Target selection ---
TARGET="${1:-}"
if [[ -n "$TARGET" && "$TARGET" != "--" ]]; then
  shift
else
  TARGET=""
fi

if [[ -z "$TARGET" ]]; then
  if [[ -z "$(list_targets)" ]]; then
    echo "No liquibase_targets configured in $CONFIG_FILE"
    exit 1
  fi

  echo "Select a database target:"
  echo ""
  while IFS= read -r t; do
    desc="$(cfg "$t" description)"
    printf "  %-14s %s\n" "$t" "$desc"
  done < <(list_targets)
  echo ""
  read -rp "Target: " TARGET
fi

# Validate target exists in config
if ! target_exists "$TARGET"; then
  echo "Unknown target: $TARGET"
  echo "Valid targets: $(list_targets | tr '\n' ' ')"
  exit 1
fi

# Parse remaining args: everything after "--" goes to liquibase
SHELL_MODE=false
LB_ARGS=()
if [[ "${1:-}" == "--shell" ]]; then
  SHELL_MODE=true
  shift
elif [[ "${1:-}" == "--" ]]; then
  shift
  LB_ARGS=("$@")
elif [[ $# -gt 0 ]]; then
  LB_ARGS=("$@")
fi

# --- Load target config ---
NAMESPACE="$(cfg "$TARGET" namespace)"
SVC="$(cfg "$TARGET" service)"
REMOTE_PORT="$(cfg "$TARGET" remote_port)"
LOCAL_PORT="$(cfg "$TARGET" local_port)"
DB_TYPE="$(cfg "$TARGET" db_type)"
DB_NAME="$(cfg "$TARGET" db_name)"
DB_NAME_KEY="$(cfg "$TARGET" db_name_key)"
DB_NAME_SECRET_NAME="$(cfg "$TARGET" db_name_secret_name)"
DB_NAME_SECRET_NAMESPACE="$(cfg "$TARGET" db_name_secret_namespace)"
DB_SCHEMA="$(cfg "$TARGET" schema)"
SECRET_NAME="$(cfg "$TARGET" secret_name)"
SECRET_NAMESPACE="$(cfg "$TARGET" secret_namespace)"
SECRET_KEY="$(cfg "$TARGET" secret_key)"
DB_USER="$(cfg "$TARGET" username)"
USERNAME_KEY="$(cfg "$TARGET" username_key)"
USERNAME_SECRET_NAME="$(cfg "$TARGET" username_secret_name)"
USERNAME_SECRET_NAMESPACE="$(cfg "$TARGET" username_secret_namespace)"
SAFETY="$(cfg "$TARGET" safety)"
CHANGELOG_REL="$(cfg "$TARGET" changelog_dir)"
CHANGELOG_FILE="$(cfg "$TARGET" changelog_file)"
HAS_CHANGELOG=false
if [[ -n "$CHANGELOG_REL" || -n "$CHANGELOG_FILE" ]]; then
  HAS_CHANGELOG=true
  CHANGELOG_DIR="$(resolve_config_path "${CHANGELOG_REL:-.}")"
  CHANGELOG_FILE="${CHANGELOG_FILE:-changelog-master.yaml}"
  if [[ "$CHANGELOG_FILE" == /* ]]; then
    CHANGELOG_PATH="$CHANGELOG_FILE"
    CHANGELOG_PROPERTY="$CHANGELOG_FILE"
    CHANGELOG_SEARCH_PATH="$(dirname "$CHANGELOG_FILE")"
  else
    CHANGELOG_PATH="${CHANGELOG_DIR%/}/$CHANGELOG_FILE"
    CHANGELOG_PROPERTY="$CHANGELOG_FILE"
    CHANGELOG_SEARCH_PATH="$CHANGELOG_DIR"
  fi
else
  CHANGELOG_DIR=""
  CHANGELOG_PATH=""
  CHANGELOG_PROPERTY=""
  CHANGELOG_SEARCH_PATH=""
fi

SECRET_KEYS=("$SECRET_KEY")
while IFS= read -r key; do
  [[ -n "$key" ]] && SECRET_KEYS+=("$key")
done < <(cfg_list "$TARGET" secret_key_fallbacks)

USERNAME_KEYS=("$USERNAME_KEY")
while IFS= read -r key; do
  [[ -n "$key" ]] && USERNAME_KEYS+=("$key")
done < <(cfg_list "$TARGET" username_key_fallbacks)

DB_NAME_KEYS=("$DB_NAME_KEY")
while IFS= read -r key; do
  [[ -n "$key" ]] && DB_NAME_KEYS+=("$key")
done < <(cfg_list "$TARGET" db_name_key_fallbacks)

SECRET_NAMESPACE="${SECRET_NAMESPACE:-$NAMESPACE}"
DB_NAME_SECRET_NAME="${DB_NAME_SECRET_NAME:-$SECRET_NAME}"
DB_NAME_SECRET_NAMESPACE="${DB_NAME_SECRET_NAMESPACE:-$SECRET_NAMESPACE}"
USERNAME_SECRET_NAME="${USERNAME_SECRET_NAME:-$SECRET_NAME}"
USERNAME_SECRET_NAMESPACE="${USERNAME_SECRET_NAMESPACE:-$SECRET_NAMESPACE}"
DB_SCHEMA="${DB_SCHEMA:-public}"
SAFETY="${SAFETY:-normal}"

missing=()
for required in NAMESPACE SVC REMOTE_PORT LOCAL_PORT DB_TYPE SECRET_NAME SECRET_KEY; do
  [[ -z "${!required}" ]] && missing+=("$required")
done
if [[ -z "$DB_NAME" && -z "$DB_NAME_KEY" ]]; then
  missing+=("db_name or db_name_key")
fi
if [[ -z "$DB_USER" && -z "$USERNAME_KEY" ]]; then
  missing+=("username or username_key")
fi
if [[ ${#missing[@]} -gt 0 ]]; then
  echo "Target '$TARGET' is missing required config: ${missing[*]}"
  exit 1
fi

# --- Readonly operations whitelist ---
READONLY_OPS="status diff validate history update-sql rollback-count-sql changelog-sync-sql"

# --- Safety gate ---
check_safety() {
  local cmd="$1"
  if [[ "$SAFETY" == "readonly" ]]; then
    if ! echo "$READONLY_OPS" | grep -qw "$cmd"; then
      echo "✗ Target '$TARGET' is read-only. Blocked: $cmd"
      echo "  Allowed: $READONLY_OPS"
      return 1
    fi
  elif [[ "$SAFETY" == "destructive" ]]; then
    case "$cmd" in
      update|rollback|rollback-count|drop-all|clear-checksums)
        echo ""
        echo "⚠  You are about to run '$cmd' against $TARGET (DESTRUCTIVE)."
        read -rp "Type 'yes' to confirm: " CONFIRM
        [[ "$CONFIRM" != "yes" ]] && { echo "Aborted."; return 1; }
        ;;
    esac
  fi
  return 0
}

args_have_changelog() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --changelog-file|--changelog-file=*|--changeLogFile|--changeLogFile=*|--change-log-file|--change-log-file=*)
        return 0
        ;;
    esac
  done
  return 1
}

liquibase_command_from_args() {
  local arg skip_next=false
  for arg in "$@"; do
    if [[ "$skip_next" == true ]]; then
      skip_next=false
      continue
    fi

    case "$arg" in
      --changelog-file|--changeLogFile|--change-log-file|--url|--username|--password|--defaults-file|--log-level|--contexts|--label-filter|--liquibase-schema-name|--default-schema-name)
        skip_next=true
        ;;
      --*)
        ;;
      -*)
        ;;
      *)
        printf '%s' "$arg"
        return 0
        ;;
    esac
  done
  return 1
}

if [[ "$SAFETY" == "readonly" ]]; then
  echo ""
  echo "⚠  Read-only target selected — write operations will be blocked."
  echo "   Allowed: $READONLY_OPS"
  echo ""
fi

if [[ "$SHELL_MODE" != true && ${#LB_ARGS[@]} -gt 0 && "$HAS_CHANGELOG" != true ]] && ! args_have_changelog "${LB_ARGS[@]}"; then
  echo "Target '$TARGET' has no changelog configured."
  echo "Use --shell for an interactive connection, or pass a Liquibase --changelog-file argument."
  exit 1
fi

# --- Fetch connection values from K8s secrets ---
if [[ -n "$DB_NAME_KEY" ]]; then
  echo "==> Fetching database name from secret $DB_NAME_SECRET_NAMESPACE/$DB_NAME_SECRET_NAME..."
  DB_NAME=$(fetch_secret_value_from_keys "$DB_NAME_SECRET_NAMESPACE" "$DB_NAME_SECRET_NAME" "${DB_NAME_KEYS[@]}") || {
    echo "Failed to read database name from secret $DB_NAME_SECRET_NAME in namespace $DB_NAME_SECRET_NAMESPACE"
    echo "Tried keys: ${DB_NAME_KEYS[*]}"
    exit 1
  }
fi

if [[ -n "$USERNAME_KEY" ]]; then
  echo "==> Fetching username from secret $USERNAME_SECRET_NAMESPACE/$USERNAME_SECRET_NAME..."
  DB_USER=$(fetch_secret_value_from_keys "$USERNAME_SECRET_NAMESPACE" "$USERNAME_SECRET_NAME" "${USERNAME_KEYS[@]}") || {
    echo "Failed to read username from secret $USERNAME_SECRET_NAME in namespace $USERNAME_SECRET_NAMESPACE"
    echo "Tried keys: ${USERNAME_KEYS[*]}"
    exit 1
  }
fi

echo "==> Fetching password from secret $SECRET_NAMESPACE/$SECRET_NAME..."
DB_PASS=$(fetch_secret_value_from_keys "$SECRET_NAMESPACE" "$SECRET_NAME" "${SECRET_KEYS[@]}") || {
  echo "Failed to read password from secret $SECRET_NAME in namespace $SECRET_NAMESPACE"
  echo "Tried keys: ${SECRET_KEYS[*]}"
  exit 1
}

# --- Start port-forward ---
echo "==> Port-forwarding $SVC:$REMOTE_PORT → localhost:$LOCAL_PORT"
kubectl port-forward -n "$NAMESPACE" "$SVC" "$LOCAL_PORT:$REMOTE_PORT" &>/dev/null &
PF_PID=$!

for i in {1..20}; do
  if nc -z localhost "$LOCAL_PORT" 2>/dev/null; then
    break
  fi
  if ! kill -0 "$PF_PID" 2>/dev/null; then
    echo "Port-forward process died. Is $SVC available in namespace $NAMESPACE?"
    exit 1
  fi
  sleep 0.5
done

if ! nc -z localhost "$LOCAL_PORT" 2>/dev/null; then
  echo "Timed out waiting for port-forward on localhost:$LOCAL_PORT"
  exit 1
fi
echo "==> Port-forward active (pid $PF_PID)"

# --- Build liquibase.properties in temp dir ---
TMPDIR_LB=$(mktemp -d)

if [[ "$DB_TYPE" == "postgresql" ]]; then
  JDBC_URL="jdbc:postgresql://localhost:$LOCAL_PORT/$DB_NAME?currentSchema=$DB_SCHEMA"
  {
    if [[ "$HAS_CHANGELOG" == true ]]; then
      printf 'changeLogFile=%s\n' "$CHANGELOG_PROPERTY"
      printf 'searchPath=%s\n' "$CHANGELOG_SEARCH_PATH"
    fi
    cat <<PROPS
url=$JDBC_URL
username=$DB_USER
password=$DB_PASS
defaultSchemaName=$DB_SCHEMA
liquibaseSchemaName=$DB_SCHEMA
liquibase.hub.mode=off
liquibase.show-banner=false
PROPS
  } > "$TMPDIR_LB/liquibase.properties"
elif [[ "$DB_TYPE" == "mysql" ]]; then
  JDBC_URL="jdbc:mysql://localhost:$LOCAL_PORT/$DB_NAME"
  {
    if [[ "$HAS_CHANGELOG" == true ]]; then
      printf 'changeLogFile=%s\n' "$CHANGELOG_PROPERTY"
      printf 'searchPath=%s\n' "$CHANGELOG_SEARCH_PATH"
    fi
    cat <<PROPS
url=$JDBC_URL
username=$DB_USER
password=$DB_PASS
defaultSchemaName=$DB_SCHEMA
liquibase.hub.mode=off
liquibase.show-banner=false
PROPS
  } > "$TMPDIR_LB/liquibase.properties"
else
  echo "Unsupported db_type for target '$TARGET': $DB_TYPE"
  echo "Supported types: postgresql, mysql"
  exit 1
fi

echo "==> Connected: $DB_TYPE @ localhost:$LOCAL_PORT/$DB_NAME (user: $DB_USER)"
echo ""

# --- Run liquibase ---
run_lb() {
  liquibase --defaults-file="$TMPDIR_LB/liquibase.properties" "$@"
}

interactive_shell() {
  echo ""
  echo "Dropping into zsh with port-forward active."
  echo "  DB: $DB_TYPE @ localhost:$LOCAL_PORT/$DB_NAME (user: $DB_USER)"
  if [[ "$HAS_CHANGELOG" == true ]]; then
    echo "  Changelog: $CHANGELOG_PATH"
  else
    echo "  Changelog: not configured for this target"
  fi
  echo "  Liquibase properties: $TMPDIR_LB/liquibase.properties"
  echo "  Type 'exit' to close the shell and tear down port-forward."
  echo ""
  export LB_DB_HOST=localhost
  export LB_DB_PORT="$LOCAL_PORT"
  export LB_DB_NAME="$DB_NAME"
  export LB_DB_SCHEMA="$DB_SCHEMA"
  export LB_DB_USER="$DB_USER"
  export LB_DB_PASS="$DB_PASS"
  export LB_DB_TYPE="$DB_TYPE"
  export LB_TARGET="$TARGET"
  export LB_DEFAULTS_FILE="$TMPDIR_LB/liquibase.properties"
  export LB_CHANGELOG_PATH="$CHANGELOG_PATH"
  export LB_CHANGELOG_DIR="$CHANGELOG_SEARCH_PATH"
  if [[ "$DB_TYPE" == "postgresql" ]]; then
    export PGHOST=localhost PGPORT="$LOCAL_PORT" PGDATABASE="$DB_NAME" PGUSER="$DB_USER" PGPASSWORD="$DB_PASS"
  elif [[ "$DB_TYPE" == "mysql" ]]; then
    export MYSQL_HOST=localhost MYSQL_TCP_PORT="$LOCAL_PORT" MYSQL_PWD="$DB_PASS"
  fi
  PROMPT="[lb:$TARGET] %~ %# " zsh
}

if [[ "$SHELL_MODE" == true ]]; then
  interactive_shell
elif [[ ${#LB_ARGS[@]} -gt 0 ]]; then
  # One-shot mode
  LB_CMD="$(liquibase_command_from_args "${LB_ARGS[@]}" || true)"
  LB_CMD="${LB_CMD:-${LB_ARGS[0]}}"
  check_safety "$LB_CMD" || exit 1
  echo "==> Running: liquibase ${LB_ARGS[*]}"
  echo ""
  run_lb "${LB_ARGS[@]}"
elif [[ "$HAS_CHANGELOG" != true ]]; then
  echo "Target '$TARGET' has no changelog configured; opening a connection shell."
  interactive_shell
else
  # Interactive menu
  echo "Liquibase interactive shell — $TARGET"
  echo "Changelog: $CHANGELOG_PATH"
  echo "Config: $CONFIG_FILE"
  echo ""
  while true; do
    echo "Commands:"
    echo "  1) status            — show pending changesets"
    echo "  2) update-sql        — preview SQL (dry run)"
    echo "  3) update            — apply pending migrations"
    echo "  4) rollback-sql N    — preview rollback of N changesets"
    echo "  5) history           — show applied changesets"
    echo "  6) diff              — diff database vs changelog"
    echo "  7) validate          — validate changelog syntax"
    echo "  8) custom            — enter a custom liquibase command"
    echo "  9) shell             — drop into free-form liquibase prompt"
    echo "  q) quit"
    echo ""
    read -rp "> " CHOICE

    case "$CHOICE" in
      1|status)
        check_safety "status" && run_lb status
        ;;
      2|update-sql)
        check_safety "update-sql" && run_lb update-sql
        ;;
      3|update)
        check_safety "update" && run_lb update
        ;;
      4|rollback*)
        read -rp "Number of changesets to preview rollback for: " N
        check_safety "rollback-count-sql" && run_lb rollback-count-sql "$N"
        ;;
      5|history)
        check_safety "history" && run_lb history
        ;;
      6|diff)
        check_safety "diff" && run_lb diff
        ;;
      7|validate)
        check_safety "validate" && run_lb validate
        ;;
      8|custom)
        read -rp "liquibase command (e.g. 'tag v1.0'): " CMD
        # shellcheck disable=SC2086
        check_safety "${CMD%% *}" && run_lb $CMD
        ;;
      9|shell)
        interactive_shell
        ;;
      q|quit|exit)
        echo "Bye."
        break
        ;;
      "")
        continue
        ;;
      *)
        echo "Unknown choice: $CHOICE"
        ;;
    esac
    echo ""
  done
fi
