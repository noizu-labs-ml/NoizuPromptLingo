#!/usr/bin/env bash
# =============================================================================
# tsdb-snapshot — EBS snapshot of TimescaleDB volume
#
# Takes an application-consistent EBS snapshot by bracketing with
# pg_backup_start/stop (forces a checkpoint, marks WAL for recovery).
# Pass --crash-only to skip the pg_backup bracket (e.g. for standby volumes).
#
# Usage:
#   tsdb-snapshot --config gnp --label "pre-promote"
#   tsdb-snapshot --config gnp-replica --label "daily"
#   tsdb-snapshot --config gnp --crash-only
#
# Targets are defined in infra-config.yaml under tsdb_snapshot_targets.
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config as a TARGET NAME (not a file path).
# We still need infra-config.yaml resolved via standard mechanisms, so do NOT
# export K8_CONFIG here — let the git-root walker find infra-config.yaml.
_TSDB_TARGET=""
_k8_prev=""
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) _TSDB_TARGET="${_k8_arg#--config=}" ;;
  esac
  [[ "$_k8_prev" == "--config" ]] && _TSDB_TARGET="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

# ── Resolve named target from YAML ─────────────────────────────────────────
if [[ -z "$_TSDB_TARGET" ]]; then
  # List available targets and bail
  echo "Usage: tsdb-snapshot --config <target> [--label <text>] [--crash-only]" >&2
  echo "" >&2
  echo "Available targets:" >&2
  yq eval '.tsdb_snapshot_targets | keys | .[]' "$_K8_MERGED_CONFIG" 2>/dev/null | while read -r t; do
    local_desc="$(yq eval ".tsdb_snapshot_targets.\"$t\".description // \"\"" "$_K8_MERGED_CONFIG" 2>/dev/null)"
    printf "  %-20s %s\n" "$t" "$local_desc" >&2
  done
  exit 1
fi

_target_exists="$(yq eval ".tsdb_snapshot_targets.\"$_TSDB_TARGET\" // \"\"" "$_K8_MERGED_CONFIG" 2>/dev/null)"
if [[ -z "$_target_exists" || "$_target_exists" == "null" ]]; then
  echo "❌ Unknown snapshot target: $_TSDB_TARGET" >&2
  echo "   Available targets:" >&2
  yq eval '.tsdb_snapshot_targets | keys | .[]' "$_K8_MERGED_CONFIG" 2>/dev/null | sed 's/^/     /' >&2
  exit 1
fi

# Load target values (env vars override YAML)
_tgt=".tsdb_snapshot_targets.\"$_TSDB_TARGET\""
NAMESPACE="${K8_NAMESPACE:-$(yq eval "$_tgt.namespace // \"gnp\"" "$_K8_MERGED_CONFIG")}"
K8_TSDB_LABEL="${K8_TSDB_LABEL:-$(yq eval "$_tgt.pod_label // \"timescaledb\"" "$_K8_MERGED_CONFIG")}"
SNAPSHOT_NAME="${K8_TSDB_SNAPSHOT_NAME:-$(yq eval "$_tgt.snapshot_name // \"timescaledb-snapshot\"" "$_K8_MERGED_CONFIG")}"
DB_NAME="${K8_DB_NAME:-$(yq eval "$_tgt.db_name // \"postgres\"" "$_K8_MERGED_CONFIG")}"
_yaml_crash="$(yq eval "$_tgt.crash_only // false" "$_K8_MERGED_CONFIG")"

POD_LABEL="app.kubernetes.io/name=${K8_TSDB_LABEL}"
REGION="${AWS_DEFAULT_REGION:-${K8_AWS_REGION:-us-east-1}}"
LABEL="manual"
CONSISTENT=true
[[ "$_yaml_crash" == "true" ]] && CONSISTENT=false

# ── Parse remaining args ───────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
  case "$1" in
    --config) shift 2 ;;
    --config=*) shift ;;
    --label) LABEL="$2"; shift 2 ;;
    --consistent) CONSISTENT=true; shift ;;
    --crash-only) CONSISTENT=false; shift ;;
    *) die "Unknown argument: $1" ;;
  esac
done

TIMESTAMP="$(date -u +%Y%m%dT%H%M%SZ)"
SNAPSHOT_DESC="${SNAPSHOT_NAME} ${LABEL} ${TIMESTAMP}"

info "Target: $_TSDB_TARGET (ns=$NAMESPACE, label=$POD_LABEL, mode=$(if [[ "$CONSISTENT" == "true" ]]; then echo "consistent"; else echo "crash-only"; fi))"

# ── Find pod ────────────────────────────────────────────────────────────────
step "Finding timescaledb pod"
POD="$(kubectl -n "$NAMESPACE" get pod -l "$POD_LABEL" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)" \
  || die "No pod found with label $POD_LABEL in namespace $NAMESPACE"
ok "Pod: $POD"

# ── Resolve PVC → PV → EBS volume ──────────────────────────────────────────
step "Resolving EBS volume from PVC"
PVC="$(kubectl -n "$NAMESPACE" get pod "$POD" -o jsonpath='{.spec.volumes[?(@.persistentVolumeClaim)].persistentVolumeClaim.claimName}')" \
  || die "Could not find PVC on pod $POD"
ok "PVC: $PVC"

PV="$(kubectl get pvc -n "$NAMESPACE" "$PVC" -o jsonpath='{.spec.volumeName}')" \
  || die "Could not resolve PV from PVC $PVC"
ok "PV:  $PV"

VOLUME_ID="$(kubectl get pv "$PV" -o jsonpath='{.spec.csi.volumeHandle}')" \
  || die "Could not get EBS volume handle from PV $PV"
ok "EBS: $VOLUME_ID"

# ── Persistent psql session helpers (backup mode is session-scoped in PG15+) ─
# We keep a single kubectl exec psql session alive via a FIFO so that
# pg_backup_start and pg_backup_stop run in the same connection.
_PSQL_FIFO=""
_PSQL_PID=""
_PSQL_OUT=""

_psql_session_start() {
  _PSQL_FIFO="$(mktemp -d)/psql_in"
  _PSQL_OUT="$(mktemp)"
  mkfifo "$_PSQL_FIFO"
  kubectl -n "$NAMESPACE" exec -i "$POD" -- \
    psql -U postgres -d "$DB_NAME" -At < "$_PSQL_FIFO" > "$_PSQL_OUT" 2>&1 &
  _PSQL_PID=$!
  exec 7>"$_PSQL_FIFO"
}

_psql_session_exec() {
  local sql="$1"
  local marker="__TSDB_SNAP_DONE__"
  truncate -s 0 "$_PSQL_OUT"
  echo "SET statement_timeout = 0;" >&7
  echo "$sql" >&7
  echo "SELECT '${marker}';" >&7
  local _wait=0
  while ! grep -q "$marker" "$_PSQL_OUT" 2>/dev/null; do
    sleep 0.5
    _wait=$(( _wait + 1 ))
    if [[ $_wait -ge 120 ]]; then
      return 1
    fi
    if ! kill -0 "$_PSQL_PID" 2>/dev/null; then
      return 1
    fi
  done
  grep -v "$marker" "$_PSQL_OUT"
  if grep -qi "^ERROR" "$_PSQL_OUT"; then
    return 1
  fi
  return 0
}

_psql_session_stop() {
  if [[ -n "$_PSQL_PID" ]] && kill -0 "$_PSQL_PID" 2>/dev/null; then
    echo "\\q" >&7 2>/dev/null || true
    exec 7>&- 2>/dev/null || true
    wait "$_PSQL_PID" 2>/dev/null || true
  fi
  [[ -n "$_PSQL_FIFO" ]] && rm -rf "$(dirname "$_PSQL_FIFO")" 2>/dev/null || true
  [[ -n "$_PSQL_OUT" ]] && rm -f "$_PSQL_OUT" 2>/dev/null || true
  _PSQL_PID=""
}

trap '_psql_session_stop' EXIT

# ── Optional: pg_backup_start (primary only) ────────────────────────────────
if [[ "$CONSISTENT" == "true" ]]; then
  step "Starting persistent psql session for backup bracketing"
  _psql_session_start
  ok "Session PID: $_PSQL_PID"

  step "Starting Postgres backup mode (forces checkpoint)"
  _psql_session_exec "SELECT pg_backup_start('${SNAPSHOT_DESC}');" \
    || die "pg_backup_start failed — is this a standby? Use --crash-only."
  ok "Backup mode active"
fi

# ── Create EBS snapshot ─────────────────────────────────────────────────────
step "Creating EBS snapshot"
SNAPSHOT_ID="$(aws ec2 create-snapshot \
  --region "$REGION" \
  --volume-id "$VOLUME_ID" \
  --description "$SNAPSHOT_DESC" \
  --tag-specifications "ResourceType=snapshot,Tags=[{Key=Name,Value=${SNAPSHOT_NAME}},{Key=Source,Value=tsdb-snapshot},{Key=Label,Value=${LABEL}},{Key=Timestamp,Value=${TIMESTAMP}},{Key=Target,Value=${_TSDB_TARGET}}]" \
  --query 'SnapshotId' --output text)" \
  || {
    if [[ "$CONSISTENT" == "true" ]]; then
      warn "Snapshot failed — releasing backup mode"
      _psql_session_exec "SELECT pg_backup_stop();" 2>/dev/null || true
      _psql_session_stop
    fi
    die "aws ec2 create-snapshot failed for $VOLUME_ID"
  }
ok "Snapshot: $SNAPSHOT_ID"

# ── Wait for EBS snapshot to complete before releasing backup mode ──────────
if [[ "$CONSISTENT" == "true" ]]; then
  SNAPSHOT_TIMEOUT="${K8_TSDB_SNAPSHOT_TIMEOUT:-3600}"
  step "Waiting for EBS snapshot to complete (timeout: ${SNAPSHOT_TIMEOUT}s)"

  _snap_start="$(date +%s)"
  _last_progress=""
  while true; do
    _elapsed="$(( $(date +%s) - _snap_start ))"
    if [[ "$_elapsed" -ge "$SNAPSHOT_TIMEOUT" ]]; then
      warn "Snapshot wait timed out after ${SNAPSHOT_TIMEOUT}s — releasing backup mode anyway"
      _psql_session_exec "SELECT pg_backup_stop();" 2>/dev/null \
        || warn "pg_backup_stop failed — backup mode may need manual cleanup"
      _psql_session_stop
      die "EBS snapshot $SNAPSHOT_ID did not complete within ${SNAPSHOT_TIMEOUT}s"
    fi

    _snap_json="$(aws ec2 describe-snapshots --region "$REGION" \
      --snapshot-ids "$SNAPSHOT_ID" \
      --query 'Snapshots[0].[State,Progress]' --output text 2>/dev/null)" || true
    _snap_state="$(echo "$_snap_json" | awk '{print $1}')"
    _snap_progress="$(echo "$_snap_json" | awk '{print $2}')"

    if [[ "$_snap_state" == "completed" ]]; then
      ok "Snapshot completed (100%) in ${_elapsed}s"
      break
    elif [[ "$_snap_state" == "error" ]]; then
      warn "Snapshot entered error state — releasing backup mode"
      _psql_session_exec "SELECT pg_backup_stop();" 2>/dev/null \
        || warn "pg_backup_stop failed — backup mode may need manual cleanup"
      _psql_session_stop
      die "EBS snapshot $SNAPSHOT_ID failed"
    fi

    if [[ "$_snap_progress" != "$_last_progress" ]]; then
      info "  Snapshot progress: ${_snap_progress} (${_elapsed}s elapsed)"
      _last_progress="$_snap_progress"
    fi

    sleep 15
  done

  step "Stopping Postgres backup mode"
  _psql_session_exec "SELECT pg_backup_stop();" \
    || warn "pg_backup_stop failed — backup mode may need manual cleanup"
  ok "Backup mode released"
  _psql_session_stop
fi

# ── Summary ─────────────────────────────────────────────────────────────────
echo ""
echo -e "${GRN}Snapshot initiated successfully${NC}"
echo -e "  Target:       ${_TSDB_TARGET}"
echo -e "  Snapshot ID:  ${SNAPSHOT_ID}"
echo -e "  Volume:       ${VOLUME_ID}"
echo -e "  Description:  ${SNAPSHOT_DESC}"
echo -e "  Region:       ${REGION}"
echo -e "  Mode:         $(if [[ "$CONSISTENT" == "true" ]]; then echo "app-consistent"; else echo "crash-consistent"; fi)"
echo ""
echo -e "  Monitor progress:"
echo -e "    aws ec2 describe-snapshots --snapshot-ids ${SNAPSHOT_ID} --query 'Snapshots[0].Progress'"
