#!/usr/bin/env bash
# media-eval-port-forward — keep the in-cluster evaluator proxy reachable locally.
#
# The generate-media-prompt eval system probes endpoints in this order:
#   1. MEDIA_EVAL_BASE_URL env var (if set)
#   2. http://192.168.68.59:3713/v1  — LAN inference server hosting Qwen 3.6
#   3. http://noizu.server:3713/v1  — noizu.server forward of the LAN server
#   4. http://lmstudio-proxy:3713/v1  — in-cluster service (platform-ai namespace)
#   5. http://127.0.0.1:3713/v1  — kubectl port-forward (what this script provides)
#
# This script is only needed when the LAN inference server (192.168.68.59:3713)
# is NOT directly reachable from this machine. It forwards the in-cluster
# lmstudio-proxy service to localhost:3713.
#
# The LAN server also forwards to noizu.server so the cluster's lmstudio-proxy
# bridge can reach it — that path must be up for in-cluster eval to work.
#
# Usage:
#   bin/media-eval-port-forward          # runs in foreground, Ctrl-C to stop
#   bin/media-eval-port-forward &        # background

set -euo pipefail

NS="platform-ai"
SVC="svc/lmstudio-proxy"
LOCAL_PORT=3713
REMOTE_PORT=3713
CONTEXT="noizu"

while true; do
  echo "[$(date)] Starting port-forward ${SVC} ${LOCAL_PORT}:${REMOTE_PORT} (context: ${CONTEXT}) ..."
  kubectl --context "${CONTEXT}" -n "${NS}" port-forward "${SVC}" "${LOCAL_PORT}:${REMOTE_PORT}" || true
  echo "[$(date)] Port-forward exited. Reconnecting in 2s ..."
  sleep 2
done
