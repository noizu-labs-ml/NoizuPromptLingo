# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: game-breakout-001
type: html
service: z.ai
model: grok-4.3

prompt:
  system: |
    Generate a complete, self-contained HTML file with inline JavaScript.
    No external dependencies except a single CDN script tag for the game library if needed.
    The game must be playable immediately on opening the HTML file in a browser.
    Use HTML5 Canvas for rendering. Clean, well-structured code.
  text: |
    Create a Breakout/Arkanoid clone using HTML5 Canvas:
    - Paddle at bottom, controlled by mouse movement
    - Ball bounces off walls, paddle, and bricks
    - 5 rows of 8 colored bricks (rainbow gradient top to bottom)
    - Score counter and lives (3 lives)
    - Ball speeds up slightly each time it hits the paddle
    - "Game Over" and "You Win" screens with restart button
    - Dark background (#1a1a2e), neon-colored ball and paddle (#00d4ff)
    - Smooth 60fps animation via requestAnimationFrame
  provider_options:
    max_tokens: 8192
    temperature: 0.3

output:
  formats:
    - format: html

tags: [game, breakout, canvas, interactive]
