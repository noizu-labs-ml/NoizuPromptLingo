schema: "0.4"
id: base-logo-001
type: image
quality: high

prompt:
  text: "Minimal geometric logomark, interconnected hexagons forming a brain shape, electric cyan and deep navy gradient, clean vector lines on transparent background"
  negative: "realistic, photographic, text, words, busy, cluttered, 3D, shadows"
  style: vector-logo

output:
  formats:
    - format: png
      quality: 100
  dimensions:
    width: 1024
    height: 1024
    aspect_ratio: "1:1"
  transparency: required
  color_space: sRGB
  dpi: 300

tags: [logo, brand, tier-0]
product_targets: [favicon, og-card, hero-image]

eval:
  pass_threshold: 0.7
  required_pass: [relevance]
  criteria:
    relevance:
      weight: 3
      description: "Recognizable brain/hexagon logomark"
      fail_signals: ["no hexagons", "text present"]
    composition:
      weight: 2
      description: "Balanced, works at small sizes, reads as a logomark"
    technical:
      weight: 3
      description: "Clean edges, proper transparency, no compression artifacts"
    brand_fit:
      weight: 2
      description: "Matches tech/AI brand aesthetic — cyan on navy"
  reject_if:
    - "contains text or letterforms"
    - "photorealistic"
    - "watermark or signature"
