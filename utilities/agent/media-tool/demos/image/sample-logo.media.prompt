schema: "0.3"
id: base-logo-001
type: image
service: gemini
model: imagen-4.0-generate-001

prompt:
  text: "Minimal geometric logomark, interconnected hexagons forming a brain shape, electric cyan and deep navy gradient, clean vector lines on transparent background"
  negative: "realistic, photographic, text, words, busy, cluttered, 3D, shadows"
  style: vector-logo

output:
  formats:
    - format: png
      quality: 100
  dimensions:
    width: 1024
    height: 1024
    aspect_ratio: "1:1"
  transparency: required
  color_space: sRGB
  dpi: 300

tags: [logo, brand, tier-0]
product_targets: [favicon, og-card, hero-image]

eval:
  pass_threshold: 3.5
  required_pass: [relevance]
  criteria:
    relevance:
      weight: 0.30
      scale: [1, 5]
      description: "Recognizable brain/hexagon logomark"
    composition:
      weight: 0.20
      scale: [1, 5]
      description: "Balanced, works at small sizes"
    technical:
      weight: 0.25
      scale: [1, 5]
      description: "Clean edges, proper transparency"
    brand_fit:
      weight: 0.25
      scale: [1, 5]
      description: "Matches tech/AI brand aesthetic"
  reject_if:
    - "contains text or letterforms"
    - "photorealistic"
