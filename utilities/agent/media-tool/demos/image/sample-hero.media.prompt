schema: "0.4"
id: hero-with-logo-001
type: image
quality: high

attachments:
  - path: ./refs/brand-palette.png
    role: style
    description: "Reference palette: deep navy (#0A1628), electric cyan (#00D4FF), warm white (#F5F5F0)"

prompt:
  text: "Modern SaaS landing page hero section, dark navy gradient background, a minimal geometric logomark of interconnected hexagons centered above the headline 'Build Smarter', floating geometric shapes in cyan, clean sans-serif typography, 16:10 aspect ratio, color palette from the reference image"
  negative: "wireframe, cluttered, light theme, realistic photo, stock photo"
  style: screenshot-mockup

output:
  formats:
    - format: png
      quality: 100
    - format: webp
      quality: 85
  dimensions:
    width: 1440
    height: 900
    aspect_ratio: "16:9"
  transparency: none
  color_space: sRGB
  dpi: 72

post_processing:
  - action: resize
    params:
      width: 1200
      height: 750
      fit: cover

tags: [hero, landing, tier-1]
product_targets: [hero-image, og-card]

eval:
  pass_threshold: 0.75
  max_attempts: 3
  required_pass: [relevance]
  criteria:
    relevance:
      weight: 3
      description: "SaaS landing page with hexagon logomark and 'Build Smarter' headline visible"
      fail_signals: ["missing headline", "no logomark"]
    composition:
      weight: 2
      description: "Clear visual hierarchy, CTA prominence, floating shapes balanced"
    technical:
      weight: 2
      description: "Sharp, correct 16:9 dimensions, no artifacts"
    web_ready:
      weight: 2
      description: "Web-optimized, has text overlay space, dark background maintained"
    brand_fit:
      weight: 1
      description: "Matches dark tech brand aesthetic — navy and cyan palette"
  reject_if:
    - "obvious AI artifacts"
    - "wrong aspect ratio"
    - "watermark visible"
