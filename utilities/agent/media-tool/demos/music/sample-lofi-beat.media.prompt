schema: "0.4"
id: background-music-001
type: music
quality: medium

prompt:
  text: "A calm lo-fi hip hop beat with soft piano chords, vinyl crackle, and a gentle bass line. Relaxing study music vibes."
  negative: "Heavy Metal, Screaming, Aggressive"
  provider_options:
    instrumental: true
    customMode: true
    style: "Lo-fi Hip Hop, Chill, Ambient"
    title: "Study Session"

output:
  duration: 120            # 2 minutes; passed as a track-length hint where supported
  formats:
    - format: mp3

# eval: omitted — audio is not yet auto-gradable by the eval system.
# The tool warns and accepts the first successful generation for music types.

tags: [background, lofi, ambient]
product_targets: [video-background, podcast-intro]
