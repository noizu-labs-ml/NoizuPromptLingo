# v0.3 back-compat fixture — pins service: explicitly; kept as-is for backward-compatibility testing
schema: "0.3"
id: react-landing-001
type: react-page
service: z.ai
model: grok-4.3

prompt:
  system: |
    You are a React component generator. Output a single self-contained TSX file using:
    - React 18+ with hooks
    - Tailwind CSS classes for styling
    - No external dependencies beyond React and Tailwind
    - Export as default
  text: "Create a SaaS landing page with: hero section (dark gradient background, headline, subheading, CTA button), features grid (3 columns with icons), testimonials carousel, and footer with links."
  provider_options:
    max_tokens: 8192
    temperature: 0.3

output:
  formats:
    - format: tsx

tags: [landing-page, react, saas]
