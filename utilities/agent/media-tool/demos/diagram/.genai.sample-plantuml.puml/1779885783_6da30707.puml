@startuml
class Product {
  -id: int
  -name: string
  -price: float
  -description: string
}

class Cart {
  -id: int
  -createdAt: DateTime
}

class CartItem {
  -quantity: int
}

class Order {
  -id: int
  -orderDate: DateTime
  -status: string
  -totalAmount: float
}

class OrderLine {
  -quantity: int
  -price: float
}

class Customer {
  -id: int
  -name: string
  -email: string
  -address: string
}

Customer "1" -- "0..*" Cart : owns >
Cart "1" *-- "0..*" CartItem : contains
CartItem "1" -- "1" Product : refers to >
Customer "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderLine : contains
OrderLine "1" -- "1" Product : refers to >
@enduml