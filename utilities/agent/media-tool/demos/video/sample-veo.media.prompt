schema: "0.4"
id: promo-veo-001
type: video
quality: high

prompt:
  text: "A robot hand carefully placing the final piece of a glowing circuit board puzzle, camera pulls back to reveal a complete futuristic cityscape. Warm golden lighting, hopeful tone."
  provider_options:
    resolution: "720p"
    personGeneration: "allow_all"

output:
  duration: 8
  formats:
    - format: mp4
  dimensions:
    aspect_ratio: "16:9"

tags: [promo, robot, cinematic]
product_targets: [landing-page, youtube-ad]

eval:
  pass_threshold: 0.7
  criteria:
    motion_quality:
      weight: 3
      description: "Smooth camera pull-back, no warping or temporal artifacts"
    prompt_adherence:
      weight: 3
      description: "Robot hand placing puzzle piece and cityscape reveal both visible"
      fail_signals: ["no robot hand", "cityscape not revealed"]
    technical:
      weight: 2
      description: "Full 8-second duration rendered, correct 16:9 aspect ratio"
  reject_if:
    - "abrupt cut before cityscape reveal"
    - "watermark visible"
