# Example sudoers fragment for secret-bucket.
# Install with visudo, not by direct editing:
#   sudo visudo -f /etc/sudoers.d/secret-bucket
#
# Replace AGENT_USER with the local account used by agents.

Cmnd_Alias SECRET_BUCKET = /usr/local/sbin/secret-bucket
AGENT_USER ALL=(root) NOPASSWD: SECRET_BUCKET

# Avoid sudo I/O logging for this command. secret-bucket itself emits value-free
# audit output, but stdin/stdout capture can become risky for future workflows.
Defaults!SECRET_BUCKET !log_input
Defaults!SECRET_BUCKET !log_output
