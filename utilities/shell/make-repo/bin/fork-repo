#!/usr/bin/env bash
set -euo pipefail
# =============================================================================
# fork-repo — Fork a GitHub repo and configure remotes.
#
# Two modes of operation:
#   Local clone mode (no positional arg):
#     Forks the repo of the current directory, renames origin to upstream,
#     and sets the fork as the new origin.
#
#   Remote slug mode (positional org/repo arg):
#     Forks the specified repo. With --clone, clones the fork locally
#     and adds the source as the upstream remote.
#
# Usage:
#   fork-repo                              # fork current directory's repo
#   fork-repo org/repo                     # fork a specified repo
#   fork-repo --org my-org                 # fork into a specific org
#   fork-repo --clone                      # clone after forking (slug mode)
#   fork-repo --yes                        # skip confirmation prompt
#   fork-repo --dry-run                    # show what would happen
#
# Environment:
#   GH_FORK_TARGET_ORG          — default target org for forks
#   GH_FORK_TARGET_ORG_OVERRIDE — override target org (beats all except CLI)
# =============================================================================

# --- Colours -----------------------------------------------------------------
RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'
BLU=$'\033[0;34m'; CYN=$'\033[0;36m'; NC=$'\033[0m'
BOLD=$'\033[1m'

banner()  { echo -e "\n${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; echo -e "${BLU}${BOLD}  $1${NC}"; echo -e "${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; }
step()    { echo -e "\n${BLU}▶ $1${NC}"; }
ok()      { echo -e "  ${GRN}✅ $1${NC}"; }
warn()    { echo -e "  ${YEL}⚠️  $1${NC}"; }
fail()    { echo -e "  ${RED}❌ $1${NC}"; }
info()    { echo -e "  ${CYN}ℹ️  $1${NC}"; }
die()     { echo -e "\n${RED}❌ $1${NC}\n"; exit 1; }

# --- Parse CLI flags ---------------------------------------------------------
cli_target_org=""
source_slug=""
do_clone=false
auto_confirm=false
dry_run=false

args=("$@")
set -- "${args[@]}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --org)        cli_target_org="$2"; shift 2 ;;
    --clone)      do_clone=true; shift ;;
    --yes|-y)     auto_confirm=true; shift ;;
    --dry-run)    dry_run=true; shift ;;
    --help|-h)    head -25 "$0" | tail -n +3 | sed 's/^# \?//'; exit 0 ;;
    -*)           die "Unknown flag: $1 (try --help)" ;;
    *)
      if [[ -z "$source_slug" ]]; then
        source_slug="$1"; shift
      else
        die "Unexpected argument: $1 (try --help)"
      fi
      ;;
  esac
done

# --- Preflight checks -------------------------------------------------------
command -v gh >/dev/null 2>&1 || die "gh CLI not found — install with: brew install gh"
gh auth status >/dev/null 2>&1 || die "Not authenticated — run: gh auth login"

# --- Resolve operating mode --------------------------------------------------
mode=""          # "local" or "remote"
source_org=""
source_repo=""
remote_scheme="" # "ssh" or "https"

parse_github_slug() {
  local url="$1"
  case "$url" in
    git@github.com:*)
      remote_scheme="ssh"
      source_org="$(echo "$url" | sed 's|git@github.com:||;s|/.*||')"
      source_repo="$(echo "$url" | sed 's|git@github.com:[^/]*/||;s|\.git$||')"
      ;;
    *github.com/*)
      remote_scheme="https"
      source_org="$(echo "$url" | sed 's|.*github.com/||;s|/.*||')"
      source_repo="$(echo "$url" | sed 's|.*github.com/[^/]*/||;s|\.git$||')"
      ;;
    *)
      return 1
      ;;
  esac
  return 0
}

if [[ -n "$source_slug" ]]; then
  # Remote slug mode — parse org/repo from the slug
  if [[ "$source_slug" == */* ]]; then
    source_org="${source_slug%%/*}"
    source_repo="${source_slug#*/}"
  else
    die "Invalid repo slug: ${source_slug} (expected org/repo)"
  fi

  # Check if we happen to be inside a clone of this repo
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local_origin="$(git remote get-url origin 2>/dev/null || true)"
    if [[ -n "$local_origin" ]]; then
      local_org="" local_repo=""
      case "$local_origin" in
        git@github.com:*)
          local_org="$(echo "$local_origin" | sed 's|git@github.com:||;s|/.*||')"
          local_repo="$(echo "$local_origin" | sed 's|git@github.com:[^/]*/||;s|\.git$||')"
          ;;
        *github.com/*)
          local_org="$(echo "$local_origin" | sed 's|.*github.com/||;s|/.*||')"
          local_repo="$(echo "$local_origin" | sed 's|.*github.com/[^/]*/||;s|\.git$||')"
          ;;
      esac
      if [[ "$local_org" == "$source_org" && "$local_repo" == "$source_repo" ]]; then
        mode="local"
        parse_github_slug "$local_origin"
      fi
    fi
  fi

  if [[ -z "$mode" ]]; then
    mode="remote"
    remote_scheme="ssh"  # default for new clones
  fi
else
  # Local clone mode — detect from cwd
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    die "Not inside a git repo. Provide a repo slug: fork-repo org/repo"
  fi

  if [[ -f .git ]]; then
    warn "Running inside a submodule — fork will target the submodule's own remote, not the parent repo."
  fi

  local_origin="$(git remote get-url origin 2>/dev/null || true)"
  if [[ -z "$local_origin" ]]; then
    die "No origin remote found. Provide a repo slug: fork-repo org/repo"
  fi

  if ! parse_github_slug "$local_origin"; then
    die "Origin remote is not a GitHub URL: ${local_origin}"
  fi

  mode="local"
fi

source_slug="${source_org}/${source_repo}"

# --- Resolve target org ------------------------------------------------------
resolve() {
  local cli_val="$1" override_val="$2" base_val="$3" default_val="$4"
  if [[ -n "$cli_val" ]]; then echo "$cli_val"
  elif [[ -n "$override_val" ]]; then echo "$override_val"
  elif [[ -n "$base_val" ]]; then echo "$base_val"
  else echo "$default_val"
  fi
}

target_org="$(resolve \
  "$cli_target_org" \
  "${GH_FORK_TARGET_ORG_OVERRIDE:-}" \
  "${GH_FORK_TARGET_ORG:-}" \
  "")"

# --- Determine fork identity -------------------------------------------------
if [[ -n "$target_org" ]]; then
  fork_owner="$target_org"
else
  fork_owner="$(gh api /user -q '.login' 2>/dev/null || die "Could not determine your GitHub username")"
fi

fork_slug="${fork_owner}/${source_repo}"

# Guard: can't fork into the same org
if [[ "$fork_owner" == "$source_org" ]]; then
  die "Cannot fork ${source_slug} into ${fork_owner} — that's the source org."
fi

# --- Verify source repo exists -----------------------------------------------
step "Checking source repo"
if ! gh repo view "$source_slug" --json nameWithOwner >/dev/null 2>&1; then
  die "Source repo not found: ${source_slug}"
fi
ok "Source repo exists: ${source_slug}"

# --- Check if fork already exists --------------------------------------------
fork_exists=false
if gh repo view "$fork_slug" --json nameWithOwner >/dev/null 2>&1; then
  fork_exists=true
  info "Fork already exists: ${fork_slug}"
fi

# --- Build fork URL matching original scheme ---------------------------------
build_remote_url() {
  local owner="$1" repo="$2"
  if [[ "$remote_scheme" == "ssh" ]]; then
    echo "git@github.com:${owner}/${repo}.git"
  else
    echo "https://github.com/${owner}/${repo}.git"
  fi
}

fork_url="$(build_remote_url "$fork_owner" "$source_repo")"
source_url="$(build_remote_url "$source_org" "$source_repo")"

# --- Check existing remote state (local mode) --------------------------------
upstream_status=""  # "none", "matches", "conflicts"
origin_is_fork=false

if [[ "$mode" == "local" ]]; then
  existing_upstream="$(git remote get-url upstream 2>/dev/null || true)"
  if [[ -z "$existing_upstream" ]]; then
    upstream_status="none"
  elif [[ "$existing_upstream" == *"${source_org}/${source_repo}"* ]]; then
    upstream_status="matches"
  else
    upstream_status="conflicts"
  fi

  existing_origin="$(git remote get-url origin 2>/dev/null || true)"
  if [[ "$existing_origin" == *"${fork_owner}/${source_repo}"* ]]; then
    origin_is_fork=true
  fi
fi

# --- Mode label for display --------------------------------------------------
if [[ "$mode" == "local" ]]; then
  mode_label="local (rename remotes in place)"
else
  if [[ "$do_clone" == true ]]; then
    mode_label="remote (fork + clone)"
  else
    mode_label="remote (fork only)"
  fi
fi

# --- Dry-run output ----------------------------------------------------------
if [[ "$dry_run" == true ]]; then
  banner "Fork Repo (dry run)"
  info "Source:    ${source_slug}"
  info "Fork to:   ${fork_slug}${target_org:+ (org: ${target_org})}${target_org:-" (personal account)"}"
  info "Mode:      ${mode_label}"
  if [[ "$fork_exists" == true ]]; then
    info "Fork:      already exists — will skip creation"
  fi
  if [[ "$mode" == "local" ]]; then
    case "$upstream_status" in
      none)      info "Remotes:   origin → upstream, fork → origin" ;;
      matches)   info "Remotes:   upstream already set correctly, verify origin" ;;
      conflicts) warn "Remotes:   upstream exists but points to ${existing_upstream}" ;;
    esac
    if [[ "$origin_is_fork" == true ]]; then
      info "Origin:    already points to fork — no changes needed"
    fi
  fi
  warn "Dry run — no changes made."
  exit 0
fi

# --- Confirmation prompt -----------------------------------------------------
confirm_and_edit() {
  while true; do
    banner "Fork Repo"
    echo ""
    echo -e "  ${BOLD}[1]${NC} Source:    ${CYN}${source_slug}${NC}"
    if [[ -n "$target_org" ]]; then
      echo -e "  ${BOLD}[2]${NC} Fork to:   ${CYN}${fork_slug}${NC} (org: ${target_org})"
    else
      echo -e "  ${BOLD}[2]${NC} Fork to:   ${CYN}${fork_slug}${NC} (personal account)"
    fi
    echo -e "  ${BOLD}[3]${NC} Mode:      ${CYN}${mode_label}${NC}"
    if [[ "$fork_exists" == true ]]; then
      echo -e "      ${CYN}Fork already exists — will skip creation${NC}"
    fi
    if [[ "$mode" == "local" && "$upstream_status" == "conflicts" ]]; then
      echo -e "      ${YEL}upstream remote exists → ${existing_upstream}${NC}"
    fi
    if [[ "$mode" == "local" && "$origin_is_fork" == true ]]; then
      echo -e "      ${CYN}origin already points to fork — no remote changes needed${NC}"
    fi
    echo ""
    echo -e "  ${BOLD}[y]${NC} Confirm and fork"
    echo -e "  ${BOLD}[n]${NC} Abort"
    echo -e "  ${BOLD}[1-2]${NC} Edit a field"
    echo ""
    read -rp "  > " choice

    case "$choice" in
      y|Y|yes) return 0 ;;
      n|N|no|q) warn "Aborted."; exit 1 ;;
      1)
        read -rp "  Source repo [${source_slug}]: " new_val
        if [[ -n "$new_val" ]]; then
          if [[ "$new_val" != */* ]]; then
            warn "Expected org/repo format"
          else
            source_org="${new_val%%/*}"
            source_repo="${new_val#*/}"
            source_slug="${source_org}/${source_repo}"
            fork_slug="${fork_owner}/${source_repo}"
            fork_url="$(build_remote_url "$fork_owner" "$source_repo")"
            source_url="$(build_remote_url "$source_org" "$source_repo")"
            fork_exists=false
            gh repo view "$fork_slug" --json nameWithOwner >/dev/null 2>&1 && fork_exists=true
          fi
        fi
        ;;
      2)
        read -rp "  Target org (blank for personal account) [${target_org:-personal}]: " new_val
        if [[ -n "$new_val" ]]; then
          target_org="$new_val"
          fork_owner="$new_val"
        else
          target_org=""
          fork_owner="$(gh api /user -q '.login' 2>/dev/null)"
        fi
        fork_slug="${fork_owner}/${source_repo}"
        fork_url="$(build_remote_url "$fork_owner" "$source_repo")"
        fork_exists=false
        gh repo view "$fork_slug" --json nameWithOwner >/dev/null 2>&1 && fork_exists=true
        ;;
      *) warn "Invalid choice: ${choice}" ;;
    esac
  done
}

if [[ "$auto_confirm" == false ]]; then
  confirm_and_edit
fi

# --- Execute fork ------------------------------------------------------------
if [[ "$fork_exists" == false ]]; then
  step "Forking ${source_slug}"
  fork_args=(gh repo fork "$source_slug" --clone=false)
  if [[ -n "$target_org" ]]; then
    fork_args+=(--org "$target_org")
  fi
  "${fork_args[@]}"
  ok "Forked: ${fork_slug}"
else
  step "Fork already exists"
  ok "Using existing fork: ${fork_slug}"
fi

# --- Configure remotes -------------------------------------------------------
if [[ "$mode" == "local" ]]; then
  # Already fully configured?
  if [[ "$origin_is_fork" == true && "$upstream_status" == "matches" ]]; then
    step "Remotes already configured"
    ok "origin → ${fork_url}"
    ok "upstream → ${source_url}"
  else
    step "Configuring remotes"

    # Handle upstream
    case "$upstream_status" in
      none)
        git remote rename origin upstream
        ok "Renamed origin → upstream"
        ;;
      matches)
        ok "upstream already points to source"
        ;;
      conflicts)
        warn "upstream remote exists but points to: ${existing_upstream}"
        if [[ "$auto_confirm" == true ]]; then
          git remote set-url upstream "$source_url"
          ok "Overwrote upstream → ${source_url}"
        else
          read -rp "  Overwrite upstream to point to source? [y/N] " overwrite
          if [[ "$overwrite" =~ ^[yY](es)?$ ]]; then
            git remote set-url upstream "$source_url"
            ok "Overwrote upstream → ${source_url}"
          else
            warn "Leaving upstream as-is. You may need to configure it manually."
          fi
        fi
        ;;
    esac

    # Handle origin
    if [[ "$origin_is_fork" == true ]]; then
      ok "origin already points to fork"
    elif [[ "$upstream_status" == "none" ]]; then
      # We renamed origin to upstream, so origin no longer exists
      git remote add origin "$fork_url"
      ok "Added origin → ${fork_url}"
    else
      # origin still exists (upstream was pre-existing) — update it
      git remote set-url origin "$fork_url"
      ok "Set origin → ${fork_url}"
    fi

    # Fetch and set tracking
    step "Fetching from fork"
    git fetch origin
    current_branch="$(git branch --show-current)"
    if [[ -n "$current_branch" ]]; then
      git branch --set-upstream-to="origin/${current_branch}" "$current_branch" 2>/dev/null || true
      ok "Tracking: ${current_branch} → origin/${current_branch}"
    fi
  fi

elif [[ "$mode" == "remote" && "$do_clone" == true ]]; then
  step "Cloning fork"
  gh repo clone "$fork_slug"
  ok "Cloned: ${fork_slug}"

  clone_dir="$source_repo"
  cd "$clone_dir"

  step "Adding upstream remote"
  git remote add upstream "$source_url"
  git fetch upstream
  ok "upstream → ${source_url}"
fi

# --- Done --------------------------------------------------------------------
echo ""
ok "Done! ${fork_slug}"
info "Fork:     https://github.com/${fork_slug}"
info "Source:   https://github.com/${source_slug}"
if [[ "$mode" == "local" ]]; then
  echo ""
  info "Remotes:"
  git remote -v | sed 's/^/    /'
fi
