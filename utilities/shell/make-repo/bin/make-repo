#!/usr/bin/env bash
set -euo pipefail
# =============================================================================
# make-repo — Create a GitHub repo and push the current directory.
#
# Defaults: org=noizu, repo name=current folder basename, private visibility.
# When run inside an existing GitHub repo (or submodule), inherits the parent
# repo's org and visibility unless overridden.
#
# Precedence (highest wins):
#   1. CLI flags          (--org, --public, etc.)
#   2. _OVERRIDE env vars (GH_NEW_REPO_ORG_OVERRIDE, etc.)
#   3. Parent repo        (detected from nearest GitHub remote)
#   4. Base env vars      (GH_NEW_REPO_ORG, etc.)
#   5. Built-in defaults  (org=noizu, private)
#
# Usage:
#   make-repo                              # noizu/<current-folder>, private
#   make-repo --org my-org                 # my-org/<current-folder>
#   make-repo --repo cool-thing            # noizu/<prefix>-cool-thing
#   make-repo --public                     # public repo
#   make-repo --prefix libs                # noizu/libs-<folder>
#   make-repo --no-prefix                  # ignore GH_NEW_REPO_PREFIX
#   make-repo --no-inherit                 # skip parent repo detection
#   make-repo --description "My project"   # set repo description
#   make-repo --groups "team-a,team-b:admin,team-c"  # grant team access
#   make-repo --yes                        # skip confirmation prompt
#   make-repo --edit                       # edit existing repo settings
#   make-repo --edit --public              # make existing repo public
#   make-repo --no-submodule               # don't convert to submodule in parent
#   make-repo --dry-run                    # show what would happen
#
# Environment (base):
#   GH_NEW_REPO_ORG        — default org (default: noizu)
#   GH_NEW_REPO_PREFIX     — prefix prepended to repo name
#   GH_NEW_REPO_NAME       — override repo name (prefix still applied)
#   GH_NEW_REPO_DESC       — repo description
#   GH_NEW_REPO_PUBLIC     — set to any value for public visibility
#   GH_NEW_REPO_GROUPS     — comma-separated teams, optional :role suffix
#   GH_NEW_REPO_GROUP_ROLE — default role for teams (default: push)
#
# Environment (overrides — beat parent detection):
#   GH_NEW_REPO_ORG_OVERRIDE    — force org even inside a parent repo
#   GH_NEW_REPO_PREFIX_OVERRIDE — force prefix
#   GH_NEW_REPO_NAME_OVERRIDE   — force repo name
#   GH_NEW_REPO_DESC_OVERRIDE   — force description
#   GH_NEW_REPO_PUBLIC_OVERRIDE — force public (set to 1) or private (set to 0)
#   GH_NEW_REPO_GROUPS_OVERRIDE — force team list
# =============================================================================

# --- Colours -----------------------------------------------------------------
RED=$'\033[0;31m'; YEL=$'\033[1;33m'; GRN=$'\033[0;32m'
BLU=$'\033[0;34m'; CYN=$'\033[0;36m'; NC=$'\033[0m'
BOLD=$'\033[1m'

banner()  { echo -e "\n${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; echo -e "${BLU}${BOLD}  $1${NC}"; echo -e "${BLU}${BOLD}═══════════════════════════════════════════════${NC}"; }
step()    { echo -e "\n${BLU}▶ $1${NC}"; }
ok()      { echo -e "  ${GRN}✅ $1${NC}"; }
warn()    { echo -e "  ${YEL}⚠️  $1${NC}"; }
fail()    { echo -e "  ${RED}❌ $1${NC}"; }
info()    { echo -e "  ${CYN}ℹ️  $1${NC}"; }
die()     { echo -e "\n${RED}❌ $1${NC}\n"; exit 1; }

# --- Parse CLI flags (first pass — collect explicit overrides) ---------------
cli_org=""
cli_prefix=""
cli_repo_name=""
cli_description=""
cli_visibility=""
cli_groups=""
cli_group_role=""
dry_run=false
no_prefix=false
no_inherit=false
auto_confirm=false
edit_mode=false
no_submodule=false

args=("$@")
set -- "${args[@]}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --org)         cli_org="$2"; shift 2 ;;
    --prefix)      cli_prefix="$2"; shift 2 ;;
    --no-prefix)   no_prefix=true; shift ;;
    --no-inherit)  no_inherit=true; shift ;;
    --repo)        cli_repo_name="$2"; shift 2 ;;
    --description) cli_description="$2"; shift 2 ;;
    --public)      cli_visibility="public"; shift ;;
    --private)     cli_visibility="private"; shift ;;
    --groups)      cli_groups="$2"; shift 2 ;;
    --group-role)  cli_group_role="$2"; shift 2 ;;
    --yes|-y)      auto_confirm=true; shift ;;
    --edit)        edit_mode=true; shift ;;
    --no-submodule) no_submodule=true; shift ;;
    --dry-run)     dry_run=true; shift ;;
    --help|-h)     head -47 "$0" | tail -n +3 | sed 's/^# \?//'; exit 0 ;;
    *)             die "Unknown flag: $1 (try --help)" ;;
  esac
done

# --- Parent repo detection ---------------------------------------------------
parent_org=""
parent_visibility=""
parent_detected=false
parent_git_root=""
subdir_relpath=""

detect_parent_repo() {
  local dir="$PWD"
  local git_root=""

  # Walk up to find a .git that isn't ours (or is ours if we're not yet a repo)
  # For submodules, .git is a file pointing to the parent's .git/modules/
  if [[ -f .git ]]; then
    # We're a submodule — the parent is one level up from the gitdir target
    local gitdir
    gitdir="$(sed -n 's/^gitdir: //p' .git)"
    if [[ -n "$gitdir" ]]; then
      # Resolve to absolute path
      local abs_gitdir
      abs_gitdir="$(cd "$(dirname "$gitdir")" && pwd)/$(basename "$gitdir")"
      # The parent repo's .git is typically at .git/modules/../../.git
      # Walk up from gitdir to find the parent working tree
      local parent_dir="$abs_gitdir"
      while [[ "$parent_dir" != "/" ]]; do
        parent_dir="$(dirname "$parent_dir")"
        if [[ -d "${parent_dir}/.git" ]]; then
          git_root="$parent_dir"
          break
        fi
      done
    fi
  elif [[ -d .git ]]; then
    # We're inside a regular git repo — check if pwd is a subdirectory
    # that the user wants to split into its own repo
    git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
    # If git root IS our pwd, there's no parent to inherit from
    if [[ "$git_root" == "$PWD" ]]; then
      git_root=""
    fi
  else
    # No .git at all — walk up looking for a containing repo
    local check_dir="$PWD"
    while [[ "$check_dir" != "/" ]]; do
      check_dir="$(dirname "$check_dir")"
      if [[ -d "${check_dir}/.git" || -f "${check_dir}/.git" ]]; then
        git_root="$check_dir"
        break
      fi
    done
  fi

  [[ -z "$git_root" ]] && return 1

  # Extract GitHub remote from parent
  local remote_url
  remote_url="$(git -C "$git_root" remote get-url origin 2>/dev/null || true)"
  [[ -z "$remote_url" ]] && return 1

  # Parse org from remote URL (handles SSH and HTTPS)
  # git@github.com:org/repo.git  →  org
  # https://github.com/org/repo  →  org
  local parsed_org=""
  case "$remote_url" in
    git@github.com:*)
      parsed_org="$(echo "$remote_url" | sed 's|git@github.com:||;s|/.*||')"
      ;;
    *github.com/*)
      parsed_org="$(echo "$remote_url" | sed 's|.*github.com/||;s|/.*||')"
      ;;
  esac
  [[ -z "$parsed_org" ]] && return 1

  parent_org="$parsed_org"

  # Query parent repo visibility via gh
  local parent_repo_name
  parent_repo_name="$(echo "$remote_url" | sed 's|.*github.com[:/]||;s|\.git$||')"
  local vis
  vis="$(gh repo view "$parent_repo_name" --json visibility -q '.visibility' 2>/dev/null || true)"
  case "${vis,,}" in
    public)  parent_visibility="public" ;;
    private) parent_visibility="private" ;;
    *)       parent_visibility="" ;;
  esac

  parent_git_root="$git_root"
  subdir_relpath="${PWD#${git_root}/}"
  parent_detected=true
  return 0
}

if [[ "$no_inherit" == false ]]; then
  detect_parent_repo || true
fi

# --- Resolve final values (precedence: CLI > _OVERRIDE > parent > base env) --
resolve() {
  local cli_val="$1"
  local override_val="$2"
  local parent_val="$3"
  local base_val="$4"
  local default_val="$5"

  if [[ -n "$cli_val" ]]; then echo "$cli_val"
  elif [[ -n "$override_val" ]]; then echo "$override_val"
  elif [[ -n "$parent_val" ]]; then echo "$parent_val"
  elif [[ -n "$base_val" ]]; then echo "$base_val"
  else echo "$default_val"
  fi
}

org="$(resolve \
  "$cli_org" \
  "${GH_NEW_REPO_ORG_OVERRIDE:-}" \
  "$parent_org" \
  "${GH_NEW_REPO_ORG:-}" \
  "noizu")"

prefix="$(resolve \
  "$cli_prefix" \
  "${GH_NEW_REPO_PREFIX_OVERRIDE:-}" \
  "" \
  "${GH_NEW_REPO_PREFIX:-}" \
  "")"

repo_name="$(resolve \
  "$cli_repo_name" \
  "${GH_NEW_REPO_NAME_OVERRIDE:-}" \
  "" \
  "${GH_NEW_REPO_NAME:-}" \
  "")"

description="$(resolve \
  "$cli_description" \
  "${GH_NEW_REPO_DESC_OVERRIDE:-}" \
  "" \
  "${GH_NEW_REPO_DESC:-}" \
  "")"

groups="$(resolve \
  "$cli_groups" \
  "${GH_NEW_REPO_GROUPS_OVERRIDE:-}" \
  "" \
  "${GH_NEW_REPO_GROUPS:-}" \
  "")"

group_role="$(resolve \
  "$cli_group_role" \
  "" \
  "" \
  "${GH_NEW_REPO_GROUP_ROLE:-}" \
  "push")"

# Visibility needs special handling: _OVERRIDE uses 1/0
resolve_visibility() {
  if [[ -n "$cli_visibility" ]]; then
    echo "$cli_visibility"
    return
  fi

  local ov="${GH_NEW_REPO_PUBLIC_OVERRIDE:-}"
  if [[ -n "$ov" ]]; then
    [[ "$ov" == "1" ]] && echo "public" || echo "private"
    return
  fi

  if [[ -n "$parent_visibility" ]]; then
    echo "$parent_visibility"
    return
  fi

  if [[ -n "${GH_NEW_REPO_PUBLIC:-}" ]]; then
    echo "public"
    return
  fi

  echo "private"
}

visibility="$(resolve_visibility)"

# --- Resolve repo name -------------------------------------------------------
if [[ -z "$repo_name" ]]; then
  repo_name="$(basename "$(pwd)")"
fi

if [[ "$no_prefix" == false && -n "$prefix" ]]; then
  repo_name="${prefix}-${repo_name}"
fi

full_name="${org}/${repo_name}"

# --- Generate description if not provided ------------------------------------
generate_description() {
  # TODO: Use CLI AI (e.g. `claude -p "..."` or `gh copilot suggest`) to
  # generate an appropriate description based on the repo contents.
  # For now, return a placeholder.
  echo "No additional details."
}

if [[ -z "$description" ]]; then
  description="$(generate_description)"
fi

# --- Preflight checks --------------------------------------------------------
command -v gh >/dev/null 2>&1 || die "gh CLI not found — install with: brew install gh"
gh auth status >/dev/null 2>&1 || die "Not authenticated — run: gh auth login"

# --- Edit mode helper --------------------------------------------------------
edit_existing() {
  while true; do
    banner "Edit Repo"
    echo ""
    echo -e "  ${BOLD}Editing:${NC} ${CYN}${full_name}${NC}"
    echo ""
    echo -e "  ${BOLD}[1]${NC} Visibility:  ${CYN}${visibility}${NC} (current: ${current_vis,,})"
    echo -e "  ${BOLD}[2]${NC} Description: ${CYN}${description}${NC}"
    if [[ -n "$groups" ]]; then
      echo -e "  ${BOLD}[3]${NC} Groups:      ${CYN}${groups}${NC} (role: ${group_role})"
    else
      echo -e "  ${BOLD}[3]${NC} Groups:      ${CYN}(none — add teams)${NC}"
    fi
    echo ""
    echo -e "  ${BOLD}[y]${NC} Apply changes"
    echo -e "  ${BOLD}[n]${NC} Abort"
    echo -e "  ${BOLD}[1-3]${NC} Edit a field"
    echo ""
    read -rp "  > " choice

    case "$choice" in
      y|Y|yes) return 0 ;;
      n|N|no|q) warn "Aborted."; exit 1 ;;
      1)
        if [[ "$visibility" == "private" ]]; then
          visibility="public"
        else
          visibility="private"
        fi
        ok "Toggled to ${visibility}"
        ;;
      2)
        read -rp "  Description [${description}]: " new_val
        [[ -n "$new_val" ]] && description="$new_val"
        ;;
      3)
        read -rp "  Groups (comma-separated, :role suffix) [${groups}]: " new_val
        [[ -n "$new_val" ]] && groups="$new_val"
        if [[ -n "$groups" ]]; then
          read -rp "  Default role [${group_role}]: " new_role
          [[ -n "$new_role" ]] && group_role="$new_role"
        fi
        ;;
      *) warn "Invalid choice: ${choice}" ;;
    esac
  done
}

apply_edits() {
  banner "Edit Repo"
  echo -e "  ${BOLD}Repo:${NC} ${CYN}${full_name}${NC}"
  changes_made=false

  if [[ "${visibility}" != "${current_vis,,}" ]]; then
    warn "Visibility change: ${current_vis,,} → ${visibility}"
    if [[ "$auto_confirm" == false ]]; then
      read -rp "  Are you sure? [y/N] " confirm_vis
      if [[ ! "$confirm_vis" =~ ^[yY](es)?$ ]]; then
        info "Visibility change skipped."
      else
        gh repo edit "$full_name" --visibility "$visibility" --accept-visibility-change-consequences
        ok "Visibility set to ${visibility}"
        changes_made=true
      fi
    else
      gh repo edit "$full_name" --visibility "$visibility" --accept-visibility-change-consequences
      ok "Visibility set to ${visibility}"
      changes_made=true
    fi
  fi

  if [[ "${description}" != "${current_desc}" ]]; then
    step "Updating description"
    gh repo edit "$full_name" --description "$description"
    ok "Description updated"
    changes_made=true
  fi

  if [[ -n "$groups" ]]; then
    step "Updating team access"
    IFS=',' read -ra team_entries <<< "$groups"
    for entry in "${team_entries[@]}"; do
      entry="$(echo "$entry" | xargs)"
      if [[ "$entry" == *:* ]]; then
        team="${entry%%:*}"
        role="${entry#*:}"
      else
        team="$entry"
        role="$group_role"
      fi

      valid_roles="pull push admin maintain triage"
      if [[ ! " $valid_roles " =~ " $role " ]]; then
        warn "Invalid role '${role}' for team '${team}' — skipping (valid: ${valid_roles})"
        continue
      fi

      info "  ${team} → ${role}"
      if gh api \
        --method PUT \
        -H "Accept: application/vnd.github+json" \
        "/orgs/${org}/teams/${team}/repos/${full_name}" \
        -f "permission=${role}" >/dev/null 2>&1; then
        ok "  ${team}: ${role}"
        changes_made=true
      else
        fail "  Failed to set ${role} for team ${team}"
      fi
    done
  fi

  if [[ "$changes_made" == false ]]; then
    info "No changes to apply."
  else
    echo ""
    ok "Done! ${full_name}"
  fi
  info "URL: https://github.com/${full_name}"
  exit 0
}

# --- Submodule self-detection: use the submodule's own remote ----------------
# When pwd is a submodule (.git is a file), it has its own origin remote.
# If no CLI overrides were given for org/repo, prefer the submodule's remote
# over what parent detection inferred.
if [[ -f .git && -z "$cli_org" && -z "$cli_repo_name" ]]; then
  _sub_remote="$(git remote get-url origin 2>/dev/null || true)"
  if [[ -n "$_sub_remote" ]]; then
    _sub_org=""
    _sub_repo=""
    case "$_sub_remote" in
      git@github.com:*)
        _sub_org="$(echo "$_sub_remote" | sed 's|git@github.com:||;s|/.*||')"
        _sub_repo="$(echo "$_sub_remote" | sed 's|git@github.com:[^/]*/||;s|\.git$||')"
        ;;
      *github.com/*)
        _sub_org="$(echo "$_sub_remote" | sed 's|.*github.com/||;s|/.*||')"
        _sub_repo="$(echo "$_sub_remote" | sed 's|.*github.com/[^/]*/||;s|\.git$||')"
        ;;
    esac
    if [[ -n "$_sub_org" && -n "$_sub_repo" ]]; then
      org="$_sub_org"
      repo_name="$_sub_repo"
      full_name="${org}/${repo_name}"
    fi
    unset _sub_remote _sub_org _sub_repo
  fi
fi

# --- Auto-enter edit mode for existing repos when visibility flag is set -----
if [[ "$edit_mode" == false ]] && gh repo view "$full_name" >/dev/null 2>&1; then
  if [[ -n "$cli_visibility" ]]; then
    edit_mode=true
  else
    die "Repo ${full_name} already exists on GitHub. Use --edit, --public, or --private to modify it."
  fi
fi

# --- Edit mode: modify an existing repo -------------------------------------
if [[ "$edit_mode" == true ]]; then
  if ! gh repo view "$full_name" >/dev/null 2>&1; then
    die "Repo ${full_name} does not exist — nothing to edit."
  fi

  current_vis="$(gh repo view "$full_name" --json visibility -q '.visibility' 2>/dev/null || echo "unknown")"
  current_desc="$(gh repo view "$full_name" --json description -q '.description' 2>/dev/null || echo "")"

  [[ -z "$cli_visibility" ]] && visibility="${current_vis,,}"
  [[ -z "$cli_description" ]] && description="${current_desc}"

  if [[ "$auto_confirm" == false && -z "$cli_visibility" ]]; then
    edit_existing
  fi

  apply_edits
fi

# --- Confirmation prompt -----------------------------------------------------
confirm_and_edit() {
  local repo_exists=false
  gh repo view "${org}/${repo_name}" >/dev/null 2>&1 && repo_exists=true

  while true; do
    if [[ "$repo_exists" == true ]]; then
      banner "Edit Repo"
    else
      banner "Create Repo"
    fi
    echo ""
    echo -e "  ${BOLD}[1]${NC} Org:         ${CYN}${org}${NC}"
    echo -e "  ${BOLD}[2]${NC} Repo:        ${CYN}${repo_name}${NC}"
    echo -e "  ${BOLD}[3]${NC} Full name:   ${CYN}${org}/${repo_name}${NC}"
    echo -e "  ${BOLD}[4]${NC} Visibility:  ${CYN}${visibility}${NC}"
    echo -e "  ${BOLD}[5]${NC} Description: ${CYN}${description}${NC}"
    if [[ -n "$groups" ]]; then
      echo -e "  ${BOLD}[6]${NC} Groups:      ${CYN}${groups}${NC} (role: ${group_role})"
    else
      echo -e "  ${BOLD}[6]${NC} Groups:      ${CYN}(none)${NC}"
    fi
    if [[ "$parent_detected" == true ]]; then
      echo -e "  ${CYN}    Inherited:  org=${parent_org}${parent_visibility:+, visibility=${parent_visibility}} (from parent repo)${NC}"
    fi
    echo ""
    if [[ "$repo_exists" == true ]]; then
      echo -e "  ${BOLD}[y]${NC} Apply changes"
    else
      echo -e "  ${BOLD}[y]${NC} Confirm and create"
    fi
    echo -e "  ${BOLD}[n]${NC} Abort"
    echo -e "  ${BOLD}[1-6]${NC} Edit a field"
    echo ""
    read -rp "  > " choice

    case "$choice" in
      y|Y|yes)
        return 0
        ;;
      n|N|no|q)
        warn "Aborted."
        exit 1
        ;;
      1)
        read -rp "  Org [${org}]: " new_val
        [[ -n "$new_val" ]] && org="$new_val"
        repo_exists=false
        gh repo view "${org}/${repo_name}" >/dev/null 2>&1 && repo_exists=true
        ;;
      2)
        read -rp "  Repo name [${repo_name}]: " new_val
        [[ -n "$new_val" ]] && repo_name="$new_val"
        repo_exists=false
        gh repo view "${org}/${repo_name}" >/dev/null 2>&1 && repo_exists=true
        ;;
      3)
        info "Edit org [1] or repo name [2] individually."
        ;;
      4)
        if [[ "$visibility" == "private" ]]; then
          visibility="public"
        else
          visibility="private"
        fi
        ok "Toggled to ${visibility}"
        ;;
      5)
        read -rp "  Description [${description}]: " new_val
        [[ -n "$new_val" ]] && description="$new_val"
        ;;
      6)
        read -rp "  Groups (comma-separated, :role suffix) [${groups}]: " new_val
        [[ -n "$new_val" ]] && groups="$new_val"
        if [[ -n "$groups" ]]; then
          read -rp "  Default role [${group_role}]: " new_role
          [[ -n "$new_role" ]] && group_role="$new_role"
        fi
        ;;
      *)
        warn "Invalid choice: ${choice}"
        ;;
    esac
  done
}

if [[ "$dry_run" == true ]]; then
  if [[ "$edit_mode" == true ]]; then
    banner "Edit Repo (dry run)"
  else
    banner "Create Repo (dry run)"
  fi
  info "Org:         ${org}"
  info "Repo:        ${repo_name}"
  info "Full name:   ${full_name}"
  info "Visibility:  ${visibility}"
  info "Description: ${description}"
  [[ -n "$groups" ]] && info "Groups:      ${groups} (default role: ${group_role})"
  if [[ "$parent_detected" == true ]]; then
    info "Inherited:   org=${parent_org}${parent_visibility:+, visibility=${parent_visibility}} (from parent repo)"
  fi
  if [[ "$no_submodule" == false && -n "$parent_git_root" ]]; then
    info "Submodule:   will convert to submodule in ${parent_git_root} at ${subdir_relpath}"
  elif [[ "$no_submodule" == true && -n "$parent_git_root" ]]; then
    info "Submodule:   skipped (--no-submodule)"
  fi
  warn "Dry run — no changes made."
  exit 0
fi

if [[ "$auto_confirm" == false ]]; then
  confirm_and_edit
fi
full_name="${org}/${repo_name}"

# Re-check after edits — auto-enter edit mode if visibility was explicitly set
if gh repo view "$full_name" >/dev/null 2>&1; then
  if [[ -n "$cli_visibility" ]]; then
    current_vis="$(gh repo view "$full_name" --json visibility -q '.visibility' 2>/dev/null || echo "unknown")"
    current_desc="$(gh repo view "$full_name" --json description -q '.description' 2>/dev/null || echo "")"
    [[ -z "$cli_description" ]] && description="${current_desc}"
    apply_edits
  fi
  die "Repo ${full_name} already exists on GitHub. Use --edit, --public, or --private to modify it."
fi

# --- Track original state for submodule conversion ---------------------------
orig_was_submodule=false
[[ -f .git ]] && orig_was_submodule=true

# --- Init local git if needed ------------------------------------------------
if [[ ! -d .git && ! -f .git ]]; then
  step "Initializing git repo"
  git init
  git add .
  git commit -m "initial commit"
  ok "Local repo initialized"
elif [[ -f .git ]]; then
  # Submodule — deinit from parent and reinit as standalone
  step "Detaching from parent repo (submodule → standalone)"
  local_gitdir="$(sed -n 's/^gitdir: //p' .git)"
  rm .git
  git init
  git add .
  git commit -m "initial commit" --allow-empty
  ok "Detached from parent, standalone repo initialized"
fi

# --- Create the GitHub repo --------------------------------------------------
step "Creating GitHub repo: ${full_name}"

visibility_flag="--${visibility}"
gh repo create "$full_name" \
  --source=. \
  --push \
  "$visibility_flag" \
  --description "$description"

ok "Repo created and pushed: ${full_name}"

# --- Grant team access -------------------------------------------------------
if [[ -n "$groups" ]]; then
  step "Granting team access"
  IFS=',' read -ra team_entries <<< "$groups"
  for entry in "${team_entries[@]}"; do
    entry="$(echo "$entry" | xargs)"
    if [[ "$entry" == *:* ]]; then
      team="${entry%%:*}"
      role="${entry#*:}"
    else
      team="$entry"
      role="$group_role"
    fi

    valid_roles="pull push admin maintain triage"
    if [[ ! " $valid_roles " =~ " $role " ]]; then
      warn "Invalid role '${role}' for team '${team}' — skipping (valid: ${valid_roles})"
      continue
    fi

    info "  ${team} → ${role}"
    if gh api \
      --method PUT \
      -H "Accept: application/vnd.github+json" \
      "/orgs/${org}/teams/${team}/repos/${full_name}" \
      -f "permission=${role}" >/dev/null 2>&1; then
      ok "  ${team}: ${role}"
    else
      fail "  Failed to set ${role} for team ${team} — check team name and org permissions"
    fi
  done
fi

# --- Done --------------------------------------------------------------------
echo ""
ok "Done! ${full_name}"
info "URL: https://github.com/${full_name}"

# --- Convert to submodule in parent repo ------------------------------------
if [[ "$no_submodule" == false && -n "$parent_git_root" && -n "$subdir_relpath" ]]; then
  remote_url="$(git remote get-url origin 2>/dev/null)"
  target_dir="$PWD"
  dir_basename="$(basename "$subdir_relpath")"
  copy_path="${parent_git_root}/copy.${dir_basename}"

  step "Converting to submodule in parent repo"
  info "Parent: ${parent_git_root}"
  info "Path:   ${subdir_relpath}"
  info "Remote: ${remote_url}"

  if [[ "$auto_confirm" == false ]]; then
    echo ""
    read -rp "  Convert to submodule in parent repo? [Y/n] " sm_confirm
    if [[ "$sm_confirm" =~ ^[nN] ]]; then
      info "Skipped submodule conversion."
      exit 0
    fi
  fi

  cd "$parent_git_root"

  # Back up existing directory before any destructive operations
  step "Backing up ${subdir_relpath} → copy.${dir_basename}"
  if [[ -e "$copy_path" ]]; then
    die "Backup path ${copy_path} already exists — remove it first."
  fi
  cp -a "$subdir_relpath" "$copy_path"
  ok "Backup created at copy.${dir_basename}"

  # Remove from git index (the backup preserves the files)
  if [[ "$orig_was_submodule" == true ]]; then
    step "Removing old submodule entry"
    git submodule deinit -f "$subdir_relpath" 2>/dev/null || true
    git rm -f "$subdir_relpath" 2>/dev/null || true
    rm -rf ".git/modules/${subdir_relpath}" 2>/dev/null || true
  else
    step "Removing directory from parent repo index"
    if git ls-files --error-unmatch "$subdir_relpath" >/dev/null 2>&1; then
      git rm -rf "$subdir_relpath"
    else
      rm -rf "$subdir_relpath"
    fi
  fi

  # Add as submodule — restore from backup on failure
  step "Adding as submodule"
  if ! git submodule add "$remote_url" "$subdir_relpath"; then
    fail "git submodule add failed — restoring from backup"
    git checkout -- . 2>/dev/null || true
    rm -rf "$subdir_relpath" 2>/dev/null || true
    mv "$copy_path" "$subdir_relpath"
    die "Submodule conversion failed. Original directory restored."
  fi

  # Verify: compare tracked files between backup and new submodule
  step "Verifying submodule contents match backup"
  verify_failed=false

  # Build list of files to check (skip .git entries)
  while IFS= read -r -d '' rel_file; do
    backup_file="${copy_path}/${rel_file}"
    submod_file="${subdir_relpath}/${rel_file}"
    if [[ ! -f "$submod_file" ]]; then
      warn "Missing in submodule: ${rel_file}"
      verify_failed=true
    elif ! diff -q "$backup_file" "$submod_file" >/dev/null 2>&1; then
      warn "Content mismatch: ${rel_file}"
      verify_failed=true
    fi
  done < <(cd "$copy_path" && find . -type f ! -path './.git/*' ! -path './.git' -print0 | sed -z 's|^\./||')

  if [[ "$verify_failed" == true ]]; then
    warn "Verification found differences — backup preserved at copy.${dir_basename}"
    warn "Review manually, then remove copy.${dir_basename} when satisfied."
  else
    ok "All files match"
    info "Backup preserved at: ${copy_path}"
    info "Remove it when you're satisfied: rm -rf ${copy_path}"
  fi

  step "Committing submodule"
  git add .gitmodules "$subdir_relpath"
  git commit -m "convert ${subdir_relpath} to submodule (${full_name})"

  ok "Submodule registered: ${subdir_relpath} → ${remote_url}"
  cd "$target_dir"
fi
