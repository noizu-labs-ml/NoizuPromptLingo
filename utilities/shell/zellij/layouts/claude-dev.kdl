// claude-dev — standard development layout
// Use: zellij -n claude-dev (new session)
//      zellij action new-tab --layout claude-dev --cwd /path (add tab)
//
// Panes: claude (left) | nvim (right) | shell (bottom)
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="status-bar"
        }
    }
    tab name="dev" {
        pane split_direction="vertical" {
            pane size="50%" name="claude" focus=true
            pane size="50%" name="editor" {
                command "bash"
                args "-c" "nvim .; exec ${SHELL:-bash}"
            }
        }
        pane name="shell" size=10
    }
}
