#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
zj-panes — populate the current tab with claude dev panes

Run from inside a zellij tab to split it into the standard layout:
  - Current pane becomes: claude (left, focused)
  - New right pane: nvim .
  - New bottom pane: shell (or custom command)

Usage:
    zj-panes [OPTIONS] [DIRECTORY]

Arguments:
    DIRECTORY                  Project directory (default: current dir)

Options:
    --claude-args ARGS         Extra arguments passed to claude
    --claude-command CMD       Override the claude invocation entirely
    --claude-message, --prompt MSG  Starting message/prompt for claude
    --cerebras                 Shorthand: use "run-claude with cerebras-pro"
    --zai                      Shorthand: use "run-claude with zai-pro"
    --start-app, --run CMD     Command for a floating preview pane
    -c, --command CMD          Command to run in the bottom shell pane
    --no-nvim                  Skip the nvim pane (full-width claude)
    --no-rename                Don't rename the current tab
    -h, --help                 Show this help

Examples:
    zj-panes                           # Populate current tab for cwd
    zj-panes ~/Github/my-project       # Populate for specific dir
    zj-panes --cerebras .              # With cerebras claude
    zj-panes -c "make watch" .         # Bottom pane runs make watch
USAGE
    exit 0
}

if [[ -z "${ZELLIJ_SESSION_NAME:-}" ]]; then
    echo "Error: not inside a zellij session" >&2
    echo "Use 'zj-tab' to create a new session/tab instead." >&2
    exit 1
fi

claude_args=""
claude_command=""
claude_message=""
start_app=""
bottom_command=""
no_nvim=false
no_rename=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --claude-args)        claude_args="$2"; shift 2 ;;
        --claude-command)     claude_command="$2"; shift 2 ;;
        --claude-message|--prompt) claude_message="$2"; shift 2 ;;
        --cerebras)           claude_command="run-claude with cerebras-pro"; shift ;;
        --zai)                claude_command="run-claude with zai-pro"; shift ;;
        --start-app|--run)    start_app="$2"; shift 2 ;;
        -c|--command)         bottom_command="$2"; shift 2 ;;
        --no-nvim)            no_nvim=true; shift ;;
        --no-rename)          no_rename=true; shift ;;
        -h|--help)            usage ;;
        -*)                   echo "Unknown option: $1" >&2; exit 1 ;;
        *)                    break ;;
    esac
done

dir="${1:-.}"
dir="$(cd "$dir" && pwd)"
tab_name="$(basename "$dir")"

if [[ -n "$claude_command" ]]; then
    claude_cmd="$claude_command"
elif [[ -n "$claude_args" ]]; then
    claude_cmd="claude $claude_args"
else
    claude_cmd="claude"
fi

if [[ -n "$claude_message" ]]; then
    claude_cmd="$claude_cmd $(printf '%q' "$claude_message")"
fi

if [[ "$no_rename" == false ]]; then
    zellij action rename-tab "$tab_name"
fi

if [[ "$no_nvim" == false ]]; then
    zellij action new-pane --direction right --name "nvim: $tab_name" --cwd "$dir" -- nvim .
fi

if [[ -n "$bottom_command" ]]; then
    zellij action new-pane --direction down --name "shell: $tab_name" --cwd "$dir" -- bash -c "$bottom_command; exec ${SHELL:-bash}"
else
    zellij action new-pane --direction down --name "shell: $tab_name" --cwd "$dir"
fi

if [[ -n "$start_app" ]]; then
    zellij action new-pane --floating --name "preview: $tab_name" --cwd "$dir" -- bash -c "$start_app; exec ${SHELL:-bash}"
fi

echo "Run claude in this pane:"
echo "  cd '$dir' && $claude_cmd"
