#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'USAGE'
zj-spawn — launch a zellij session with a tab per selected subdirectory

Usage:
    zj-spawn [OPTIONS] [DIRECTORY]

Arguments:
    DIRECTORY       Base directory to list subdirs from (default: current dir)

Options:
    -c, --command CMD   Command to run in each tab (skips prompt)
    -s, --session NAME  Zellij session name (default: derived from directory)
    -g, --glob PATTERN  Pre-select dirs matching glob, open fzf to edit
    -d, --depth N       Depth of subdirectory listing (default: 1)
    -a, --all           Include hidden directories
    --pane              Use a 4x4 pane grid in a single tab instead of tabs
    --no-command        Skip command prompt, open shell only
    -h, --help          Show this help
USAGE
    exit 0
}

cmd=""
session=""
explicit_session=""
glob=""
depth=1
show_hidden=false
no_cmd=false
use_pane=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--command)  cmd="$2"; shift 2 ;;
        -s|--session)  session="$2"; explicit_session=1; shift 2 ;;
        -g|--glob)     glob="$2"; shift 2 ;;
        -d|--depth)    depth="$2"; shift 2 ;;
        -a|--all)      show_hidden=true; shift ;;
        --pane)        use_pane=true; shift ;;
        --no-command)  no_cmd=true; shift ;;
        -h|--help)     usage ;;
        -*)            echo "Unknown option: $1" >&2; exit 1 ;;
        *)             break ;;
    esac
done

base_dir="${1:-.}"
base_dir="$(cd "$base_dir" && pwd)"

if ! command -v zellij &>/dev/null; then
    echo "Error: zellij not found in PATH" >&2
    exit 1
fi
if ! command -v fzf &>/dev/null; then
    echo "Error: fzf not found in PATH" >&2
    exit 1
fi

find_args=("$base_dir" -mindepth 1 -maxdepth "$depth" -type d)
if [[ "$show_hidden" == false ]]; then
    find_args+=(-not -path '*/.*')
fi
find_args+=(-print)

if [[ -n "$glob" ]]; then
    # --glob: pre-select dirs matching the pattern, let user edit in fzf
    mapfile -t selected < <(
        find "${find_args[@]}" | sort | \
        fzf --multi \
            --header="Tab=toggle, Enter=confirm, Esc=cancel (glob pre-selected: $glob)" \
            --prompt="Select directories> " \
            --preview="ls -1 --color=always {}" \
            --bind="ctrl-a:select-all,ctrl-d:deselect-all,start:select-all" \
            --query="$glob"
    )
else
    # Default: all dirs pre-selected, fzf to toggle off
    mapfile -t selected < <(
        find "${find_args[@]}" | sort | \
        fzf --multi \
            --header="Tab=toggle off, Enter=confirm, Esc=cancel (all selected)" \
            --prompt="Select directories> " \
            --preview="ls -1 --color=always {}" \
            --bind="ctrl-a:select-all,ctrl-d:deselect-all,start:select-all"
    )
fi

if [[ ${#selected[@]} -eq 0 ]]; then
    echo "No directories selected." >&2
    exit 0
fi

if [[ -z "$session" ]]; then
    session="$(basename "$base_dir")"
fi

# Collect the command to run in each tab
cmd_script=""
if [[ -z "$cmd" && "$no_cmd" == false ]]; then
    echo ""
    echo "Selected ${#selected[@]} directories."
    cmd_edit="/tmp/zj-spawn-cmd-$$-$(date +%s).sh"
    cat > "$cmd_edit" <<'HEADER'
#!/usr/bin/env bash
# Write the commands to run in each tab below.
# Multiline is fine — this runs as a script.
# Save and quit to continue. Empty file = shell only.

HEADER
    "${EDITOR:-vi}" "$cmd_edit"
    # Strip comment/blank lines to detect if user wrote anything
    if grep -qvE '^\s*(#|$)' "$cmd_edit"; then
        cmd_script="$cmd_edit"
    else
        rm -f "$cmd_edit"
    fi
elif [[ -n "$cmd" ]]; then
    cmd_script="/tmp/zj-spawn-cmd-$$-$(date +%s).sh"
    printf '#!/usr/bin/env bash\n%s\n' "$cmd" > "$cmd_script"
fi

if [[ -n "$cmd_script" ]]; then
    chmod +x "$cmd_script"
fi

# Ensure unique session name
unset ZELLIJ ZELLIJ_SESSION_NAME
if zellij list-sessions --short --no-formatting 2>/dev/null | grep -qxF "$session"; then
    if [[ -z "$explicit_session" ]]; then
        session="${session}-$(date +%s)"
    fi
fi

if $use_pane; then
    echo "Launching zellij session '$session' with ${#selected[@]} pane(s) in 4x4 grid..."
else
    echo "Launching zellij session '$session' with ${#selected[@]} tab(s)..."
fi

# Build layout
layout_file="/tmp/zj-spawn-$$-$(date +%s).kdl"
trap 'rm -f "$layout_file"' EXIT

gen_pane() {
    local dir="$1" name="$2" indent="$3"
    if [[ -n "$cmd_script" ]]; then
        echo "${indent}pane name=\"$name\" {"
        echo "${indent}  command \"bash\""
        echo "${indent}  args \"-c\" \"cd $dir && $cmd_script; exec bash\""
        echo "${indent}}"
    else
        echo "${indent}pane name=\"$name\" {"
        echo "${indent}  command \"bash\""
        echo "${indent}  args \"-c\" \"cd $dir; exec bash\""
        echo "${indent}}"
    fi
}

{
    echo "layout {"
    echo "  default_tab_template {"
    echo "    pane size=1 borderless=true {"
    echo "      plugin location=\"tab-bar\""
    echo "    }"
    echo "    children"
    echo "    pane size=2 borderless=true {"
    echo "      plugin location=\"status-bar\""
    echo "    }"
    echo "  }"
    if $use_pane; then
        # 3x2 grid: 6 panes per tab (3 columns x 2 rows), new tab every 6 dirs
        total=${#selected[@]}
        panes_per_tab=6
        num_tabs=$(( (total + panes_per_tab - 1) / panes_per_tab ))
        idx=0
        for (( t=0; t<num_tabs; t++ )); do
            tab_label="${session}.$((t+1))"
            echo "  tab name=\"$tab_label\" {"
            echo "    pane split_direction=\"vertical\" {"
            remaining=$(( total - idx ))
            tab_count=$(( remaining < panes_per_tab ? remaining : panes_per_tab ))
            cols=$(( (tab_count + 1) / 2 ))
            [[ $cols -gt 3 ]] && cols=3
            for (( c=0; c<cols; c++ )); do
                rows_this_col=$(( (tab_count - c + cols - 1) / cols ))
                [[ $rows_this_col -gt 2 ]] && rows_this_col=2
                echo "      pane split_direction=\"horizontal\" {"
                for (( r=0; r<rows_this_col && idx<total; r++, idx++ )); do
                    dir="${selected[$idx]}"
                    pane_name="$(basename "$dir")"
                    gen_pane "$dir" "$pane_name" "        "
                done
                echo "      }"
            done
            echo "    }"
            echo "  }"
        done
    else
        # Default: one tab per directory
        for dir in "${selected[@]}"; do
            tab_name="$(basename "$dir")"
            echo "  tab name=\"$tab_name\" {"
            gen_pane "$dir" "$tab_name" "    "
            echo "  }"
        done
    fi
    echo "}"
} > "$layout_file"

zellij -s "$session" -n "$layout_file"
