#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage: submodule-pull [repo-root]

Reads repo-root/.gitmodules, enters each listed submodule, and runs:
  git pull --ff-only

Submodules checked out on a detached HEAD are skipped with a note. If the
detached commit exactly matches a tag, the note includes that tag.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

repo_root="${1:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"
gitmodules="${repo_root}/.gitmodules"

if [ ! -f "$gitmodules" ]; then
  echo "error: .gitmodules not found at ${gitmodules}" >&2
  exit 1
fi

submodule_paths=()
while IFS= read -r submodule_path; do
  submodule_paths+=("$submodule_path")
done < <(
  git config --file "$gitmodules" --get-regexp '^submodule\..*\.path$' |
    awk '{print $2}'
)

if [ "${#submodule_paths[@]}" -eq 0 ]; then
  echo "No submodules found in ${gitmodules}"
  exit 0
fi

for submodule_path in "${submodule_paths[@]}"; do
  submodule_dir="${repo_root}/${submodule_path}"

  echo "==> ${submodule_path}"

  if [ ! -d "$submodule_dir" ]; then
    echo "note: missing directory; run git submodule update --init --recursive"
    continue
  fi

  if ! git -C "$submodule_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "note: not a git work tree; skipping"
    continue
  fi

  branch="$(git -C "$submodule_dir" symbolic-ref --quiet --short HEAD || true)"

  if [ -z "$branch" ]; then
    tag="$(git -C "$submodule_dir" describe --tags --exact-match 2>/dev/null || true)"
    commit="$(git -C "$submodule_dir" rev-parse --short HEAD)"

    if [ -n "$tag" ]; then
      echo "note: detached HEAD at tag ${tag} (${commit}); skipping pull"
    else
      echo "note: detached HEAD at ${commit}; not on a branch or tag; skipping pull"
    fi
    continue
  fi

  echo "branch: ${branch}"
  git -C "$submodule_dir" pull --ff-only
done
