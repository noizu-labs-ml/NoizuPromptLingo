#!/usr/bin/env bash
# bin/_tabbing-wrapper — shared setup for CLI wrapper scripts
#
# Sourced (not executed) by each bin/tabbing-* wrapper.
# Sets up: TABBING_ROOT, sources adapter + all libs, loads state,
# registers EXIT trap to save state on completion.

if [ -z "${TABBING_ROOT:-}" ]; then
  _tabbing_parent="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [ -d "$_tabbing_parent/lib" ] && [ -f "$_tabbing_parent/lib/render.sh" ]; then
    TABBING_ROOT="$_tabbing_parent"
  else
    TABBING_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/tabbing-on"
  fi
fi

# Source the bash adapter (loads render.sh + defines public functions)
source "$TABBING_ROOT/shell/tabbing.bash"

# Source remaining libs that the adapter no longer loads
source "$TABBING_ROOT/lib/core.sh"
source "$TABBING_ROOT/lib/terminal.sh"
source "$TABBING_ROOT/lib/history.sh"
source "$TABBING_ROOT/lib/recording.sh"
source "$TABBING_ROOT/lib/todo.sh"
source "$TABBING_ROOT/lib/session.sh"
source "$TABBING_ROOT/lib/claude.sh"
source "$TABBING_ROOT/lib/theme.sh"
source "$TABBING_ROOT/lib/dc.sh"

# Sentinel: tells adapter functions that full libs are available
_TABBING_FULL_LIBS=1

# Load persisted session state (TAB_SESSION inherited from parent env)
_tabbing_session_load

# If dc mode is active, overlay dc state and ensure daemon is running
if _tabbing_dc_enabled; then
  _tabbing_dc_load
  _tabbing_dc_ensure_daemon
else
  printf 'DAEMON DISABLED (TABBING_ON_DC_MODE=%s, dc=%s)\n' \
    "${TABBING_ON_DC_MODE:-unset}" "$(command -v dc 2>/dev/null || echo 'not found')" >&2
fi

# Version check helper — bin scripts can call: _tabbing_check_version "$@"
_tabbing_check_version() {
  case "${1:-}" in --version|-V) _tabbing_print_version; exit 0 ;; esac
}

# Auto-save state when the wrapper exits
# In dc mode, individual _tabbing_set calls write-through to dc immediately,
# so no bulk save needed on exit.
trap '_tabbing_session_save' EXIT
