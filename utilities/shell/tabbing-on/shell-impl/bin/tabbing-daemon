#!/usr/bin/env bash
# tabbing-daemon — Background daemon that renders tab title from dc state
#
# Usage:
#   tabbing-daemon start   # start in background
#   tabbing-daemon stop    # stop running daemon
#   tabbing-daemon status  # check if running
#
# Polls dc tab state at 200ms intervals. Only re-renders when
# `dc tab last_update` changes. When status text exceeds the clip
# length, advances a marquee scroll offset each tick.
#
# Per-directory: pidfile is keyed by TAB_SESSION

set -u

if [ -z "${TABBING_TTY:-}" ]; then
  TABBING_TTY="$(tty 2>/dev/null)" || TABBING_TTY="/dev/tty"
  export TABBING_TTY
fi

_pidfile() {
  printf '%s/tabbing-daemon.%s.pid' \
    "${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}" \
    "${TAB_SESSION:-$$}"
}

_daemon_running() {
  local pf
  pf="$(_pidfile)"
  [ -f "$pf" ] && kill -0 "$(cat "$pf")" 2>/dev/null
}

# ── Resolve TABBING_ROOT ────────────────────────────────────────────
if [ -z "${TABBING_ROOT:-}" ]; then
  _tabbing_parent="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [ -d "$_tabbing_parent/lib" ] && [ -f "$_tabbing_parent/lib/render.sh" ]; then
    TABBING_ROOT="$_tabbing_parent"
  else
    TABBING_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/tabbing-on"
  fi
fi

# ── The loop ─────────────────────────────────────────────────────────
_daemon_loop() {
  source "$TABBING_ROOT/lib/render.sh"

  local max_title=25
  local max_status=20
  local poll_interval=0.2
  local last_seen_update=""
  local marquee_offset=0
  local force_refresh=0

  # Session-scoped dc namespace (matches _tabbing_dc_ns in dc.sh)
  local dc_ns="tab"
  if [ -n "${TABBING_DC_UUID:-}" ]; then
    dc_ns="tab-${TABBING_DC_UUID}"
  fi

  # Cached dc values
  local c_title="" c_status="" c_highlight="" c_urgency="" c_emoji=""

  local tty="${TABBING_TTY:-/dev/tty}"

  # SIGUSR1 = immediate refresh (sent by _tabbing_dc_set)
  trap 'force_refresh=1' USR1
  trap 'printf "\033]0;\007" > "$tty" 2>/dev/null; exit 0' INT TERM

  while true; do
    sleep "$poll_interval" || true  # sleep interrupted by USR1 is fine

    # Fast check: has anything changed?
    local cur_update=""
    cur_update="$(dc get "$dc_ns" last_update --raw 2>/dev/null || true)"
    [ -z "$cur_update" ] && continue

    if [ "$force_refresh" -eq 1 ]; then
      force_refresh=0
      # fall through to reload
    elif [ "$cur_update" = "$last_seen_update" ]; then
      # No data change — but if marquee is active, advance it
      if [ ${#c_status} -gt $max_status ] && [ -n "$c_status" ]; then
        marquee_offset=$(( (marquee_offset + 1) % (${#c_status} + 4) ))
        _daemon_render_marquee "$tty"
      fi
      continue
    fi

    # State changed — reload from dc
    last_seen_update="$cur_update"
    marquee_offset=0

    c_title="$(dc get "$dc_ns" title --raw 2>/dev/null)" || true
    c_status="$(dc get "$dc_ns" status --raw 2>/dev/null)" || true
    c_highlight="$(dc get "$dc_ns" highlight --raw 2>/dev/null)" || true
    c_urgency="$(dc get "$dc_ns" urgency --raw 2>/dev/null)" || true
    c_emoji="$(dc get "$dc_ns" emoji --raw 2>/dev/null)" || true

    export TAB_TITLE="$c_title" TAB_STATUS="$c_status" TAB_HIGHLIGHT="$c_highlight"
    export TAB_URGENCY="$c_urgency" TAB_EMOJI="$c_emoji"

    if [ ${#c_status} -gt $max_status ]; then
      _daemon_render_marquee "$tty"
    else
      _daemon_render_static "$tty"
    fi
  done
}

# ── Render: static title (status fits in clip) ──────────────────────
_daemon_render_static() {
  local tty="$1"
  local max_title=25
  local t_title="${TAB_TITLE:-}"
  local t_status="${TAB_STATUS:-}"

  if [ ${#t_title} -gt $max_title ]; then
    t_title="$(printf '%s' "$t_title" | cut -c1-$((max_title - 1)))"
    t_title="${t_title}…"
  fi

  local dot=""
  dot="$(_tabbing_get_indicator)"
  [ -n "$dot" ] && dot="$dot "

  local output="${dot}${t_title}"
  [ -n "$t_status" ] && output="${dot}${t_title}: ${t_status}"

  printf '\033]0;%s\007' "$output" > "$tty" 2>/dev/null || true
}

# ── Render: marquee scroll (status exceeds clip) ────────────────────
_daemon_render_marquee() {
  local tty="$1"
  local width=20
  local max_title=25
  local t_title="${TAB_TITLE:-}"
  local t_status="${TAB_STATUS:-}"

  if [ ${#t_title} -gt $max_title ]; then
    t_title="$(printf '%s' "$t_title" | cut -c1-$((max_title - 1)))"
    t_title="${t_title}…"
  fi

  local dot=""
  dot="$(_tabbing_get_indicator)"
  [ -n "$dot" ] && dot="$dot "

  local prefix="${dot}${t_title}: "

  local padded="${t_status}    "
  local padded_len=${#padded}

  local visible=""
  local i=0
  while [ "$i" -lt "$width" ]; do
    local pos=$(( (marquee_offset + i) % padded_len ))
    local char
    char="$(printf '%s' "$padded" | cut -c$((pos + 1)))"
    visible="${visible}${char}"
    i=$((i + 1))
  done

  printf '\033]0;%s%s\007' "$prefix" "$visible" > "$tty" 2>/dev/null || true
}

# ── Management commands ──────────────────────────────────────────────

_cmd_start() {
  if _daemon_running; then
    return 0
  fi

  _daemon_loop </dev/null >/dev/null 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true
  printf '%s' "$pid" > "$(_pidfile)"
  printf 'TABBING DAEMON START (pid %s, tty %s)\n' "$pid" "$TABBING_TTY"
}

_cmd_stop() {
  local pf
  pf="$(_pidfile)"
  if [ ! -f "$pf" ]; then
    printf 'tabbing-daemon: not running\n'
    return 0
  fi
  local pid
  pid="$(cat "$pf")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null
    printf 'tabbing-daemon: stopped (pid %s)\n' "$pid"
  else
    printf 'tabbing-daemon: stale pidfile (pid %s not running)\n' "$pid"
  fi
  rm -f "$pf"
}

_cmd_status() {
  if _daemon_running; then
    printf 'tabbing-daemon: running (pid %s)\n' "$(cat "$(_pidfile)")"
    printf '  TABBING_TTY=%s\n' "$TABBING_TTY"
    printf '  poll_interval=0.2s\n'
  else
    printf 'tabbing-daemon: not running\n'
  fi
}

case "${1:-status}" in
  start)     _cmd_start ;;
  stop)      _cmd_stop ;;
  status)    _cmd_status ;;
  --version|-V) source "$TABBING_ROOT/lib/render.sh"; _tabbing_print_version ;;
  *)
    printf 'Usage: tabbing-daemon {start|stop|status}\n' >&2
    exit 1
    ;;
esac
