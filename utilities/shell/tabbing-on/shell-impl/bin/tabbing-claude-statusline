#!/usr/bin/env bash
# bin/tabbing-claude-statusline — Claude Code statusline script
#
# Claude Code runs this after each assistant message, piping JSON to stdin.
# We read the tabbing-on state file and format it for the status bar.
#
# Configure via ~/.claude/settings.json:
#   { "statusLine": { "type": "command", "command": "/path/to/tabbing-claude-statusline" } }

# Consume stdin (Claude Code pipes JSON; we don't use it yet)
cat >/dev/null

# Locate the state file — use the most recent one
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tabbing"

STATE_FILE=""
if [ -d "$STATE_DIR" ]; then
  for f in "$STATE_DIR"/claude-*.state; do
    [ -f "$f" ] || continue
    if [ -z "$STATE_FILE" ] || [ "$f" -nt "$STATE_FILE" ]; then
      STATE_FILE="$f"
    fi
  done
fi

if [ -z "$STATE_FILE" ] || [ ! -f "$STATE_FILE" ]; then
  exit 0
fi

# Read state (key=value format)
title="" status="" emoji="" urgency="" highlight=""
while IFS='=' read -r key val; do
  case "$key" in
    title)     title="$val" ;;
    status)    status="$val" ;;
    emoji)     emoji="$val" ;;
    urgency)   urgency="$val" ;;
    highlight) highlight="$val" ;;
  esac
done < "$STATE_FILE"

# Nothing to show
if [ -z "$title" ] && [ -z "$status" ]; then
  exit 0
fi

# Build output
out=""

# Add emoji indicator if present
if [ -n "$emoji" ]; then
  # Try to resolve emoji name via tabbing-on's lookup
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  if [ -f "$SCRIPT_DIR/../lib/render.sh" ]; then
    _tabbing_root="$SCRIPT_DIR/.."
    . "$SCRIPT_DIR/../lib/render.sh" 2>/dev/null
    resolved="$(_tabbing_emoji_lookup "$emoji" 2>/dev/null)" && emoji="$resolved"
  fi
  out="${emoji} "
fi

# Add title
out="${out}${title}"

# Add status
if [ -n "$status" ]; then
  out="${out}: ${status}"
fi

printf '%s\n' "$out"
