#!/usr/bin/env bash
# quick-gist — quick GitHub Gist creation with fzf file picker
# Usage:
#   quick-gist                        # fzf picker: select files interactively
#   quick-gist file1.py file2.js      # gist specific files
#   quick-gist --public file.py       # public gist
#   quick-gist --secret file.py       # secret (private) gist
#   quick-gist -s file.py             # short for --secret
#   quick-gist -d "description" ...   # add description
#   quick-gist -p                     # pipe from stdin (provide filename with -n)
#   quick-gist -n name.txt -p         # name the stdin file
#   quick-gist -a <gist-id> file.py   # add files to existing gist
#   quick-gist -e <gist-id>           # edit existing gist (opens fzf to pick files to add)
#   quick-gist -l                     # list your recent gists
#   echo "code" | quick-gist -p       # pipe content directly

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[0;33m'
DIM='\033[2m'
BOLD='\033[1m'
RESET='\033[0m'

usage() {
    cat <<'USAGE'
quick-gist — quick GitHub Gist creator with fzf support

USAGE:
  quick-gist                              Interactive file picker (fzf)
  quick-gist file1 file2 ...              Gist specific files
  echo "code" | quick-gist -p             Gist from stdin
  quick-gist -a <id> file1 ...            Add files to existing gist
  quick-gist -l                           List recent gists

OPTIONS:
  -d DESC     Description for the gist
  -s          Create secret (private) gist (same as --secret)
  --public    Create public gist
  --secret    Create secret gist (default, or set QUICK_GIST_VISIBILITY)
  -p          Read from stdin (pipe mode)
  -n NAME     Filename for stdin content (default: paste.txt)
  -a ID       Add files to existing gist
  -e ID       Edit existing gist (fzf picker for new files)
  -l          List your recent gists
  -o          Open gist in browser after creation
  -h          Show this help

EXAMPLES:
  quick-gist                              # pick files with fzf
  quick-gist src/main.py README.md        # gist two files
  quick-gist -s -d "debug log" crash.log  # secret gist with description
  quick-gist --public src/main.py         # public gist
  cat output.json | quick-gist -p -n out.json  # pipe with filename
  quick-gist -a abc123def file.py         # add file to existing gist
USAGE
    exit 0
}

# Defaults
VISIBILITY="${QUICK_GIST_VISIBILITY:-secret}"
description=""
pipe_mode=false
stdin_name="paste.txt"
append_id=""
edit_id=""
list_mode=false
open_browser=false

# Pre-parse long options (getopts doesn't handle them)
rest=()
for arg in "$@"; do
    case "$arg" in
        --public) VISIBILITY=public ;;
        --secret) VISIBILITY=secret ;;
        *)        rest+=("$arg") ;;
    esac
done
set -- "${rest[@]}"

# Parse options
while getopts ":d:sn:pa:e:loh" opt; do
    case $opt in
        d) description="$OPTARG" ;;
        s) VISIBILITY=secret ;;
        n) stdin_name="$OPTARG" ;;
        p) pipe_mode=true ;;
        a) append_id="$OPTARG" ;;
        e) edit_id="$OPTARG" ;;
        l) list_mode=true ;;
        o) open_browser=true ;;
        h) usage ;;
        \?) echo -e "${RED}Unknown option: -$OPTARG${RESET}" >&2; usage ;;
        :) echo -e "${RED}Option -$OPTARG requires an argument${RESET}" >&2; usage ;;
    esac
done
shift $((OPTIND - 1))

# Check gh is authenticated
if ! gh auth status &>/dev/null; then
    echo -e "${RED}Not authenticated. Run: gh auth login${RESET}" >&2
    exit 1
fi

# --- List mode ---
if $list_mode; then
    echo -e "${BOLD}Recent Gists:${RESET}"
    gh gist list --limit 20
    exit 0
fi

# --- Edit mode: add files to existing gist via fzf ---
if [[ -n "$edit_id" ]]; then
    if ! command -v fzf &>/dev/null; then
        echo -e "${RED}fzf required for edit mode. Install: brew install fzf${RESET}" >&2
        exit 1
    fi

    echo -e "${CYAN}Select files to add to gist ${BOLD}$edit_id${RESET}${CYAN}:${RESET}"
    selected=$(fzf --multi --preview 'head -50 {}' --preview-window=right:60%:wrap \
        --header="TAB=select multiple, ENTER=confirm" \
        --bind='ctrl-a:toggle-all') || { echo "Cancelled."; exit 0; }

    if [[ -z "$selected" ]]; then
        echo "No files selected."
        exit 0
    fi

    while IFS= read -r file; do
        echo -e "${DIM}Adding: $file${RESET}"
        gh gist edit "$edit_id" --add "$file"
    done <<< "$selected"

    url=$(gh gist view "$edit_id" --raw 2>/dev/null | head -1 || echo "https://gist.github.com/$edit_id")
    gist_url="https://gist.github.com/$edit_id"
    echo -e "${GREEN}${BOLD}Updated:${RESET} ${gist_url}"
    echo -n "$gist_url" | pbcopy 2>/dev/null && echo -e "${DIM}(copied to clipboard)${RESET}"
    exit 0
fi

# --- Append mode: add files to existing gist ---
if [[ -n "$append_id" ]]; then
    files=("$@")
    if [[ ${#files[@]} -eq 0 ]]; then
        echo -e "${RED}Provide files to add: quick-gist -a <id> file1 file2${RESET}" >&2
        exit 1
    fi

    for file in "${files[@]}"; do
        if [[ ! -f "$file" ]]; then
            echo -e "${RED}Not found: $file${RESET}" >&2
            continue
        fi
        echo -e "${DIM}Adding: $file${RESET}"
        gh gist edit "$append_id" --add "$file"
    done

    gist_url="https://gist.github.com/$append_id"
    echo -e "${GREEN}${BOLD}Updated:${RESET} ${gist_url}"
    echo -n "$gist_url" | pbcopy 2>/dev/null && echo -e "${DIM}(copied to clipboard)${RESET}"
    exit 0
fi

# --- Pipe mode: read from stdin ---
if $pipe_mode; then
    content=$(cat)
    if [[ -z "$content" ]]; then
        echo -e "${RED}No input received on stdin${RESET}" >&2
        exit 1
    fi

    args=()
    [[ -n "$description" ]] && args+=(--desc "$description")
    [[ "$VISIBILITY" == "public" ]] && args+=(--public)
    args+=(--filename "$stdin_name")

    url=$(echo "$content" | gh gist create "${args[@]}" 2>&1)
    echo -e "${GREEN}${BOLD}Created:${RESET} ${url}"
    echo -n "$url" | pbcopy 2>/dev/null && echo -e "${DIM}(copied to clipboard)${RESET}"
    $open_browser && gh gist view "$(basename "$url")" --web 2>/dev/null
    exit 0
fi

# --- File selection ---
files=("$@")

# If no files given, use fzf
if [[ ${#files[@]} -eq 0 ]]; then
    if ! command -v fzf &>/dev/null; then
        echo -e "${RED}No files specified and fzf not found.${RESET}" >&2
        echo -e "Usage: quick-gist file1 file2 ... ${DIM}or install fzf for interactive mode${RESET}" >&2
        exit 1
    fi

    echo -e "${CYAN}Select files for gist ${DIM}(TAB=multi-select, ENTER=confirm, ESC=cancel)${RESET}"
    selected=$(fzf --multi \
        --preview 'head -80 {}' \
        --preview-window=right:60%:wrap \
        --header="Select files to gist" \
        --bind='ctrl-a:toggle-all' \
        --bind='ctrl-d:half-page-down' \
        --bind='ctrl-u:half-page-up') || { echo "Cancelled."; exit 0; }

    if [[ -z "$selected" ]]; then
        echo "No files selected."
        exit 0
    fi

    while IFS= read -r f; do
        files+=("$f")
    done <<< "$selected"
fi

# Validate files exist
valid_files=()
for file in "${files[@]}"; do
    if [[ ! -f "$file" ]]; then
        echo -e "${YELLOW}Skipping (not a file): $file${RESET}" >&2
    else
        valid_files+=("$file")
    fi
done

if [[ ${#valid_files[@]} -eq 0 ]]; then
    echo -e "${RED}No valid files to gist.${RESET}" >&2
    exit 1
fi

# Show what we're gisting
echo -e "${CYAN}Creating gist with ${#valid_files[@]} file(s):${RESET}"
for f in "${valid_files[@]}"; do
    size=$(wc -c < "$f" | tr -d ' ')
    echo -e "  ${DIM}$f ($size bytes)${RESET}"
done

# Prompt for description if not given
if [[ -z "$description" ]]; then
    echo -en "${CYAN}Description ${DIM}(optional, ENTER to skip)${RESET}: "
    read -r description </dev/tty || true
fi

# Build gh gist create command
args=()
[[ -n "$description" ]] && args+=(--desc "$description")
[[ "$VISIBILITY" == "public" ]] && args+=(--public)

# Create the gist
url=$(gh gist create "${args[@]}" "${valid_files[@]}" 2>&1)

echo -e "${GREEN}${BOLD}Created:${RESET} ${url}"
echo -n "$url" | pbcopy 2>/dev/null && echo -e "${DIM}(copied to clipboard)${RESET}"
$open_browser && gh gist view "$(basename "$url")" --web 2>/dev/null

exit 0
