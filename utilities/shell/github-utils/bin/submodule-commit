#!/usr/bin/env bash
# =============================================================================
# submodule-commit — Interactive bulk commit/push for dirty git submodules.
#
# Scans all submodules (recursively) under the current repo for uncommitted
# changes, presents an fzf multi-select, collects a commit message, then for
# each selected submodule (deepest-first):
#   1. git add .
#   2. git commit -m <message>
#   3. git push origin HEAD
#   4. git add <submodule-path> from its parent repo
#
# After all submodules are committed, offers to commit the parent repo too.
#
# Usage:
#   submodule-commit [flags]
#
# Flags:
#   --dry-run         Print planned actions; touch nothing
#   --no-push         Commit locally but skip git push
#   --all, -a         Select all dirty submodules (skip fzf)
#   --config <path>   Path to k8-util-config.yaml
#   -m MESSAGE        Provide commit message non-interactively
#   -h, --help        Show this help
# =============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
K8_LIB_DIR="${K8_LIB_DIR:-${HOME}/.local/share/k8-lib}"
INFRA_ROOT="${INFRA_ROOT:-$(pwd)}"

# Pre-parse --config (must resolve before k8-lib sourcing)
for _k8_arg in "$@"; do
  case "$_k8_arg" in
    --config=*) export K8_CONFIG="${_k8_arg#--config=}" ;;
  esac
done
_k8_prev=""
for _k8_arg in "$@"; do
  [[ "$_k8_prev" == "--config" ]] && export K8_CONFIG="$_k8_arg"
  _k8_prev="$_k8_arg"
done
unset _k8_arg _k8_prev

source "$K8_LIB_DIR/bin/config.sh"
source "$K8_LIB_DIR/bin/common.sh"
source "$K8_LIB_DIR/bin/assist.sh"
_k8_check_assist "$0" "$@"

CYN=$'\033[0;36m'; DIM=$'\033[2m'; BOLD=$'\033[1m'

# --- Flags -------------------------------------------------------------------
DRY_RUN=false
NO_PUSH=false
SELECT_ALL=false
COMMIT_MSG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)    DRY_RUN=true; shift ;;
    --no-push)    NO_PUSH=true; shift ;;
    --all|-a)     SELECT_ALL=true; shift ;;
    --config)     shift 2 ;;   # already consumed above
    --config=*)   shift ;;
    -m)           COMMIT_MSG="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,/^# =====/{ /^# =====/d; s/^# \?//; p; }' "$0"
      exit 0
      ;;
    *) die "Unknown flag: $1" ;;
  esac
done

command -v fzf >/dev/null 2>&1 || die "fzf is required but not found. Install with: brew install fzf"
command -v git >/dev/null 2>&1 || die "git is required but not found."

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)" || die "Not inside a git repository."
[[ -f "${ROOT_DIR}/.gitmodules" ]] || die "No .gitmodules found — no submodules to process."

# --- Discover dirty submodules -----------------------------------------------
step "Scanning submodules for changes…"

declare -a DIRTY_PATHS=()
declare -A DIRTY_STATUS=()

enumerate_submodules() {
  local repo_dir="$1"
  local gitmodules="${repo_dir}/.gitmodules"
  [[ -f "$gitmodules" ]] || return 0
  git config -f "$gitmodules" --get-regexp '^submodule\..*\.path$' 2>/dev/null \
    | awk '{print $2}'
}

check_dirty() {
  local full_path="$1"
  local display_path="$2"

  [[ -d "$full_path" ]] || return 0
  { [[ -d "$full_path/.git" ]] || [[ -f "$full_path/.git" ]]; } || return 0

  local staged_count modified_count untracked_count
  staged_count=$(git -C "$full_path" diff --cached --name-only 2>/dev/null | wc -l | tr -d ' ')
  modified_count=$(git -C "$full_path" diff --name-only 2>/dev/null | wc -l | tr -d ' ')
  untracked_count=$(git -C "$full_path" ls-files --others --exclude-standard 2>/dev/null | wc -l | tr -d ' ')

  local parts=() is_dirty=false
  [[ "$staged_count" -gt 0 ]]    && { parts+=("${GRN}${staged_count} staged${NC}"); is_dirty=true; }
  [[ "$modified_count" -gt 0 ]]  && { parts+=("${YEL}${modified_count} modified${NC}"); is_dirty=true; }
  [[ "$untracked_count" -gt 0 ]] && { parts+=("${RED}${untracked_count} untracked${NC}"); is_dirty=true; }

  if $is_dirty; then
    DIRTY_PATHS+=("$display_path")
    DIRTY_STATUS["$display_path"]=$(IFS=', '; echo "${parts[*]}")
  fi
}

walk_submodules() {
  local repo_dir="$1"
  local rel_prefix="$2"

  while IFS= read -r sm_rel; do
    [[ -z "$sm_rel" ]] && continue
    local full="${repo_dir}/${sm_rel}"
    local display="${rel_prefix}${sm_rel}"

    walk_submodules "$full" "${display}/"
    check_dirty "$full" "$display"
  done < <(enumerate_submodules "$repo_dir")
}

walk_submodules "$ROOT_DIR" ""

if [[ ${#DIRTY_PATHS[@]} -eq 0 ]]; then
  ok "All submodules are clean — nothing to commit."
  exit 0
fi

# --- Display dirty submodules ------------------------------------------------
step "Found ${#DIRTY_PATHS[@]} dirty submodule(s):"
for p in "${DIRTY_PATHS[@]}"; do
  echo -e "  ${CYN}${p}${NC}  —  ${DIRTY_STATUS[$p]}"
done

# --- Selection ---------------------------------------------------------------
if $SELECT_ALL; then
  SELECTED_PATHS=("${DIRTY_PATHS[@]}")
else
  step "Select submodules to commit (TAB to toggle, ENTER to confirm):"

  FZF_INPUT=""
  for p in "${DIRTY_PATHS[@]}"; do
    clean_status=$(echo -e "${DIRTY_STATUS[$p]}" | sed 's/\x1b\[[0-9;]*m//g')
    FZF_INPUT+="${p}  —  ${clean_status}"$'\n'
  done

  SELECTED=$(echo -n "$FZF_INPUT" | fzf --multi --ansi \
    --header="TAB=toggle  ENTER=confirm  ESC=cancel" \
    --prompt="Submodules> " \
    --preview="git -C '${ROOT_DIR}/{1}' status --short 2>/dev/null || echo 'Cannot read status'" \
    --preview-window=right:50%:wrap \
    | awk '{print $1}') || { info "Selection cancelled."; exit 0; }

  if [[ -z "$SELECTED" ]]; then
    info "Nothing selected."
    exit 0
  fi

  mapfile -t SELECTED_PATHS <<< "$SELECTED"
fi

echo -e "\n${BOLD}Selected ${#SELECTED_PATHS[@]} submodule(s):${NC}"
for p in "${SELECTED_PATHS[@]}"; do
  echo -e "  ${CYN}${p}${NC}"
done

# --- Commit message ----------------------------------------------------------
if [[ -z "$COMMIT_MSG" ]]; then
  echo ""
  read -r -p "$(echo -e "${BLU}Commit message: ${NC}")" COMMIT_MSG
  [[ -z "$COMMIT_MSG" ]] && die "Empty commit message — aborting."
fi

# --- Sort deepest-first for nested submodule bubbling ------------------------
sort_deepest_first() {
  printf '%s\n' "$@" | awk -F/ '{print NF, $0}' | sort -rnk1 | cut -d' ' -f2-
}

mapfile -t ORDERED < <(sort_deepest_first "${SELECTED_PATHS[@]}")

# --- Execute -----------------------------------------------------------------
if $DRY_RUN; then
  step "[DRY RUN] Would execute:"
  for sm in "${ORDERED[@]}"; do
    echo -e "  ${DIM}cd ${ROOT_DIR}/${sm}${NC}"
    echo -e "  ${DIM}git add .${NC}"
    echo -e "  ${DIM}git commit -m \"${COMMIT_MSG}\"${NC}"
    $NO_PUSH || echo -e "  ${DIM}git push origin HEAD${NC}"
    parent_dir=$(dirname "$sm")
    sm_basename=$(basename "$sm")
    if [[ "$parent_dir" != "." ]]; then
      echo -e "  ${DIM}cd ${ROOT_DIR}/${parent_dir} && git add ${sm_basename}${NC}"
    else
      echo -e "  ${DIM}cd ${ROOT_DIR} && git add ${sm}${NC}"
    fi
    echo ""
  done
  exit 0
fi

step "Committing and pushing ${#ORDERED[@]} submodule(s)…"

COMMITTED=()
FAILED=()

for sm in "${ORDERED[@]}"; do
  echo -e "\n${BOLD}━━━ ${CYN}${sm}${NC} ${BOLD}━━━${NC}"
  full_path="${ROOT_DIR}/${sm}"

  if ! git -C "$full_path" add .; then
    fail "git add failed in ${sm}"
    FAILED+=("$sm")
    continue
  fi
  ok "Staged changes"

  if ! git -C "$full_path" diff --cached --quiet 2>/dev/null; then
    if ! git -C "$full_path" commit -m "$COMMIT_MSG"; then
      fail "git commit failed in ${sm}"
      FAILED+=("$sm")
      continue
    fi
    ok "Committed"
  else
    warn "Nothing to commit after staging (already committed?)"
  fi

  if ! $NO_PUSH; then
    if git -C "$full_path" push origin HEAD 2>&1; then
      ok "Pushed to origin"
    else
      warn "Push failed (no remote, or auth issue) — continuing"
    fi
  fi

  parent_dir=$(dirname "$sm")
  sm_basename=$(basename "$sm")
  if [[ "$parent_dir" != "." ]]; then
    git -C "${ROOT_DIR}/${parent_dir}" add "$sm_basename"
    ok "Updated submodule ref in ${parent_dir}"
  else
    git -C "$ROOT_DIR" add "$sm"
    ok "Updated submodule ref in repo root"
  fi

  COMMITTED+=("$sm")
done

# --- Summary -----------------------------------------------------------------
step "Summary"
if [[ ${#COMMITTED[@]} -gt 0 ]]; then
  ok "${#COMMITTED[@]} submodule(s) committed"
  for c in "${COMMITTED[@]}"; do echo -e "    ${GRN}✓${NC} ${c}"; done
fi
if [[ ${#FAILED[@]} -gt 0 ]]; then
  fail "${#FAILED[@]} submodule(s) failed"
  for f in "${FAILED[@]}"; do echo -e "    ${RED}✗${NC} ${f}"; done
fi

# --- Offer to commit the parent repo ----------------------------------------
if [[ ${#COMMITTED[@]} -gt 0 ]]; then
  echo ""
  if ! git -C "$ROOT_DIR" diff --cached --quiet 2>/dev/null; then
    read -r -p "$(echo -e "${BLU}Commit updated submodule refs in parent repo? [Y/n]: ${NC}")" confirm
    confirm="${confirm:-Y}"
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      git -C "$ROOT_DIR" commit -m "$COMMIT_MSG"
      ok "Parent repo committed"
      if ! $NO_PUSH; then
        read -r -p "$(echo -e "${BLU}Push parent repo? [Y/n]: ${NC}")" push_confirm
        push_confirm="${push_confirm:-Y}"
        if [[ "$push_confirm" =~ ^[Yy]$ ]]; then
          git -C "$ROOT_DIR" push origin HEAD && ok "Parent repo pushed" || warn "Parent push failed"
        fi
      fi
    fi
  else
    info "No staged submodule ref changes in parent repo."
  fi
fi
