#!/bin/sh
# ex-litellm runs as a single non-distributed node — no Erlang clustering is
# needed, and a named node (-sname) collides on epmd when run-claude relaunches
# the gateway during health recovery. Forcing distribution off avoids the
# "name already in use" / stale-node conflicts.
export RELEASE_DISTRIBUTION=none
export RELEASE_NODE=ex_litellm
