# Generate with: openssl rand -base64 33
AUTH_SECRET=

# The public-facing URL of the app (used by NextAuth for callbacks)
AUTH_URL=http://localhost:8080

# Authentik OIDC provider — create an OAuth2/OIDC application in Authentik at auth.derobot.is
AUTHENTIK_ISSUER=https://auth.derobot.is/application/o/hello-world-mcp/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
