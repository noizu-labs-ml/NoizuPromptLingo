# .envrc.k8.dc — k8-lib tool config via direnv-config
# Provides scalar config that devops tools read at runtime.
# Source from .envrc: source_env_if_exists .envrc.k8.dc
#
# Requires: direnv-config (dc) — install from repos/incubator/utilities/direnv-config

# =============================================================================
# k8 config (base layer — safe to commit)
# =============================================================================
dc_yaml --no-bump k8 <<'YAML'
aws:
  profile: terraformer
  region: us-east-1
docker:
  registry: ""                          # e.g., ops.example.com
kubernetes:
  namespace: default
  staging_namespace: staging
  infra_namespace: infra
  app_prefix: app                       # label prefix for pod selectors
infisical:
  host: ""                              # e.g., https://infisical.example.com/api
  project_id: ""
helm:
  oci_registry: ""                      # e.g., oci://ghcr.io/your-org/charts
  registry_host: ghcr.io
preferences:
  diff_viewer: code                     # code | kdiff3 | opendiff | meld | terminal
  credentials_link: ""                  # link to credential vault (1Password, etc.)
terraform:
  dir: terraform
  lock_table: terraform-lock            # DynamoDB table for TF state locking
YAML

# =============================================================================
# k8 secrets (secrets layer — DO NOT commit real values)
# =============================================================================
dc_yaml --no-bump k8 --layer secrets --if-missing <<'YAML'
aws:
  account_id: ""
infisical:
  client_id: ""
  client_secret: ""
terraform:
  state_bucket: ""                      # S3 bucket for TF remote state
  kms_alias: ""                         # KMS alias for TF state encryption
helm:
  registry_user: ""
  registry_password: ""                 # GitHub PAT with write:packages scope
gemini:
  api_key: ""                           # Google Gemini API key (for media-tools)
YAML

dc_bump
