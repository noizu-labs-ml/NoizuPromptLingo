#!/bin/bash
# Reads /etc/osx-fstab and ensures each volume is mounted at its declared path.
#
# Format (one entry per line):
#   uuid=<UUID>  label=<Label>  disk=<device>  <mountpoint>  <fstype>  <options>  0  0
#
# Use - for unknown/unavailable identifiers.
# Mount attempt order: UUID → label → disk (first success wins).
# Volumes already at the correct mount point are left untouched.
# Volumes mounted elsewhere are force-unmounted then remounted at the correct path.

CONFIG="${OSX_FSTAB:-/etc/osx-fstab}"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') [fstab-remount] $*"; }

# Allow time for external disks to enumerate after boot
sleep 3

attempt_mount() {
    local identifier="$1" mountpoint="$2"
    [[ -z "$identifier" || "$identifier" == "-" ]] && return 1
    diskutil info "$identifier" &>/dev/null || return 1
    diskutil mount -mountPoint "$mountpoint" "$identifier" &>/dev/null
}

while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue

    uuid="" label="" disk=""
    remaining=()

    # Split while \040 is still literal (not yet a space) — fields stay intact
    for token in $line; do
        case "$token" in
            uuid=*)  uuid="${token#uuid=}"   ;;
            label=*) label="${token#label=}" ;;
            disk=*)  disk="${token#disk=}"   ;;
            *)       remaining+=("$token")   ;;
        esac
    done

    # Decode fstab-style octal escapes (e.g. \040 → space) in each field
    mountpoint="$(printf '%b' "${remaining[0]:-}")"
    options="$(printf '%b' "${remaining[2]:-}")"

    [[ -z "$mountpoint" || "$mountpoint" == "none" ]] && continue
    [[ "$options" == *"noauto"* ]] && continue

    # Determine current mount point using the first resolvable identifier
    current=""
    found_id=""
    for id in "$uuid" "$label" "$disk"; do
        [[ -z "$id" || "$id" == "-" ]] && continue
        info=$(diskutil info "$id" 2>/dev/null) || continue
        current=$(awk -F':[[:space:]]+' '/[[:space:]]Mount Point:/{print $2}' <<< "$info")
        found_id="$id"
        break
    done

    # Disk not present (offline / removable) — skip silently
    [[ -z "$found_id" ]] && continue

    # Already at the correct mount point
    if [[ "$current" == "$mountpoint" ]]; then
        log "OK    $mountpoint (already correct)"
        # Enable ownership if requested and not already enabled
        if [[ "$options" == *"owners"* ]]; then
            mount_opts=$(mount | grep -F " on $mountpoint " | grep -o '(.*)' || true)
            if [[ "$mount_opts" == *"noowners"* ]]; then
                if diskutil enableOwnership "$mountpoint" &>/dev/null; then
                    log "OWN   $mountpoint — ownership enabled"
                else
                    log "WARN  $mountpoint — failed to enable ownership"
                fi
            fi
        fi
        continue
    fi

    # Mounted at a different location — unmount first
    if [[ "$current" == /* ]]; then
        log "MOVE  $current → $mountpoint"
        diskutil unmount force "$found_id" &>/dev/null || {
            log "FAIL  could not unmount $found_id from $current — skipping"
            continue
        }
    else
        log "MOUNT → $mountpoint"
    fi

    # Ensure the target directory exists
    mkdir -p "$mountpoint"

    # Try UUID → label → disk
    mounted_id=""
    if attempt_mount "$uuid" "$mountpoint"; then
        log "OK    $mountpoint (by uuid=$uuid)"
        mounted_id="$uuid"
    elif attempt_mount "$label" "$mountpoint"; then
        log "OK    $mountpoint (by label=$label)"
        mounted_id="$label"
    elif attempt_mount "$disk" "$mountpoint"; then
        log "OK    $mountpoint (by disk=$disk)"
        mounted_id="$disk"
    else
        log "FAIL  $mountpoint — exhausted uuid=$uuid label=$label disk=$disk"
    fi

    # Enable ownership if requested
    if [[ -n "$mounted_id" && "$options" == *"owners"* ]]; then
        if diskutil enableOwnership "$mountpoint" &>/dev/null; then
            log "OWN   $mountpoint — ownership enabled"
        else
            log "WARN  $mountpoint — failed to enable ownership"
        fi
    fi

done < "$CONFIG"
