@startsalt
' Screen: Create Script Modal
' User Stories:
'   - As a tester, I can create a new script with a name and optional description
'   - As a tester, the slug is auto-derived from the name but I can override it
'   - As a tester, I am shown an error if the slug conflicts with an existing script

{
  == Create New Script ==
  ..
  {
    <b>Name</b> <color:red>*</color>
    "My New Script                              "
  }
  ..
  {
    <b>Description</b> <i>(optional)</i>
    {
      "Describe what this script tests...        "
      "                                          "
    }
  }
  ..
  {
    <b>Slug</b> <i>(auto-derived, editable)</i>
    "my-new-script                              "
  }
  ..
  {+ <color:red><b>⚠ Slug conflict</b></color>
  <i>A script with slug "my-new-script" already exists in this workspace.</i>
  <i>Please choose a different slug.</i> }
  ==
  {
    [  Cancel  ]  |  [  Create Script  ]
  }
}

@endsalt
