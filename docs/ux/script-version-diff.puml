@startsalt
' Screen: Script Version Diff View
' User Stories:
'   - As a tester, I can compare two versions of a script side by side
'   - As a tester, I can see which nodes were added, removed, or modified
'   - As a tester, I can view the raw YAML diff between two versions

{
  == Version Diff: checkout-flow-test ==
  ..
  {
    <b>Base:</b>  ^v2 ▼^   <i>2026-05-08</i>   |   <b>Compare:</b>  ^v3 ▼^   <i>(draft)</i>   |  [Compare]
  }
  ==
  {
    ' ── LEFT: Node Change Summary ──────────────────────────────────────
    {+
      <b>Node Changes</b>
      ..
      {#
        <b>Status</b>  | <b>Node Key</b>          | <b>Kind</b>
        <color:gray>= unchanged</color>   | greeting          | User Turn
        <color:orange>~ modified</color>  | ask_quantity      | User Turn
        <color:green>+ added</color>      | upsell_offer      | User Turn
        <color:gray>= unchanged</color>   | confirm_order     | System
        <color:red>- removed</color>     | old_error_node    | Terminal
        <color:gray>= unchanged</color>   | checkout_terminal | Terminal
      }
      ..
      <b>Edge Changes</b>
      ..
      {#
        <b>Status</b>  | <b>Edge</b>
        <color:orange>~ modified</color>  | greeting → ask_quantity (priority 10→5)
        <color:green>+ added</color>      | ask_quantity → upsell_offer
        <color:red>- removed</color>     | ask_quantity → old_error_node
      }
    }
    |
    ' ── RIGHT: YAML Diff ───────────────────────────────────────────────
    {+
      {/ <b>YAML Diff</b> | Node Details }
      ..
      "  nodes:"
      "<color:orange>~   - key: ask_quantity</color>"
      "<color:red>-       prompt: quantity-prompt@v1</color>"
      "<color:green>+       prompt: quantity-prompt@v2</color>"
      "<color:red>-       freeball_policy: required</color>"
      "<color:green>+       freeball_policy: strict</color>"
      " "
      "<color:green>+   - key: upsell_offer</color>"
      "<color:green>+     kind: user_turn</color>"
      "<color:green>+     prompt: upsell-prompt@v1</color>"
      "<color:green>+     freeball_policy: required</color>"
      " "
      "<color:red>-   - key: old_error_node</color>"
      "<color:red>-     kind: terminal</color>"
    }
  }
}

@endsalt
