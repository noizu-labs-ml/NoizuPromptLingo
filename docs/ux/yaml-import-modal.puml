@startsalt
' Screen: YAML Import Modal
' User Stories:
'   - As a tester, I can import a script by uploading a YAML file
'   - As a tester, I can paste YAML directly into a textarea
'   - As a tester, I can validate the YAML before committing the import
'   - As a tester, I see detailed validation errors before importing

{
  == Import Script from YAML ==
  ..
  {+
    <b>Upload File</b>
    .
    .
    "  📂  Drag & drop a .yaml / .yml file here, or [Browse Files]  "
    .
    .
  }
  ..
  <i>— or paste YAML directly —</i>
  ..
  {+
    <b>Paste YAML</b>
    {
      "script:"
      "  name: checkout-flow-test"
      "  slug: checkout-flow-test"
      "  nodes:"
      "    - key: greeting"
      "      kind: user_turn"
      "      prompt: greeting-prompt@v2"
      "      ..."
      "                                          "
    }
  }
  ..
  [ Validate YAML ]
  ..
  == Validation Results ==
  {+
    <color:red>✗ 2 errors found — import blocked</color>
    ..
    {#
      <b>#</b> | <b>Path</b>                        | <b>Error</b>
      1  | nodes[2].edges[0].target    | Referenced node key "upsell_node" does not exist in this script
      2  | nodes[1].expectations[0]   | Weight must be between 0.0 and 1.0; got 1.4
    }
  }
  ==
  {
    [ Cancel ]  |  [  Import  ]
  }
}

@endsalt
