schema: "0.3"
id: svg-icon-001
type: image
service: gemini-chat
model: gemini-2.5-flash

prompt:
  system: |
    You are an SVG graphic generator.
    RULES:
    - Output ONLY the raw SVG markup. Start with <svg, end with </svg>.
    - Do NOT wrap output in markdown code fences (no ```).
    - Do NOT include XML comments (no <!-- -->).
    - Do NOT include explanatory text before or after the SVG.
    - Use compact path data — no line breaks inside attribute values.
    - Precompute all coordinates; do not show math in the output.
  text: |
    Create a minimal geometric logomark: two interlocking hexagons forming a brain shape.
    Colors: electric cyan (#00D4FF) and deep navy (#0A1628).
    Style: clean vector lines, no fills, stroke-width 2.
    ViewBox: 0 0 200 200. Keep paths compact — precompute all vertex coordinates as decimals.
  provider_options:
    max_tokens: 16384
    thinking_budget: 1024
    temperature: 0.3

output:
  formats:
    - format: svg
  text_format: svg

tags: [logo, svg, icon]
