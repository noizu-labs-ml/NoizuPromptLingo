schema: "0.3"
id: html-pricing-001
type: html
service: openai-chat
model: gpt-4.1

prompt:
  system: "Generate a complete, self-contained HTML page with inline CSS. No external dependencies. Modern, responsive, dark-themed design."
  text: "Create a SaaS pricing page with 3 tiers: Starter ($9/mo, 1 project), Pro ($29/mo, 10 projects), Enterprise (custom). Include feature comparison, FAQ accordion with JavaScript, and CTA buttons."
  provider_options:
    max_tokens: 8192
    temperature: 0.3

output:
  formats:
    - format: html

tags: [landing-page, pricing, html]
