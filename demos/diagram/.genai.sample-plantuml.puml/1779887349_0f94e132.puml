@startuml
class Product {
  - id: int
  - name: String
  - price: float
}

class Cart {
  - id: int
  - createdAt: Date
}

class CartItem {
  - quantity: int
}

class Order {
  - id: int
  - orderDate: Date
  - status: String
}

class OrderLine {
  - quantity: int
  - price: float
}

class Customer {
  - id: int
  - name: String
  - email: String
}

Customer "1" -- "0..*" Cart : owns >
Cart "1" *-- "0..*" CartItem : contains >
CartItem "1" -- "1" Product : refers >
Customer "1" -- "0..*" Order : places >
Order "1" *-- "1..*" OrderLine : contains >
OrderLine "1" -- "1" Product : refers >
@enduml