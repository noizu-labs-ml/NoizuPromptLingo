ARG NODE_VERSION=24.13.1
ARG PYTHON_VERSION=3.13

FROM node:${NODE_VERSION}-alpine AS build

RUN apk add --no-cache git python3 make g++ libc6-compat
RUN corepack enable

WORKDIR /src
COPY . .

ENV NODE_OPTIONS=--max-old-space-size=8192
RUN pnpm install --frozen-lockfile
RUN pnpm build:deploy

FROM python:${PYTHON_VERSION}-alpine AS runtime

ARG N8N_VERSION=snapshot
ARG N8N_RELEASE_TYPE=dev

ENV NODE_ENV=production
ENV N8N_RELEASE_TYPE=${N8N_RELEASE_TYPE}
ENV SHELL=/bin/sh

RUN apk add --no-cache ca-certificates libc6-compat libstdc++ nodejs npm tini
RUN addgroup -g 1000 -S runner && \
    adduser -u 1000 -S -G runner -h /home/runner -D runner

WORKDIR /home/runner

COPY --from=build --chown=root:root /src/dist/task-runner-javascript /opt/runners/task-runner-javascript
COPY --from=build --chown=root:root /src/packages/@n8n/task-runner-python /opt/runners/task-runner-python
COPY --from=build --chown=root:root /src/docker/images/runners/n8n-task-runners.json /etc/n8n-task-runners.json

RUN npm install -g corepack && \
    corepack enable && \
    cd /opt/runners/task-runner-javascript && \
    pnpm add moment@2.30.1 --prod --no-lockfile && \
    python -m venv /opt/runners/task-runner-python/.venv && \
    /opt/runners/task-runner-python/.venv/bin/pip install --no-cache-dir /opt/runners/task-runner-python

USER runner
EXPOSE 5680/tcp
ENTRYPOINT ["tini", "--", "node", "/opt/runners/task-runner-javascript/dist/start.js"]

LABEL org.opencontainers.image.title="n8n task runners" \
      org.opencontainers.image.description="Sidecar image providing n8n task runners" \
      org.opencontainers.image.source="https://github.com/n8n-io/n8n" \
      org.opencontainers.image.url="https://n8n.io" \
      org.opencontainers.image.version="${N8N_VERSION}"
