FROM clojure:temurin-21-tools-deps-bookworm AS build

RUN apt-get update && \
    apt-get install -y --no-install-recommends curl ca-certificates git nodejs npm rsync && \
    npm install -g corepack && \
    corepack enable && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ENV NODE_OPTIONS=--max-old-space-size=4096
RUN ./manage.sh build-frontend-bundle

FROM nginxinc/nginx-unprivileged:1.29.1

USER root

RUN set -ex; \
    useradd -U -M -u 1001 -s /bin/false -d /opt/penpot penpot; \
    mkdir -p /opt/data/assets; \
    chown -R penpot:penpot /opt/data; \
    mkdir -p /etc/nginx/overrides/main.d/; \
    mkdir -p /etc/nginx/overrides/http.d/; \
    mkdir -p /etc/nginx/overrides/server.d/; \
    mkdir -p /etc/nginx/overrides/assets.d/; \
    mkdir -p /etc/nginx/overrides/location.d/

COPY --from=build /src/bundles/frontend/ /var/www/app/
COPY docker/images/files/config.js /var/www/app/js/config.js
COPY docker/images/files/nginx.conf.template /tmp/nginx.conf.template
COPY docker/images/files/nginx-resolvers.conf.template /tmp/resolvers.conf.template
COPY docker/images/files/nginx-mime.types /etc/nginx/mime.types
COPY docker/images/files/nginx-external-locations.conf /etc/nginx/overrides/location.d/external-locations.conf
COPY docker/images/files/nginx-entrypoint.sh /entrypoint.sh

RUN chown -R 1001:0 /var/cache/nginx; \
    chmod -R g+w /var/cache/nginx; \
    chown -R 1001:0 /etc/nginx; \
    chmod -R g+w /etc/nginx; \
    chown -R 1001:0 /var/www; \
    chmod -R g+w /var/www; \
    chmod +x /entrypoint.sh

USER penpot:penpot
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]

