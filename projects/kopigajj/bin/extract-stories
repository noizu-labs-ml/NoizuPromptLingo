#!/usr/bin/env bash
# Extract various views from the stories.yaml file
# Usage: ./extract-stories <view-name>
# Views: id-title, stage, status, tshirt, complexity, persona, dependencies

STORIES_FILE="$(dirname "$0")/../user-stories/stories.yaml"

# Check if yq is installed
if ! command -v yq &> /dev/null; then
    echo "Error: yq is not installed"
    echo "Install with: brew install yq"
    exit 1
fi

extract_id_title() {
    echo "# ID | Title"
    echo "--- | ---"
    yq '.stories[] | [.id, .title] | join(" | ")' "$STORIES_FILE"
}

extract_by_stage() {
    local stage=$1
    echo "# Stories in Stage $stage"
    echo "---"
    yq ".stories[] | select(.stage == $stage) | \"- \(.id): \(.title)\"" "$STORIES_FILE"
}

extract_all_stages() {
    echo "# Stories by Stage"
    echo ""
    for stage in {0..7}; do
        echo "## Stage $stage"
        yq ".stories[] | select(.stage == $stage) | \"- \(.id): \(.title)\"" "$STORIES_FILE"
        echo ""
    done
}

extract_by_status() {
    local status=$1
    echo "# Stories with status: $status"
    echo "---"
    yq ".stories[] | select(.status == \"$status\") | \"- \(.id): \(.title)\"" "$STORIES_FILE"
}

extract_tshirt_sizes() {
    echo "# Stories by T-Shirt Size"
    echo ""
    for size in XS S M L XL XXL; do
        count=$(yq ".stories[] | select(.notes.t_shirt_size == \"$size\") | length" "$STORIES_FILE" | wc -l | tr -d ' ')
        echo "## Size $size: $count stories"
        yq ".stories[] | select(.notes.t_shirt_size == \"$size\") | \"- \(.id): \(.title)\"" "$STORIES_FILE"
        echo ""
    done
}

extract_complexity() {
    echo "# Stories by Complexity"
    echo ""
    for complexity in low medium high xl; do
        count=$(yq ".stories[] | select(.notes.complexity == \"$complexity\") | length" "$STORIES_FILE" | wc -l | tr -d ' ')
        echo "## Complexity $complexity: $count stories"
        yq ".stories[] | select(.notes.complexity == \"$complexity\") | \"- \(.id): \(.title)\"" "$STORIES_FILE"
        echo ""
    done
}

extract_by_persona() {
    local persona=$1
    echo "# Stories for persona: $persona"
    echo "---"
    yq ".stories[] | select(.notes.persona == \"$persona\") | \"- \(.id): \(.title)\"" "$STORIES_FILE"
}

extract_dependencies() {
    echo "# Story Dependencies"
    echo "---"
    yq '.stories[] | "\(.id) -> " + (.notes.dependencies | join(", "))' "$STORIES_FILE" | sed 's/ -> ->/ -> none/'
}

extract_summary() {
    echo "# User Stories Summary"
    echo ""
    local total=$(yq '.stories | length' "$STORIES_FILE")
    echo "**Total Stories:** $total"
    echo ""
    echo "**By Stage:**"
    for stage in {0..7}; do
        local count=$(yq ".stories[] | select(.stage == $stage) | length" "$STORIES_FILE" | wc -l | tr -d ' ')
        echo "  - Stage $stage: $count"
    done
    echo ""
    echo "**By Status:**"
    for status in pending in_progress done blocked; do
        local count=$(yq ".stories[] | select(.status == \"$status\") | length" "$STORIES_FILE" | wc -l | tr -d ' ')
        echo "  - $status: $count"
    done
}

show_usage() {
    echo "Usage: $0 <view-name>"
    echo ""
    echo "Available views:"
    echo "  id-title              - List all stories with ID and title"
    echo "  all-stages            - Group all stories by stage (0-7)"
    echo "  stage <0-7>           - Show stories in a specific stage"
    echo "  status <status>       - Show stories with specific status (pending, in_progress, done, blocked)"
    echo "  tshirt                - Group stories by T-shirt size"
    echo "  complexity            - Group stories by complexity"
    echo "  persona <type>        - Show stories for persona (developer, knowledge-worker, both)"
    echo "  dependencies          - Show story dependencies"
    echo "  summary               - Overall summary statistics"
    echo ""
    echo "Examples:"
    echo "  $0 id-title"
    echo "  $0 stage 0"
    echo "  $0 status pending"
    echo "  $0 tshirt"
}

case "${1:-help}" in
    -h|--help|help) show_usage ;;
    id-title)       extract_id_title ;;
    all-stages)     extract_all_stages ;;
    stage)          extract_by_stage "${2}" ;;
    status)         extract_by_status "${2}" ;;
    tshirt)         extract_tshirt_sizes ;;
    complexity)     extract_complexity ;;
    persona)        extract_by_persona "${2}" ;;
    dependencies)   extract_dependencies ;;
    summary)        extract_summary ;;
    *)              show_usage ;;
esac