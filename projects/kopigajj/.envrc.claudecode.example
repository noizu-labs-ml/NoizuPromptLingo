# =============================================================================
# Claude Code Environment Variables — .envrc example
# =============================================================================
# Copy this file to .envrc, uncomment the variables you need, and run:
#   direnv allow
# Or source manually:
#   source .envrc
#
# Default values are shown where known. Variables with no default are noted.
# =============================================================================


# -----------------------------------------------------------------------------
# Authentication & API Configuration
# -----------------------------------------------------------------------------

# API key sent as X-Api-Key header. Overrides Claude Pro/Team/Enterprise subscription.
# Default: (none — uses OAuth login)
# export ANTHROPIC_API_KEY=""

# Custom value for the Authorization: Bearer header
# Default: (none)
# export ANTHROPIC_AUTH_TOKEN=""

# Override API endpoint for proxy or gateway routing
# Default: https://api.anthropic.com
# export ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Extra headers on requests (Name: Value, newline-separated for multiple)
# Default: (none)
# export ANTHROPIC_CUSTOM_HEADERS=""


# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------

# Model setting name
# Default: (auto — latest available)
# export ANTHROPIC_MODEL=""

# Override default Haiku-class model
# Default: (latest haiku)
# export ANTHROPIC_DEFAULT_HAIKU_MODEL=""

# Override default Sonnet-class model
# Default: (latest sonnet)
# export ANTHROPIC_DEFAULT_SONNET_MODEL=""

# Override default Opus-class model
# Default: (latest opus)
# export ANTHROPIC_DEFAULT_OPUS_MODEL=""

# Add a custom model ID to the /model picker
# Default: (none)
# export ANTHROPIC_CUSTOM_MODEL_OPTION=""

# Display name for the custom model (defaults to model ID if unset)
# Default: (model ID)
# export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME=""

# Display description for the custom model
# Default: "Custom model (<model-id>)"
# export ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION=""

# DEPRECATED — Haiku-class model for background tasks
# Default: (latest haiku)
# export ANTHROPIC_SMALL_FAST_MODEL=""

# AWS region override for Haiku on Bedrock
# Default: (none)
# export ANTHROPIC_SMALL_FAST_MODEL_AWS_REGION=""

# Effort level: low, medium, high, max (Opus only), auto
# Default: auto
# export CLAUDE_CODE_EFFORT_LEVEL="auto"

# Model override for subagents
# Default: (inherits parent model)
# export CLAUDE_CODE_SUBAGENT_MODEL=""

# Max output tokens per request
# Default: (model default)
# export CLAUDE_CODE_MAX_OUTPUT_TOKENS=""

# Extended thinking token budget (0 = disable thinking)
# Default: (model default)
# export MAX_THINKING_TOKENS=""

# Disable adaptive reasoning for Opus/Sonnet 4.6
# Default: 0
# export CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING="0"

# Disable 1M context window support
# Default: 0
# export CLAUDE_CODE_DISABLE_1M_CONTEXT="0"

# Disable prompt caching for all models
# Default: 0
# export DISABLE_PROMPT_CACHING="0"

# Disable prompt caching per model family
# Default: 0
# export DISABLE_PROMPT_CACHING_HAIKU="0"
# export DISABLE_PROMPT_CACHING_SONNET="0"
# export DISABLE_PROMPT_CACHING_OPUS="0"


# -----------------------------------------------------------------------------
# Cloud Providers — AWS Bedrock
# -----------------------------------------------------------------------------

# Enable AWS Bedrock integration
# Default: 0
# export CLAUDE_CODE_USE_BEDROCK="0"

# Bedrock API key
# Default: (none)
# export AWS_BEARER_TOKEN_BEDROCK=""

# Skip AWS auth (e.g., when using an LLM gateway)
# Default: 0
# export CLAUDE_CODE_SKIP_BEDROCK_AUTH="0"


# -----------------------------------------------------------------------------
# Cloud Providers — Google Vertex AI
# -----------------------------------------------------------------------------

# Enable Vertex AI integration
# Default: 0
# export CLAUDE_CODE_USE_VERTEX="0"

# Skip Google auth
# Default: 0
# export CLAUDE_CODE_SKIP_VERTEX_AUTH="0"

# Per-model region overrides for Vertex AI
# Default: (auto)
# export VERTEX_REGION_CLAUDE_3_5_HAIKU=""
# export VERTEX_REGION_CLAUDE_3_7_SONNET=""
# export VERTEX_REGION_CLAUDE_4_0_OPUS=""
# export VERTEX_REGION_CLAUDE_4_0_SONNET=""
# export VERTEX_REGION_CLAUDE_4_1_OPUS=""


# -----------------------------------------------------------------------------
# Cloud Providers — Microsoft Foundry
# -----------------------------------------------------------------------------

# Enable Microsoft Foundry integration
# Default: 0
# export CLAUDE_CODE_USE_FOUNDRY="0"

# Foundry API key
# Default: (none)
# export ANTHROPIC_FOUNDRY_API_KEY=""

# Foundry resource name (e.g., my-resource)
# Default: (none)
# export ANTHROPIC_FOUNDRY_RESOURCE=""

# Full Foundry base URL (e.g., https://my-resource.services.ai.azure.com/anthropic)
# Default: (none)
# export ANTHROPIC_FOUNDRY_BASE_URL=""

# Skip Azure auth for Foundry
# Default: 0
# export CLAUDE_CODE_SKIP_FOUNDRY_AUTH="0"

# Allow fast mode when org status check fails due to network error
# Default: 0
# export CLAUDE_CODE_SKIP_FAST_MODE_NETWORK_ERRORS="0"


# -----------------------------------------------------------------------------
# Bash & Shell Execution
# -----------------------------------------------------------------------------

# Default timeout for bash commands (ms)
# Default: 120000
# export BASH_DEFAULT_TIMEOUT_MS="120000"

# Maximum timeout the model can set (ms)
# Default: 600000
# export BASH_MAX_TIMEOUT_MS="600000"

# Max characters in bash output before middle-truncation
# Default: (auto)
# export BASH_MAX_OUTPUT_LENGTH=""

# Return to original working directory after each command
# Default: 0
# export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR="0"

# Override automatic shell detection (bash, zsh, etc.)
# Default: (auto-detected from $SHELL)
# export CLAUDE_CODE_SHELL=""

# Command prefix wrapping all bash commands (for logging/auditing)
# Default: (none)
# export CLAUDE_CODE_SHELL_PREFIX=""

# Shell script sourced before each Bash command (virtualenv/conda activation)
# Default: (none)
# export CLAUDE_ENV_FILE=""


# -----------------------------------------------------------------------------
# Context Window & Memory
# -----------------------------------------------------------------------------

# Context capacity percentage at which auto-compaction triggers (1-100)
# Default: 95
# export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="95"

# Context capacity in tokens for auto-compaction calculations
# Default: (model context window — 200K standard, 1M extended)
# export CLAUDE_CODE_AUTO_COMPACT_WINDOW=""

# Disable auto memory
# Default: 0
# export CLAUDE_CODE_DISABLE_AUTO_MEMORY="0"

# Load CLAUDE.md files from --add-dir directories
# Default: 0
# export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD="0"

# Token limit for file reads
# Default: (auto)
# export CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=""


# -----------------------------------------------------------------------------
# Network & Proxy
# -----------------------------------------------------------------------------

# HTTP/HTTPS proxy servers
# Default: (none)
# export HTTP_PROXY=""
# export HTTPS_PROXY=""

# Domains/IPs to bypass proxy
# Default: (none)
# export NO_PROXY=""

# Let proxy handle DNS resolution instead of caller
# Default: false
# export CLAUDE_CODE_PROXY_RESOLVES_HOSTS="false"


# -----------------------------------------------------------------------------
# mTLS & Certificates
# -----------------------------------------------------------------------------

# Client certificate for mTLS authentication
# Default: (none)
# export CLAUDE_CODE_CLIENT_CERT=""

# Client private key for mTLS authentication
# Default: (none)
# export CLAUDE_CODE_CLIENT_KEY=""

# Passphrase for encrypted client key
# Default: (none)
# export CLAUDE_CODE_CLIENT_KEY_PASSPHRASE=""


# -----------------------------------------------------------------------------
# MCP (Model Context Protocol)
# -----------------------------------------------------------------------------

# Tool search: true (always on), auto (at 10%), auto:N (custom %), false (off)
# Default: auto
# export ENABLE_TOOL_SEARCH="auto"

# Server startup timeout (ms)
# Default: (varies)
# export MCP_TIMEOUT=""

# Tool execution timeout (ms)
# Default: (varies)
# export MCP_TOOL_TIMEOUT=""

# Max tokens in MCP responses (warning at 10,000)
# Default: 25000
# export MAX_MCP_OUTPUT_TOKENS="25000"

# Fixed port for OAuth redirect callback
# Default: (auto)
# export MCP_OAUTH_CALLBACK_PORT=""

# OAuth client secret for MCP servers with pre-configured credentials
# Default: (none)
# export MCP_CLIENT_SECRET=""

# Disable claude.ai MCP servers
# Default: true (enabled for logged-in users)
# export ENABLE_CLAUDEAI_MCP_SERVERS="true"


# -----------------------------------------------------------------------------
# Plugins
# -----------------------------------------------------------------------------

# Git timeout for plugin install/update (ms)
# Default: 120000
# export CLAUDE_CODE_PLUGIN_GIT_TIMEOUT_MS="120000"

# Read-only plugin seed directories (colon-separated on Unix)
# Default: (none)
# export CLAUDE_CODE_PLUGIN_SEED_DIR=""

# Force plugin auto-updates even when main autoupdater is disabled
# Default: false
# export FORCE_AUTOUPDATER_PLUGINS="false"


# -----------------------------------------------------------------------------
# Automation & Scheduling
# -----------------------------------------------------------------------------

# Disable scheduled tasks and /loop
# Default: 0
# export CLAUDE_CODE_DISABLE_CRON="0"

# Disable background tasks and Ctrl+B
# Default: 0
# export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS="0"

# Auto-exit delay after idle (ms, useful for automated workflows)
# Default: (none — no auto-exit)
# export CLAUDE_CODE_EXIT_AFTER_STOP_DELAY=""


# -----------------------------------------------------------------------------
# UI & Terminal
# -----------------------------------------------------------------------------

# Disable automatic terminal title updates
# Default: 0
# export CLAUDE_CODE_DISABLE_TERMINAL_TITLE="0"

# Disable prompt suggestions (grayed-out predictions)
# Default: true (enabled)
# export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION="true"

# Enable task tracking in non-interactive (-p) mode
# Default: false
# export CLAUDE_CODE_ENABLE_TASKS="false"

# Share a task list across sessions (set same ID in multiple instances)
# Default: (none)
# export CLAUDE_CODE_TASK_LIST_ID=""

# Demo mode: hides email/org, skips onboarding
# Default: false
# export IS_DEMO="false"


# -----------------------------------------------------------------------------
# Git & Workflows
# -----------------------------------------------------------------------------

# Strip git/commit/PR workflow instructions from system prompt
# Default: 0
# export CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS="0"


# -----------------------------------------------------------------------------
# Telemetry & Reporting
# -----------------------------------------------------------------------------

# Opt out of Statsig telemetry
# Default: 0
# export DISABLE_TELEMETRY="0"

# Opt out of Sentry error reporting
# Default: 0
# export DISABLE_ERROR_REPORTING="0"

# Disable /feedback command
# Default: 0
# export DISABLE_FEEDBACK_COMMAND="0"

# Disable cost warning messages
# Default: 0
# export DISABLE_COST_WARNINGS="0"

# Disable session quality surveys
# Default: 0
# export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY="0"

# Disable all non-essential traffic (autoupdater + feedback + error + telemetry)
# Default: 0
# export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="0"

# Enable OpenTelemetry data collection
# Default: 0
# export CLAUDE_CODE_ENABLE_TELEMETRY="0"

# OTel headers refresh interval (ms, ~29 min default)
# Default: 1740000
# export CLAUDE_CODE_OTEL_HEADERS_HELPER_DEBOUNCE_MS="1740000"


# -----------------------------------------------------------------------------
# Installation & Updates
# -----------------------------------------------------------------------------

# Disable automatic updates
# Default: 0
# export DISABLE_AUTOUPDATER="0"

# Disable installation warnings
# Default: 0
# export DISABLE_INSTALLATION_CHECKS="0"

# Skip auto-installation of IDE extensions
# Default: 0
# export CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="0"


# -----------------------------------------------------------------------------
# Directories & Paths
# -----------------------------------------------------------------------------

# Custom config/data directory
# Default: ~/.claude
# export CLAUDE_CONFIG_DIR="$HOME/.claude"

# Override temp directory (Claude appends /claude/)
# Default: /tmp
# export CLAUDE_CODE_TMPDIR="/tmp"

# Interactive /init setup flow
# Default: false
# export CLAUDE_CODE_NEW_INIT="false"


# -----------------------------------------------------------------------------
# Features & Experimental
# -----------------------------------------------------------------------------

# Minimal/bare mode — no hooks, skills, MCP, auto memory, CLAUDE.md
# Default: 0
# export CLAUDE_CODE_SIMPLE="0"

# Disable fast mode
# Default: 0
# export CLAUDE_CODE_DISABLE_FAST_MODE="0"

# Enable agent teams (experimental)
# Default: 0
# export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS="0"

# Use system-installed rg instead of built-in
# Default: 1 (use built-in)
# export USE_BUILTIN_RIPGREP="1"

# Character budget for skill metadata in Skill tool
# Default: (auto)
# export SLASH_COMMAND_TOOL_CHAR_BUDGET=""

# Max time for SessionEnd hooks (ms)
# Default: 1500
# export CLAUDE_CODE_SESSIONEND_HOOKS_TIMEOUT_MS="1500"

# Strip anthropic-beta headers (for proxy gateways that reject them)
# Default: 0
# export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="0"


# -----------------------------------------------------------------------------
# Account & Organization (SDK Callers)
# -----------------------------------------------------------------------------

# Account UUID for SDK callers
# Default: (none)
# export CLAUDE_CODE_ACCOUNT_UUID=""

# User email for SDK callers
# Default: (none)
# export CLAUDE_CODE_USER_EMAIL=""

# Organization UUID for SDK callers
# Default: (none)
# export CLAUDE_CODE_ORGANIZATION_UUID=""
