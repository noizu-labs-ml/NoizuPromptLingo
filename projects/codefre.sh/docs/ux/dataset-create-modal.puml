@startsalt
' Screen: Create Dataset Modal
' User Stories:
'   - US-404: As a developer, I can create a new dataset with a name, slug, and type
'   - US-405: As a developer, the slug is auto-derived from the name but editable
'   - US-406: As a developer, I choose between request_response and conversation types at creation

{
  <b>Create New Dataset</b>                                              [✕]
  ==
  {
    <b>Name</b> <i>(required)</i>
    "                                                                    "
    <i>e.g. Customer Support QA, Regression Set v2</i>
    --
    <b>Slug</b> <i>(auto-derived, editable)</i>
    "                                                                    "
    <i>Used in API and URLs. Lowercase, hyphens only. Auto-generated from Name.</i>
    --
    <b>Description</b> <i>(optional)</i>
    {+
      "                                                                    "
      "                                                                    "
    }
    --
    <b>Type</b> <i>(required)</i>
    --
    {
      (X) <b>request_response</b>
          <i>Single-turn: one input → one expected output. Best for QA, classification, extraction.</i>
      --
      ( ) <b>conversation</b>
          <i>Multi-turn: sequence of messages with roles. Best for dialogue and chat agents.</i>
    }
    ==
    {
      [Cancel] | [Create Dataset]
    }
  }
}
@endsalt
