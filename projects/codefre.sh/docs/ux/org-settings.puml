@startsalt
' Screen: Org Settings Shell (General tab active)
' User Stories:
'   - As an org admin, I want a settings hub with clear section navigation
'   - As an org admin, I want to rename my org or change its slug
'   - As an org admin, I want to navigate directly to members, tokens, SSO, freeball, webhooks, or audit log

{
  ' Top nav
  {
    <b>codefre.sh</b> | Scripts | Runs | Review Queue | <b>Settings</b>
    .
    <i>Acme Engineering</i> | keith@noizu.com
  }
  ==
  ' Page header
  {
    <b>Organization Settings — Acme Engineering</b>
  }
  --
  ' Two-column: sidebar + content
  {
    ' Sidebar
    {+
      <b>Settings</b>
      --
      <b>General</b>
      Members
      API Tokens
      SSO
      Freeball
      Webhooks
      Audit Log
      --
      ..
      <i>Danger Zone</i>
      <color:red>Delete Organization</color>
    }
    |
    ' Main content — General tab
    {
      <b>General</b>
      ==
      {+
        <b>Organization Name</b>
        "Acme Engineering                   "
        <i>Displayed across the app and in notification emails.</i>
        --
        <b>Slug</b>
        "acme-engineering                   "
        <i>Used in URLs and API references. Changing this will break existing integrations.</i>
        <color:orange>Warning: renaming the slug updates all API URLs. Notify your team.</color>
        --
        <b>Default Runner Model</b>
        ^gpt-4o                             ^
        <i>Used for freeball runs unless overridden at the script level.</i>
        --
        <b>Org Timezone</b>
        ^America/Chicago (UTC-5)            ^
        <i>Used for scheduled runs and audit log timestamps.</i>
        --
        [Save Changes]   [Cancel]
      }
      ==
      {+
        <b>Danger Zone</b>
        --
        <color:red>Delete this organization</color>
        <i>Permanently deletes all scripts, runs, freeballs, and member data.\nThis action cannot be undone.</i>
        --
        [Delete Organization...]
      }
    }
  }
}

@endsalt
