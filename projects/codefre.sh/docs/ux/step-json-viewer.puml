@startsalt
' Screen: Step JSON Viewer (Modal)
' Related user stories:
'   US-40: As a developer, I want to inspect the raw JSON payload of any run step
'   US-41: As a developer, I want to copy subtree JSON to clipboard for debugging

{
  ' Modal header
  {
    <b>Step JSON — Turn 2 · Agent Response</b> | " " | [X Close]
  }
  ==
  ' Toolbar
  {
    [ Copy All ] | [ Expand All ] | [ Collapse All ] | " " | " Search keys... "
  }
  --
  ' JSON tree (pretty-printed)
  {T
    + <b>run_step</b>
    ++ step_id: "step_2847_t2"
    ++ turn: 2
    ++ role: "agent"
    ++ <b>prompt</b>                          [Copy ⎘]
    +++ model: "gpt-4o"
    +++ temperature: 0.7
    +++ max_tokens: 512
    +++ <b>messages</b>
    ++++ [0] role: "system"
    ++++ [0] content: "You are a helpful e-commerce support agent..."
    ++++ [1] role: "user"
    ++++ [1] content: "I want to return my order #45892..."
    ++ <b>response</b>                         [Copy ⎘]
    +++ content: "I'd be happy to help with your return..."
    +++ finish_reason: "stop"
    +++ <b>usage</b>
    ++++ prompt_tokens: 312
    ++++ completion_tokens: 87
    ++++ total_tokens: 399
    ++ <b>scoring</b>                          [Copy ⎘]
    +++ score: 0.92
    +++ scorer_version: "v2.1"
