@startsalt
' Screen: OTel Settings — Retention Policy
' User Stories:
'   - US-311: As an admin, I can configure how long span data is retained
'   - US-312: As an admin, I can see current storage usage before changing retention
'   - US-313: As an admin, I am warned before saving settings that will delete data

{
  <b>CodeFre.sh</b> | Settings | Observability | <b>Retention</b>
  ==
  {/ <b>Retention</b> | <b>Sampling</b> | <b>Exporters</b> | <b>Index Settings</b> }
  ==
  {
    <b>Data Retention Policy</b>
    <i>Configure how long OTel spans and logs are stored before automatic deletion.</i>
    ==
    {
      <b>⚠ Warning</b>
      Reducing retention will <b>permanently delete</b> spans and logs older than the new threshold.
      This action cannot be undone. Deletion runs nightly at 02:00 UTC.
    }
    ==
    {
      <b>Span Retention</b>
      --
      ^30 days                                                               ^
      <i>Options: 30 days / 60 days / 90 days / 180 days / 365 days / Indefinite</i>
    }
    --
    {
      <b>Log Retention</b>
      --
      ^60 days                                                               ^
      <i>Options: 30 days / 60 days / 90 days / 180 days / 365 days / Indefinite</i>
    }
    ==
    <b>Current Storage Usage</b>
    --
    {
      {
        <b>Spans</b>       | 2.4 GB  | "████████████░░░░░░░░░░░░  48%"
        <b>Logs</b>        | 0.8 GB  | "████░░░░░░░░░░░░░░░░░░░░  16%"
        <b>Indexes</b>     | 0.6 GB  | "███░░░░░░░░░░░░░░░░░░░░░  12%"
        <b>Free</b>        | 1.2 GB  | "░░░░░░░░░░░░░░░░░░░░░░░░  24%"
        <b>Total</b>       | 5.0 GB  |
      }
    }
    --
    <b>Monthly Ingestion (last 6 months)</b>
    --
    {
      {
        "Dec" | "Jan" | "Feb" | "Mar" | "Apr" | "May"
        "█   " | "██  " | "███ " | "████" | "███ " | "██  "
        "0.3G" | "0.5G" | "0.8G" | "1.1G" | "0.9G" | "0.4G"
      }
    }
    ==
    {
      [Cancel] | [Save Retention Policy]
    }
  }
}
@endsalt
