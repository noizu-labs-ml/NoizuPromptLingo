{
  "name": "@trr/storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "seed:weaviate": "node --loader ts-node/esm src/seed-weaviate.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@trr/core": "workspace:*",
    "pg": "^8.13.0",
    "ioredis": "^5.4.0",
    "weaviate-client": "^3.3.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.0",
    "@types/pg": "^8.11.0"
  }
}
