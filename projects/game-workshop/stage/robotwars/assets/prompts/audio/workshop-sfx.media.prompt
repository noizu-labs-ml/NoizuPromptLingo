schema: "0.4"
id: audio-004-workshop-sfx
type: sfx
quality: medium

# This prompt generates multiple individual SFX files. Each output entry
# describes one sound effect. The tool generates each as a separate request.
prompt:
  system: |
    You are generating individual sound effects for a cozy game's crafting
    workshop. Every sound should be warm, quiet, and tactile — like ASMR for
    a woodworker's shop. These are UI-adjacent sounds.

    SHARED CHARACTERISTICS:
    - Recorded with room tone (small wooden room, warm acoustic space)
    - Warm frequency range. No harsh highs. No rumbling lows.
    - Quiet enough to sit beneath music and ambience.
  provider_options:
    style: "sound effects foley workshop wood crafting warm cozy"

output:
  formats:
    - format: mp3
      filename: craft-start
      description: "Satisfying thunk of placing an item on a wooden workbench. Solid, warm, like placing a heavy book on oak. Not a slam — a placement."
    - format: mp3
      filename: ingredient-added
      description: "Gentle wooden tap followed by a brief pleasant crystalline tone. Like dropping a component into a carved depression on the bench. Wood variant."
    - format: mp3
      filename: crafting-progress
      description: "Rhythmic woodworking sound — gentle planing or sanding. Rhythmic, satisfying, ASMR quality. The sound of patient, skilled handwork."
    - format: mp3
      filename: craft-complete
      description: "Rising three-note chime (wooden xylophone or marimba, warm-toned) followed by a soft settling sound — the finished item being placed down. Satisfaction without fanfare."
    - format: mp3
      filename: quality-reveal
      description: "Gentle ascending guitar arpeggio — warm, brief, pleasant. Four ascending notes for a 4-star quality reveal."
    - format: mp3
      filename: craft-error
      description: "Soft wooden thunk — not harsh or punitive. Just 'that didn't work.' A dropped piece of wood sound, gentle."
  duration: 5

# eval: audio not yet auto-gradable

tags: [audio, sfx, workshop, crafting, ui-sounds, foley, warm]
