# Gateway
MODAL_GENAI_HOST=127.0.0.1
MODAL_GENAI_PORT=8080
MODAL_GENAI_MODEL_CONFIG=config/models.yaml
MODAL_GENAI_API_KEY=local-dev-key

# Set to 1 to run the gateway with no Modal token/GPU: media providers return
# deterministic stubs and the test suite passes offline.
MODAL_GENAI_STUB_MODE=0

# Shared bearer token enforced by the deployed vLLM apps (passed as api_key in
# config/models.yaml -> providers.*.api_key). Generate with `openssl rand -hex 24`.
MODAL_GENAI_VLLM_KEY=change-me

# Modal needs a Hugging Face token to pull gated/large weights at build time.
# Create a Modal secret named `huggingface` holding HF_TOKEN, or export here for
# local `modal run`.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Non-interactive deploy (make deploy-ci / ./deploy-ci.sh)
# ---------------------------------------------------------------------------
# Modal API tokens — create at https://modal.com/settings/tokens. With these set
# you can deploy from CI with no `modal setup` / browser step.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Optional: Modal environment/workspace to deploy into (else your default).
MODAL_ENVIRONMENT=
# If left blank, deploy-ci.sh generates these and prints them. Set them here to
# keep them stable across re-deploys (recommended).
# MODAL_GENAI_VLLM_KEY=
# MODAL_GENAI_API_KEY=
