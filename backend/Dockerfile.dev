# syntax=docker/dockerfile:1.7
FROM elixir:1.19.5-otp-28-slim

# Dev image: tool base only; mix deps live on named volumes. Hex/rebar cache mounts speed rebuilds when this layer invalidates.
# Keep BEAM JIT mappings compatible with cross-arch dev builds/runs.
ENV ERL_AFLAGS="+JMsingle true"

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update -y && \
    apt-get install -y build-essential git inotify-tools && \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.hex,sharing=locked \
    --mount=type=cache,target=/root/.cache/rebar3,sharing=locked \
    mix local.hex --force && mix local.rebar --force

WORKDIR /app

CMD ["mix", "phx.server"]
