#!/bin/sh
# tabbing-marquee — Marquee-scroll text across the tab title
#
# Runs in a subprocess, updating the tab title to show a sliding
# window of text that scrolls left, looping continuously.
#
# Usage:
#   tabbing-marquee "Hello World — this is my scrolling tab title"
#   tabbing-marquee -w 20 -d 0.15 "Some long text here"
#   tabbing-marquee --stop
#
# Options:
#   -w, --width N    Visible window width (default: 20)
#   -d, --delay S    Seconds between frames (default: 0.2)
#   --stop           Kill any running marquee for this terminal

set -e

case "${1:-}" in --version|-V)
  _dr="$(cd "$(dirname "$0")/.." && pwd)"
  [ ! -f "$_dr/lib/render.sh" ] && _dr="${XDG_DATA_HOME:-$HOME/.local/share}/tabbing-on"
  . "$_dr/lib/render.sh"; _tabbing_print_version; exit 0 ;;
esac

# Output helper — use stdout when inside Claude Code, /dev/tty otherwise
_tabbing_tty_printf() {
  if [[ "${CLAUDECODE}" == "1" ]; then
    printf "$@"
  else
    printf "$@" >/dev/tty 2>/dev/null || printf "$@"
  fi
}

# Defaults
_WIDTH=20
_DELAY=0.2
_TEXT=""
_STOP=0
_PIDFILE="${TMPDIR:-/tmp}/tabbing-marquee-$$.pid"

# Use XDG or fallback for pid tracking
_state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/tabbing"

_usage() {
  printf 'Usage: tabbing-marquee [options] "text"\n\n'
  printf 'Options:\n'
  printf '  -w, --width N    Visible width (default: 20)\n'
  printf '  -d, --delay S    Frame delay in seconds (default: 0.2)\n'
  printf '  --stop           Stop running marquee\n'
  exit 0
}

# Parse args
while [ $# -gt 0 ]; do
  case "$1" in
    -w|--width)  _WIDTH="$2"; shift 2 ;;
    -w=*|--width=*) _WIDTH="${1#*=}"; shift ;;
    -d|--delay)  _DELAY="$2"; shift 2 ;;
    -d=*|--delay=*) _DELAY="${1#*=}"; shift ;;
    --stop)      _STOP=1; shift ;;
    -h|--help)   _usage ;;
    -*)          printf 'tabbing-marquee: unknown option: %s\n' "$1" >&2; exit 1 ;;
    *)           _TEXT="$1"; shift ;;
  esac
done

# PID file location
_pidfile="${_state_dir}/marquee.pid"
mkdir -p "$_state_dir"

# Handle --stop
if [ "$_STOP" -eq 1 ]; then
  if [ -f "$_pidfile" ]; then
    _pid="$(cat "$_pidfile")"
    if kill -0 "$_pid" 2>/dev/null; then
      kill "$_pid" 2>/dev/null
      printf 'tabbing-marquee: stopped (pid %s)\n' "$_pid"
    else
      printf 'tabbing-marquee: no running marquee found\n'
    fi
    rm -f "$_pidfile"
  else
    printf 'tabbing-marquee: no running marquee found\n'
  fi
  exit 0
fi

if [ -z "$_TEXT" ]; then
  printf 'tabbing-marquee: no text provided\n' >&2
  _usage
fi

# Kill any existing marquee
if [ -f "$_pidfile" ]; then
  _old_pid="$(cat "$_pidfile")"
  kill "$_old_pid" 2>/dev/null || true
  rm -f "$_pidfile"
fi

# Pad text with spaces so it scrolls cleanly
_padded="${_TEXT}    "
_len=${#_padded}

# Run the marquee loop in a background subprocess
(
  _offset=0
  trap '_tabbing_tty_printf "\033]0;\007"; rm -f "'"$_pidfile"'"; exit 0' INT TERM

  while true; do
    # Build the visible window by wrapping around
    _visible=""
    _i=0
    while [ "$_i" -lt "$_WIDTH" ]; do
      _pos=$(( (_offset + _i) % _len ))
      # Extract character at position
      _char="$(printf '%s' "$_padded" | cut -c$((_pos + 1)))"
      _visible="${_visible}${_char}"
      _i=$((_i + 1))
    done

    _tabbing_tty_printf '\033]0;%s\007' "$_visible"

    _offset=$(( (_offset + 1) % _len ))
    sleep "$_DELAY"
  done
) &

_bg_pid=$!
printf '%s' "$_bg_pid" > "$_pidfile"
printf 'tabbing-marquee: running (pid %s, width %s, delay %s)\n' "$_bg_pid" "$_WIDTH" "$_DELAY"
printf 'tabbing-marquee: stop with: tabbing-marquee --stop\n'
