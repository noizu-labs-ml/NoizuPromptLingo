schema: "0.3"
id: landing-page-001
type: html
service: anthropic
model: claude-sonnet-4-6

prompt:
  system: "Generate a complete, self-contained HTML page with inline CSS. No external dependencies. Modern, responsive, dark-themed design."
  text: "Create a SaaS pricing page with 3 tiers: Starter ($9/mo, 1 project), Pro ($29/mo, 10 projects), Enterprise (custom). Include feature comparison, FAQ accordion with JavaScript, and CTA buttons."
  provider_options:
    max_tokens: 8192
    temperature: 0.3

output:
  formats:
    - format: html
    - format: png
  dimensions:
    width: 1440
    height: 900

post_processing:
  - action: render
    params:
      tool: puppeteer
      output_format: png
      viewport:
        width: 1440
        height: 900

tags: [landing-page, pricing, saas]
