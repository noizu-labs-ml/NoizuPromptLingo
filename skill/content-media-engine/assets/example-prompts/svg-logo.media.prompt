schema: "0.3"
id: svg-logo-001
type: image
service: gemini-chat
model: gemini-2.5-flash

prompt:
  system: "You are an SVG graphic generator. Output ONLY valid SVG markup starting with <svg>. Use viewBox for scaling. No wrapping, no explanation."
  text: "Create a minimal geometric logomark: two interlocking hexagons forming a brain shape. Use electric cyan (#00D4FF) and deep navy (#0A1628). Clean vector lines, no fills, stroke-width 2."
  provider_options:
    max_tokens: 4096
    temperature: 0.3

output:
  formats:
    - format: svg
  text_format: svg

tags: [logo, brand, svg]
