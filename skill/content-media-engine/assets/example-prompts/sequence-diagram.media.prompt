schema: "0.3"
id: seq-diagram-001
type: diagram
service: anthropic
model: claude-sonnet-4-6

prompt:
  system: "You are a Mermaid diagram generator. Output ONLY valid Mermaid markup. No code fences. No explanation."
  text: "Create a sequence diagram showing OAuth 2.0 authorization code flow: User → Browser → Auth Server → Resource Server. Show token exchange, redirect, and API call with bearer token."
  provider_options:
    max_tokens: 4096
    temperature: 0.2

output:
  formats:
    - format: mmd
    - format: svg
  diagram_type: mermaid

post_processing:
  - action: render
    params:
      tool: mermaid
      output_format: svg
      theme: dark

tags: [sequence, oauth, auth]
